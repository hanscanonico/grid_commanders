# Godot
.godot/

# Vendored engine binary (see README for setup). No trailing slash: a git
# worktree shares no ignored files with the main checkout, so the usual fix is
# to symlink bin/ across — and `bin/` would not match a symlink named `bin`.
bin

# The Godot AI MCP plugin's installer drops a second copy of its licence at the
# repo root; the vendored addon carries its own `addons/godot_ai/LICENSE`, which
# is the copy we track.
godot-ai-LICENSE.txt

# Python bytecode. arena_search.py refuses to write its own
# (sys.dont_write_bytecode), but that guards only its runs — any other
# interpreter importing the file (a linter, an editor, a test) drops one.
__pycache__/

# macOS
.DS_Store

# Local verification artifacts
screenshot*.png
screenshot*.png.import

# Balance runner output (tools/run_commander_balance.gd). The committed artifacts
# of a balance pass are tuned data/commanders/*.tres and docs/commander_balance.md,
# never the generated CSV/JSON. `reports/*` rather than `reports/`: git will not
# look inside an excluded directory, so the marker below could not be re-included.
reports/*
# The one exception, and the reason the directory is tracked at all: it tells the
# engine not to import a report as game data. See reports/.gdignore.
!reports/.gdignore

# Agent scratch space. .claude/worktrees holds nested checkouts of this repo,
# which git would otherwise offer to commit as embedded repositories. `.claude/*`
# rather than `.claude/`: git will not look inside an excluded directory, so the
# rules below could not be re-included.
.claude/*
# The exception: .claude/rules/ holds the designs of record CLAUDE.md indexes,
# loaded by path rather than at launch. They are tracked instructions, not scratch.
!.claude/rules/

# Lavish review artifacts — in-progress plans and the screenshots they cite are
# scratch by default. The designs of record CLAUDE.md points at are already
# tracked and stay that way: ignoring a path git already tracks changes nothing.
# A new plan worth keeping is promoted with `git add -f .lavish/<name>.html`.
.lavish/
# The sprite generator brought its own `.lavish/` in, and that one is not
# scratch: it holds the review gallery, and `check_snapshots.py` reads the
# preview sheets out of it, so a new one has to be addable without -f.
!generators/sprites/.lavish/

# Promo capture scratch: the rendered clips, frames and cut videos a promo pass
# leaves behind are generated media, never a source artifact. `.promo/*` rather
# than `.promo/`: git will not look inside an excluded directory, so the
# generator below could not be re-included.
.promo/*
# The generator that renders all of it is source, and is kept.
!.promo/make_promo.sh

# Mobile packages and their signing material. The package is build output
# (make export-android writes build/android/, make export-ios writes the Xcode
# project into build/ios/), and a keystore is a secret that never enters the
# repository — the debug one lives in ~/.android and a release one is machine
# setup. export_presets.cfg carries paths and identity only.
build/
*.apk
*.aab
*.ipa
*.keystore
*.jks
