CLOUDFLARE_TUNNEL_TOKEN=
# The Cloudflare Access application in front of /admin. Zero Trust → Access →
# Applications → the self-hosted app's Application Audience (AUD) tag.
ADMIN_ACCESS_AUD=
# The team domain without the .cloudflareaccess.com suffix — the collector
# fetches that team's signing keys. With either key blank /admin answers 403.
ADMIN_ACCESS_TEAM=
# The salt the daily visitor hash is built from: `openssl rand -hex 32`.
# Unset, the collector generates one per start and today's uniques reset with
# the process.
ADMIN_HASH_SECRET=
