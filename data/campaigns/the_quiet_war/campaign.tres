[resource]
script = ExtResource("1")
id = &"the_quiet_war"
title = "The Quiet War"
premise = "Cass Orlov does not cross borders; he dissolves them. Border provinces begin \"requesting Iron protection\" after their garrisons mutiny, their arsenals burn, and their governors fall to scandals that arrive too conveniently."
antagonist = "The Iron Dominion"
missions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19")])
block_titles = Array[String](["Prove It", "Cut the Network", "Daylight"])
block_lengths = Array[int]([6, 6, 6])
interludes = Array[Resource]([ExtResource("20"), ExtResource("21"), ExtResource("22")])
