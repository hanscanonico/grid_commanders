[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]

[sub_resource type="Resource" id="Objective_take_the_waystation"]
script = ExtResource("2")
text = "Take the waystation."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Failure_day_4"]
script = ExtResource("3")
text = "The waystation stayed Ferrow's past day 4."
last_day = 4

[sub_resource type="Resource" id="Bonus_take_the_courier"]
script = ExtResource("5")
text = "Take the route book off Ferrow's courier."
id = &"destroy_ferrow_courier"
tag = &"ferrow_courier"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Ferrow keeps a hidden depot for every column that's crossed unnoticed. You found it on a hunch, Flux — don't waste the head start."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "The screen's extra vision made the hunch. Hit it before his garrison learns their depot isn't as hidden as it was yesterday."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Then we move now, not at first light. Every hour's a chance he finds out."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Agreed. Moving."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "The waystation falls, and with it every route his raiders have used for a month."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Marking the depot recovered. Starting to read the routes backward, toward whoever built them."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_depot_watch"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Effect_depot_watch"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_depot_watch")])

[sub_resource type="Resource" id="Event_line_double_the_watch"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Somebody's been reading my routes. Double the depot watch and bill it to Vale."

[sub_resource type="Resource" id="Event_the_garrison_learns"]
script = ExtResource("6")
id = &"the_garrison_learns"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_depot_watch")])
once = true
lines = Array[Resource]([SubResource("Event_line_double_the_watch")])

[sub_resource type="Resource" id="Trigger_courier_taken"]
script = ExtResource("8")
objective = SubResource("Bonus_take_the_courier")

[sub_resource type="Resource" id="Effect_columns_broken"]
script = ExtResource("12")
flag = &"qw_columns_broken"
mode = 1
value = 1
note = "Ferrow's courier is down and his route book is ours; that column crosses nothing again."

[sub_resource type="Resource" id="Event_line_route_book"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Courier's down and the route book came off him intact. That's a month of his crossings, backwards."

[sub_resource type="Resource" id="Event_the_route_book"]
script = ExtResource("6")
id = &"the_route_book"
triggers = Array[Resource]([SubResource("Trigger_courier_taken")])
effects = Array[Resource]([SubResource("Effect_columns_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_route_book")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("7")
day = 1

[sub_resource type="Resource" id="Effect_evidence"]
script = ExtResource("12")
flag = &"qw_evidence"
mode = 1
value = 1
note = "The waystation's crossing manifests went into the map office's file."

[sub_resource type="Resource" id="Event_the_depot_is_marked"]
script = ExtResource("6")
id = &"the_depot_is_marked"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_evidence")])
once = true
lines = Array[Resource]([])

[resource]
script = ExtResource("1")
id = &"qw08_the_waystation"
title = "The Waystation"
location = "An unmarked depot, deep woods"
map_path = "res://maps/campaign/the_quiet_war/qw08_the_waystation.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"orin_flux",
2: &"dane_ferrow"
}
fog_enabled = true
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_waystation")])
failures = Array[Resource]([SubResource("Failure_day_4")])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_courier")])
events = Array[Resource]([SubResource("Event_the_garrison_learns"), SubResource("Event_the_route_book"), SubResource("Event_the_depot_is_marked")])
par_day = 4
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The waystation held, and stayed exactly as hidden as it needed to be."
