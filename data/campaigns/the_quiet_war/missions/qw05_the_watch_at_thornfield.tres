[sub_resource type="Resource" id="Objective_hold_thornfield"]
script = ExtResource("2")
text = "Hold Thornfield for five days."
cell = Vector2i(9, 2)
days = 5

[sub_resource type="Resource" id="Failure_losses"]
script = ExtResource("4")
text = "More than 3 of ours lost in the wood line, to any cause."
max_losses = 3

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Vale's column is moving on Thornfield before it can be garrisoned properly. You've got one picket and a wood line, Rook."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "I doubted you at Selwich, Flux. Not twice. We make the tree line look like more than it is."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Reinforcements are six days out. That's the whole of what I can promise you."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Six days of bluffing a wood line. I've done worse with less."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Thornfield holds. His column pulls back to look for a softer town and doesn't find one this week."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "The woods were the real reinforcement. My picket just had to stand in them."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_vale_armour"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(13, 4)

[sub_resource type="Resource" id="Effect_vale_presses"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_vale_armour")])

[sub_resource type="Resource" id="Event_line_bluff"]
script = ExtResource("3")
speaker = &"konrad_vale"
text = "The wood line is a bluff, Commander Rook. I am sending something that does not care what is standing in it."

[sub_resource type="Resource" id="Event_vales_column_presses"]
script = ExtResource("5")
id = &"vales_column_presses"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_vale_presses")])
once = true
lines = Array[Resource]([SubResource("Event_line_bluff")])

[sub_resource type="Resource" id="Trigger_thornfield_still_ours"]
script = ExtResource("11")
cell = Vector2i(9, 2)
holder = 0

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("6")
day = 5

[sub_resource type="Resource" id="Trigger_before_day_5"]
script = ExtResource("12")
day = 5

[sub_resource type="Resource" id="Effect_thornfield_held"]
script = ExtResource("10")
flag = &"qw_thornfield_held"
value = 1
note = "Thornfield was still Rook's on the fifth morning, with Vale's armour already in the tree line."

[sub_resource type="Resource" id="Event_line_fifth_morning"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Fifth morning, and the town is still ours with his armour already in the tree line. The district can put that in a report."

[sub_resource type="Resource" id="Event_the_watch_stands"]
script = ExtResource("5")
id = &"the_watch_stands"
triggers = Array[Resource]([SubResource("Trigger_thornfield_still_ours"), SubResource("Trigger_day_5"), SubResource("Trigger_before_day_5")])
effects = Array[Resource]([SubResource("Effect_thornfield_held")])
once = true
lines = Array[Resource]([SubResource("Event_line_fifth_morning")])

[resource]
script = ExtResource("1")
id = &"qw05_the_watch_at_thornfield"
title = "The Watch at Thornfield"
location = "Thornfield, Aurora border woods"
map_path = "res://maps/campaign/the_quiet_war/qw05_the_watch_at_thornfield.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"cassian_rook",
2: &"konrad_vale"
}
fog_enabled = true
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_thornfield")])
failures = Array[Resource]([SubResource("Failure_losses")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_vales_column_presses"), SubResource("Event_the_watch_stands")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Thornfield fell before the relief column crossed the ridge, and Vale had his town by nightfall."
