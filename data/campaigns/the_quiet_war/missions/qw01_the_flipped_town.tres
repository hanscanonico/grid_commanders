[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_retake_selwich"]
script = ExtResource("2")
text = "Retake Selwich."
cell = Vector2i(6, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "No shots fired, no declaration made. Selwich's garrison changed sides overnight, and the map office heard it from a farmer."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "A garrison doesn't just change its mind, Flux. Someone paid for that, or scared them into it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "My screen went to look. It's already Orlov's — whichever it was, it worked without a fight."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Then take it back the same way it was lost. Quietly, before he decides it's worth defending."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Selwich comes back without a fight this time either. The garrison that flipped it isn't the one that held it."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "I don't like what that implies about the next town over. Neither should you."

[resource]
script = ExtResource("1")
id = &"qw01_the_flipped_town"
