[sub_resource type="Resource" id="Objective_retake_selwich"]
script = ExtResource("2")
text = "Recapture Selwich."
cell = Vector2i(6, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "No shots fired. No declaration. Selwich's garrison changed sides overnight and the map office heard about it from a farmer."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "A garrison doesn't just change its mind, Flux. Someone paid for that, or scared them into it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "My screen went to look. It's already flying his colours. Paid or frightened, it worked without a shot."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Then take it back the same way it was lost, and do it before he decides the place is worth a garrison."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Selwich comes back without a fight this time either. The garrison that flipped it wasn't the garrison that held it, and neither of them is from here."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "I don't like what that implies about the next town over."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_selwich_garrison"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(9, 3)

[sub_resource type="Resource" id="Effect_garrison_selwich"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_selwich_garrison")])

[sub_resource type="Resource" id="Event_line_garrison"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "So the map office reads its mail after all. Garrison Selwich. It's stopped being free."

[sub_resource type="Resource" id="Event_orlov_garrisons"]
script = ExtResource("5")
id = &"orlov_garrisons"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_garrison_selwich")])
once = true
lines = Array[Resource]([SubResource("Event_line_garrison")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("6")
day = 1

[sub_resource type="Resource" id="Effect_evidence"]
script = ExtResource("10")
flag = &"qw_evidence"
mode = 1
value = 1
note = "The map office has opened a file on Orlov's network."

[sub_resource type="Resource" id="Event_the_file_opens"]
script = ExtResource("5")
id = &"the_file_opens"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_evidence")])
once = true
lines = Array[Resource]([])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Selwich stays mine, and nobody declared a thing. Write that down. That's how I'd like the whole season to go."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Your column's off the board. The garrison Selwich flipped for is still drawing pay. I've opened the file anyway."

[resource]
script = ExtResource("1")
id = &"qw01_the_flipped_town"
title = "The Flipped Town"
location = "Selwich, Meridian border district"
map_path = "res://maps/campaign/the_quiet_war/qw01_the_flipped_town.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"orin_flux",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_retake_selwich")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_orlov_garrisons"), SubResource("Event_the_file_opens")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
