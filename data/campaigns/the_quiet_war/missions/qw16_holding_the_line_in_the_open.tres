[sub_resource type="Resource" id="Objective_hold_the_line"]
script = ExtResource("2")
text = "Hold the line until day 7."
day = 7

[sub_resource type="Resource" id="Objective_stand_where_you_started"]
script = ExtResource("4")
text = "Keep the anchor town ours for five whole days."
cell = Vector2i(6, 3)
days = 5

[sub_resource type="Resource" id="Thornfield_held"]
script = ExtResource("5")
flag = &"qw_thornfield_held"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Vance is throwing her heaviest column of the war at the line before our reserves arrive, Colt. No fog to hide behind this time. Just the line."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "I hold it the way I always have. Refuse, refit, refuse again."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "I've held lines like that. It costs more in the open than it ever did in fog."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Rook held a wood line with one picket and the district still talks about it. You've got an army. Hold."
requires = SubResource("Thornfield_held")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Everything costs more in the open. Doesn't mean I stop paying it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Her push spends itself against a line that won't move. Everything she put into it came straight back at her."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Second Wind found plenty of reasons to keep fighting today, and I'll take that as a compliment."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Spawn_reserve_heavy"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(16, 5)

[sub_resource type="Resource" id="Spawn_reserve_tank"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(16, 6)

[sub_resource type="Resource" id="Effect_her_whole_reserve"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_reserve_heavy"), SubResource("Spawn_reserve_tank")])

[sub_resource type="Resource" id="Event_line_reserve"]
script = ExtResource("3")
speaker = &"iona_vance"
text = "This is the whole of my reserve. I'm spending it on one line, and I expect the scales to tip."

[sub_resource type="Resource" id="Event_her_whole_reserve"]
script = ExtResource("6")
id = &"her_whole_reserve"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_her_whole_reserve")])
once = true
lines = Array[Resource]([SubResource("Event_line_reserve")])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("3")
speaker = &"iona_vance"
text = "I spent my whole reserve on one line and the scales tipped. Your line's in the open with nowhere to hide why it broke."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The line broke before the seventh day. No fog to put the reason in this time. It goes in the file the way it happened."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Her whole column's on my screen and none of it's hiding. I've never had a page this easy to read. I like it less than the fog."

