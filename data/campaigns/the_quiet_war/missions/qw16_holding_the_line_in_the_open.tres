[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_hold_the_line"]
script = ExtResource("2")
text = "Hold the line until day 7."
day = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Vance is committing her heaviest column of the war to break the line before we bring up reserves, Colt. No fog to hide behind this time — only the line itself."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Then I hold it the way I always have. Refuse, refit, refuse again."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "I've held lines like that. It costs more in the open than it ever did in fog."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Everything costs more in the open. Doesn't mean I stop paying it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Her push spends itself against a line that won't move. You're standing exactly where you started."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Second Wind found plenty of reasons to keep fighting today. I'll take that as a compliment."

[resource]
script = ExtResource("1")
id = &"qw16_holding_the_line_in_the_open"
title = "Holding the Line in the Open"
location = "The eastern plain, Meridian border"
map_path = "res://maps/campaign/the_quiet_war/qw16_holding_the_line_in_the_open.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
