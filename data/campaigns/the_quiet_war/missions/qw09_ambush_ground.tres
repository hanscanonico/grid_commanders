[sub_resource type="Resource" id="Unlock_handler_at_large"]
script = ExtResource("6")
flag = &"qw_handler_taken"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_reach_the_tree_line"]
script = ExtResource("4")
text = "Get two units into the tree line before his raiders do."
cells = Array[Vector2i]([Vector2i(8, 3), Vector2i(9, 3), Vector2i(7, 4)])
count = 2

[sub_resource type="Resource" id="Objective_survive_the_ambush"]
script = ExtResource("2")
text = "Survive until day 4."
day = 4

[sub_resource type="Resource" id="Failure_one_loss"]
script = ExtResource("5")
text = "The column lost more in the wood than the wood was worth."
max_losses = 1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Orlov's raiders picked this wood because the map calls it empty ground, Calder. It hasn't been empty since your column moved through it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Then let's make his ambush cost him more than it saves. A cheaper, smaller force reaches the tree line first."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "That's the one thing his plan never accounted for. He's set the trap for someone who isn't there."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Good. I'd rather spend less than he expects and still walk away."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "The ambush springs on ground it can't hold. Your column was never where the map said it would be."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "His raiders scatter into terrain that no longer favours them either. Small price for a wasted trap."

[sub_resource type="Resource" id="Trigger_tree_line_taken"]
script = ExtResource("8")
objective = SubResource("Objective_reach_the_tree_line")

[sub_resource type="Resource" id="Spawn_raider_east"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Spawn_raider_south"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(9, 5)

[sub_resource type="Resource" id="Effect_the_trap"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_raider_east"), SubResource("Spawn_raider_south")])

[sub_resource type="Resource" id="Event_line_close_it"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "There they are. Close it."

[sub_resource type="Resource" id="Event_the_trap_springs"]
script = ExtResource("7")
id = &"the_trap_springs"
triggers = Array[Resource]([SubResource("Trigger_tree_line_taken")])
effects = Array[Resource]([SubResource("Effect_the_trap")])
once = true
lines = Array[Resource]([SubResource("Event_line_close_it")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("9")
day = 1

[sub_resource type="Resource" id="Effect_columns_broken"]
script = ExtResource("13")
flag = &"qw_columns_broken"
mode = 1
value = 1
note = "Orlov's raiders sprang their trap on ground they could not hold, and a raid column is off the board."

[sub_resource type="Resource" id="Event_the_trap_is_wasted"]
script = ExtResource("7")
id = &"the_trap_is_wasted"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_columns_broken")])
once = true
lines = Array[Resource]([])

[resource]
script = ExtResource("1")
id = &"qw09_ambush_ground"
title = "Ambush Ground"
location = "An unmarked wood, Verdant border"
map_path = "res://maps/campaign/the_quiet_war/qw09_ambush_ground.txt"
unlock_requires = SubResource("Unlock_handler_at_large")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ines_calder",
2: &"cass_orlov"
}
fog_enabled = true
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_reach_the_tree_line"), SubResource("Objective_survive_the_ambush")])
failures = Array[Resource]([SubResource("Failure_one_loss")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_trap_springs"), SubResource("Event_the_trap_is_wasted")])
par_day = 4
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The ambush caught the column exactly where the map promised it would be."
