[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_survive_the_ambush"]
script = ExtResource("2")
text = "Survive until day 4."
day = 4

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Orlov's raiders picked this wood because the map calls it empty ground, Calder. It hasn't been empty since your column moved through it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Then let's make his ambush cost him more than it saves. A cheaper, smaller force reaches the tree line first."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "That's the one thing his plan never accounted for. He's set the trap for someone who isn't there."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Good. I'd rather spend less than he expects and still walk away."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "The ambush springs on ground it can't hold. Your column was never where the map said it would be."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "His raiders scatter into terrain that no longer favours them either. Small price for a wasted trap."

[resource]
script = ExtResource("1")
