[sub_resource type="Resource" id="Objective_take_millhollow"]
script = ExtResource("2")
text = "Capture Millhollow before the cache moves."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Bonus_break_the_convoy"]
script = ExtResource("5")
text = "Break the cache column before it clears the trees."
id = &"destroy_cache_convoy"
hidden = true
tag = &"morn_cache_convoy"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Morn's forward supply cache moves at the end of the week, Quill. Six days in the trees to take it, or it's gone."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Small force, small window. Give me the odds and I will tell you if I like them."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Better than even, worse than comfortable. That's as precise as I can make it from here."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Good enough odds to move on. Let us not give the clock a vote."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Millhollow falls with a day of the week to spare. He got his crates onto the road. He doesn't get the town that fed them."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "I do not linger on a win like this one, since a raid that stands still becomes a target."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("7")
day = 2

[sub_resource type="Resource" id="Effect_name_the_convoy"]
script = ExtResource("9")
objective_id = &"destroy_cache_convoy"

[sub_resource type="Resource" id="Spawn_barn_guard"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Effect_barn_guard"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_barn_guard")])

[sub_resource type="Resource" id="Event_line_first_light"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "It moves on my schedule, not on hers. Let them arrive to an empty barn."

[sub_resource type="Resource" id="Event_the_cache_loads"]
script = ExtResource("6")
id = &"the_cache_loads"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_name_the_convoy"), SubResource("Effect_barn_guard")])
once = true
lines = Array[Resource]([SubResource("Event_line_first_light")])

[sub_resource type="Resource" id="Trigger_convoy_broken"]
script = ExtResource("8")
objective = SubResource("Bonus_break_the_convoy")

[sub_resource type="Resource" id="Effect_columns_broken"]
script = ExtResource("13")
flag = &"qw_columns_broken"
mode = 1
value = 1
note = "A raid column of Orlov's is off the board for good."

[sub_resource type="Resource" id="Event_line_empty_barn"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "The barn is empty and so is his column. Those were even odds, and I will take them again."

[sub_resource type="Resource" id="Event_the_convoy_breaks"]
script = ExtResource("6")
id = &"the_convoy_breaks"
triggers = Array[Resource]([SubResource("Trigger_convoy_broken")])
effects = Array[Resource]([SubResource("Effect_columns_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_empty_barn")])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "Six days in the trees and you never found the barn. My crates left on my schedule, by a road you never saw."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Your raid ran out before the week did. The convoy pulled out on the seventh morning with everything it came for. Millhollow's an empty town on a map."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "You're the Concord's, on contract, so you'd know better than me. They don't hold a border. They hold the odds."

