[sub_resource type="Resource" id="Objective_take_millhollow"]
script = ExtResource("2")
text = "Take Millhollow before the cache moves."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Failure_day_4"]
script = ExtResource("3")
text = "The cache moved out past day 4."
last_day = 4

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Morn's forward supply cache moves at first light, Quill. One night in the trees to take it, or it's gone."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Small force, small window — give me the odds and I'll tell you if I like them."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Better than even, worse than comfortable. That's as precise as I can make it before dawn."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Good enough odds to move on. Let's not give the sun a vote."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Millhollow falls before dawn. The cache stays exactly where he left it, under new management."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "I don't linger on a win like this one. A raid that stands still becomes a target."

[resource]
script = ExtResource("1")
id = &"qw07_the_cache_at_millhollow"
title = "The Cache at Millhollow"
location = "Millhollow, deep woods"
map_path = "res://maps/campaign/the_quiet_war/qw07_the_cache_at_millhollow.txt"
