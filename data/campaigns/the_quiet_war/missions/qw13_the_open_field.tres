briefing = Array[String]([
"There is nothing quiet about this. Iona Vance's column advances in the open, in daylight, and every instrument the network needed to hide is worthless now.",
"Alina Ward answers with an army instead of a screen. Take the base and prove the open war is one the alliance can also fight in the open."
])
victory = Array[String]([
"Vance's base falls in a fight neither side had to hide from. Ward's army holds ground it took in daylight, which is its own answer.",
"Orlov wanted this war fought in shadows because the alliance could not win it in the light. Today says otherwise."
])
defeat = "Vance's base held, and the open war is not yet the alliance's to win outright."
