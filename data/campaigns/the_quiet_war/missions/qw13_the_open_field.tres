[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="10"]

[sub_resource type="Resource" id="Objective_take_vances_base"]
script = ExtResource("2")
text = "Capture Vance's forward base."
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Columns_broken"]
script = ExtResource("5")
flag = &"qw_columns_broken"
at_least = 2
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Nothing quiet about this one. Vance is advancing in the open, in daylight, like a woman who's run out of things worth hiding. Every scrap of cover Orlov's network bought her is worthless now."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "We answer with an army instead of a screen. Take the base, and prove this is a war we can fight in the open too."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "No fog to plan behind, no rumour to chase. Just her column and ours."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Two of his raid columns are already off the board, for whatever that's worth out here, and she's advancing anyway."
requires = SubResource("Columns_broken")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Good. I'm tired of chasing rumours."

[sub_resource type="Resource" id="Line_4b"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "We've spent the whole war being clever about it, so it'll be a novelty to just walk at somebody in the daylight."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Her base falls in a fight neither side had to hide. We hold ground we took in daylight, and that's answer enough."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Orlov wanted this fought in shadows because he didn't think we could win it in the light. Every axis moved at once and her base came apart between them."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Orlov's people will have to write this one up the way it happened, and I'd pay real money to read the draft they try first."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_second_corps_road"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(2, 4)

[sub_resource type="Resource" id="Spawn_second_corps_flank"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(2, 5)

[sub_resource type="Resource" id="Effect_second_corps"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_second_corps_road"), SubResource("Spawn_second_corps_flank")])

[sub_resource type="Resource" id="Event_line_second_corps"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "No more screens. No more hunches. Second Corps is on the road behind you, so fight like it."

[sub_resource type="Resource" id="Event_line_second_corps_holt"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "It's daylight, an audience, and a second corps coming up the road like a parade, after months of moving this army so carefully nobody would write it down."

[sub_resource type="Resource" id="Event_second_corps"]
script = ExtResource("6")
id = &"second_corps"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_second_corps")])
once = true
lines = Array[Resource]([SubResource("Event_line_second_corps"), SubResource("Event_line_second_corps_holt")])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("3")
speaker = &"iona_vance"
text = "You wanted a war in the open. My column gave you one and your army came apart in daylight. The base is still mine."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "First fight in daylight and the army's off the board in front of an audience. Her base holds. Nothing about the open war is ours yet."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Six entries in the file and the seventh is walking at us in daylight."

