[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_reach_city_hall"]
script = ExtResource("2")
text = "Get the column onto city hall before the signing."
cells = Array[Vector2i]([Vector2i(6, 3), Vector2i(6, 4)])
count = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "A ledger nobody can trace surfaced this morning, Holt. It names the city's governor as an Iron asset."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Naturally it surfaced this morning, the one morning I've got somewhere else to be."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "He signs the annexation papers by nightfall unless your column reaches city hall first."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then city hall it is. I do love a deadline that comes with a villain already attached."

[sub_resource type="Resource" id="Line_4b"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Fog the whole way and one road worth walking, so we'll be finding him by rumour and hoping the rumour keeps better time than he does."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "City hall's yours before the ink dried on anything. Governor in custody. Ledger in evidence."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Confirms what you already suspected, Flux. This was never one town. It's a list."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Somewhere a clerk alphabetised that list, and I'd like to shake his hand and then ask what else is in his drawer."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_city_hall_guard"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(7, 3)

[sub_resource type="Resource" id="Effect_lent_men"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_city_hall_guard")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "The governor found his courage at the last minute. I lent him some men to keep it."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Lent. Of course it's lent. Nothing in this town belongs to the man standing on it."

[sub_resource type="Resource" id="Event_the_governors_courage"]
script = ExtResource("5")
id = &"the_governors_courage"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_lent_men")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("6")
day = 1

[sub_resource type="Resource" id="Effect_evidence"]
script = ExtResource("10")
flag = &"qw_evidence"
mode = 1
value = 1
note = "The governor's ledger went into evidence with a name still on it."

[sub_resource type="Resource" id="Event_line_ledger"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Somebody left the name in that ledger before they filed it, and I gave up years ago on telling carelessness apart from a favour."

[sub_resource type="Resource" id="Event_the_ledger_is_filed"]
script = ExtResource("5")
id = &"the_ledger_is_filed"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_evidence")])
once = true
lines = Array[Resource]([SubResource("Event_line_ledger")])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "The governor's men stood in the fog all day. You walked past them twice. He signed at nightfall with a steady hand."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Your column never reached city hall. The papers went through and the city is Iron ground the way Selwich is, with nobody firing a shot."

[resource]
script = ExtResource("1")
