[sub_resource type="Resource" id="Objective_reach_city_hall"]
script = ExtResource("2")
text = "Get the column onto city hall before the signing."
cells = Array[Vector2i]([Vector2i(6, 3), Vector2i(6, 4)])
count = 2

[sub_resource type="Resource" id="Failure_day_5"]
script = ExtResource("3")
text = "The papers were signed past day 5."
last_day = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "A ledger nobody can trace surfaced this morning, Holt. It names the city's governor as an Iron asset."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Naturally it surfaced this morning, the one morning I've got somewhere else to be."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "He signs the annexation papers by nightfall unless your column reaches city hall first."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then city hall it is. I do love a deadline that comes with a villain already attached."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "City hall's yours before the ink is dry on anything. Governor's in custody, ledger's in evidence."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Confirms what you already suspected, Flux. This was never one town. It's a list."

[resource]
script = ExtResource("1")
