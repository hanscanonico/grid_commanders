[sub_resource type="Resource" id="Objective_take_the_works"]
script = ExtResource("2")
text = "Take Vale's engineering works."
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Failure_day_12"]
script = ExtResource("4")
text = "The works were still Vale's past day 12."
last_day = 12

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "Vale's border works went from forged rail permits to a fortified position in the open, Marr. The paperwork phase is over."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "Then I take it the honest way this time. An army in daylight, not a ledger in the dark."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "No domain edge on rock and timber walls. You'll need to earn every yard of it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "I've earned worse in worse weather. This'll do."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "The works fall to a straightforward fight. First straightforward thing Vale's offered this whole war."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "My report needs no footnotes. Ground taken, ground held."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_wall_battery"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(16, 6)

[sub_resource type="Resource" id="Effect_wall_battery"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_wall_battery")])

[sub_resource type="Resource" id="Event_line_concrete"]
script = ExtResource("3")
speaker = &"konrad_vale"
text = "There is nothing left to file, Commander. What is left is concrete and a battery behind it, and concrete does not negotiate."

[sub_resource type="Resource" id="Event_concrete_does_not_negotiate"]
script = ExtResource("5")
id = &"concrete_does_not_negotiate"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_wall_battery")])
once = true
lines = Array[Resource]([SubResource("Event_line_concrete")])

[resource]
script = ExtResource("1")
id = &"qw15_the_engineering_works"
title = "The Engineering Works"
location = "The border works, Meridian frontier"
map_path = "res://maps/campaign/the_quiet_war/qw15_the_engineering_works.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"halden_marr",
2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_works")])
failures = Array[Resource]([SubResource("Failure_day_12")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_concrete_does_not_negotiate")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The works held, and Vale's fortifications proved as stubborn as his paperwork."
