[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_the_works"]
script = ExtResource("2")
text = "Take Vale's engineering works."
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "Vale's border works went from forged rail permits to a fortified position in the open, Marr. The paperwork phase is over."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "Then I take it the honest way this time. An army in daylight, not a ledger in the dark."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "No domain edge on rock and timber walls. You'll need to earn every yard of it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "I've earned worse in worse weather. This'll do."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "The works fall to a straightforward fight. First straightforward thing Vale's offered this whole war."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "My report needs no footnotes. Ground taken, ground held."

