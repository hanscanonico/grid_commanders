[gd_resource type="Resource" script_class="MissionDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]

[sub_resource type="Resource" id="Objective_take_the_node"]
script = ExtResource("2")
text = "Take Morn's forward base."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Failure_day_5"]
script = ExtResource("3")
text = "The node kept running past day 5."
last_day = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Every cache, relay and raid column this act has cut all ran through one forward base, Lark. Close it before he stands up a second one somewhere harder to find."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Then we move fast. A network this exposed doesn't stay exposed for long."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Agreed. This is the last piece I can hand you before the map runs out of pieces to find."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Good. I'd rather run out of pieces than run out of time."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "The node falls. First time since Selwich the network has nowhere left to report to."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "I don't think Morn's finished. I think he's about to stop being quiet about it."

[resource]
script = ExtResource("1")
id = &"qw12_the_network_node"
title = "The Network Node"
location = "The forward raid base, Aurora border woods"
map_path = "res://maps/campaign/the_quiet_war/qw12_the_network_node.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"sera_lark",
2: &"radek_morn"
}
fog_enabled = true
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_node")])
failures = Array[Resource]([SubResource("Failure_day_5")])
bonus_objectives = Array[Resource]([])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The node held, and rebuilt itself somewhere the next scout will have to find all over again."
