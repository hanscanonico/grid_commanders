briefing = Array[String]([
"Rumours put Viktor Draeg's own spearhead on this stretch of border, hedging Orlov's play with real armour instead of forged paperwork.",
"Rhea Sol answers by taking and holding every city on the map. It is the least ambiguous statement there is."
])
