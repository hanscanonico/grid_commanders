[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_the_outpost"]
script = ExtResource("2")
text = "Take Morn's last outpost."
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Morn's holding the ground between us and whatever Orlov calls a headquarters, Voss. Last outpost between here and the man himself."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then I clear it. Nothing about the finish works if this ground's still his."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "You'll have more open road to work with than that counterattack doctrine of yours has ever seen."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Good. I'll put it to use."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "The outpost falls, and his column falls back with it. Orlov's own ground is visible for the first time in this war."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "My counterattack doctrine has never had this much open road to work with. I intend to enjoy it."

[resource]
