[gd_resource type="Resource" script_class="MissionDefinition" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/reveal_objective_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]

[sub_resource type="Resource" id="Objective_take_the_safehouse"]
script = ExtResource("2")
text = "Take the forward safehouse."
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Bonus_take_the_handler"]
script = ExtResource("4")
text = "Stop the handler before he clears the east road."
id = &"destroy_orlov_handler"
hidden = true
tag = &"orlov_handler"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Every flipped town, every column in the woods, every forged ledger ran through one garrison base, and it is on no map anyone issued."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Then we take the source this time, not another symptom of it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "It's defended lighter than it should be for what's inside, which tells you he doesn't think we've found it yet."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Good. I'll take his surprise over his strength any day of the week."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The safehouse falls, and its files fall with it. Names, routes, towns not yet touched."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Not the end of his network. But it's the first time we've read its handwriting, and that was worth the fight."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("9")
day = 3

[sub_resource type="Resource" id="Effect_name_the_handler"]
script = ExtResource("10")
objective_id = &"destroy_orlov_handler"

[sub_resource type="Resource" id="Event_line_staff_car"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "A staff car just left the safehouse by the east road, ahead of us. That is the handler, and he is the whole file."

[sub_resource type="Resource" id="Event_the_handler_runs"]
script = ExtResource("6")
id = &"the_handler_runs"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_name_the_handler")])
once = true
lines = Array[Resource]([SubResource("Event_line_staff_car")])

[sub_resource type="Resource" id="Trigger_handler_taken"]
script = ExtResource("8")
objective = SubResource("Bonus_take_the_handler")

[sub_resource type="Resource" id="Effect_handler_taken"]
script = ExtResource("11")
flag = &"qw_handler_taken"
value = 1
note = "The handler was taken on the east road, and the file has a name where the hole was."

[sub_resource type="Resource" id="Event_line_the_car_stops"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Staff car stopped short of the east road. Whatever he was carrying, he's carrying it for us now."

[sub_resource type="Resource" id="Event_the_handler_taken"]
script = ExtResource("6")
id = &"the_handler_taken"
triggers = Array[Resource]([SubResource("Trigger_handler_taken")])
effects = Array[Resource]([SubResource("Effect_handler_taken")])
once = true
lines = Array[Resource]([SubResource("Event_line_the_car_stops")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("9")
day = 1

[sub_resource type="Resource" id="Effect_evidence"]
script = ExtResource("11")
flag = &"qw_evidence"
mode = 1
value = 1
note = "The safehouse files went into the map office whole."

[sub_resource type="Resource" id="Event_the_files_are_read"]
script = ExtResource("6")
id = &"the_files_are_read"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_evidence")])
once = true
lines = Array[Resource]([])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("3")
text = "The safehouse burned its files before Thorne's column got the gate open, and the network stayed a rumour."

[resource]
script = ExtResource("1")
id = &"qw06_the_forward_safehouse"
title = "The Forward Safehouse"
location = "An unmarked garrison, Meridian frontier"
map_path = "res://maps/campaign/the_quiet_war/qw06_the_forward_safehouse.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ivar_thorne",
2: &"cass_orlov"
}
fog_enabled = true
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_take_the_safehouse")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_handler")])
events = Array[Resource]([SubResource("Event_the_handler_runs"), SubResource("Event_the_handler_taken"), SubResource("Event_the_files_are_read")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat")])
