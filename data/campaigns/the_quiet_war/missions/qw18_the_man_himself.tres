objectives = Array[Resource]([SubResource("Objective_take_orlovs_hq")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_regulars_stand_down"), SubResource("Event_the_wall_is_held")])
par_day = 9
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_3b"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_5b"), SubResource("Line_6"), SubResource("Line_6b"), SubResource("Line_6c"), SubResource("Line_7"), SubResource("Line_7b"), SubResource("Line_8")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_draeg"), SubResource("Line_defeat_staff")])
