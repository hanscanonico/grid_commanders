[gd_resource type="Resource" script_class="MissionDefinition" load_steps=44 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_take_orlovs_hq"]
script = ExtResource("2")
text = "Capture Orlov's headquarters."
cell = Vector2i(19, 11)

[sub_resource type="Resource" id="Draeg_unbloodied"]
script = ExtResource("5")
flag = &"qw_draeg_bloodied"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Draeg_bloodied"]
script = ExtResource("5")
flag = &"qw_draeg_bloodied"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Every_town_saved"]
script = ExtResource("5")
flag = &"qw_towns_saved"
at_least = 10
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Every flipped town, every ledger, every raid pointed here. Orlov never crossed a border in the open until there was nothing left to take quietly, Ash."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "I finish it the way it should have started. An army, in daylight, against a headquarters that thought nobody would ever find it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Found, Ash. Not finished. I've enjoyed watching you learn to read my handwriting."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Marshal Draeg's division holds the eastern wall for me. He at least understands an order."
requires = SubResource("Draeg_bloodied")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "Enjoy it while it lasts. It ends today."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "A wall taken isn't a man caught. Remember that the next time you think a war's over."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The headquarters falls, and every quiet land grab this war ran on is neither quiet nor a land grab any more."

[sub_resource type="Resource" id="Line_6b"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Ten of the towns in his ledger never became Iron ground. He took them on paper, and the paper never reached the map."
requires = SubResource("Every_town_saved")

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "No Orlov among the papers. We took the wall and he was already somewhere else."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("7")
day = 2

[sub_resource type="Resource" id="Trigger_draeg_stands_aside"]
script = ExtResource("8")
condition = SubResource("Draeg_unbloodied")

[sub_resource type="Resource" id="Effect_regulars_stand_down"]
script = ExtResource("9")
tags = Array[StringName]([&"iron_regular_a", &"iron_regular_b"])

[sub_resource type="Resource" id="Event_line_stand_down"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "My division wasn't raised to garrison a man's paperwork. We're standing down. What happens on that hill is his business."

[sub_resource type="Resource" id="Event_the_regulars_stand_down"]
script = ExtResource("6")
id = &"the_regulars_stand_down"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_draeg_stands_aside")])
effects = Array[Resource]([SubResource("Effect_regulars_stand_down")])
once = true
lines = Array[Resource]([SubResource("Event_line_stand_down")])

[sub_resource type="Resource" id="Trigger_draeg_bloodied"]
script = ExtResource("8")
condition = SubResource("Draeg_bloodied")

[sub_resource type="Resource" id="Effect_the_wall_is_his"]
script = ExtResource("10")
flag = &"qw_draeg_wall"
value = 1
note = "Draeg's own regulars held Orlov's eastern wall to the end, because the march had made the war theirs."

[sub_resource type="Resource" id="Event_line_the_wall"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "You broke my spearhead on the march, Ash, so you have the rest of me. My regulars hold that wall. Come and take it."

[sub_resource type="Resource" id="Event_the_wall_is_held"]
script = ExtResource("6")
id = &"the_wall_is_held"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_draeg_bloodied")])
effects = Array[Resource]([SubResource("Effect_the_wall_is_his")])
once = true
lines = Array[Resource]([SubResource("Event_line_the_wall")])

[sub_resource type="Resource" id="Run_at_par"]
script = ExtResource("5")
flag = &"run:par"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_full_stars"]
script = ExtResource("5")
flag = &"run:full"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_three_losses_or_fewer"]
script = ExtResource("5")
flag = &"run:losses"
at_least = 0
at_most = 3

[sub_resource type="Resource" id="Run_new_best"]
script = ExtResource("5")
flag = &"run:best"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_first_clear"]
script = ExtResource("5")
flag = &"run:first"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "You found the wall and the wall held. The war I never declared stays undeclared, which is how I always meant to leave it."

[sub_resource type="Resource" id="Line_defeat_draeg"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "My regulars held the wall. I told you they would."
requires = SubResource("Draeg_bloodied")

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The headquarters stands. Every quiet land grab in the file stays quiet. Orlov's somewhere my screen can't see."

[sub_resource type="Resource" id="Line_5b"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Nine days. You read faster than I write."
requires = SubResource("Run_at_par")

[sub_resource type="Resource" id="Line_6c"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Nine days. No losses to speak of, and the file closes on schedule. Orlov never managed that."
requires = SubResource("Run_full_stars")

[sub_resource type="Resource" id="Line_7b"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "Three names in the file for the man himself. I'd have paid more."
requires = SubResource("Run_three_losses_or_fewer")

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The file already had a closing page. You just wrote a better one over it."
requires = SubResource("Run_new_best")
unless = SubResource("Run_first_clear")

[resource]
script = ExtResource("1")
id = &"qw18_the_man_himself"
title = "The Man Himself"
location = "Orlov's headquarters, the border he dissolved"
map_path = "res://maps/campaign/the_quiet_war/qw18_the_man_himself.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
