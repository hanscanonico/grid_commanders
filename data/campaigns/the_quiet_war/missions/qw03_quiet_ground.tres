[gd_resource type="Resource" script_class="MissionDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]

[sub_resource type="Resource" id="Objective_hold_three_towns"]
script = ExtResource("2")
text = "Hold all three border towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Objective_sit_on_the_southern_town"]
script = ExtResource("4")
text = "Sit on the southern town for two days once the permit lands."
cell = Vector2i(9, 5)
days = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Three border towns have filed for Iron rail permits nobody in Meridian approved. That is Vale's paperwork, Rowan. He takes ground without firing."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "I won't fight for the towns, then. I'll sit on all three before the ink dries."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Three towns, one column, and a clock running on the permits, so you'll be splitting your force whether you like it or not."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "I trust the ground more than his paperwork. Splitting it is."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "All three towns fly Meridian colours before the ink would've dried, and Vale's rail office has nothing left to file."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "He'll try this again before the season's out. I'd bet the wood on it."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Effect_permit_filed"]
script = ExtResource("8")
team = 2
cells = Array[Vector2i]([Vector2i(9, 5)])

[sub_resource type="Resource" id="Event_line_permit"]
script = ExtResource("3")
speaker = &"konrad_vale"
text = "The southern town's permit cleared this morning. Nothing was taken, Commander. It was filed."

[sub_resource type="Resource" id="Event_the_permit_clears"]
script = ExtResource("6")
id = &"the_permit_clears"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_permit_filed")])
once = true
lines = Array[Resource]([SubResource("Event_line_permit")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("7")
day = 1

[sub_resource type="Resource" id="Effect_towns_saved"]
script = ExtResource("9")
flag = &"qw_towns_saved"
mode = 1
value = 3
note = "Three border towns stayed Meridian's, on the ground rather than on paper."

[sub_resource type="Resource" id="Event_the_towns_stand"]
script = ExtResource("6")
id = &"the_towns_stand"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_towns_saved")])
once = true
lines = Array[Resource]([])

[resource]
script = ExtResource("1")
id = &"qw03_quiet_ground"
title = "Quiet Ground"
location = "The border towns, Meridian frontier"
map_path = "res://maps/campaign/the_quiet_war/qw03_quiet_ground.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"nia_rowan",
2: &"konrad_vale"
}
fog_enabled = true
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_hold_three_towns"), SubResource("Objective_sit_on_the_southern_town")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_permit_clears"), SubResource("Event_the_towns_stand")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "One town too many went through on paper, and the frontier is less Meridian's than the map says."
