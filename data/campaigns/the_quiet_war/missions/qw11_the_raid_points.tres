[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_hold_three_towns"]
script = ExtResource("2")
text = "Hold all three raid towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "Three small towns have traded hands all month between Ferrow's raiders and whoever held them last week. Nobody's held all three at once."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I'm done trading, Rowan. Hold all three, and end the argument for good."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "The last four garrisons couldn't hold the ground long enough for it to matter. What's different this time?"

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "This time I'm not leaving until it does."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "All three towns fly the same colours for the first time this month. His raiders have nowhere left to trade for."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I did what the last four garrisons couldn't. Held the ground long enough for it to matter."

[resource]
script = ExtResource("1")
id = &"qw11_the_raid_points"
title = "The Raid Points"
location = "Three small towns, Aurora border woods"
map_path = "res://maps/campaign/the_quiet_war/qw11_the_raid_points.txt"
