[ext_resource type="Resource" path="res://data/units/recon.tres" id="13"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="14"]

[sub_resource type="Resource" id="Unlock_columns_broken"]
script = ExtResource("6")
flag = &"qw_columns_broken"
at_least = 2
at_most = -1

[sub_resource type="Resource" id="Objective_hold_three_towns"]
script = ExtResource("2")
text = "Hold all three raid towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Objective_hold_the_middle_town"]
script = ExtResource("4")
text = "Hold the middle town for three days — long enough for it to matter."
cell = Vector2i(9, 2)
days = 3

[sub_resource type="Resource" id="Failure_day_10"]
script = ExtResource("5")
text = "The towns were still trading hands past day 10."
last_day = 10

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "Three small towns have traded hands all month between Ferrow's raiders and whoever held them last week. Nobody's held all three at once."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I'm done trading, Rowan. Hold all three, and end the argument for good."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "The last four garrisons couldn't hold the ground long enough for it to matter. What's different this time?"

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "This time I'm not leaving until it does."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "All three towns fly the same colours for the first time this month. His raiders have nowhere left to trade for."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I did what the last four garrisons couldn't. Held the ground long enough for it to matter."

[sub_resource type="Resource" id="Trigger_middle_town_ours"]
script = ExtResource("8")
cell = Vector2i(9, 2)
holder = 0

[sub_resource type="Resource" id="Spawn_raider_north"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(10, 1)

[sub_resource type="Resource" id="Spawn_raider_rider"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(11, 3)

[sub_resource type="Resource" id="Effect_ferrow_returns"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_raider_north"), SubResource("Spawn_raider_rider")])

[sub_resource type="Resource" id="Event_line_fifth_time"]
script = ExtResource("3")
speaker = &"dane_ferrow"
text = "That town's traded four times this month, Reed. Nobody's ever paid me to let the fifth one stand."

[sub_resource type="Resource" id="Event_ferrow_comes_back"]
script = ExtResource("7")
id = &"ferrow_comes_back"
triggers = Array[Resource]([SubResource("Trigger_middle_town_ours")])
effects = Array[Resource]([SubResource("Effect_ferrow_returns")])
once = true
lines = Array[Resource]([SubResource("Event_line_fifth_time")])

[sub_resource type="Resource" id="Trigger_opening"]
script = ExtResource("9")
day = 1

[sub_resource type="Resource" id="Effect_towns_saved"]
script = ExtResource("14")
flag = &"qw_towns_saved"
mode = 1
value = 3

[sub_resource type="Resource" id="Event_the_trading_stops"]
script = ExtResource("7")
id = &"the_trading_stops"
triggers = Array[Resource]([SubResource("Trigger_opening")])
effects = Array[Resource]([SubResource("Effect_towns_saved")])
once = true
lines = Array[Resource]([])

[resource]
script = ExtResource("1")
id = &"qw11_the_raid_points"
title = "The Raid Points"
location = "Three small towns, Aurora border woods"
map_path = "res://maps/campaign/the_quiet_war/qw11_the_raid_points.txt"
unlock_requires = SubResource("Unlock_columns_broken")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"tomas_reed",
2: &"dane_ferrow"
}
fog_enabled = true
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_three_towns"), SubResource("Objective_hold_the_middle_town")])
failures = Array[Resource]([SubResource("Failure_day_10")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_ferrow_comes_back"), SubResource("Event_the_trading_stops")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "One town changed hands again before the other two were secure, and the argument goes on."
