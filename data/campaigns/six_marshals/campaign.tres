[resource]
script = ExtResource("1")
id = &"six_marshals"
title = "The Six Marshals"
premise = "The Dominion's autocrat is dead, and the succession goes to whichever marshal delivers the greatest conquest. Six private wars cross the border at once — and each is fought in its marshal's own style."
antagonist = "The Iron Dominion"
missions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19")])
block_titles = Array[String](["Ferrow — the plunderer", "Vale — the industrialist", "Orlov — the hunter", "Vance — the attritionist", "Draeg — the spearhead", "Morn — the terror"])
block_lengths = Array[int]([3, 3, 3, 3, 3, 3])
