[sub_resource type="Resource" id="Objective_take_the_forward_depot_before_vance_"]
script = ExtResource("2")
text = "Take the forward depot before Vance digs in."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Failure_the_depot_stayed_contested_past_day_"]
script = ExtResource("3")
text = "The depot stayed contested past day 6."
last_day = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Vance is the fifth marshal, and the hardest kind — every fight she's in, she's a little stronger than the chart says."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Three percent here, three there. It costs you nothing to notice and everything to ignore."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Then we don't give her the turns to compound it. Fast and clean, before she finds her rhythm."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Take the depot before she digs in — there's no version of this that gets easier tomorrow."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Fast and clean. The depot fell before Vance's army ever found its footing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Every day we don't give her is a day her edge doesn't get to spend."

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("6")
day = 5

[sub_resource type="Resource" id="Effect_compounded_funds"]
script = ExtResource("7")
team = 2
amount = 3000

[sub_resource type="Resource" id="Spawn_dug_in_armour"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(11, 2)

[sub_resource type="Resource" id="Effect_dug_in_armour"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_dug_in_armour")])

[sub_resource type="Resource" id="Effect_vance_dug_in"]
script = ExtResource("10")
flag = &"vance_dug_in"
mode = 0
value = 1
note = "Vance was given five days at the depot, and reported the cost of them as an investment."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Day five. Three percent, five times over. You are already fighting a different army, Commander."

[sub_resource type="Resource" id="Event_three_percent_five_times"]
script = ExtResource("5")
id = &"three_percent_five_times"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_compounded_funds"), SubResource("Effect_dug_in_armour"), SubResource("Effect_vance_dug_in")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"sm10_first_blood"
title = "First Blood"
location = "The forward depot, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm10_first_blood.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"iris_colt",
	2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_forward_depot_before_vance_")])
failures = Array[Resource]([SubResource("Failure_the_depot_stayed_contested_past_day_")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_three_percent_five_times")])
par_day = 4
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The fight dragged on, and every extra day was a day that belonged to her."
