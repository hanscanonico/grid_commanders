[sub_resource type="Resource" id="Objective_take_the_forward_depot_before_vance_"]
script = ExtResource("2")
text = "Capture the forward depot before Vance digs in."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Vance is the fourth marshal. In every fight she's a little stronger than the chart says."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Three percent here, three there. It costs you nothing to notice and everything to ignore."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Then she doesn't get the turns. Go now."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Take the depot before she digs in, and take it in one push instead of three tidy waves."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Fast and clean. The depot fell before her army found its footing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Every day we don't give her is a day her edge doesn't get to spend."

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("6")
day = 5

[sub_resource type="Resource" id="Effect_compounded_funds"]
script = ExtResource("7")
team = 2
amount = 3000

[sub_resource type="Resource" id="Spawn_dug_in_armour"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(11, 2)

[sub_resource type="Resource" id="Effect_dug_in_armour"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_dug_in_armour")])

[sub_resource type="Resource" id="Effect_vance_dug_in"]
script = ExtResource("10")
flag = &"vance_dug_in"
mode = 0
value = 1
note = "Vance was given five days at the depot, and reported the cost of them as an investment."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Day five. Three percent, five times over. You're fighting a different army than the one you counted."

[sub_resource type="Resource" id="Event_three_percent_five_times"]
script = ExtResource("5")
id = &"three_percent_five_times"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_compounded_funds"), SubResource("Effect_dug_in_armour"), SubResource("Effect_vance_dug_in")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Orlov_has_a_trophy"]
script = ExtResource("12")
flag = &"orlov_trophy"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_orlov_trophy"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "Vance. I have one of theirs. It says the recon breaks first."
requires = SubResource("Orlov_has_a_trophy")

[sub_resource type="Resource" id="Line_orlov_no_trophy"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "Vance. Three weeks and nothing of theirs limped. Make them slow instead."
unless = SubResource("Orlov_has_a_trophy")

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "You took your time at the depot. Three percent a day. I'd have waited for every one of them."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Colt said go now. We went in three tidy waves instead. By the third one she'd already added us up."

[resource]
script = ExtResource("1")
id = &"sm10_first_blood"
title = "First Blood"
location = "The forward depot, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm10_first_blood.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"iris_colt",
	2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_forward_depot_before_vance_")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_three_percent_five_times")])
par_day = 4
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_orlov_trophy"), SubResource("Line_orlov_no_trophy"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
