[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]

[sub_resource type="Resource" id="Objective_hold_four_of_the_six_scattered_towns"]
script = ExtResource("2")
text = "Hold four of the six scattered towns."
count = 4

[sub_resource type="Resource" id="Failure_the_towns_stayed_split_past_day_11"]
script = ExtResource("3")
text = "The towns stayed split past day 11."
last_day = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This board won't let you mass an army even if you wanted to — every prize is in a different corner."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "Good. Nobody bunches up on my watch anyway — not with Morn on the other side of the map."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Take four towns. Keep the columns apart the way the ground already wants them."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "Four towns, ours, spread across the board and never once bunched for Morn to punish."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "He waited the whole match for a target that never stood still enough."

[resource]
script = ExtResource("1")
id = &"sm17_scattered_ground"
title = "Scattered Ground"
location = "The far corners, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm17_scattered_ground.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"tomas_reed",
	2: &"radek_morn"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_four_of_the_six_scattered_towns")])
failures = Array[Resource]([SubResource("Failure_the_towns_stayed_split_past_day_11")])
bonus_objectives = Array[Resource]([])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Two columns met at the crossroads to consolidate, and that was the last thing they did together."
