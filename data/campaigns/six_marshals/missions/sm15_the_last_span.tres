[gd_resource type="Resource" script_class="MissionDefinition" load_steps=32 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="12"]
[ext_resource type="Resource" path="res://data/units/rockets.tres" id="13"]

[sub_resource type="Resource" id="Objective_hold_the_west_bank_until_day_7"]
script = ExtResource("2")
text = "Hold the west bank until day 7."
day = 7

[sub_resource type="Resource" id="Failure_the_span_fell_before_day_7"]
script = ExtResource("3")
text = "Day 11 came and the span went down with the west bank still contested."
last_day = 11

[sub_resource type="Resource" id="Bonus_break_the_van"]
script = ExtResource("5")
text = "Kill the tank at the head of the queue for the bridge."
tag = &"draeg_van"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "His tanks hit hard, but they have to queue at the bridge to do it. Dig in. Charge them for the crossing."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "So we don't wait for them to settle in; we hit the head of that queue the moment it forms."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Seven days. Relief is coming. The span only has to still be ours when it gets here."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Day seven. The span held, and Draeg's column is still stacked up on the far bank."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Fifteen percent means nothing to a tank that never crosses."

[sub_resource type="Resource" id="Trigger_van_gone"]
script = ExtResource("8")
tag = &"draeg_van"

[sub_resource type="Resource" id="Spawn_next_in_line"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Effect_next_in_line"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_next_in_line")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "The head of a queue is replaceable, Commander. The queue is not."

[sub_resource type="Resource" id="Event_the_queue_re_forms"]
script = ExtResource("7")
id = &"the_queue_re_forms"
triggers = Array[Resource]([SubResource("Trigger_van_gone")])
effects = Array[Resource]([SubResource("Effect_next_in_line")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("9")
day = 6

[sub_resource type="Resource" id="Spawn_relief_rockets"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(1, 7)

[sub_resource type="Resource" id="Spawn_relief_armour"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(2, 7)

[sub_resource type="Resource" id="Effect_relief"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_relief_rockets"), SubResource("Spawn_relief_armour")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Relief on the west road, and they aren't stopping to ask."

[sub_resource type="Resource" id="Event_relief_on_the_west_road"]
script = ExtResource("7")
id = &"relief_on_the_west_road"
triggers = Array[Resource]([SubResource("Trigger_day_6")])
effects = Array[Resource]([SubResource("Effect_relief")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"sm15_the_last_span"
title = "The Last Span"
location = "The one bridge, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm15_the_last_span.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"sera_lark",
	2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_the_west_bank_until_day_7")])
failures = Array[Resource]([SubResource("Failure_the_span_fell_before_day_7")])
bonus_objectives = Array[Resource]([SubResource("Bonus_break_the_van")])
events = Array[Resource]([SubResource("Event_the_queue_re_forms"), SubResource("Event_relief_on_the_west_road")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The bank gave ground once, and once was all the bridge needed to fall."
