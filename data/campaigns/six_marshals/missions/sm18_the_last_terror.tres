[sub_resource type="Resource" id="Event_line_ferrow"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "I sold him what I took off you, Commander. Do not imagine I gave him a discount."

[sub_resource type="Resource" id="Event_ferrow_sold_it_on"]
