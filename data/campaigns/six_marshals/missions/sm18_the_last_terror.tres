[sub_resource type="Resource" id="Objective_hold_the_heartland_line_until_day_9"]
script = ExtResource("2")
text = "Hold the heartland line until day 9."
day = 9

[sub_resource type="Resource" id="Failure_nothing_worth_the_charge"]
script = ExtResource("6")
text = "Morn's one great strike found something worth the charge — more than nine of ours lost, to any cause."
max_losses = 9

[sub_resource type="Resource" id="Bonus_take_the_northern_town_for_a_bonus"]
script = ExtResource("4")
text = "Take the western town behind the line as well."
cell = Vector2i(6, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Five marshals have already lost their war. Morn thinks fear wins the sixth."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Fear doesn't need to win, Commander. It only needs you to hesitate once."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Then we do not. Two passes through the mountain, two squares wide each, with eight squares of rock between them. Hold each one and keep everything behind it spread out."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Win here and the succession — and the border — is decided."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The heartland held. Morn is finished, and so is the fight over who leads the Dominion."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Six marshals crossed the border. Six marshals were answered."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("8")
day = 6

[sub_resource type="Resource" id="Effect_charge_the_hammer"]
script = ExtResource("11")
team = 2
points = 8000

[sub_resource type="Resource" id="Event_line_charge"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "The charge is ready, Commander, and this time there is nowhere behind you to spread into."

[sub_resource type="Resource" id="Event_the_charge_is_ready"]
script = ExtResource("7")
id = &"the_charge_is_ready"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_charge_the_hammer")])
once = true
lines = Array[Resource]([SubResource("Event_line_charge")])

[sub_resource type="Resource" id="Effect_recall_the_reserve"]
script = ExtResource("15")
tags = Array[StringName]([&"morn_reserve"])

[sub_resource type="Resource" id="Event_line_recall_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "…The Directorate has recalled my reserve. They have decided the succession without me."

[sub_resource type="Resource" id="Event_line_recall_2"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Then hold the line one more day, and let him find out what that feels like."

[sub_resource type="Resource" id="Event_the_directorate_recalls_him"]
script = ExtResource("7")
id = &"the_directorate_recalls_him"
triggers = Array[Resource]([SubResource("Trigger_day_6")])
effects = Array[Resource]([SubResource("Effect_recall_the_reserve")])
once = true
lines = Array[Resource]([SubResource("Event_line_recall_1"), SubResource("Event_line_recall_2")])

