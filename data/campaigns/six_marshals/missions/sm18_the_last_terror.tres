[sub_resource type="Resource" id="Objective_hold_the_heartland_line_until_day_9"]
script = ExtResource("2")
text = "Hold the heartland line until day 9."
day = 9

[sub_resource type="Resource" id="Failure_the_line_broke_before_day_9"]
script = ExtResource("3")
text = "The line broke before day 9."
last_day = 9

[sub_resource type="Resource" id="Bonus_take_the_northern_town_for_a_bonus"]
script = ExtResource("4")
text = "Take the northern town for a bonus."
cell = Vector2i(6, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Five marshals have already lost their war. Morn thinks fear wins the sixth."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Fear doesn't need to win, Commander. It only needs you to hesitate once."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Then we don't. Spread the line, hold the passes, and let his one great strike find nothing worth the charge."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Win here and the succession — and the border — is decided."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The heartland held. Morn's terror campaign, and with it the Dominion's succession fight, is finished."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Six marshals crossed the border. Six marshals were answered."

[resource]
script = ExtResource("1")
