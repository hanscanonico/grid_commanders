[resource]
script = ExtResource("1")
id = &"sm18_the_last_terror"
title = "The Last Terror"
location = "The contested heartland, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm18_the_last_terror.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"alina_ward",
	2: &"radek_morn"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_the_heartland_line_until_day_9")])
failures = Array[Resource]([SubResource("Failure_nothing_worth_the_charge")])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_northern_town_for_a_bonus")])
events = Array[Resource]([SubResource("Event_ferrow_sold_it_on"), SubResource("Event_the_crossroads_outlives_him"), SubResource("Event_orlov_keeps_what_he_catches"), SubResource("Event_vance_still_compounding"), SubResource("Event_draegs_column_keeps_its_word"), SubResource("Event_morn_never_spent_it"), SubResource("Event_the_charge_is_ready"), SubResource("Event_the_directorate_recalls_him")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The line bunched under pressure, and Morn's last strike ended the war on his terms."
