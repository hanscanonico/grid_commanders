[gd_resource type="Resource" script_class="MissionDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]

[sub_resource type="Resource" id="Objective_take_the_relay_before_morn_s_hammerf"]
script = ExtResource("2")
text = "Take the relay before Morn's Hammerfall comes online."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Failure_the_relay_stayed_in_morn_s_hands_pas"]
script = ExtResource("3")
text = "The relay stayed in Morn's hands past day 9."
last_day = 9

[sub_resource type="Resource" id="Failure_keep_it_loose"]
script = ExtResource("5")
text = "Hammerfall takes whatever stands together. Lose no more than eight units, to any cause."
max_losses = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The last marshal. Radek Morn doesn't fight for ground, Gideon — he fights to erase it. Hammerfall flattens a three-by-three block, whole."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "Ground remembers nothing, Commander. Neither will yours."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then we don't give him a block to erase. Spread the advance — there's no target worth the charge."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The relay stands alone at the top of nineteen squares of open field — no cover near it, no second prize beside it. Whoever walks at it walks in the open, so walk at it in ones."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The relay's ours, and Morn never found three units close enough together to be worth the charge."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Erase nothing, spend nothing. That's how you beat him."

[sub_resource type="Resource" id="Trigger_day_7"]
script = ExtResource("7")
day = 7

[sub_resource type="Resource" id="Effect_charge_the_hammer"]
script = ExtResource("8")
team = 2
points = 8000

[sub_resource type="Resource" id="Effect_morn_charged"]
script = ExtResource("9")
flag = &"morn_charged"
mode = 0
value = 1
note = "Morn charged Hammerfall on the wide field and never had to spend it."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "The charge is ready, Commander. I am only waiting for three of you to stand together."

[sub_resource type="Resource" id="Event_the_charge_is_ready"]
script = ExtResource("6")
id = &"the_charge_is_ready"
triggers = Array[Resource]([SubResource("Trigger_day_7")])
effects = Array[Resource]([SubResource("Effect_charge_the_hammer"), SubResource("Effect_morn_charged")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"sm16_the_wide_field"
title = "The Wide Field"
location = "The open plain, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm16_the_wide_field.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"gideon_holt",
	2: &"radek_morn"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_relay_before_morn_s_hammerf")])
failures = Array[Resource]([SubResource("Failure_the_relay_stayed_in_morn_s_hands_pas"), SubResource("Failure_keep_it_loose")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_charge_is_ready")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The advance bunched at the relay, and Hammerfall found exactly the target it wanted."
