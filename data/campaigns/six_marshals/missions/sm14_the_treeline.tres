[sub_resource type="Resource" id="Objective_hold_three_of_the_four_towns"]
script = ExtResource("2")
text = "Hold three of the four towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Failure_the_towns_stayed_split_past_day_10"]
script = ExtResource("3")
text = "The towns stayed split past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_break_the_lead"]
script = ExtResource("5")
text = "Kill the tank leading Draeg's line into the woods."
tag = &"draeg_lead"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This ground's too broken for his tanks to mass. Meet a lone tank with artillery, not with a tank of your own."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Broken ground. Good ground."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three of four towns wins the treeline."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Three towns. Draeg's bonus never found a lane."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Fifteen percent harder means nothing at zero range in the open he never got."

[sub_resource type="Resource" id="Trigger_lead_gone"]
script = ExtResource("7")
tag = &"draeg_lead"

[sub_resource type="Resource" id="Spawn_next_hull"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(15, 8)

[sub_resource type="Resource" id="Effect_next_hull"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_next_hull")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "One hull in your woods. I have more hulls than you have woods, Commander."

[sub_resource type="Resource" id="Event_no_lane"]
script = ExtResource("6")
id = &"no_lane"
triggers = Array[Resource]([SubResource("Trigger_lead_gone")])
effects = Array[Resource]([SubResource("Effect_next_hull")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Column_through_the_gate"]
script = ExtResource("10")
flag = &"draeg_column_intact"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_column_through_the_gate"]
script = ExtResource("9")
condition = SubResource("Column_through_the_gate")

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Spawn_gate_column"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Effect_gate_column"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_gate_column")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "The column you let through the gate. It is in your treeline now, and it kept its formation the whole way."

[sub_resource type="Resource" id="Event_the_gate_column_arrives"]
script = ExtResource("6")
id = &"the_gate_column_arrives"
triggers = Array[Resource]([SubResource("Trigger_column_through_the_gate"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_gate_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"sm14_the_treeline"
title = "The Treeline"
location = "The broken forest, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm14_the_treeline.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"sable_wren",
	2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_four_towns")])
failures = Array[Resource]([SubResource("Failure_the_towns_stayed_split_past_day_10")])
bonus_objectives = Array[Resource]([SubResource("Bonus_break_the_lead")])
events = Array[Resource]([SubResource("Event_no_lane"), SubResource("Event_the_gate_column_arrives")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The line thinned to chase the last town, and Draeg's column found a lane after all."
