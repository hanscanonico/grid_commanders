[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This ground's too broken for his tanks to mass. Meet a lone tank with artillery, not with a tank of your own."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Broken ground. Good ground."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three of four towns wins the treeline."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Three towns. Draeg's bonus never found a lane."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Fifteen percent harder means nothing at zero range in the open he never got."

