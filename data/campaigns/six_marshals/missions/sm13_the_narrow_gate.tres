[gd_resource type="Resource" script_class="MissionDefinition" load_steps=36 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="13"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="14"]

[sub_resource type="Resource" id="Objective_take_the_depot_before_draeg_s_column"]
script = ExtResource("2")
text = "Capture the depot before Draeg's column breaks through the gate."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Bonus_break_the_spear"]
script = ExtResource("5")
text = "Kill the tank at the head of Draeg's column."
tag = &"draeg_spear"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The fifth marshal is no terror. Viktor Draeg is worse in a simpler way: his tanks hit fifteen percent harder than the chart says, and when his meter fills they walk through a point of your cover as well."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "I field an honest army. It simply outperforms yours."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"mara_voss"
text = "Then he doesn't get his terms. There is one gap in that wall, and every hull he owns has to come through it while we are standing in the middle of it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"mara_voss"
text = "The gate held. Draeg's column never found open ground."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Honest or not, his column spent the whole war parked in that one gap."

[sub_resource type="Resource" id="Trigger_spear_gone"]
script = ExtResource("7")
tag = &"draeg_spear"

[sub_resource type="Resource" id="Effect_the_line_rallies"]
script = ExtResource("9")
team = 1
points = 4000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"mara_voss"
text = "Head of the column is gone. The rest are just tanks now, and the line knows it."

[sub_resource type="Resource" id="Event_the_spear_breaks"]
script = ExtResource("6")
id = &"the_spear_breaks"
triggers = Array[Resource]([SubResource("Trigger_spear_gone")])
effects = Array[Resource]([SubResource("Effect_the_line_rallies")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_7"]
script = ExtResource("8")
day = 7

[sub_resource type="Resource" id="Spawn_through_the_gate"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(13, 6)

[sub_resource type="Resource" id="Effect_through_the_gate"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_through_the_gate")])

[sub_resource type="Resource" id="Effect_draeg_column_intact"]
script = ExtResource("12")
flag = &"draeg_column_intact"
mode = 0
value = 1
note = "Draeg's column came through the narrow gate whole, and it has not stopped since."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "A gate is a gate. My column is through it, and it is still a column."

[sub_resource type="Resource" id="Event_the_column_is_through"]
script = ExtResource("6")
id = &"the_column_is_through"
triggers = Array[Resource]([SubResource("Trigger_day_7")])
effects = Array[Resource]([SubResource("Effect_through_the_gate"), SubResource("Effect_draeg_column_intact")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Vance_dug_in"]
script = ExtResource("14")
flag = &"vance_dug_in"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_vance_dug_in"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Draeg. I had five days at the depot and every one of them paid. Take whatever days they'll give you."
requires = SubResource("Vance_dug_in")

[sub_resource type="Resource" id="Line_vance_hurried"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Draeg. They took the depot before I'd had five days at it. Don't plan on being given time."
unless = SubResource("Vance_dug_in")

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "Six days at the gate, then on the seventh my column came through it in formation, the way an honest army's supposed to."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Voss said the middle of the gap. We stood a bit to one side. That's all a column needs."

[resource]
script = ExtResource("1")
id = &"sm13_the_narrow_gate"
title = "The Narrow Gate"
location = "The armour road, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm13_the_narrow_gate.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"mara_voss",
	2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_depot_before_draeg_s_column")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_break_the_spear")])
events = Array[Resource]([SubResource("Event_the_spear_breaks"), SubResource("Event_the_column_is_through")])
par_day = 6
carry_out = true
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_vance_dug_in"), SubResource("Line_vance_hurried"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
