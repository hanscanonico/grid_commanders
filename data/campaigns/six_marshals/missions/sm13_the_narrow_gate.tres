[sub_resource type="Resource" id="Objective_take_the_depot_before_draeg_s_column"]
script = ExtResource("2")
text = "Take the depot before Draeg's column breaks through the gate."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Failure_the_gate_fell_to_the_column_before_d"]
script = ExtResource("3")
text = "The gate fell to the column before day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The sixth marshal isn't the terror. Viktor Draeg is worse in a simpler way — his tanks hit fifteen percent harder than the chart admits, and shrug off a point of your cover besides."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "I field an honest army, Commander. It simply outperforms yours."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"mara_voss"
text = "Then we don't fight it on his terms. One gap in the wall — own it, and his whole column stalls there."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"mara_voss"
text = "The gate held. Draeg's column never found the open ground it needed."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Honest or not, an army that can't move is an army that loses."

[resource]
