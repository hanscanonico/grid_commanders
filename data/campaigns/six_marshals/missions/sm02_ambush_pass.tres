[gd_resource type="Resource" script_class="MissionDefinition" load_steps=36 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/defeat_team_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="10"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="12"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="13"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="14"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="15"]

[sub_resource type="Resource" id="Objective_hold_the_pass_towns"]
script = ExtResource("2")
text = "Hold three of the four pass towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Failure_the_passes_stayed_open_past_day_10"]
script = ExtResource("3")
text = "The passes stayed open past day 10."
last_day = 10

[sub_resource type="Resource" id="Failure_the_bounty"]
script = ExtResource("11")
text = "Ferrow's bounty outgrew the passes. Lose no more than three units, to any cause."
max_losses = 3

[sub_resource type="Resource" id="Bonus_break_ferrows_column_outright"]
script = ExtResource("5")
text = "Break Ferrow's column outright."
team = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow's second column is probing the passes. He wants a lane through, not a fight — and every kill he lands still pays into his bounty."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then make sure nothing he touches is worth killing. His raiders are thin-skinned — corner one and it comes apart."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Let him commit to one gap, then close on him from the towns either side."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Both gaps are ours. Ferrow's column broke off with nothing to show for the climb."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "No kills, no bounty. That's the only ledger entry that matters today."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_east_lane_1"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(13, 7)

[sub_resource type="Resource" id="Spawn_east_lane_2"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(12, 8)

[sub_resource type="Resource" id="Effect_east_lane"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_east_lane_1"), SubResource("Spawn_east_lane_2")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "East gap. I do like a lane nobody is standing in."

[sub_resource type="Resource" id="Event_he_commits"]
script = ExtResource("6")
id = &"he_commits"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_east_lane")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_down_to_two"]
script = ExtResource("12")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Effect_toll_funds"]
script = ExtResource("15")
team = 2
amount = 3000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "There it is. Wreckage on the climb, and a credit against my name for every piece of it."

[sub_resource type="Resource" id="Event_the_climb_pays"]
script = ExtResource("6")
id = &"the_climb_pays"
triggers = Array[Resource]([SubResource("Trigger_down_to_two")])
effects = Array[Resource]([SubResource("Effect_toll_funds")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Paid_on_the_road"]
script = ExtResource("14")
flag = &"ferrow_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_paid_on_the_road"]
script = ExtResource("13")
condition = SubResource("Paid_on_the_road")

[sub_resource type="Resource" id="Spawn_bought_raider"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(11, 8)

[sub_resource type="Resource" id="Effect_bought_raider"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_raider")])

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "The customs road bought this one outright, Commander. Your column, my third raider. Do keep spending."

[sub_resource type="Resource" id="Event_bought_on_the_border"]
script = ExtResource("6")
id = &"bought_on_the_border"
triggers = Array[Resource]([SubResource("Trigger_paid_on_the_road"), SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_bought_raider")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"sm02_ambush_pass"
title = "Ambush Pass"
location = "The high passes, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm02_ambush_pass.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"gideon_holt",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_pass_towns")])
failures = Array[Resource]([SubResource("Failure_the_passes_stayed_open_past_day_10"), SubResource("Failure_the_bounty")])
bonus_objectives = Array[Resource]([SubResource("Bonus_break_ferrows_column_outright")])
events = Array[Resource]([SubResource("Event_he_commits"), SubResource("Event_the_climb_pays"), SubResource("Event_bought_on_the_border")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The passes changed hands, and Ferrow's ledger got heavier."
