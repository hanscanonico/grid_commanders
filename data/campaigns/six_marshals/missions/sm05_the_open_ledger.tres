[sub_resource type="Resource" id="Objective_hold_five_of_the_market_towns"]
script = ExtResource("2")
text = "Hold five of the market towns."
count = 5

[sub_resource type="Resource" id="Failure_the_market_stayed_split_past_day_11"]
script = ExtResource("3")
text = "The market stayed split past day 11."
last_day = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's army costs more than it should and hits harder for it. Don't fight him fund for fund — outgrow him."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "Six towns on the board, income for the taking. Every one we hold is one his premium can't buy back."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Take the majority before he prices you out of the race."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "Five towns, ours. The market's closed before his premium army arrived to bid."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's ledger shows the expense. It doesn't show the win."

[resource]
script = ExtResource("1")
