[gd_resource type="Resource" script_class="MissionDefinition" load_steps=25 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="11"]

[sub_resource type="Resource" id="Objective_take_the_watchtower_at_the_centre_of"]
script = ExtResource("2")
text = "Take the watchtower at the centre of the ridge."
cell = Vector2i(7, 5)

[sub_resource type="Resource" id="Failure_no_cripples"]
script = ExtResource("5")
text = "Orlov hunted what limped — more than eleven of ours lost, to any cause."
max_losses = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Vale's money is gone. Cass Orlov doesn't build armies. He hunts the wounded in ours."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "Wounded birds sing loudest. I listen."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "Then nothing hurt stays in his sight line. Pull it back the moment it bleeds."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "Take the watchtower and hold it clean. Nothing of ours still bleeding where he can see it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "The watchtower's ours. Orlov's hunters found nothing worth finishing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Keep them whole, and there's nothing left for him to hunt."

[sub_resource type="Resource" id="Trigger_first_blood"]
script = ExtResource("7")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Spawn_hunter"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(11, 5)

[sub_resource type="Resource" id="Effect_hunter"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_hunter")])

[sub_resource type="Resource" id="Effect_orlov_trophy"]
script = ExtResource("10")
flag = &"orlov_trophy"
mode = 0
value = 1
note = "Orlov took a trophy off the ridge, and the other marshals have started asking him where the weak ones are."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "There. The limp. I'll be along shortly, Commander. Someone of mine is already ahead of me, keeping it company."

[sub_resource type="Resource" id="Event_the_limp"]
script = ExtResource("6")
id = &"the_limp"
triggers = Array[Resource]([SubResource("Trigger_first_blood")])
effects = Array[Resource]([SubResource("Effect_hunter"), SubResource("Effect_orlov_trophy")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"sm07_the_watchtower"
title = "The Watchtower"
location = "The mirrored ridge, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm07_the_watchtower.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"halden_marr",
	2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_watchtower_at_the_centre_of")])
failures = Array[Resource]([SubResource("Failure_no_cripples")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_limp")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "One wounded unit stood its ground too long, and Orlov made an example of it."
