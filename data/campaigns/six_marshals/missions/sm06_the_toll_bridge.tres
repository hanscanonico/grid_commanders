[gd_resource type="Resource" script_class="MissionDefinition" load_steps=34 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="11"]

[sub_resource type="Resource" id="Objective_hold_the_west_bank_until_day_8"]
script = ExtResource("2")
text = "Hold the west bank until day 8."
day = 8

[sub_resource type="Resource" id="Failure_the_bridges_fell_before_day_8"]
script = ExtResource("3")
text = "Day 12 came and the bridges went down with the west bank still contested."
last_day = 12

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's whole column has to cross two bridges to reach us. Let his expensive units queue up for the privilege of arriving one at a time."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Two lanes, one result. Anything that comes through them is a bad trade for him. Reliably."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Two crossings, one square apart in the same gap. He can't widen it. Everything he owns arrives in single file."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Day eight. The odds were with us the whole way, and the bridges are full of wrecks that cost him a fortune each."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale finally found a fight money couldn't win."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Effect_buys_the_far_town"]
script = ExtResource("9")
team = 2
cells = Array[Vector2i]([Vector2i(11, 10)])

[sub_resource type="Resource" id="Effect_war_chest"]
script = ExtResource("10")
team = 2
amount = 4000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "The far town is mine as of this morning. I did not have to cross the river for it. I only had to outbid you."

[sub_resource type="Resource" id="Event_the_far_bank_is_bought"]
script = ExtResource("6")
id = &"the_far_bank_is_bought"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_buys_the_far_town"), SubResource("Effect_war_chest")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_his_column_thins"]
script = ExtResource("8")
team = 2
bound = 0
count = 3

[sub_resource type="Resource" id="Effect_salvage"]
script = ExtResource("10")
team = 1
amount = 4000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Expensive hulls in the river, and the scrap is ours. He will feel that one. Reliably."

[sub_resource type="Resource" id="Event_the_river_bill"]
script = ExtResource("6")
id = &"the_river_bill"
triggers = Array[Resource]([SubResource("Trigger_his_column_thins")])
effects = Array[Resource]([SubResource("Effect_salvage")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("11")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Run_par"]
script = ExtResource("11")
flag = &"run:par"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_vale_par"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Eight days. You never even let the interest accrue."
requires = SubResource("Run_par")

[sub_resource type="Resource" id="Line_orlov_next"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "Expensive hulls in a river, Vale. I'd have waited for the crews to crawl out."

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Two bridges, one column, the west bank mine before the interest is due. Expensive, yes. Worth it."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Day twelve saw the bridges go down with the bank still contested, which is the one ending this fight didn't need."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "His column came across one hull at a time just like we planned, only we didn't have enough to charge every one of them."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"sm06_the_toll_bridge"
title = "The Toll Bridge"
location = "The river crossing, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm06_the_toll_bridge.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"lyra_quill",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_west_bank_until_day_8")])
failures = Array[Resource]([SubResource("Failure_the_bridges_fell_before_day_8")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_far_bank_is_bought"), SubResource("Event_the_river_bill")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_vale_par"), SubResource("Line_orlov_next")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3")])
