[sub_resource type="Resource" id="Objective_hold_the_west_bank_until_day_8"]
script = ExtResource("2")
text = "Hold the west bank until day 8."
day = 8

[sub_resource type="Resource" id="Failure_the_bridges_fell_before_day_8"]
script = ExtResource("3")
text = "The bridges fell before day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's whole column has to cross two bridges to reach us. Let his expensive units queue for the privilege."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Two lanes, one outcome — every attack that funnels through them is a bad trade for him, reliably."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Hold the bank. Every attack he makes here he pays double for."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "Day eight. The odds favored us the whole way, and the bridges are choked with wrecks that cost him a fortune apiece."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale finally found a fight his ledger couldn't win."

[resource]
script = ExtResource("1")
