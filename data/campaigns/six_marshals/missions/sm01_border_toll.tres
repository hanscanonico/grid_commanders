[gd_resource type="Resource" script_class="MissionDefinition" load_steps=28 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="10"]

[sub_resource type="Resource" id="Objective_take_road_city"]
script = ExtResource("2")
text = "Capture the customs city north of the road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Failure_the_toll"]
script = ExtResource("5")
text = "Ferrow was paid three times over — more than two of ours lost, to any cause."
max_losses = 2

[sub_resource type="Resource" id="Bonus_south_city"]
script = ExtResource("2")
text = "Capture the southern city as well."
cell = Vector2i(5, 7)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow crossed at the coal bridge before dawn. He isn't here for ground. He's here for what our wrecks are worth."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then we stop paying. What's he actually after?"

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The customs city. Every column he breaks pays for the next one, and that road is where the money moves."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Take the city. Close the road. Nobody meets him on open ground — he comes to us."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Road's open. His columns pulled back east with less than they came for."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "He crossed for payment and went home with an empty column."

[sub_resource type="Resource" id="Trigger_down_to_two"]
script = ExtResource("7")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Effect_toll_funds"]
script = ExtResource("8")
team = 2
amount = 4000

[sub_resource type="Resource" id="Effect_ferrow_paid"]
script = ExtResource("9")
flag = &"ferrow_paid"
mode = 0
value = 1
note = "Ferrow's raiders went home paid, in wrecks off our own column."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Two wrecks on the customs road. That's the toll. You've paid it."

[sub_resource type="Resource" id="Event_the_toll_is_paid"]
script = ExtResource("6")
id = &"the_toll_is_paid"
triggers = Array[Resource]([SubResource("Trigger_down_to_two")])
effects = Array[Resource]([SubResource("Effect_toll_funds"), SubResource("Effect_ferrow_paid")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("10")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Three wrecks on the customs road means the toll's paid in full, so I'll be back the day the next column's worth the trip."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three down. He's paid three times over now. He never wanted the city, only our wrecks."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "We met him on open ground after all, which is the one thing Ward said we'd never do."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"sm01_border_toll"
title = "Border Toll"
location = "The customs road, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm01_border_toll.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"alina_ward",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_road_city")])
failures = Array[Resource]([SubResource("Failure_the_toll")])
bonus_objectives = Array[Resource]([SubResource("Bonus_south_city")])
events = Array[Resource]([SubResource("Event_the_toll_is_paid")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3")])
