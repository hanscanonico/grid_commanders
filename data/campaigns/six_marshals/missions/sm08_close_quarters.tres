[sub_resource type="Resource" id="Objective_hold_three_of_the_four_hamlets"]
script = ExtResource("2")
text = "Hold three of the four hamlets."
count = 3

[sub_resource type="Resource" id="Failure_the_hamlets_stayed_split_past_day_8"]
script = ExtResource("3")
text = "The hamlets stayed split past day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Close ground, close range — and Orlov's bonus bites hardest on anything under half health."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Then we bleed on our terms, not his. Rotate the wounded out before he ever gets the shot."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three of the four hamlets wins it. Keep the hurt behind the line."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Three hamlets held, and every wound we took, we took on our feet."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Orlov never got the low-health kill he came hunting for."

