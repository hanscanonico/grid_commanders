[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="13"]

; Measured with the scripted beats live: sixteen seeds of the skirmish planner
; playing both sides, against `last_day` 8 and `par_day` 6. The three hamlets are
; held on day 7 in eleven seeds, on day 8 in four, and never in one, so the mission
; is decided fifteen times in sixteen inside its own deadline and the one loss is
; the clock. Par is not reached by the planner; by hand a player who builds on days
; one and two takes (9,2) and (5,1) by day 4 and (2,6) by day 5.
;
; The clock is the whole of the difficulty here, and it is the only failure this
; board carries. A second, escort failure on the recon was measured against the
; same sixteen seeds and cost five of them on days 4-6 — before the capture race it
; sat on top of could possibly finish — which is a mission decided by an errand
; rather than by its own objective.

[sub_resource type="Resource" id="Objective_hold_three_of_the_four_hamlets"]
script = ExtResource("2")
text = "Hold three of the four hamlets."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Close ground, close range — and Orlov's bonus bites hardest on anything under half health."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Then we bleed on our terms, not his. Rotate the wounded out before he ever gets the shot."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four hamlets and four squares of trees, and nothing else on twelve squares of board. Whatever gets hurt goes into the trees — there is no back to send it to."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Three hamlets held, and every wound we took, we took on our feet."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Orlov never got the low-health kill he came hunting for."

[sub_resource type="Resource" id="Trigger_far_hamlet_ours"]
script = ExtResource("7")
cell = Vector2i(6, 7)
holder = 0

[sub_resource type="Resource" id="Spawn_flanker"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(9, 5)

[sub_resource type="Resource" id="Effect_flanker"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_flanker")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "You reached for the far one. Now show me what you left behind you."

[sub_resource type="Resource" id="Event_what_you_left_behind"]
script = ExtResource("6")
id = &"what_you_left_behind"
triggers = Array[Resource]([SubResource("Trigger_far_hamlet_ours")])
effects = Array[Resource]([SubResource("Effect_flanker")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Has_a_trophy"]
script = ExtResource("10")
flag = &"orlov_trophy"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_has_a_trophy"]
script = ExtResource("9")
condition = SubResource("Has_a_trophy")

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Spawn_second_hunter"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Effect_second_hunter"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_second_hunter")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "I still have the one I took off the ridge, Commander. It taught me which of yours limps first."

[sub_resource type="Resource" id="Event_the_trophy_talks"]
script = ExtResource("6")
id = &"the_trophy_talks"
triggers = Array[Resource]([SubResource("Trigger_has_a_trophy"), SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_second_hunter")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"sm08_close_quarters"
title = "Close Quarters"
location = "The border hamlets, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm08_close_quarters.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"ivar_thorne",
	2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_four_hamlets")])
