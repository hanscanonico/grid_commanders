bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_what_you_left_behind"), SubResource("Event_the_trophy_talks")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "A hurt recon lingered one turn too many in the open, and that was the fight."
