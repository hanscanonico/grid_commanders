[gd_resource type="Resource" script_class="MissionDefinition" load_steps=40 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/reach_cell_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/reveal_objective_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="12"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="13"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="14"]

[sub_resource type="Resource" id="Objective_hold_the_near_bank_until_day_4"]
script = ExtResource("2")
text = "Hold the near bank until day 4."
day = 4

[sub_resource type="Resource" id="Objective_the_crossing"]
script = ExtResource("5")
text = "Push two units onto the far bank."
id = &"the_crossing"
hidden = true
cells = Array[Vector2i]([Vector2i(8, 4), Vector2i(9, 4), Vector2i(8, 5), Vector2i(9, 5)])
count = 2

[sub_resource type="Resource" id="Failure_the_crossing_was_never_forced"]
script = ExtResource("3")
text = "The crossing was never forced, and by day 8 it was hers."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This is a short window, not a siege. Hold the bank, mass at the bridge, and go before Vance's edge compounds."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "Four days to form up, then one push across. No loitering on either side of that line."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then the crossing is ours to force."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "The bank held, the bridge is ours, and Vance never got the long fight she wanted."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four days. That's all the window she ever had."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Effect_three_days_of_interest"]
script = ExtResource("11")
team = 2
amount = 5000

[sub_resource type="Resource" id="Spawn_far_bank_armour"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(13, 7)

[sub_resource type="Resource" id="Effect_far_bank_armour"]
script = ExtResource("12")
team = 2
units = Array[Resource]([SubResource("Spawn_far_bank_armour")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Three days, Commander, and I have spent every one of them. Whatever crosses that bridge meets what they bought."

[sub_resource type="Resource" id="Event_she_counts_the_days"]
script = ExtResource("6")
id = &"she_counts_the_days"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_three_days_of_interest"), SubResource("Effect_far_bank_armour")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Effect_open_the_crossing"]
script = ExtResource("10")
objective_id = &"the_crossing"

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "Bank held. Bridges are ours to force — everything across, now."

[sub_resource type="Resource" id="Event_the_push"]
script = ExtResource("6")
id = &"the_push"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_open_the_crossing")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Dug_in_at_the_depot"]
script = ExtResource("9")
flag = &"vance_dug_in"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_dug_in_at_the_depot"]
script = ExtResource("8")
condition = SubResource("Dug_in_at_the_depot")

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("7")
day = 6

[sub_resource type="Resource" id="Spawn_depot_dividend"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(12, 8)

[sub_resource type="Resource" id="Effect_depot_dividend"]
script = ExtResource("12")
team = 2
units = Array[Resource]([SubResource("Spawn_depot_dividend")])

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "The depot is still paying, Commander. It has been paying since the day you let me keep it."

[sub_resource type="Resource" id="Event_the_depot_still_pays"]
script = ExtResource("6")
id = &"the_depot_still_pays"
triggers = Array[Resource]([SubResource("Trigger_dug_in_at_the_depot"), SubResource("Trigger_day_6")])
effects = Array[Resource]([SubResource("Effect_depot_dividend")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"sm12_the_narrow_crossing"
title = "The Narrow Crossing"
location = "The bridgehead, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm12_the_narrow_crossing.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"perrin_ash",
	2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_the_near_bank_until_day_4"), SubResource("Objective_the_crossing")])
failures = Array[Resource]([SubResource("Failure_the_crossing_was_never_forced")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_she_counts_the_days"), SubResource("Event_the_push"), SubResource("Event_the_depot_still_pays")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The bank held too passively, and by the time the strike came, her army had grown into it."
