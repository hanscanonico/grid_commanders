[gd_resource type="Resource" script_class="MissionDefinition" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="11"]

; Ferrow is the one marshal whose flag is written twice. Every other block writes
; its fact in the marshal's first mission and only reads it afterwards; here sm01
; and sm03 both write `ferrow_paid`, and sm02 alone reads it. Deliberate: the fact
; is "his raiders went home paid", and his third mission can charge that bill on a
; war where his first one did not. SET is idempotent, so the second write records
; the bad war rather than doubling it — an ADD here would be a bug.

[sub_resource type="Resource" id="Objective_hold_the_timber_line_until_day_6"]
script = ExtResource("2")
text = "Hold the timber line until day 6."
day = 6

[sub_resource type="Resource" id="Failure_the_count"]
script = ExtResource("6")
text = "Ferrow was paid by the kill — more than three of ours lost, to any cause."
max_losses = 3

[sub_resource type="Resource" id="Bonus_take_the_northern_camp_for_a_bonus"]
script = ExtResource("4")
text = "Capture the northern camp as well."
cell = Vector2i(6, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Ferrow's paid by the kill, not the mile. He'll hit whatever's weakest and pull back before you can answer."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Then nothing stands alone. Every position keeps a neighbour inside one turn's march before we call the timber line held."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "His raiders are quick and thin-skinned. Make them stand and fight and the trade goes our way."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Day six. The timber line held, and we came out ahead."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Ferrow's raiders bled for ground they never got to keep."

[sub_resource type="Resource" id="Trigger_down_to_two"]
script = ExtResource("8")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Effect_bounty_charge"]
script = ExtResource("9")
team = 2
points = 4000

[sub_resource type="Resource" id="Effect_ferrow_paid"]
script = ExtResource("10")
flag = &"ferrow_paid"
mode = 0
value = 1
note = "Ferrow's raiders went home paid, in wrecks off our own column."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "One. One more than you could afford. I'm not done with the timber yet."

[sub_resource type="Resource" id="Event_the_count_pays_out"]
script = ExtResource("7")
id = &"the_count_pays_out"
triggers = Array[Resource]([SubResource("Trigger_down_to_two")])
effects = Array[Resource]([SubResource("Effect_bounty_charge"), SubResource("Effect_ferrow_paid")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("11")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Run_par"]
script = ExtResource("11")
flag = &"run:par"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_ferrow_par"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Six days on the timber line and nobody's paying me by the day, so I'm gone before it costs me fuel."
requires = SubResource("Run_par")

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Four by the timber line is paid in full, so I'll be gone before your relief's even read the receipt."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Four lost before day six. Somewhere a flank stood alone for one turn. That's all he's ever needed."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "He hit the weakest thing we had, pulled back, then did it again until there wasn't a line left to watch."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"sm03_the_long_watch"
title = "The Long Watch"
location = "Timber country, Meridian frontier"
map_path = "res://maps/campaign/six_marshals/sm03_the_long_watch.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"cassian_rook",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_timber_line_until_day_6")])
failures = Array[Resource]([SubResource("Failure_the_count")])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_northern_camp_for_a_bonus")])
events = Array[Resource]([SubResource("Event_the_count_pays_out")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_ferrow_par")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3")])
