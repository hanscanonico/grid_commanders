seats = Array[int]([])
sides = {}
commanders = {
	1: &"rhea_sol",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_crossroads_base_before_vale")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_gate_finishes")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_ferrow_paid"), SubResource("Line_ferrow_unpaid"), SubResource("Line_concord"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
