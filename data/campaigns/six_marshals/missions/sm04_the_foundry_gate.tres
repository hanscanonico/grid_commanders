[sub_resource type="Resource" id="Objective_take_the_crossroads_base_before_vale"]
script = ExtResource("2")
text = "Capture the crossroads base before Vale finishes it."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Five marshals left. The second is Konrad Vale, and everything he fields costs more and hits harder for it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Then we don't let him field it. Crossroads base, nine days to completion. We take it on day six."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Six days. Optimistic, Commander. I have built more than this on worse odds."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Take the factory off him and all that extra money never gets spent."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "The crossroads is ours, four days early. His factory never opened."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "One marshal's war, over before it started."

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("6")
day = 6

[sub_resource type="Resource" id="Trigger_still_nobodys"]
script = ExtResource("7")
cell = Vector2i(7, 4)
holder = 2

[sub_resource type="Resource" id="Effect_vale_takes_the_gate"]
script = ExtResource("8")
team = 2
cells = Array[Vector2i]([Vector2i(7, 4)])

[sub_resource type="Resource" id="Effect_vale_factory"]
script = ExtResource("9")
flag = &"vale_factory"
mode = 0
value = 1
note = "Vale's crossroads factory opened on schedule, and it is still producing."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Day six. The crossroads is finished, and it is mine. Ask your quartermaster what that costs you."

[sub_resource type="Resource" id="Event_the_gate_finishes"]
script = ExtResource("5")
id = &"the_gate_finishes"
triggers = Array[Resource]([SubResource("Trigger_day_6"), SubResource("Trigger_still_nobodys")])
effects = Array[Resource]([SubResource("Effect_vale_takes_the_gate"), SubResource("Effect_vale_factory")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Ferrow_was_paid"]
script = ExtResource("10")
flag = &"ferrow_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_ferrow_paid"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Vale. They paid me on the customs road. I've sold you the list of what they can't afford to lose."
requires = SubResource("Ferrow_was_paid")

[sub_resource type="Resource" id="Line_ferrow_unpaid"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Vale. I came home with an empty column. Don't spend what you haven't taken."
unless = SubResource("Ferrow_was_paid")

[sub_resource type="Resource" id="Line_concord"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Concord's lent us Sol. It shares no border with Iron. It lends arithmetic."

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "The crossroads opened on schedule. It is producing. Everything it builds is paid for with ground you left me."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "We went at the base head-on and paid his prices for it, when what Sol said was take it off him, don't trade for it."

[resource]
script = ExtResource("1")
