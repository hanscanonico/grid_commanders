[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]

[sub_resource type="Resource" id="Objective_take_the_crossroads_base_before_vale"]
script = ExtResource("2")
text = "Take the crossroads base before Vale finishes it."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Failure_vale_finished_fortifying_the_base"]
script = ExtResource("3")
text = "Vale finished fortifying the base."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Five marshals down to one border, and one left to open: Konrad Vale. Everything he fields costs more and hits harder for it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Then we don't let him field it. The crossroads base finishes in nine days — we take it in six."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Six days. Optimistic pricing, Commander. I've built empires on worse odds."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Deny him the factory, and every premium he priced in never gets spent."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "The crossroads is ours, four days early. Vale's ledger shows a factory that never opened."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "One marshal's economy, closed before it started."

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("6")
day = 6

[sub_resource type="Resource" id="Trigger_still_nobodys"]
script = ExtResource("7")
cell = Vector2i(7, 4)
holder = 2

[sub_resource type="Resource" id="Effect_vale_takes_the_gate"]
script = ExtResource("8")
team = 2
cells = Array[Vector2i]([Vector2i(7, 4)])

[sub_resource type="Resource" id="Effect_vale_factory"]
script = ExtResource("9")
flag = &"vale_factory"
mode = 0
value = 1
note = "Vale's crossroads factory opened on schedule, and it is still producing."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Day six. The crossroads is finished, and it is mine. Ask your quartermaster what that costs you."

[sub_resource type="Resource" id="Event_the_gate_finishes"]
script = ExtResource("5")
id = &"the_gate_finishes"
triggers = Array[Resource]([SubResource("Trigger_day_6"), SubResource("Trigger_still_nobodys")])
effects = Array[Resource]([SubResource("Effect_vale_takes_the_gate"), SubResource("Effect_vale_factory")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"sm04_the_foundry_gate"
title = "The Foundry Gate"
location = "The road forks, Meridian-Iron border"
map_path = "res://maps/campaign/six_marshals/sm04_the_foundry_gate.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"rhea_sol",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_crossroads_base_before_vale")])
failures = Array[Resource]([SubResource("Failure_vale_finished_fortifying_the_base")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_gate_finishes")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Vale finished the base, and every unit that rolled out of it cost us twice."
