[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=10 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Trophy"]
script = ExtResource("3")
flag = &"orlov_trophy"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="No_trophy"]
script = ExtResource("3")
flag = &"orlov_trophy"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "Orlov's hunters crossed back over the broken hills without being told to. He'd already decided the hills weren't worth what leaving them would cost."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &"cass_orlov"
text = "Nothing sang. Three weeks out there and nothing of yours ever limped. I've written you down as expensive."
requires = SubResource("No_trophy")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"cass_orlov"
text = "I leave with one of yours and a reputation, and Vance has already written to ask me which of yours limps first."
requires = SubResource("Trophy")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Three answered. Iona Vance is the fourth. She doesn't need us to make a mistake, only time."

[resource]
script = ExtResource("1")
after_block = 2
title = "The Hunt Ends"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
