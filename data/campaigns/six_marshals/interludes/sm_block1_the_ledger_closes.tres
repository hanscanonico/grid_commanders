[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=8 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Paid"]
script = ExtResource("3")
flag = &"ferrow_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Unpaid"]
script = ExtResource("3")
flag = &"ferrow_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "Ferrow's column went home in the second week of the thaw. It is the only Iron force on the whole border that withdrew because it wanted to."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &"dane_ferrow"
text = "The Directorate is dead and six of us are bidding for its chair. I am the only one keeping receipts."
requires = SubResource("Unpaid")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"dane_ferrow"
text = "The Directorate is dead and six of us are bidding for its chair. I go into that room with a full column and your losses on the ledger beside it."
requires = SubResource("Paid")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "One marshal answered. The next one does not raid at all — Konrad Vale buys the ground before he takes it, and he is already building on ours."

[resource]
script = ExtResource("1")
after_block = 0
title = "The Ledger Closes"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
