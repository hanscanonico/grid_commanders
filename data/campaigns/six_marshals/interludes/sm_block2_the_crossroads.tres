[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=8 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Factory_open"]
script = ExtResource("3")
flag = &"vale_factory"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "Vale's war ended at a river, the last place he ever wanted to fight, and his accountants left before his infantry did."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &"konrad_vale"
text = "The crossroads factory is still under contract, and my name is not on it. Whichever marshal is left will find it waiting, paid for, in your half of the map."
requires = SubResource("Factory_open")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Two answered. Cass Orlov is next, and he doesn't want the border. He wants whatever of ours is already hurt."

[resource]
script = ExtResource("1")
after_block = 1
title = "The Crossroads"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
