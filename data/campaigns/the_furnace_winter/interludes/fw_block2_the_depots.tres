[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=17 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Cond_road_runs_whole"]
script = ExtResource("3")
flag = &"fw_depots_open"
at_least = 10
at_most = -1

[sub_resource type="Resource" id="Cond_road_runs_short"]
script = ExtResource("3")
flag = &"fw_depots_open"
at_least = 1
at_most = 9

[sub_resource type="Resource" id="Cond_road_runs_nowhere"]
script = ExtResource("3")
flag = &"fw_depots_open"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Cond_ledger_clean"]
script = ExtResource("3")
flag = &"fw_bounty_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Cond_ledger_paid"]
script = ExtResource("3")
flag = &"fw_bounty_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_vale_withdrew"]
script = ExtResource("3")
flag = &"fw_vale_withdrew"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "Thirteen depots run from the causeway to the foundry gate. By the thaw the map office had stopped calling it a road and started calling it a ledger. Both sides were reading from it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &"perrin_ash"
text = "Ten of the thirteen came out of it whole, pumps still turning. That's a working supply line, quartermaster, not a souvenir."
requires = SubResource("Cond_road_runs_whole")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"perrin_ash"
text = "We opened the road. A good part of it is scrap now, so the fuel runs east slowly. The furnace will notice."
requires = SubResource("Cond_road_runs_short")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"perrin_ash"
text = "We took every depot and left the road behind us in pieces. Nothing runs east on its own now, so whatever the furnace needs, we fly it in."
requires = SubResource("Cond_road_runs_nowhere")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2")
speaker = &"cassian_rook"
text = "Ferrow never collected a coin on that road. Every column he looked at was at full strength, and a raider paid per kill can't bill for a line with no gaps in it."
requires = SubResource("Cond_ledger_clean")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2")
speaker = &"cassian_rook"
text = "Ferrow got paid. Never well, never on time, and he still rode out of the depots with a column we bought him."
requires = SubResource("Cond_ledger_paid")

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2")
speaker = &"konrad_vale"
text = "I pulled east off the last mile rather than burn it. I did not have to. Look at what is standing at the end of the road I left you."
requires = SubResource("Cond_vale_withdrew")

[resource]
script = ExtResource("1")
after_block = 1
title = "The Depots"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7")])
