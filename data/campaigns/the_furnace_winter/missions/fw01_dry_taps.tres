[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the crossroads base. It is the only way this army builds anything."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "Vale's garrison held the crossroads past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay as well."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Vale shut the depots at first frost. No factory behind us — the crossroads base is the only one still unclaimed."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Then it's a race, Commander. My garrison's already dug in, and I get paid whether you show up or not."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "We move now. Whoever builds first wins the winter."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The depot is ours. First tanks are already rolling off it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Pulled back east with less than I came for. Vale won't like the invoice."

