[gd_resource type="Resource" script_class="MissionDefinition" load_steps=21 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="8"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="9"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the crossroads base. It is the only way this army builds anything."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay as well."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Vale closed the depots at first frost. There is no factory behind us. The crossroads base is the only one still free."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Then it's a race. My garrison's already dug in, and I get paid whether you show up or not."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "We move now. Whoever builds first wins the winter."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The depot is ours. First tanks are already rolling off it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Pulled back east with less than I came for. Vale won't like the bill."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("6")
day = 3

[sub_resource type="Resource" id="Spawn_crossroads_picket"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(7, 5)

[sub_resource type="Resource" id="Effect_garrison_arrives"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_crossroads_picket")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Race called. My people had the crossroads while yours were still reading the map, and I'll be billing Vale for the early start."

[sub_resource type="Resource" id="Event_the_garrison_arrives"]
script = ExtResource("5")
id = &"the_garrison_arrives"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_garrison_arrives")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
