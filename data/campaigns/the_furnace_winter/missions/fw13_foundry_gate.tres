[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's forward headquarters."
cell = Vector2i(16, 10)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The foundry kept running past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Two bases deep, Commander, and I open richer than you by design. Vale's doctrine, not an accident."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Design or not, a headquarters is a headquarters. Take it and the gate stops being yours to close."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "No time to out-produce her. We go straight for the command post."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Gate's down. Your forward command answers to us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Whatever richer opening he gave me, it bought one headquarters and no more."

