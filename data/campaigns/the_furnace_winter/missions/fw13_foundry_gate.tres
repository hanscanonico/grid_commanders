[ext_resource type="Resource" path="res://data/units/tank.tres" id="11"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's forward headquarters."
cell = Vector2i(16, 10)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Two bases and more money than you. Vale signed for both."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Rich or not, a headquarters is a headquarters. Take it and she can't close the gate on anyone again."

[sub_resource type="Resource" id="Line_ward"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The money behind that gate is toll money collected at our own valves, Lark, and it's paying for her two bases."

[sub_resource type="Resource" id="Cond_vale_withdrew"]
script = ExtResource("10")
flag = &"fw_vale_withdrew"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "He gave up the last mile without burning it. He's saving what he has for ground he means to hold."
requires = SubResource("Cond_vale_withdrew")

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Same column that opened the last mile, same boots that walked up from the causeway."

[sub_resource type="Resource" id="Cond_depot_road_open"]
script = ExtResource("10")
flag = &"fw_depots_open"
at_least = 8
at_most = -1

[sub_resource type="Resource" id="Line_ward_road"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Every drum you burn at that gate came up the depot road behind you, and there's more of it coming."
requires = SubResource("Cond_depot_road_open")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "No time to out-produce her. We go straight for the command post."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Gate's down. Your forward command answers to us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "All that extra money bought one headquarters. No more."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_second_base_armour"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Effect_second_base_opens"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_second_base_armour")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The second base opened at dawn. It will open again tomorrow, and the day after."

[sub_resource type="Resource" id="Event_the_second_base_opens"]
script = ExtResource("6")
id = &"the_second_base_opens"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_second_base_opens")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_6"]
script = ExtResource("7")
day = 6

[sub_resource type="Resource" id="Spawn_second_base_again"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Effect_second_base_again"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_second_base_again")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "And again, as promised. The gate doesn't tire. Do you?"

[sub_resource type="Resource" id="Event_the_gate_arithmetic"]
script = ExtResource("6")
id = &"the_gate_arithmetic"
triggers = Array[Resource]([SubResource("Trigger_day_6")])
effects = Array[Resource]([SubResource("Effect_second_base_again")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("5")
text = "The gate held, and the foundry kept its richer defender through another winter."

