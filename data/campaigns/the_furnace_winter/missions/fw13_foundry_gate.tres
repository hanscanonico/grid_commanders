[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's forward headquarters."
cell = Vector2i(16, 10)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The foundry kept running past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Two bases deep, Commander, and I open richer than you by design. Vale's doctrine, not an accident."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Design or not, a headquarters is a headquarters. Take it and the gate stops being yours to close."

[sub_resource type="Resource" id="Cond_vale_withdrew"]
script = ExtResource("10")
flag = &"fw_vale_withdrew"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "He gave up the last mile without burning it. That was a man saving his stock for somewhere he means to stand."
requires = SubResource("Cond_vale_withdrew")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "No time to out-produce her. We go straight for the command post."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Gate's down. Your forward command answers to us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Whatever richer opening he gave me, it bought one headquarters and no more."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_second_base_armour"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Effect_second_base_opens"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_second_base_armour")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The second base opened at dawn. It will open again tomorrow, and the day after."

[sub_resource type="Resource" id="Event_the_second_base_opens"]
script = ExtResource("6")
id = &"the_second_base_opens"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_second_base_opens")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

