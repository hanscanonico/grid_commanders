[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Two depots stand between you and the eastern fields, Commander. Both closed, both mine."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "No convoy to escort this time, just the road. We take the depots in order."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Ten days. She won't leave them undefended for an eleventh."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Both depots open. The eastern road's running fuel again."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Withdrawn to the next junction. I'll be waiting there with a longer ledger."

