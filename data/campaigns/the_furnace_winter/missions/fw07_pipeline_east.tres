[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("3")
text = "Keep depot 1 for two whole days while you go for the second."
cell = Vector2i(5, 3)
days = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold every property on the road at once — all six."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "Two depots stand between you and the eastern fields, Commander. Both closed, both mine."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "No convoy to escort this time, just the road. We take the depots in order."

[sub_resource type="Resource" id="Cond_ice_road_open"]
script = ExtResource("13")
flag = &"fw_ice_road_open"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "We still hold the causeway from the freeze. Open this road and the fuel has somewhere to go."
requires = SubResource("Cond_ice_road_open")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Ten days. She won't leave them undefended for an eleventh."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Both depots open. The eastern road's running fuel again."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "Withdrawn to the next junction. I will be waiting there with more."

[sub_resource type="Resource" id="Trigger_depot_1_ours"]
script = ExtResource("8")
cell = Vector2i(5, 3)
holder = 0

[sub_resource type="Resource" id="Spawn_depot_2_watch"]
script = ExtResource("11")
unit_type = ExtResource("14")
cell = Vector2i(12, 3)

[sub_resource type="Resource" id="Spawn_depot_2_reserve"]
script = ExtResource("11")
unit_type = ExtResource("15")
cell = Vector2i(13, 2)

[sub_resource type="Resource" id="Effect_re_staffed"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_depot_2_watch"), SubResource("Spawn_depot_2_reserve")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "Depot one is yours. Depot two has fresh troops in it — I keep a reserve for exactly this."

[sub_resource type="Resource" id="Event_re_staffed"]
script = ExtResource("7")
id = &"re_staffed"
triggers = Array[Resource]([SubResource("Trigger_depot_1_ours")])
effects = Array[Resource]([SubResource("Effect_re_staffed")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_depot_2_ours"]
script = ExtResource("8")
cell = Vector2i(13, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_with_a_day_in_hand"]
script = ExtResource("9")
day = 9

[sub_resource type="Resource" id="Effect_two_depots_open"]
script = ExtResource("12")
flag = &"fw_depots_open"
mode = 1
value = 2
note = "The eastern fuel road was reopened with its depots still working."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Both depots ours with a day to spare. Pumps turning, tanks full. The eastern road is open."

[sub_resource type="Resource" id="Event_the_east_road_runs"]
script = ExtResource("7")
id = &"the_east_road_runs"
triggers = Array[Resource]([SubResource("Trigger_depot_1_ours"), SubResource("Trigger_depot_2_ours"), SubResource("Trigger_with_a_day_in_hand")])
effects = Array[Resource]([SubResource("Effect_two_depots_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

