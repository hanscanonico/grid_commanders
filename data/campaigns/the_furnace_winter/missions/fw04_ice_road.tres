[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the causeway base. It is the only way this army builds anything."
cell = Vector2i(6, 5)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "Vale's garrison held the causeway past day 9."
last_day = 9

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("4")
text = "More than two of our units left the column, however they went."
max_losses = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay as well."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "The causeway's frozen solid, but it's still a factory the moment it's ours."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Three columns across already, Reed. Fourth's on the ice behind them."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Every column he breaks funds the next. We don't feed him one at a time."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Causeway's open. The base builds for us now, not for his raiders."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Pulled back with less than I came for. Fine. There's always a next crossing."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Spawn_fourth_column_lead"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(9, 5)

[sub_resource type="Resource" id="Spawn_fourth_column_mech"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(8, 5)

[sub_resource type="Resource" id="Effect_fourth_column"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_fourth_column_lead"), SubResource("Spawn_fourth_column_mech")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Fourth column's across the ice. That's the one you were supposed to stop, Reed."

[sub_resource type="Resource" id="Event_the_fourth_column"]
script = ExtResource("6")
id = &"the_fourth_column"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_fourth_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_causeway_ours"]
script = ExtResource("8")
cell = Vector2i(6, 5)
holder = 0

[sub_resource type="Resource" id="Effect_ice_road_open"]
script = ExtResource("11")
flag = &"fw_ice_road_open"
mode = 0
value = 1
note = "The frozen causeway was reopened, and the northern fuel has somewhere to go."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Causeway's ours. Whatever crosses that ice from now on crosses it for us."

[sub_resource type="Resource" id="Event_the_causeway_opens"]
script = ExtResource("6")
id = &"the_causeway_opens"
triggers = Array[Resource]([SubResource("Trigger_causeway_ours")])
effects = Array[Resource]([SubResource("Effect_ice_road_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw04_ice_road"
title = "Ice Road"
location = "The frozen causeway, north of Kestrel"
map_path = "res://maps/campaign/the_furnace_winter/fw04_ice_road.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"tomas_reed",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_0"), SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_fourth_column"), SubResource("Event_the_causeway_opens")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The causeway stayed his, and the toll went on being paid in armour and men."
