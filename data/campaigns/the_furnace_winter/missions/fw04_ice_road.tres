[ext_resource type="Script" path="res://core/campaign/triggers/unit_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/objectives/reach_cell_objective.gd" id="14"]
[ext_resource type="Script" path="res://core/campaign/objectives/protect_unit_objective.gd" id="15"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="12"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="13"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the causeway base. The bridge tolls nobody once it is ours."
cell = Vector2i(6, 5)

[sub_resource type="Resource" id="Objective_landing"]
script = ExtResource("14")
text = "Get a unit through to the east landing."
cells = Array[Vector2i]([Vector2i(11, 6)])
count = 1

[sub_resource type="Resource" id="Failure_sledge"]
script = ExtResource("15")
text = "The fuel sledge went under the ice."
tag = &"fuel_sledge"

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay on the far bank as well."
cell = Vector2i(10, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "First fuel convoy of the winter, one sledge, one bridge. The causeway base pays for the escort the moment it's ours."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "One bridge, Reed. I only have to be standing on it once, and I'm paid either way."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "The sledge doesn't swim. Boots can wade the ice — clear the far bank before it rolls onto the bridge."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Convoy's across and the causeway builds for us. The ice road is a road again."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Pulled back with less than I came for. Fine. There's always a next crossing."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Spawn_ambush_lead"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(9, 5)

[sub_resource type="Resource" id="Spawn_ambush_mech"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(9, 4)

[sub_resource type="Resource" id="Effect_bridge_ambush"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_ambush_lead"), SubResource("Spawn_ambush_mech")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Told you, Reed. The east bridgehead is mine, and your sledge is a fee waiting to be collected."

[sub_resource type="Resource" id="Event_the_bridge_ambush"]
script = ExtResource("6")
id = &"the_bridge_ambush"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_bridge_ambush")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_sledge_lands"]
script = ExtResource("8")
tag = &"fuel_sledge"
cells = Array[Vector2i]([Vector2i(11, 6)])

[sub_resource type="Resource" id="Effect_ice_road_open"]
script = ExtResource("11")
flag = &"fw_ice_road_open"
mode = 0
value = 1
note = "The fuel sledge crossed the Kestrel ice — the first convoy of the winter got through."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Sledge is on the east landing. That's the first fuel over the Kestrel ice all winter."

[sub_resource type="Resource" id="Event_the_first_convoy"]
script = ExtResource("6")
id = &"the_first_convoy"
triggers = Array[Resource]([SubResource("Trigger_sledge_lands")])
effects = Array[Resource]([SubResource("Effect_ice_road_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw04_ice_road"
title = "Ice Road"
location = "The frozen causeway, north of Kestrel"
map_path = "res://maps/campaign/the_furnace_winter/fw04_ice_road.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"tomas_reed",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_landing")])
failures = Array[Resource]([SubResource("Failure_sledge")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_bridge_ambush"), SubResource("Event_the_first_convoy")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The convoy never crossed, and the toll went on being paid in armour and men."
