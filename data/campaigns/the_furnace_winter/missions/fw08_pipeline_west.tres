[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The western depots mirror the eastern pair. I built them identically — economy of design."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "Then we've already learned this fight once. I hold, I don't chase — we take both and stop."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "Ten days, same as the east. Don't give her time to learn from her own mistake."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "Western road's open. Both pipelines answer to us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The same lesson, twice. That is a cost I did not budget for."

[resource]
script = ExtResource("1")
id = &"fw08_pipeline_west"
title = "Pipeline West"
