[ext_resource type="Resource" path="res://data/units/infantry.tres" id="16"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("3")
text = "Depot 1 is already ours. Keep it ours for three whole days."
cell = Vector2i(5, 3)
days = 3

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold every property on the road at once — all six."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "The western depots match the eastern pair. I built them the same way. It is cheaper."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Not identical now. Depot 1 has flown our flag since dawn, and this time it's your columns walking onto a dug-in line."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "We hold what's ours and take the second. She'll come for the first. Let her."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Held the first, took the second. Both pipelines answer to us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "You defended better than I allowed for. Noted."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Spawn_recovery_mech"]
script = ExtResource("12")
unit_type = ExtResource("15")
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Spawn_recovery_infantry"]
script = ExtResource("12")
unit_type = ExtResource("16")
cell = Vector2i(8, 2)

[sub_resource type="Resource" id="Effect_recovery_column"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_recovery_mech"), SubResource("Spawn_recovery_infantry")])

[sub_resource type="Resource" id="Event_line_recovery"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "You hold my depot. Taking it back is worth a column to me, so here is one."

[sub_resource type="Resource" id="Event_the_recovery_column"]
script = ExtResource("7")
id = &"the_recovery_column"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_recovery_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_recovery")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("8")
day = 5

[sub_resource type="Resource" id="Spawn_the_same_column"]
script = ExtResource("12")
unit_type = ExtResource("14")
cell = Vector2i(17, 3)

[sub_resource type="Resource" id="Effect_the_same_column"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_the_same_column")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "Same design, same answer. I have sent the same column to the same junction. Expect the same result."

[sub_resource type="Resource" id="Event_the_same_column_again"]
script = ExtResource("7")
id = &"the_same_column_again"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_the_same_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_depot_1_ours"]
script = ExtResource("9")
cell = Vector2i(5, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_depot_2_ours"]
script = ExtResource("9")
cell = Vector2i(13, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_with_a_day_in_hand"]
script = ExtResource("10")
day = 9

[sub_resource type="Resource" id="Effect_two_depots_open"]
script = ExtResource("13")
flag = &"fw_depots_open"
mode = 1
value = 2
note = "The western fuel road was reopened with its depots still working."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Still standing on both of them. The western road runs."

[sub_resource type="Resource" id="Event_the_west_road_runs"]
script = ExtResource("7")
id = &"the_west_road_runs"
triggers = Array[Resource]([SubResource("Trigger_depot_1_ours"), SubResource("Trigger_depot_2_ours"), SubResource("Trigger_with_a_day_in_hand")])
effects = Array[Resource]([SubResource("Effect_two_depots_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
