[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="14"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="15"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_reached_trigger.gd" id="16"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="17"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the granary base. It is the last food Milltown has this winter."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay too — eyes on the whole valley."
cell = Vector2i(9, 2)

[sub_resource type="Resource" id="Bonus_torch"]
script = ExtResource("14")
text = "Put the torch squad down on the road."
tag = &"the_match"

[sub_resource type="Resource" id="Fact_granary_saved"]
script = ExtResource("17")
flag = &"fw_granary_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Fact_granary_lost"]
script = ExtResource("17")
flag = &"fw_granary_saved"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "One base left standing in Milltown, and Ferrow's decided burning it is cheaper than defending it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Cheaper for me. You're welcome to the ash, quartermaster."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "That mech on the road is his torch squad. Reach the base first, or put the squad down on the way."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Base held. Milltown eats through the winter, and so do we."
requires = SubResource("Fact_granary_saved")

[sub_resource type="Resource" id="Line_4_late"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Base is ours, late and short of what was in it. Milltown eats off our wagons now, which means it eats whatever we can spare off the line. I'll be signing for that all winter."
requires = SubResource("Fact_granary_lost")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Scattered into the treeline. I'll collect on this later."

[sub_resource type="Resource" id="Trigger_base_ours"]
script = ExtResource("6")
cell = Vector2i(6, 4)
holder = 0

[sub_resource type="Resource" id="Trigger_before_the_match"]
script = ExtResource("7")
day = 5

[sub_resource type="Resource" id="Effect_granary_saved"]
script = ExtResource("9")
flag = &"fw_granary_saved"
mode = 0
value = 1
note = "Milltown's granary came through the freeze — Ferrow's match never reached it."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Silos intact, roof on, not a drum of fuel poured. Milltown keeps its grain and Ferrow keeps his matches, which is the best trade I've made all winter."

[sub_resource type="Resource" id="Event_the_match_never_struck"]
script = ExtResource("5")
id = &"the_match_never_struck"
triggers = Array[Resource]([SubResource("Trigger_base_ours"), SubResource("Trigger_before_the_match")])
effects = Array[Resource]([SubResource("Effect_granary_saved")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_match_reaches"]
script = ExtResource("16")
tag = &"the_match"
cells = Array[Vector2i]([Vector2i(6, 4)])

[sub_resource type="Resource" id="Effect_torched"]
script = ExtResource("10")
team = 2
cells = Array[Vector2i]([Vector2i(6, 4)])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Torch it. If the quartermaster wants Milltown fed, he can pay me for the ashes."

[sub_resource type="Resource" id="Event_he_strikes_the_match"]
script = ExtResource("5")
id = &"he_strikes_the_match"
triggers = Array[Resource]([SubResource("Trigger_match_reaches")])
effects = Array[Resource]([SubResource("Effect_torched")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_match_down"]
script = ExtResource("15")
tag = &"the_match"

[sub_resource type="Resource" id="Trigger_yard_unburned"]
script = ExtResource("6")
cell = Vector2i(6, 4)
holder = 2

[sub_resource type="Resource" id="Effect_granary_saved_by_hunt"]
script = ExtResource("9")
flag = &"fw_granary_saved"
mode = 0
value = 1
note = "The torch squad went down on the road with its matches unstruck."

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Torch squad's down on the road, matches unstruck. Milltown sleeps tonight."

[sub_resource type="Resource" id="Event_the_match_goes_down"]
script = ExtResource("5")
id = &"the_match_goes_down"
triggers = Array[Resource]([SubResource("Trigger_match_down"), SubResource("Trigger_yard_unburned")])
effects = Array[Resource]([SubResource("Effect_granary_saved_by_hunt")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

