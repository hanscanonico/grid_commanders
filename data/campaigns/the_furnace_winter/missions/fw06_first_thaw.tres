[gd_resource type="Resource" script_class="MissionDefinition" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="12"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("3")
text = "Hold four of the pass's seven properties at once."
count = 4

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("4")
text = "Hold Kestrel Pass itself for two whole days."
cell = Vector2i(7, 5)
days = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the border relay above the pass — nothing crosses unseen."
cell = Vector2i(11, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "The Director of Supply doesn't usually carry a rifle count. I make an exception for a pass worth holding."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"halden_marr"
text = "You want Kestrel held as a lesson. We want it as a foothold."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"halden_marr"
text = "Hold four properties, win the pass, and the roads start opening on their own weight."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"halden_marr"
text = "You withdrew from the pass yourself. That's not a thing you do twice."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "No. It is not. This valley was never the whole of it, Commander."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"halden_marr"
text = "Then we'll see the rest of it, one depot at a time."

[sub_resource type="Resource" id="Trigger_pass_ours"]
script = ExtResource("8")
cell = Vector2i(7, 5)
holder = 0

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("9")
day = 4

[sub_resource type="Resource" id="Effect_guard_withdraws"]
script = ExtResource("10")
tags = Array[StringName]([&"vale_guard_a", &"vale_guard_b"])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "You are still on my pass, and my column is still paying for it. I do not spend a division on a point I have already lost. Withdraw to the depot line."

[sub_resource type="Resource" id="Event_vale_withdraws_from_kestrel"]
script = ExtResource("7")
id = &"vale_withdraws_from_kestrel"
triggers = Array[Resource]([SubResource("Trigger_pass_ours"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_guard_withdraws")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_before_he_is_ready"]
script = ExtResource("12")
day = 6

[sub_resource type="Resource" id="Effect_kestrel_held"]
script = ExtResource("11")
flag = &"fw_kestrel_held"
mode = 0
value = 1
note = "Kestrel Pass was taken inside the first week of the thaw, before Vale had settled his column onto it."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"halden_marr"
text = "Inside the week. He has not had time to make this pass expensive, and he is not getting another."

[sub_resource type="Resource" id="Event_the_pass_taken_early"]
script = ExtResource("7")
id = &"the_pass_taken_early"
triggers = Array[Resource]([SubResource("Trigger_pass_ours"), SubResource("Trigger_before_he_is_ready")])
effects = Array[Resource]([SubResource("Effect_kestrel_held")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw06_first_thaw"
title = "First Thaw"
location = "The border crossing, Kestrel Pass"
map_path = "res://maps/campaign/the_furnace_winter/fw06_first_thaw.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"halden_marr",
2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_vale_withdraws_from_kestrel"), SubResource("Event_the_pass_taken_early")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])
defeat = "Vale held the pass himself, and the Freeze goes on exactly as he designed it."
