[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture Vale's forward headquarters."
cell = Vector2i(18, 11)

[sub_resource type="Resource" id="Bonus_the_four_towns"]
script = ExtResource("3")
text = "Hold all four of the stacks district's towns at once."
count = 4
terrain_id = &"city"

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Bonus_1"]
script = ExtResource("4")
text = "Hold the stack yard itself for two whole days."
cell = Vector2i(10, 11)
days = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "No more enforcers, quartermaster. The stacks are the furnace's doorstep, and I am standing on it."

[sub_resource type="Resource" id="Cond_kestrel_held"]
script = ExtResource("10")
flag = &"fw_kestrel_held"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "You took my pass in the first month of the freeze. I have thought about it every week since. I do not make the same mistake twice."
requires = SubResource("Cond_kestrel_held")

[sub_resource type="Resource" id="Cond_siege_broken"]
script = ExtResource("10")
flag = &"fw_siege_broken"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "His guns never recovered from the smelter yard. Nothing here is going to shell us."
requires = SubResource("Cond_siege_broken")

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The stacks burn coal day and night. The whole district fights under its own smoke. Watch your flanks."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Richest start we've faced all winter, Vale. It still won't be enough."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Take the headquarters and hold the district. After this he has nowhere left but the furnace floor."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Stacks are ours. You pulled back to the furnace floor with nothing behind you."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "One district left. It was always going to come down to that one."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Effect_signed_for_personally"]
script = ExtResource("9")
team = 2
points = 9000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "I am paying for this district out of my own hand, quartermaster. Most of what I held back is on the field now."

[sub_resource type="Resource" id="Event_signed_for_personally"]
script = ExtResource("7")
id = &"signed_for_personally"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_signed_for_personally")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("6")
speaker = &"konrad_vale"
text = "The stacks hold, quartermaster. I paid for this district out of my own hand. It stayed mine."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Richest start we faced all winter. It turned out to be enough. The furnace doorstep stays his."

[resource]
script = ExtResource("1")
