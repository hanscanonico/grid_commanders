[gd_resource type="Resource" script_class="MissionDefinition" load_steps=14 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's forward headquarters."
cell = Vector2i(18, 11)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Hold six properties by the deadline."
count = 6

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The foundry kept running past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "I'm done sending enforcers, quartermaster. The stacks are the furnace's own doorstep, and I'm standing on it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Richest opening we've faced all winter. Should've brought a bigger ledger yourself, Vale."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Take the headquarters, hold the district. Nowhere left for him to fall back to but the furnace floor."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Stacks are ours. You pulled back to the furnace floor with nothing behind you."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "One district left. It was always going to come down to that one."

[resource]
script = ExtResource("1")
id = &"fw17_the_stacks"
title = "The Stacks"
location = "The foundry stacks, inner district"
map_path = "res://maps/campaign/the_furnace_winter/fw17_the_stacks.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The stacks held for Vale, and the furnace's doorstep stayed exactly that — his."
