[sub_resource type="Resource" id="Objective_hq"]
script = ExtResource("2")
text = "Capture Ferrow's headquarters."
cell = Vector2i(19, 2)

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("6")
text = "More than five of our units left the column, however they went."
max_losses = 5

[sub_resource type="Resource" id="Bonus_rider_a"]
script = ExtResource("13")
text = "Run down his western pay-rider."
tag = &"rider_a"

[sub_resource type="Resource" id="Bonus_rider_b"]
script = ExtResource("13")
text = "Run down his eastern pay-rider."
tag = &"rider_b"

[sub_resource type="Resource" id="Fact_never_billed"]
script = ExtResource("15")
flag = &"fw_bounty_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Fact_bounty_paid"]
script = ExtResource("15")
flag = &"fw_bounty_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "The coalyard is mine, Rook. I get paid for every column of yours I cut off and break."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted. We move as one column, not three. Nothing for you to isolate."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Two depots, nine days. His pay-riders carry the bounty money. Run them down and he gets nothing."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Coalyard's running. He rode all that way and collected nothing."
requires = SubResource("Fact_never_billed")

[sub_resource type="Resource" id="Line_4_short"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Coalyard's running. It cost us more of the column than I meant to spend. Ferrow rode away from this road with something to show for it after all."
requires = SubResource("Fact_bounty_paid")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Not a man among them to bounty. Fine. There's always the next junction."
requires = SubResource("Fact_never_billed")

[sub_resource type="Resource" id="Line_5_invoiced"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Keep the yard, and know that what your column left on the road was worth more to me than the coal."
requires = SubResource("Fact_bounty_paid")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Log the spur open, and let's have the column back on the road east."

[sub_resource type="Resource" id="Trigger_column_is_short"]
script = ExtResource("8")
team = 1
bound = 0
count = 4

[sub_resource type="Resource" id="Effect_bounty_paid"]
script = ExtResource("9")
team = 2
amount = 3000

[sub_resource type="Resource" id="Effect_bounty_on_the_books"]
script = ExtResource("12")
flag = &"fw_bounty_paid"
mode = 1
value = 1
note = "Ferrow caught our column under the strength it rode in with at least once this winter."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Your line came out shorter than it went in. I counted the gap and billed Vale for it."

[sub_resource type="Resource" id="Event_invoice_submitted"]
script = ExtResource("7")
id = &"invoice_submitted"
triggers = Array[Resource]([SubResource("Trigger_column_is_short")])
effects = Array[Resource]([SubResource("Effect_bounty_paid"), SubResource("Effect_bounty_on_the_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_rider_a_down"]
script = ExtResource("14")
tag = &"rider_a"

[sub_resource type="Resource" id="Trigger_rider_b_down"]
script = ExtResource("14")
tag = &"rider_b"

[sub_resource type="Resource" id="Effect_strongbox"]
script = ExtResource("9")
team = 1
amount = 2000

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Two riders down, one strongbox recovered. His float is our budget now."

[sub_resource type="Resource" id="Event_the_strongbox"]
script = ExtResource("7")
id = &"the_strongbox"
triggers = Array[Resource]([SubResource("Trigger_rider_a_down"), SubResource("Trigger_rider_b_down")])
effects = Array[Resource]([SubResource("Effect_strongbox")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[sub_resource type="Resource" id="Trigger_depot_1_ours"]
script = ExtResource("10")
cell = Vector2i(5, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_depot_2_ours"]
script = ExtResource("10")
cell = Vector2i(15, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_with_a_day_in_hand"]
script = ExtResource("11")
day = 8

[sub_resource type="Resource" id="Effect_two_depots_open"]
script = ExtResource("12")
flag = &"fw_depots_open"
mode = 1
value = 2
note = "The coalyard spur was reopened with its depots still working."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Both yards ours with a day still in hand, coal still on the pad, spur logged open."

[sub_resource type="Resource" id="Event_the_coalyard_runs"]
script = ExtResource("7")
id = &"the_coalyard_runs"
triggers = Array[Resource]([SubResource("Trigger_depot_1_ours"), SubResource("Trigger_depot_2_ours"), SubResource("Trigger_with_a_day_in_hand")])
effects = Array[Resource]([SubResource("Effect_two_depots_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw09_coalyard_junction"
title = "Coalyard Junction"
location = "The coalyard spur"
map_path = "res://maps/campaign/the_furnace_winter/fw09_coalyard_junction.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"cassian_rook",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hq")])
failures = Array[Resource]([SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Bonus_rider_a"), SubResource("Bonus_rider_b")])
events = Array[Resource]([SubResource("Event_invoice_submitted"), SubResource("Event_the_strongbox"), SubResource("Event_the_coalyard_runs")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_4_short"), SubResource("Line_5"), SubResource("Line_5_invoiced"), SubResource("Line_6")])
defeat = "The coalyard stayed shut, and Ferrow was paid for every man we lost."
