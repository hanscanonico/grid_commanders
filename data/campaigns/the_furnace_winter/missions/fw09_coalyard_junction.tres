[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 9."
last_day = 9

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("6")
text = "More than three units were lost to Ferrow's bounty."
max_losses = 3

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Coalyard's mine personally, Rook. There's bounty in every column of yours I isolate and break."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted. We move as one column, not three — nothing for you to isolate."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Two depots, nine days. Deny the bounty, and he doesn't get paid."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Coalyard's running. Audit complete — he collected nothing for the trouble."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Not a man among them to bounty. Fine. There's always the next junction."

