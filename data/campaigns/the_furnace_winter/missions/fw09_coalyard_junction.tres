[gd_resource type="Resource" script_class="MissionDefinition" load_steps=34 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 9."
last_day = 9

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("6")
text = "More than three of our units left the column, however they went."
max_losses = 3

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once — all six."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Coalyard's mine personally, Rook. There's bounty in every column of yours I isolate and break."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted. We move as one column, not three — nothing for you to isolate."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Two depots, nine days. Deny the bounty, and he doesn't get paid."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Coalyard's running. Audit complete — he collected nothing for the trouble."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Not a man among them to bounty. Fine. There's always the next junction."

[sub_resource type="Resource" id="Trigger_column_is_short"]
script = ExtResource("8")
team = 1
bound = 0
count = 4

[sub_resource type="Resource" id="Effect_bounty_paid"]
script = ExtResource("9")
team = 2
amount = 3000

[sub_resource type="Resource" id="Effect_bounty_on_the_books"]
script = ExtResource("12")
flag = &"fw_bounty_paid"
mode = 1
value = 1
note = "Ferrow collected on our column at least once this winter."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "That's one. Invoice submitted."

[sub_resource type="Resource" id="Event_invoice_submitted"]
script = ExtResource("7")
id = &"invoice_submitted"
triggers = Array[Resource]([SubResource("Trigger_column_is_short")])
effects = Array[Resource]([SubResource("Effect_bounty_paid"), SubResource("Effect_bounty_on_the_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_depot_1_ours"]
script = ExtResource("10")
cell = Vector2i(5, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_depot_2_ours"]
script = ExtResource("10")
cell = Vector2i(15, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_with_a_day_in_hand"]
script = ExtResource("11")
day = 8

[sub_resource type="Resource" id="Effect_two_depots_open"]
script = ExtResource("12")
flag = &"fw_depots_open"
mode = 1
value = 2
note = "The coalyard spur was reopened with its depots still working."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Both yards ours with a day still in hand, and the coal still on the pad. Log the spur open."

[sub_resource type="Resource" id="Event_the_coalyard_runs"]
script = ExtResource("7")
id = &"the_coalyard_runs"
triggers = Array[Resource]([SubResource("Trigger_depot_1_ours"), SubResource("Trigger_depot_2_ours"), SubResource("Trigger_with_a_day_in_hand")])
effects = Array[Resource]([SubResource("Effect_two_depots_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw09_coalyard_junction"
title = "Coalyard Junction"
location = "The coalyard spur"
map_path = "res://maps/campaign/the_furnace_winter/fw09_coalyard_junction.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"cassian_rook",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([SubResource("Failure_0"), SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_invoice_submitted"), SubResource("Event_the_coalyard_runs")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The coalyard stayed shut, and Ferrow's ledger grew by exactly our losses."
