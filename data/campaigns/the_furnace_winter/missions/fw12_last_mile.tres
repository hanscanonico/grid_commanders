1: &"perrin_ash",
2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3"), SubResource("Objective_4")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_vale_withdraws_east"), SubResource("Event_the_last_mile_runs")])
par_day = 6
carry_out = true
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])
defeat = "The last mile held, and the foundry road stayed exactly as far away as it started."
