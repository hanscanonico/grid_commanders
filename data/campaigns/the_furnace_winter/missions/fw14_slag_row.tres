[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Ferrow's headquarters on Slag Row."
cell = Vector2i(16, 10)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The foundry kept running past day 12."
last_day = 12

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("5")
text = "More than three of our units left the column, however they went."
max_losses = 3

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Slag Row funds half my raiding column, Thorne. Richest ground I've ever been handed."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "Handed by Vale. Same doctrine, every enforcer richer than us. We've fought worse hurt."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "Break your headquarters and the bounty stops paying out of this district."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "Slag Row's ours. Your bounty book just lost its richest page."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Every raid I ran from here — gone with it. This one cost me."

[sub_resource type="Resource" id="Trigger_column_is_short"]
script = ExtResource("8")
team = 1
bound = 0
count = 5

[sub_resource type="Resource" id="Spawn_bought_rider"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Effect_bought_rider"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_rider")])

[sub_resource type="Resource" id="Effect_bounty_on_the_books"]
script = ExtResource("11")
flag = &"fw_bounty_paid"
mode = 1
value = 1
note = "Ferrow caught our column under the strength it rode in with at least once this winter."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "You are riding this row under strength, Warden, and a short line pays for a long one. That is the whole business model."

[sub_resource type="Resource" id="Event_the_business_model"]
script = ExtResource("7")
id = &"the_business_model"
triggers = Array[Resource]([SubResource("Trigger_column_is_short")])
effects = Array[Resource]([SubResource("Effect_bought_rider"), SubResource("Effect_bounty_on_the_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"fw14_slag_row"
title = "Slag Row"
location = "The slag heaps, foundry district"
map_path = "res://maps/campaign/the_furnace_winter/fw14_slag_row.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ivar_thorne",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_0"), SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_business_model")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Slag Row stayed his, and the bounty kept paying out of a headquarters we never took."
