[gd_resource type="Resource" script_class="MissionDefinition" load_steps=45 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="12"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="13"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="14"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="15"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="16"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="17"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="18"]

[sub_resource type="Resource" id="Objective_rider_a"]
script = ExtResource("13")
text = "Break the raiding column: destroy its armour."
tag = &"slag_rider_a"

[sub_resource type="Resource" id="Objective_rider_b"]
script = ExtResource("13")
text = "Break the raiding column: destroy its outrider."
tag = &"slag_rider_b"

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("5")
text = "More than five of our units left the column, however they went."
max_losses = 5

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Strip the row: hold seven of its nine properties at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Slag Row funds half my raiding column, Thorne. Richest ground I've ever been handed."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "Handed by Vale. Same doctrine, every enforcer richer than us. We've fought worse hurt."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "The armour and the outrider are his pay. Break both and this row is worth nothing to him."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"ivar_thorne"
text = "Column's broken on its own slag. Your best-paying ground just stopped paying."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Every raid I ran from here, gone with it. This one cost me."

[sub_resource type="Resource" id="Trigger_column_is_short"]
script = ExtResource("8")
team = 1
bound = 0
count = 5

[sub_resource type="Resource" id="Spawn_bought_rider"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Effect_bought_rider"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_rider")])

[sub_resource type="Resource" id="Effect_bounty_on_the_books"]
script = ExtResource("11")
flag = &"fw_bounty_paid"
mode = 1
value = 1
note = "Ferrow caught our column under the strength it rode in with at least once this winter."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "You're riding this row under strength, Thorne. A short line pays well."

[sub_resource type="Resource" id="Event_the_business_model"]
script = ExtResource("7")
id = &"the_business_model"
triggers = Array[Resource]([SubResource("Trigger_column_is_short")])
effects = Array[Resource]([SubResource("Effect_bought_rider"), SubResource("Effect_bounty_on_the_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("17")
day = 2

[sub_resource type="Resource" id="Cond_bounty_paid"]
script = ExtResource("15")
flag = &"fw_bounty_paid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_was_paid"]
script = ExtResource("14")
condition = SubResource("Cond_bounty_paid")

[sub_resource type="Resource" id="Spawn_bought_column_scout"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(12, 10)

[sub_resource type="Resource" id="Spawn_bought_column_armour"]
script = ExtResource("10")
unit_type = ExtResource("18")
cell = Vector2i(15, 9)

[sub_resource type="Resource" id="Effect_bought_column"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_column_scout"), SubResource("Spawn_bought_column_armour")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Remember every invoice you let me collect this winter? This column is what they bought."

[sub_resource type="Resource" id="Event_the_bought_column"]
script = ExtResource("7")
id = &"the_bought_column"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_was_paid")])
effects = Array[Resource]([SubResource("Effect_bought_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Cond_never_paid"]
script = ExtResource("15")
flag = &"fw_bounty_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Trigger_never_paid"]
script = ExtResource("14")
condition = SubResource("Cond_never_paid")

[sub_resource type="Resource" id="Effect_picket_walks"]
script = ExtResource("16")
tags = Array[StringName]([&"unpaid_picket"])

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Post nine hasn't been paid all winter, so post nine walked out. I don't blame them. I bill for them."

[sub_resource type="Resource" id="Event_the_unpaid_picket"]
script = ExtResource("7")
id = &"the_unpaid_picket"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_never_paid")])
effects = Array[Resource]([SubResource("Effect_picket_walks")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"fw14_slag_row"
title = "Slag Row"
location = "The slag heaps, foundry district"
map_path = "res://maps/campaign/the_furnace_winter/fw14_slag_row.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ivar_thorne",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_rider_a"), SubResource("Objective_rider_b")])
failures = Array[Resource]([SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_business_model"), SubResource("Event_the_bought_column"), SubResource("Event_the_unpaid_picket")])
par_day = 7
carry_in = true
carry_out = true
carry_floor_hp = 50
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The column kept riding, and the bounty kept paying out of Slag Row."
