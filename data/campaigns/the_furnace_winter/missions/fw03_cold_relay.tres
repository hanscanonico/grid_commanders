[gd_resource type="Resource" script_class="MissionDefinition" load_steps=21 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="8"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="9"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the relay base. In this whiteout it is the only ground that builds."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Find the northern relay in the whiteout and take it too."
cell = Vector2i(10, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Every checkpoint on this road answers to my ledger, Commander. Nothing moves without my signature."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "The relay's still unclaimed. That's one signature we can outrun."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "Her garrison outnumbers ours and the blizzard blinds both sides. We spend speed instead of shells."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "Relay's ours. One less entry in her book."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "For now you build faster than I reinforce. Enjoy the arithmetic while it favours you."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_checkpoint_watch"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(8, 4)

[sub_resource type="Resource" id="Effect_checkpoint"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_checkpoint_watch")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "A checkpoint on the crossroads, countersigned this morning. You may of course apply for passage."

[sub_resource type="Resource" id="Event_a_checkpoint_countersigned"]
script = ExtResource("5")
id = &"a_checkpoint_countersigned"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_checkpoint")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"fw03_cold_relay"
title = "Cold Relay"
location = "The relay station, Kestrel Hills"
map_path = "res://maps/campaign/the_furnace_winter/fw03_cold_relay.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ines_calder",
2: &"iona_vance"
}
fog_enabled = true
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_a_checkpoint_countersigned")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Vance's garrison held the relay, and the ledger closed against us."
