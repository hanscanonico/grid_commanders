[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's forward headquarters."
cell = Vector2i(17, 10)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Hold five properties by the deadline."
count = 5

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The foundry kept running past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Arsenal Road. My favourite ground, Wren — rich pickings for a raider paid per kill."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "Vale's extra base. Same as always. We take your headquarters instead."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "No arsenal, no raider gets paid."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "Arsenal's ours. Hunting season's closed."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Rode out with an empty ledger. That's the only defeat I understand."

