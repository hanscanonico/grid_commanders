[ext_resource type="Script" path="res://core/campaign/effects/defect_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="12"]

[sub_resource type="Resource" id="Unlock_ledger_still_empty"]
script = ExtResource("12")
flag = &"fw_bounty_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Ferrow's headquarters."
cell = Vector2i(17, 10)

[sub_resource type="Resource" id="Bonus_the_four_towns"]
script = ExtResource("3")
text = "Hold all four towns on the arsenal road at once. Leave nothing here to pay a raider from."
count = 4
terrain_id = &"city"

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("5")
text = "More than three of our units left the line, however they went."
max_losses = 3

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Arsenal Road. My favourite ground, Wren — rich pickings for a raider paid per kill."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "Vale's extra base. Same as always. We take your headquarters instead."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "No arsenal, no raider gets paid."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "Arsenal's ours. Hunting season's closed."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Rode out with an empty ledger. That's the only defeat I understand."

[sub_resource type="Resource" id="Trigger_line_is_short"]
script = ExtResource("8")
team = 1
bound = 0
count = 5

[sub_resource type="Resource" id="Effect_bounty_paid"]
script = ExtResource("10")
team = 2
amount = 3000

[sub_resource type="Resource" id="Effect_bounty_on_the_books"]
script = ExtResource("11")
flag = &"fw_bounty_paid"
mode = 1
value = 1
note = "Ferrow caught our column under the strength it rode in with at least once this winter."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "First entry in the book all winter, and it took you until Arsenal Road. Invoice submitted."

[sub_resource type="Resource" id="Event_invoice_submitted"]
script = ExtResource("7")
id = &"invoice_submitted"
triggers = Array[Resource]([SubResource("Trigger_line_is_short")])
effects = Array[Resource]([SubResource("Effect_bounty_paid"), SubResource("Effect_bounty_on_the_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_ferrow_is_worn_down"]
script = ExtResource("8")
team = 2
bound = 0
count = 3

[sub_resource type="Resource" id="Effect_riders_change_employer"]
script = ExtResource("9")
from_team = 2
to_team = 1
tags = Array[StringName]([&"ferrow_riders_a", &"ferrow_riders_b"])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Ledger's empty and the road's yours. I don't die for districts, Wren — and neither do my riders. Boys: new employer."

[sub_resource type="Resource" id="Event_rode_out_with_an_empty_ledger"]
script = ExtResource("7")
id = &"rode_out_with_an_empty_ledger"
triggers = Array[Resource]([SubResource("Trigger_ferrow_is_worn_down")])
effects = Array[Resource]([SubResource("Effect_riders_change_employer")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"fw16_arsenal_road"
title = "Arsenal Road"
location = "The arsenal district road"
map_path = "res://maps/campaign/the_furnace_winter/fw16_arsenal_road.txt"
unlock_requires = SubResource("Unlock_ledger_still_empty")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"sable_wren",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_the_four_towns"), SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_invoice_submitted"), SubResource("Event_rode_out_with_an_empty_ledger")])
par_day = 7
carry_in = true
carry_out = true
carry_floor_hp = 50
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The arsenal stayed his hunting ground, and the ledger closed on our side instead."
