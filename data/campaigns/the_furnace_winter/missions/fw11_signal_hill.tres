[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 8."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Three relays, Flux. Dug in on all of them — figured you'd besiege one at a time."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"orin_flux"
text = "Wrong figure. We take them together or not at all — a single depot held back funds the other two."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"orin_flux"
text = "Eight days. Your raiders are fast. A siege isn't."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"orin_flux"
text = "All three relays answer to us. Nothing left on this hill to bounty."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Three depots short of a paycheck. Vale's going to hear about this."

