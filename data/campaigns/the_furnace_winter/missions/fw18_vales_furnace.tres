[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vale's headquarters on the furnace floor."
cell = Vector2i(19, 11)

[sub_resource type="Resource" id="Bonus_seven_of_nine"]
script = ExtResource("3")
text = "Hold seven of the furnace's nine properties at once."
count = 7

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The foundry kept running past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold all nine at once — the furnace floor and everything that feeds it."
count = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "This is the furnace, Commander. I'm not leaving it to an enforcer, not after everything it took to hold."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Every depot, every base, every checkpoint this winter answered to keep us out of this room."

[sub_resource type="Resource" id="Cond_granary_saved"]
script = ExtResource("12")
flag = &"fw_granary_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Milltown still eats, because we reached its granary before his match did. That is the whole argument, Director, and it started in the first week."
requires = SubResource("Cond_granary_saved")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "We take your headquarters here, and the toll you've collected all winter stops being collected."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Your headquarters is ours. The furnace floor with it. The toll is over."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "The toll bought a winter without open war, Commander. Count the cost of that against what you're about to spend."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "We'll count it. The gate's open regardless — that ledger's closed for good."

[sub_resource type="Resource" id="Cond_ledger_stayed_clean"]
script = ExtResource("12")
flag = &"fw_bounty_paid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "And Ferrow rode the whole winter without collecting once. Send him the accounting; he'll appreciate it."
requires = SubResource("Cond_ledger_stayed_clean")

[sub_resource type="Resource" id="Cond_road_open"]
script = ExtResource("12")
flag = &"fw_depots_open"
at_least = 10
at_most = -1

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The fuel road runs east tonight, depot by depot, all the way back to Milltown. It was never yours to close."
requires = SubResource("Cond_road_open")

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("7")
day = 2

[sub_resource type="Resource" id="Cond_depots_open"]
script = ExtResource("12")
flag = &"fw_depots_open"
at_least = 10
at_most = -1

[sub_resource type="Resource" id="Trigger_the_road_is_ours"]
script = ExtResource("8")
condition = SubResource("Cond_depots_open")

[sub_resource type="Resource" id="Spawn_relief_lead"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(2, 6)

[sub_resource type="Resource" id="Spawn_relief_second"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(3, 6)

[sub_resource type="Resource" id="Effect_relief_column"]
script = ExtResource("9")
team = 1
units = Array[Resource]([SubResource("Spawn_relief_lead"), SubResource("Spawn_relief_second")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Every depot we opened this winter is running east tonight, and it came up the road behind us. Spend it — it was ours to begin with."

[sub_resource type="Resource" id="Event_the_road_runs_east"]
script = ExtResource("6")
id = &"the_road_runs_east"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_the_road_is_ours")])
effects = Array[Resource]([SubResource("Effect_relief_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Cond_depots_short"]
script = ExtResource("12")
flag = &"fw_depots_open"
at_least = 0
at_most = 9

[sub_resource type="Resource" id="Trigger_the_road_is_half_his"]
script = ExtResource("8")
condition = SubResource("Cond_depots_short")

[sub_resource type="Resource" id="Effect_road_ran_half"]
script = ExtResource("11")
flag = &"fw_road_half"
mode = 0
value = 1
note = "The fuel road ran only half east, and the furnace was fought on what we carried in."

[sub_resource type="Resource" id="Spawn_reserve_armour_a"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(18, 10)

[sub_resource type="Resource" id="Spawn_reserve_armour_b"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Effect_reserve_armour"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_reserve_armour_a"), SubResource("Spawn_reserve_armour_b")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "The road behind you is still half mine, Commander — and the fuel you never freed is in these tanks. You will fight this room on what you carried in."

[sub_resource type="Resource" id="Event_the_road_runs_half"]
script = ExtResource("6")
id = &"the_road_runs_half"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_the_road_is_half_his")])
effects = Array[Resource]([SubResource("Effect_road_ran_half"), SubResource("Effect_reserve_armour")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("7")
day = 5

[sub_resource type="Resource" id="Spawn_doorstep_sortie"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(16, 7)

[sub_resource type="Resource" id="Effect_doorstep_sortie"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_doorstep_sortie")])

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("5")
speaker = &"konrad_vale"
text = "I gave up the last mile to stand here with something left to spend. This is the stock I saved, Commander."

[sub_resource type="Resource" id="Event_the_saved_stock"]
script = ExtResource("6")
id = &"the_saved_stock"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_doorstep_sortie")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

