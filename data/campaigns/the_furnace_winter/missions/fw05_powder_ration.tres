[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the crossroads base. It is the only way this army builds anything."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "Vale's garrison held the crossroads past day 8."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay as well."
cell = Vector2i(10, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "The magazine base is dug in, Commander. I ration everything, including how long you get to try."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "HQ, three units, four days. That's the ledger we're working from."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Take the base before the clock rations us out of the fight."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Magazine's ours. Four days, and the accounting closed in our favour."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "A column lost defending nothing. I will revise the ration."

