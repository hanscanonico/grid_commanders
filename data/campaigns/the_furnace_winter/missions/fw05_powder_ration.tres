[sub_resource type="Resource" id="Unlock_granary_burned"]
script = ExtResource("8")
flag = &"fw_granary_saved"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the magazine base — the only base this raid will ever have."
cell = Vector2i(7, 4)

[sub_resource type="Resource" id="Failure_ration"]
script = ExtResource("9")
text = "More than two of ours lost, to any cause. Powder is the ration."
max_losses = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("2")
text = "Take the northern relay before she signs it over."
cell = Vector2i(10, 2)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "The magazine base is dug in, Commander. I ration everything, including your time."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "One HQ, three units, four days. That is all we have."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Take the base before the clock runs out on us."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Magazine's ours. Four days, and we still have a column."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "A column lost defending nothing. I will revise the ration."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Effect_relay_signed_over"]
script = ExtResource("7")
team = 2
cells = Array[Vector2i]([Vector2i(10, 2)])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "The northern relay is mine as of this morning. Take it if you like. You will be taking it from me."

[sub_resource type="Resource" id="Event_the_ration_is_revised"]
script = ExtResource("5")
id = &"the_ration_is_revised"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_relay_signed_over")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("4")
text = "Vance's ration held, and our factories stayed as cold as the ground."

