[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="11"]

[sub_resource type="Resource" id="Objective_hq"]
script = ExtResource("2")
text = "Capture Vance's headquarters."
cell = Vector2i(19, 2)

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Recapture depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Recapture depot 2 of the fuel road."
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("2")
text = "Recapture depot 3 of the fuel road."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once — all seven."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three depots this time, spaced so no single column of yours reaches all three."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "Spread out is not the same as safe. The far depot pays for the middle one, so take the far one first."

[sub_resource type="Resource" id="Line_ward"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Three at once, Quill, which is the longest stretch of the fuel road anyone's tried to open in one week."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "Nine days for three checkpoints. Do not stop to hold what is already taken."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "The crossing is open. That chain was never good odds."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The chain didn't hold. I won't space them the same way twice."

[sub_resource type="Resource" id="Trigger_far_depot_ours"]
script = ExtResource("7")
cell = Vector2i(15, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_middle_depot_still_hers"]
script = ExtResource("7")
cell = Vector2i(10, 3)
holder = 1

[sub_resource type="Resource" id="Effect_the_far_books"]
script = ExtResource("9")
team = 1
amount = 4000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "The far depot's pay chest came with it, and the middle one is still owed. Two garrisons, one payroll, and we are holding the payroll."

[sub_resource type="Resource" id="Event_the_far_depots_books"]
script = ExtResource("6")
id = &"the_far_depots_books"
triggers = Array[Resource]([SubResource("Trigger_far_depot_ours"), SubResource("Trigger_middle_depot_still_hers")])
effects = Array[Resource]([SubResource("Effect_the_far_books")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_near_depot_ours"]
script = ExtResource("7")
cell = Vector2i(5, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_middle_depot_ours"]
script = ExtResource("7")
cell = Vector2i(10, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_with_a_day_in_hand"]
script = ExtResource("8")
day = 8

[sub_resource type="Resource" id="Effect_three_depots_open"]
script = ExtResource("10")
flag = &"fw_depots_open"
mode = 1
value = 3
note = "The ashen crossing was reopened end to end with its depots still working."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "All three depots, both bridges standing. Nobody bet on that."

[sub_resource type="Resource" id="Event_the_ashen_road_runs"]
script = ExtResource("6")
id = &"the_ashen_road_runs"
triggers = Array[Resource]([SubResource("Trigger_near_depot_ours"), SubResource("Trigger_middle_depot_ours"), SubResource("Trigger_far_depot_ours"), SubResource("Trigger_with_a_day_in_hand")])
effects = Array[Resource]([SubResource("Effect_three_depots_open")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Cond_road_four"]
script = ExtResource("11")
flag = &"fw_depots_open"
at_least = 4
at_most = -1

[sub_resource type="Resource" id="Line_holt_road"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Four on the wall at least. Pumps still turning on every one. Whatever you open here has somewhere to send its fuel."
requires = SubResource("Cond_road_four")

[sub_resource type="Resource" id="Line_holt_short"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Tally on the wall's thin. Too much of what we opened came through in pieces. This road has to carry itself."
unless = SubResource("Cond_road_four")

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three depots, spaced so that nothing of yours reaches all three. Nothing did. The spacing stays."

[sub_resource type="Resource" id="Line_defeat_staff"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Three depots on the ashen road, still shut. Longest stretch anyone's tried to open. Longest walk back, too."

[resource]
script = ExtResource("1")
id = &"fw10_ashen_crossing"
title = "Ashen Crossing"
location = "The ashen road, three depots"
map_path = "res://maps/campaign/the_furnace_winter/fw10_ashen_crossing.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"lyra_quill",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hq")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_far_depots_books"), SubResource("Event_the_ashen_road_runs")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_ward"), SubResource("Line_holt_road"), SubResource("Line_holt_short"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_staff")])
