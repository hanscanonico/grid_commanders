[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Retake depot 1 of the fuel road."
cell = Vector2i(5, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Retake depot 2 of the fuel road."
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("2")
text = "Retake depot 3 of the fuel road."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The road stayed closed past day 9."
last_day = 9

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the road at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three depots this time, spaced so no single column of yours reaches all three."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "Spaced doesn't mean safe — the far depot funds the middle one. Break the order, break the funding."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "Nine days for three checkpoints. Don't stop to hold what's already taken."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"lyra_quill"
text = "All three open. The odds on that chain holding were never good."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Every link broken. I will not space them the same way twice."

