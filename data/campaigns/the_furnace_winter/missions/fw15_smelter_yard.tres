[gd_resource type="Resource" script_class="MissionDefinition" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="12"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Vance's forward headquarters."
cell = Vector2i(17, 10)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Hold all three of the yard's bases at once. Starve the smelters."
count = 3
terrain_id = &"base"

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("5")
text = "The foundry kept running past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Hold seven of the district's nine properties at once."
count = 7

[sub_resource type="Resource" id="Bonus_1"]
script = ExtResource("4")
text = "Sit on the spine city for two whole days — the smelters' road in."
cell = Vector2i(9, 10)
days = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "The smelters run day and night, Warden. My second base here is why."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Then the base falls first. Hold ground, starve the smelters."

[sub_resource type="Resource" id="Cond_road_is_ours"]
script = ExtResource("11")
flag = &"fw_depots_open"
at_least = 8
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Most of the fuel road behind us is running our way now. Whatever her smelters burn, they're burning it slower than we can replace ours."
requires = SubResource("Cond_road_is_ours")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "She's fielded more than us since turn one. We out-produce her from what we take."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Smelter yard's ours, headquarters and all. The furnace runs on our schedule now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "My extra base bought time. Not the district."

[sub_resource type="Resource" id="Trigger_spine_city_ours"]
script = ExtResource("8")
cell = Vector2i(9, 10)
holder = 0

[sub_resource type="Resource" id="Spawn_smelter_escort"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(14, 10)

[sub_resource type="Resource" id="Effect_smelter_escort"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_smelter_escort")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "The smelters do not stop because you are standing on the road to them. Clear it."

[sub_resource type="Resource" id="Event_the_smelters_do_not_stop"]
script = ExtResource("7")
id = &"the_smelters_do_not_stop"
triggers = Array[Resource]([SubResource("Trigger_spine_city_ours")])
effects = Array[Resource]([SubResource("Effect_smelter_escort")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"fw15_smelter_yard"
title = "Smelter Yard"
location = "The smelter district"
map_path = "res://maps/campaign/the_furnace_winter/fw15_smelter_yard.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"nia_rowan",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0"), SubResource("Bonus_1")])
events = Array[Resource]([SubResource("Event_the_smelters_do_not_stop")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_6"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The smelters kept running for Vance, and the deadline ran out before we could stop them."
