[sub_resource type="Resource" id="Objective_survive"]
script = ExtResource("2")
text = "Hold out until the relief column is in the yard — day 8."
day = 8

[sub_resource type="Resource" id="Objective_yard"]
script = ExtResource("3")
text = "Keep the smelter yard ours for six whole days."
cell = Vector2i(9, 10)
days = 6

[sub_resource type="Resource" id="Failure_losses"]
script = ExtResource("5")
text = "More than six of ours lost, to any cause. The yard crews can replace machines, not columns."
max_losses = 6

[sub_resource type="Resource" id="Bonus_starve"]
script = ExtResource("4")
text = "Hold all three of the yard's bases at once. Starve the smelters."
count = 3
terrain_id = &"base"

[sub_resource type="Resource" id="Bonus_gun"]
script = ExtResource("12")
text = "Silence the siege gun shelling the approach."
tag = &"siege_gun"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "You're standing in my smelter yard. I have the price of taking it back already written down."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Then your books are wrong. The yard cost us men, and we're not giving it back."

[sub_resource type="Resource" id="Cond_depots_ten"]
script = ExtResource("15")
flag = &"fw_depots_open"
at_least = 8
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Most of the depot road is open behind us. Relief is loaded and moving. We only have to still be here."
requires = SubResource("Cond_depots_ten")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "She'll shell the approach and send her columns in waves. Eight days of it. We dig in and we count."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Relief's in the yard and the smelters still answer to us. Eight days, and the woods behind us never gave her a road in."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "I costed that attack down to the last shell, and the yard didn't move."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Spawn_wave_one_tank"]
script = ExtResource("10")
unit_type = ExtResource("16")
cell = Vector2i(16, 9)

[sub_resource type="Resource" id="Spawn_wave_one_foot"]
script = ExtResource("10")
unit_type = ExtResource("17")
cell = Vector2i(15, 8)

[sub_resource type="Resource" id="Effect_wave_one"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_wave_one_tank"), SubResource("Spawn_wave_one_foot")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "First instalment. The recovery is budgeted in waves."

[sub_resource type="Resource" id="Event_the_first_instalment"]
script = ExtResource("7")
id = &"the_first_instalment"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_wave_one")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("8")
day = 5

[sub_resource type="Resource" id="Spawn_wave_two_tank"]
script = ExtResource("10")
unit_type = ExtResource("16")
cell = Vector2i(16, 7)

[sub_resource type="Resource" id="Effect_wave_two"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_wave_two_tank")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"iona_vance"
text = "Second wave. I can pay for more than you can dig for."

[sub_resource type="Resource" id="Event_the_second_instalment"]
script = ExtResource("7")
id = &"the_second_instalment"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_wave_two")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_day_7"]
script = ExtResource("8")
day = 7

[sub_resource type="Resource" id="Spawn_relief_tank"]
script = ExtResource("10")
unit_type = ExtResource("16")
cell = Vector2i(2, 5)

[sub_resource type="Resource" id="Spawn_relief_mech"]
script = ExtResource("10")
unit_type = ExtResource("18")
cell = Vector2i(2, 6)

[sub_resource type="Resource" id="Effect_relief"]
script = ExtResource("9")
team = 1
units = Array[Resource]([SubResource("Spawn_relief_tank"), SubResource("Spawn_relief_mech")])

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "Lights on the ridge road. The relief column came through the depots. One more day."

[sub_resource type="Resource" id="Event_the_relief_column"]
script = ExtResource("7")
id = &"the_relief_column"
triggers = Array[Resource]([SubResource("Trigger_day_7")])
effects = Array[Resource]([SubResource("Effect_relief")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[sub_resource type="Resource" id="Trigger_gun_down"]
script = ExtResource("13")
tag = &"siege_gun"

[sub_resource type="Resource" id="Effect_siege_broken"]
script = ExtResource("11")
flag = &"fw_siege_broken"
mode = 0
value = 1
note = "Vance's siege gun was silenced in the smelter yard, and her batteries never shelled a road again."

[sub_resource type="Resource" id="Event_line_4"]
script = ExtResource("6")
speaker = &"nia_rowan"
text = "The gun is silent. She can have her shells back."

[sub_resource type="Resource" id="Event_the_gun_falls_silent"]
script = ExtResource("7")
id = &"the_gun_falls_silent"
triggers = Array[Resource]([SubResource("Trigger_gun_down")])
effects = Array[Resource]([SubResource("Effect_siege_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_4")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("6")
text = "The yard went back to Vance, and the smelters fed Vale's furnace all spring."

