[resource]
script = ExtResource("1")
id = &"the_furnace_winter"
title = "The Furnace Winter"
premise = "The continent's foundries and fuel fields ended up on Iron's side of the armistice line. Konrad Vale, now Director of Supply, closes the valves in the coldest year in memory — officially a pricing dispute, enforced by garrisons at every depot."
antagonist = "Konrad Vale, Director of Supply"
missions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19")])
block_titles = Array[String](["The Freeze", "The Depots", "The Furnace"])
block_lengths = Array[int]([6, 6, 6])
