[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold every property the alliance can reach."
count = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "Ferrow and I together are the worst pairing left on this board, Flux. A planner and a raider."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "This is the ridge's last crossing. Past it, the road runs straight to the capital."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Hold the relay, keep his army standing. The bargain was never going to be easy to keep."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Last crossing is ours. Your banner's still flying at the end of the ridge."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "The bargain held through its hardest test, Commander. Whatever the capital holds, we reach it together."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Together. Noted — we'll hold you to it."

