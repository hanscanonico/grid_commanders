[ext_resource type="Script" path="res://core/campaign/effects/defect_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the relay at the ridge's last crossing."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold three towns either side of the last crossing at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "Ferrow and I together are the worst pairing left on this board, Flux. A planner and a raider."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "This is the ridge's last crossing. Past it, the road runs straight to the capital."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Hold the relay, keep his army standing. The bargain was never going to be easy to keep."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Last crossing is ours. Your banner's still flying at the end of the ridge."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "The bargain held through its hardest test, Commander. Whatever the capital holds, we reach it together."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &"orin_flux"
text = "Together. Noted — we'll hold you to it."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Effect_marshal_kept"]
script = ExtResource("9")
flag = &"marshal_kept"
mode = 1
value = 1
note = "One more crossing fought with the marshal's banner still on the field."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Last crossing, Commander, and my army is standing on it with yours. Whatever else the bargain was, it was not words."

[sub_resource type="Resource" id="Event_the_last_crossing"]
script = ExtResource("7")
id = &"the_last_crossing"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_marshal_kept")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Effect_the_outriders_change_banner"]
script = ExtResource("10")
from_team = 4
to_team = 2
tags = Array[StringName]([&"ferrow_outrider_a", &"ferrow_outrider_b"])

[sub_resource type="Resource" id="Effect_alliance_debt"]
script = ExtResource("9")
flag = &"alliance_debt"
value = 1
note = "Two of Ferrow's outriders came back under Draeg's banner, and the bill is still open."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Ferrow's outriders were mine before they were his. They remember which marshal pays on time."

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Two of them, Draeg. Bill me for the difference."

[sub_resource type="Resource" id="Event_the_outriders_remember"]
script = ExtResource("7")
id = &"the_outriders_remember"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_the_outriders_change_banner"), SubResource("Effect_alliance_debt")])
once = true
lines = Array[Resource]([SubResource("Event_line_2"), SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"hc12_the_bargain_kept"
