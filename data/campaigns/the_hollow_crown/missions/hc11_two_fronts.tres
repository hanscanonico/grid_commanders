[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the spur relay while both passes are contested."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Neither of us fights this one alone: keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "Both passes on the spur were still contested past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold three of the spur's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "Orlov and I split the attack across two passes, Quill. Bet you can't answer both."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "I take the western pass. You take the eastern. Neither of us fights this one alone."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"lyra_quill"
text = "Good odds either way — two fronts only work against an alliance that fights like one army."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"lyra_quill"
text = "Both passes held. Two fronts bought them two defeats instead of one."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "We answered as one army. Exactly what they bet against."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Spawn_western_pass"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(5, 10)

[sub_resource type="Resource" id="Effect_orlov_takes_the_west"]
script = ExtResource("9")
team = 4
units = Array[Resource]([SubResource("Spawn_western_pass")])

[sub_resource type="Resource" id="Spawn_eastern_pass"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(15, 10)

[sub_resource type="Resource" id="Effect_morn_takes_the_east"]
script = ExtResource("9")
team = 3
units = Array[Resource]([SubResource("Spawn_eastern_pass")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Western pass is mine, Quill. Morn has the east. Choose one."

[sub_resource type="Resource" id="Event_both_passes_at_once"]
script = ExtResource("7")
id = &"both_passes_at_once"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_orlov_takes_the_west"), SubResource("Effect_morn_takes_the_east")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
