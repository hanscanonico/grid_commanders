[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the relay guarding the eastern pass."
cell = Vector2i(17, 3)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Neither of us fights this one alone: keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold three of the spur's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "Orlov and I split the attack across two passes, Quill, so I'll bet you can't answer both."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "I take the western pass. You take the eastern. Neither of us fights this one alone."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"lyra_quill"
text = "Good odds either way. Splitting into two fronts only works if we fight as two armies instead of one."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"lyra_quill"
text = "Both passes held. Two fronts bought them two defeats instead of one."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "We answered as one army. Exactly what they bet against."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Spawn_western_pass"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(5, 9)

[sub_resource type="Resource" id="Effect_orlov_takes_the_west"]
script = ExtResource("9")
team = 4
units = Array[Resource]([SubResource("Spawn_western_pass")])

[sub_resource type="Resource" id="Spawn_eastern_pass"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(19, 9)

[sub_resource type="Resource" id="Effect_morn_takes_the_east"]
script = ExtResource("9")
team = 3
units = Array[Resource]([SubResource("Spawn_eastern_pass")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Western pass is mine, Quill. Morn has the east. Choose one."

[sub_resource type="Resource" id="Event_both_passes_at_once"]
script = ExtResource("7")
id = &"both_passes_at_once"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_orlov_takes_the_west"), SubResource("Effect_morn_takes_the_east")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("12")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Morn and Orlov have a pass each, for the record. Draeg's taking the west. Quill, the eastern one's on your page."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "One front gave way, Quill. I bet on the seams. The seams paid."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Quill's headquarters fell on the eastern pass, so two fronts get logged as one loss."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "The Concord's column is gone from the spur. Draeg still holds the western pass. Nobody's on his right."
unless = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_ally"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Two passes, two armies. Neither of us fought alone. We lost as two anyway."

[resource]
script = ExtResource("1")
id = &"hc11_two_fronts"
title = "Two Fronts"
location = "The southern spur, both passes contested"
map_path = "res://maps/campaign/the_hollow_crown/hc11_two_fronts.txt"
