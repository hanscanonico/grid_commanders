briefing = Array[String]([
"Morn was never interested in the crown as a title — he wants the war it lets him keep fighting.",
"This is his fortress, built for exactly this siege. Ten days, or he outlasts every claimant left standing.",
"Take his headquarters. Whoever follows the Directorate, it will not be a marshal who wanted the crown hollow."
])
victory = Array[String]([
"Morn's fortress falls, and the crown he wanted hollow has someone willing to fill it.",
"The Hollow Crown ends the way a civil war should — not with a coronation, but with the fighting finally stopping."
])
defeat = "The fortress held, and Morn keeps the only thing he ever actually wanted: a war with no end in sight."
