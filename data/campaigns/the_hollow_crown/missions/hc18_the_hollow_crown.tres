[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="13"]
[ext_resource type="Resource" path="res://data/units/md_tank.tres" id="14"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="15"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture Morn's fortress."
cell = Vector2i(21, 3)

[sub_resource type="Resource" id="Bonus_nine_properties"]
script = ExtResource("3")
text = "Nine of the fortress's properties, ours when it falls."
count = 9

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("3")
text = "Every property in the fortress, ours at once."
count = 12

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "I never wanted the crown, Rook. I wanted the war under it. The ground it lets a man keep taking."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Then you'll lose both. Ten days, this fortress, and it ends."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "You're not fighting for a throne, Rook. You're clearing ground for Draeg to stand on. Ask yourself whose war that makes this."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Fortress falls. The war with no end ends today."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Does it. Ask Draeg what he does with an empty seat before you call this finished."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "We will. The fighting's over. What he does with the quiet is his to answer for."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Effect_crown_hollow"]
script = ExtResource("12")
flag = &"crown_hollow"
value = 1
note = "Draeg's divisions reached the fortress, and nobody gave them the order."

[sub_resource type="Resource" id="Event_line_morn"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Look at what's just arrived, Rook, and tell me again whose war this is."

[sub_resource type="Resource" id="Condition_three_crossings"]
script = ExtResource("6")
flag = &"marshal_kept"
at_least = 0
at_most = 3

[sub_resource type="Resource" id="Trigger_three_crossings"]
script = ExtResource("9")
condition = SubResource("Condition_three_crossings")

[sub_resource type="Resource" id="Spawn_two_divisions_1"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(2, 6)

[sub_resource type="Resource" id="Spawn_two_divisions_2"]
script = ExtResource("11")
unit_type = ExtResource("14")
cell = Vector2i(3, 6)

[sub_resource type="Resource" id="Effect_two_divisions"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_two_divisions_1"), SubResource("Spawn_two_divisions_2")])

[sub_resource type="Resource" id="Event_line_two"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I keep my word, Rook. Two divisions on your flank, and not one of them takes your orders."

[sub_resource type="Resource" id="Event_two_divisions_arrive"]
script = ExtResource("7")
id = &"two_divisions_arrive"
triggers = Array[Resource]([SubResource("Trigger_three_crossings"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_two_divisions"), SubResource("Effect_crown_hollow")])
once = true
lines = Array[Resource]([SubResource("Event_line_two"), SubResource("Event_line_morn")])

[sub_resource type="Resource" id="Condition_every_crossing"]
script = ExtResource("6")
flag = &"marshal_kept"
at_least = 4
at_most = -1

[sub_resource type="Resource" id="Trigger_every_crossing"]
script = ExtResource("9")
condition = SubResource("Condition_every_crossing")

[sub_resource type="Resource" id="Spawn_three_divisions_1"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(2, 6)

[sub_resource type="Resource" id="Spawn_three_divisions_2"]
script = ExtResource("11")
unit_type = ExtResource("14")
cell = Vector2i(3, 6)

[sub_resource type="Resource" id="Spawn_three_divisions_3"]
script = ExtResource("11")
unit_type = ExtResource("15")
cell = Vector2i(2, 7)

[sub_resource type="Resource" id="Effect_three_divisions"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_three_divisions_1"), SubResource("Spawn_three_divisions_2"), SubResource("Spawn_three_divisions_3")])

[sub_resource type="Resource" id="Event_line_three"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Every crossing you carried me over, I'm paying back at once. Three divisions on your flank, and not one of them takes your orders."

[sub_resource type="Resource" id="Event_three_divisions_arrive"]
script = ExtResource("7")
id = &"three_divisions_arrive"
triggers = Array[Resource]([SubResource("Trigger_every_crossing"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_three_divisions"), SubResource("Effect_crown_hollow")])
once = true
lines = Array[Resource]([SubResource("Event_line_three"), SubResource("Event_line_morn")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("6")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Run_day_four"]
script = ExtResource("6")
flag = &"run:day"
at_least = 4
at_most = -1

[sub_resource type="Resource" id="Run_before_day_four"]
script = ExtResource("6")
flag = &"run:day"
at_least = 0
at_most = 3

[sub_resource type="Resource" id="Run_full"]
script = ExtResource("6")
flag = &"run:full"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_par"]
script = ExtResource("6")
flag = &"run:par"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_few_losses"]
script = ExtResource("6")
flag = &"run:losses"
at_least = 0
at_most = 3

[sub_resource type="Resource" id="Run_best"]
script = ExtResource("6")
flag = &"run:best"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Run_first"]
script = ExtResource("6")
flag = &"run:first"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "The fortress stands, Rook. So does the war. I told you which one I wanted."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Our headquarters fell inside the capital. Ten days, this fortress. It didn't end."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "The alliance's last army is gone at the fortress gate. Nobody's left to log it. So I have."
unless = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_two_divisions"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Two divisions on your flank. The fortress still stands. That's on me as much as you."
requires = SubResource("Run_day_four")
unless = SubResource("Condition_every_crossing")

[sub_resource type="Resource" id="Line_defeat_three_divisions"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Three divisions on your flank. The fortress still stands. That's on me as much as you."
requires = SubResource("Condition_every_crossing")
unless = SubResource("Run_before_day_four")

[sub_resource type="Resource" id="Line_victory_losses"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "You barely bled for it. Then it was never a war. It was an appointment."
requires = SubResource("Run_few_losses")

[sub_resource type="Resource" id="Line_victory_full"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Every property in the fortress. You didn't leave me a wall to hold."
requires = SubResource("Run_full")

[sub_resource type="Resource" id="Line_victory_par"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Ten days, Marshal. He said a war with no end."
requires = SubResource("Run_par")

[sub_resource type="Resource" id="Line_victory_best"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Second time through the fortress, better than the first, so I've amended the record."
requires = SubResource("Run_best")
unless = SubResource("Run_first")

