events = Array[Resource]([SubResource("Event_two_divisions_arrive"), SubResource("Event_three_divisions_arrive")])
par_day = 10
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_victory_losses"), SubResource("Line_victory_full"), SubResource("Line_victory_par"), SubResource("Line_victory_best")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout"), SubResource("Line_defeat_two_divisions"), SubResource("Line_defeat_three_divisions")])
