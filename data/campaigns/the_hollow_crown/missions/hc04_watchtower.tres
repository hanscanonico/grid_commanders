[gd_resource type="Resource" script_class="MissionDefinition" load_steps=23 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("4")
text = "Hold all three checkpoints at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Every property on the watchtower road, ours at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "This stretch runs the same as everywhere I'm posted, Commander. Like a ledger."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Three checkpoints, nine days. You won't leave any undefended for a tenth."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "All three checkpoints ours in the same moment. That is the only entry that closes her ledger."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Watchtower road is ours. Her busiest entry, gone."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "For once the numbers favour you. I will remember them."

[sub_resource type="Resource" id="Trigger_middle_checkpoint_ours"]
script = ExtResource("7")
cell = Vector2i(9, 3)
holder = 0

[sub_resource type="Resource" id="Effect_the_strongbox"]
script = ExtResource("8")
team = 1
amount = 4000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The middle post kept the road's takings, Commander. Spend them faster than I collected them."

[sub_resource type="Resource" id="Event_the_middle_checkpoint"]
script = ExtResource("6")
id = &"the_middle_checkpoint"
triggers = Array[Resource]([SubResource("Trigger_middle_checkpoint_ours")])
effects = Array[Resource]([SubResource("Effect_the_strongbox")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_far_checkpoint_ours"]
script = ExtResource("7")
cell = Vector2i(13, 3)
holder = 0

[sub_resource type="Resource" id="Effect_vance_ledger_seized"]
script = ExtResource("9")
flag = &"vance_ledger_seized"
value = 1
note = "Vance's far checkpoint and its books were taken on the watchtower road."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three posts closed in one move, Commander. I am revising my figures downward."

[sub_resource type="Resource" id="Event_the_far_checkpoint"]
script = ExtResource("6")
id = &"the_far_checkpoint"
triggers = Array[Resource]([SubResource("Trigger_far_checkpoint_ours")])
effects = Array[Resource]([SubResource("Effect_vance_ledger_seized")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"hc04_watchtower"
title = "Watchtower"
location = "The high road, Verdant frontier"
map_path = "res://maps/campaign/the_hollow_crown/hc04_watchtower.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"rhea_sol",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_middle_checkpoint"), SubResource("Event_the_far_checkpoint")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Vance's ledger stayed open, and the watchtower road stayed hers."
