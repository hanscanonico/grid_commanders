[gd_resource type="Resource" script_class="MissionDefinition" load_steps=29 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("4")
text = "Hold all three checkpoints at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Every property on the watchtower road, ours at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "I'm posted where the takings are, Sol, and this road takes more than any other on my book."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Three checkpoints, nine days. You won't leave any undefended for a tenth."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "All three checkpoints ours in the same moment, not one taken and then the next while she walks the first one back. I want them on the grid together or not at all."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Watchtower road is ours, post to post. Her busiest entry, gone."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "For once the numbers favour you. I'll remember them."

[sub_resource type="Resource" id="Trigger_middle_checkpoint_ours"]
script = ExtResource("7")
cell = Vector2i(9, 3)
holder = 0

[sub_resource type="Resource" id="Effect_the_strongbox"]
script = ExtResource("8")
team = 1
amount = 4000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "The middle post kept the road's takings, Sol. Spend them faster than I collected them."

[sub_resource type="Resource" id="Event_the_middle_checkpoint"]
script = ExtResource("6")
id = &"the_middle_checkpoint"
triggers = Array[Resource]([SubResource("Trigger_middle_checkpoint_ours")])
effects = Array[Resource]([SubResource("Effect_the_strongbox")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Trigger_far_checkpoint_ours"]
script = ExtResource("7")
cell = Vector2i(13, 3)
holder = 0

[sub_resource type="Resource" id="Effect_vance_ledger_seized"]
script = ExtResource("9")
flag = &"vance_ledger_seized"
value = 1
note = "Vance's far checkpoint and its books were taken on the watchtower road."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three posts closed in one move. I'm revising my figures downward."

[sub_resource type="Resource" id="Event_the_far_checkpoint"]
script = ExtResource("6")
id = &"the_far_checkpoint"
triggers = Array[Resource]([SubResource("Trigger_far_checkpoint_ours")])
effects = Array[Resource]([SubResource("Effect_vance_ledger_seized")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("10")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Sol is the Concord's, on contract. No border of theirs is in this war. Their guns are."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Three posts, still mine. Your contract's on my book now, Sol. Under expenses."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Vance will've entered our headquarters in her book before we'd finished losing it on the watchtower road."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "The Concord's column is gone off the high road. Her ledger closes the season in profit. Ours doesn't open one."
unless = SubResource("Run_hq_taken")

[resource]
script = ExtResource("1")
id = &"hc04_watchtower"
title = "Watchtower"
location = "The high road, Verdant frontier"
map_path = "res://maps/campaign/the_hollow_crown/hc04_watchtower.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"rhea_sol",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_middle_checkpoint"), SubResource("Event_the_far_checkpoint")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_rook"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout")])
