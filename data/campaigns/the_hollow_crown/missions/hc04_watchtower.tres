[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Break the line and take their headquarters."
cell = Vector2i(17, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 9."
last_day = 9

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "This stretch runs the same as everywhere I'm posted, Commander. Like a ledger."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Three checkpoints, nine days. You won't leave any undefended for a tenth."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Take her headquarters and the whole ledger closes at once."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"rhea_sol"
text = "Watchtower road is ours. Her busiest entry, gone."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "For once the accounting favours you. I will remember the figures."

