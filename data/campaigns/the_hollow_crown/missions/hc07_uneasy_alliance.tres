[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The rivals held the field past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property the alliance can reach."
count = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I will not survive the winter without allies, Commander. I suspect neither will you."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Orlov and Morn both want the succession for themselves. That makes this easy, in its way."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Fight beside my army, not around it. The relay on the ridge is worth sharing first."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Relay's ours, and your banner's still flying beside ours."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "An uneasy alliance held its first test. I keep my word, Commander — remember that."

