[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the ridge relay before Draeg's army does it for you."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The rivals held the field past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold three of the ridge road's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I will not survive the winter without allies, Commander. I suspect neither will you."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Orlov and Morn both want the succession for themselves. That makes this easy, in its way."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Fight beside my army, not around it. The relay on the ridge is worth sharing first."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Relay's ours, and your banner's still flying beside ours."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "An uneasy alliance held its first test. I keep my word, Commander — remember that."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_the_left_flank"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(16, 3)

[sub_resource type="Resource" id="Effect_the_left_flank"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_the_left_flank")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "My left flank is yours, Commander. I do not offer it to anyone twice."

[sub_resource type="Resource" id="Event_the_flank_is_offered"]
script = ExtResource("6")
id = &"the_flank_is_offered"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_the_left_flank")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

