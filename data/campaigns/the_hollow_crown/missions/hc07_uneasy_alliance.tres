[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the ridge relay."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold three of the ridge road's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I won't survive the winter alone, Colt, and neither will you."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Orlov and Morn both want the succession. That leaves exactly one marshal we can stand beside."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Fight beside my armour, not around it. Take the ridge relay first and we share it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Relay's ours. Your banner's still up beside it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "It held. I keep my word, Colt, and you'll see the whole of it before the capital."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_the_left_flank"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(16, 3)

[sub_resource type="Resource" id="Effect_the_left_flank"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_the_left_flank")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "My left flank is yours, Colt. I don't offer it twice."

[sub_resource type="Resource" id="Event_the_flank_is_offered"]
script = ExtResource("6")
id = &"the_flank_is_offered"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_the_left_flank")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("11")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted for the record: Orlov and Morn on the far side of the ridge, Draeg on ours. I've filed it as an alliance. Nobody's signed it."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "The ridge relay is mine, Colt. Draeg picked a shoulder to stand at. He picked wrong."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Headquarters fell on the marches. First action of the alliance, first entry on its page. It's a loss."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Colt's column is gone off the ridge. The alliance has one army in it now. His."
unless = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_ally"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "One winter, one ally. That's what I asked for. It didn't last the spring."

