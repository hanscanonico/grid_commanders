[gd_resource type="Resource" script_class="MissionDefinition" load_steps=35 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/ally_survives_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="12"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="13"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="14"]

[sub_resource type="Resource" id="Unlock_column_broken"]
script = ExtResource("7")
flag = &"draeg_column_broken"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold all three cities north of the ridge."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "I commit by the numbers. Ferrow raids for bounty. A strange pairing, but not a weak one."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My column took losses at the last crossing, Commander. I cannot take this fight alone."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Then you won't. I hold, I don't chase — hold the relay, keep his army whole."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Relay holds. Your column's bloodied, but whole."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Orlov's numbers and Ferrow's bounty both came up short against two armies fighting as one. I will not forget it."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("9")
day = 2

[sub_resource type="Resource" id="Effect_marshal_kept"]
script = ExtResource("11")
flag = &"marshal_kept"
mode = 1
value = 1
note = "One more crossing fought with the marshal's banner still on the field."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "What is left of my column is on the ridge road with yours, Commander. Thin, but it is there."

[sub_resource type="Resource" id="Event_the_thin_column_marches"]
script = ExtResource("8")
id = &"the_thin_column_marches"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_marshal_kept")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_column_lead_gone"]
script = ExtResource("10")
tag = &"draeg_column_lead"

[sub_resource type="Resource" id="Spawn_second_company"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(4, 3)

[sub_resource type="Resource" id="Effect_second_company"]
script = ExtResource("12")
team = 1
units = Array[Resource]([SubResource("Spawn_second_company")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "I told you it was thin. Hold the ridge, Commander — I cannot."

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Then I will. Meridian's second company is already on the ridge road."

[sub_resource type="Resource" id="Event_meridian_takes_the_ridge"]
script = ExtResource("8")
id = &"meridian_takes_the_ridge"
triggers = Array[Resource]([SubResource("Trigger_column_lead_gone")])
effects = Array[Resource]([SubResource("Effect_second_company")])
once = true
lines = Array[Resource]([SubResource("Event_line_2"), SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"hc10_broken_column"
title = "Broken Column"
location = "The ridge road, eastern approach"
map_path = "res://maps/campaign/the_hollow_crown/hc10_broken_column.txt"
unlock_requires = SubResource("Unlock_column_broken")
player_team = 1
ai_teams = Array[int]([2, 3, 4])
seats = Array[int]([])
sides = {1: 0, 2: 0, 3: 1, 4: 1}
commanders = {
1: &"mara_voss",
2: &"viktor_draeg",
3: &"cass_orlov",
4: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_thin_column_marches"), SubResource("Event_meridian_takes_the_ridge")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Draeg's column broke on the ridge road, and the alliance lost its first marshal."
