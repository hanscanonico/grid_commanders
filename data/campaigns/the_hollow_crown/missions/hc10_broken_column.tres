[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold every property the alliance can reach."
count = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "I commit by the numbers. Ferrow raids for bounty. A strange pairing, but not a weak one."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My column took losses at the last crossing, Commander. I cannot take this fight alone."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Then you won't. I hold, I don't chase — hold the relay, keep his army whole."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Relay holds. Your column's bloodied, but whole."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Orlov's numbers and Ferrow's bounty both came up short against two armies fighting as one. I will not forget it."

[resource]
script = ExtResource("1")
