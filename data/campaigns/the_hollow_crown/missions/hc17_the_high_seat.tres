[gd_resource type="Resource" script_class="MissionDefinition" load_steps=26 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/end_mission_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the high seat itself."
cell = Vector2i(22, 6)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Every property on the hall's approach, held at once."
count = 13

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "I took the high seat myself, quartermaster. Call it ambition, or call it the last bounty left to find."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Whatever it is, it's the last checkpoint before Morn's own fortress. Convenient, that."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Ferrow armoured this one on borrowed money. Take the towns off him first. You can't pay a raider out of ground he doesn't hold."

[sub_resource type="Resource" id="Line_2b"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "He's spent more holding this seat than the seat has ever been worth, and he's honest enough about it that I half want him to keep it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "High seat's clear of your raiders. The Directorate hall stands open behind us."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "One claimant left, and he doesn't negotiate. Good luck, Holt — you'll want it."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Ferrow wishing me luck is the closest thing to a receipt anybody in this capital's offered me all year."

[sub_resource type="Resource" id="Condition_ledger_empty"]
script = ExtResource("6")
flag = &"ferrow_unpaid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_ledger_empty"]
script = ExtResource("8")
condition = SubResource("Condition_ledger_empty")

[sub_resource type="Resource" id="Trigger_column_spent"]
script = ExtResource("9")
team = 2
bound = 0
count = 5

[sub_resource type="Resource" id="Effect_he_walks_away"]
script = ExtResource("10")
success = true
reason = "Ferrow sold the high seat back rather than die on it."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "I haven't been paid since the customs fort, Holt. Ambition's expensive. There's money in the road out."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Take the road out. I won't stop you. A man dying over an unpaid invoice is bad for everybody's paperwork."

[sub_resource type="Resource" id="Event_money_in_walking_away"]
script = ExtResource("7")
id = &"money_in_walking_away"
triggers = Array[Resource]([SubResource("Trigger_ledger_empty"), SubResource("Trigger_column_spent")])
effects = Array[Resource]([SubResource("Effect_he_walks_away")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"hc17_the_high_seat"
title = "The High Seat"
location = "The Directorate hall, capital interior"
map_path = "res://maps/campaign/the_hollow_crown/hc17_the_high_seat.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_money_in_walking_away")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_2b"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])
defeat = "Ferrow held the high seat, and the last approach to the strongest claimant stayed shut."
