[gd_resource type="Resource" script_class="MissionDefinition" load_steps=23 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take Orlov's command post while the Directorate burns behind it."
cell = Vector2i(19, 3)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold the whole interior road — every property at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "My own column stopped answering the capital mid-battle, Reed. Someone else is giving the orders now."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Whatever's breaking inside the Directorate, it just broke where we could see it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Finish this fight. The next one won't look anything like it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Your line fell. The smoke behind it wasn't ours. Iron's burning its own roads now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "The Directorate is dead. Whatever comes next, it won't be six marshals answering one crown."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Then we'd better learn who's left standing, and fast."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Effect_the_strays_walk_off"]
script = ExtResource("8")
tags = Array[StringName]([&"stray_column_a", &"stray_column_b"])

[sub_resource type="Resource" id="Effect_directorate_fallen"]
script = ExtResource("9")
flag = &"directorate_fallen"
value = 1
note = "The Directorate stopped giving orders, and its marshals stopped taking them."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "That order came from a capital with nobody left in it. My own column has stopped listening. To me as much as to you."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Two of his companies just turned round and walked off the field, Marshal. No orders. Nobody chasing them either."

[sub_resource type="Resource" id="Event_the_column_stops_answering"]
script = ExtResource("6")
id = &"the_column_stops_answering"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_the_strays_walk_off"), SubResource("Effect_directorate_fallen")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
