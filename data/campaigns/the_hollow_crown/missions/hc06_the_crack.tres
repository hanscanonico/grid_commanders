[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Break the line and take their headquarters."
cell = Vector2i(19, 3)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 8."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "My own column stopped answering the capital mid-battle, Reed. Someone else is giving the orders now."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Whatever's breaking inside the Directorate, it just broke where we could see it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Finish this fight. The next one won't look anything like it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Your line fell, and the smoke behind it wasn't ours. Iron's burning its own roads."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "The Directorate is dead. Whatever comes next, it will not be six marshals answering one crown."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"tomas_reed"
text = "Then we'd better learn who's left standing, and fast."

[resource]
