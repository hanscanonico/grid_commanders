[gd_resource type="Resource" script_class="MissionDefinition" load_steps=22 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="8"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the relay where the three provinces meet."
cell = Vector2i(9, 8)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold three of the crossroads towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Vance and I rarely cooperate, Thorne. The crossroads is worth the exception."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Whoever holds that relay holds the shortest road to the capital, and we need it more than they do."

[sub_resource type="Resource" id="Line_2b"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Two marshals who can't stand each other are sharing one road for a week, and I'd wager the payroll on four days."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"ivar_thorne"
text = "Then we take it before their exception becomes permanent."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"ivar_thorne"
text = "Crossroads is ours. Their exception didn't survive contact."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "The road to the capital is shorter now. For us."

[sub_resource type="Resource" id="Trigger_morn_lead_gone"]
script = ExtResource("7")
tag = &"morn_lead"

[sub_resource type="Resource" id="Effect_vance_pulls_her_flank"]
script = ExtResource("8")
tags = Array[StringName]([&"vance_flank"])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Morn's column is spent. I don't spend mine covering a man who wouldn't cover me."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "There it goes. Nobody had to break that alliance for them. They'd brought their own crowbar."

[sub_resource type="Resource" id="Event_the_exception_ends"]
script = ExtResource("6")
id = &"the_exception_ends"
triggers = Array[Resource]([SubResource("Trigger_morn_lead_gone")])
effects = Array[Resource]([SubResource("Effect_vance_pulls_her_flank")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("5")
text = "The crossroads stayed contested, and the shortest road to the capital stayed closed to us."

