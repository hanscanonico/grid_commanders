[gd_resource type="Resource" script_class="MissionDefinition" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the gatehouse. No gate, no regent."
cell = Vector2i(19, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 8."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Own the gatehouse approach entirely: every property at once."
count = 7

[sub_resource type="Resource" id="Bonus_1"]
script = ExtResource("4")
text = "No checkpoint closes behind us: hold all three at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "I styled myself regent the moment the Directorate fell, Wren. This gate is the proof I need."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "Eight days. No checkpoint gets to close behind us. Not this one."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "Three towns strung on an open road, and woods on both sides of it the whole way. We fight from the trees. The road is hers."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"sable_wren"
text = "Gate's ours. Your proof, gone."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Whatever I call myself now, it is not regent. Noted, for my own ledger."

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("8")
day = 3

[sub_resource type="Resource" id="Effect_she_closes_the_middle"]
script = ExtResource("10")
team = 2
cells = Array[Vector2i]([Vector2i(10, 3)])

[sub_resource type="Resource" id="Condition_ledger_seized"]
script = ExtResource("6")
flag = &"vance_ledger_seized"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_ledger_seized"]
script = ExtResource("9")
condition = SubResource("Condition_ledger_seized")

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "You closed three of my entries at the watchtower, Wren. I have opened four more behind you."

[sub_resource type="Resource" id="Event_four_more_entries"]
script = ExtResource("7")
id = &"four_more_entries"
triggers = Array[Resource]([SubResource("Trigger_ledger_seized"), SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_she_closes_the_middle")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Condition_ledger_untouched"]
script = ExtResource("6")
flag = &"vance_ledger_seized"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Trigger_ledger_untouched"]
script = ExtResource("9")
condition = SubResource("Condition_ledger_untouched")

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "Every checkpoint on this road is an entry in my book, Wren. You are welcome to audit it."

[sub_resource type="Resource" id="Event_audit_it_then"]
script = ExtResource("7")
id = &"audit_it_then"
triggers = Array[Resource]([SubResource("Trigger_ledger_untouched"), SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_she_closes_the_middle")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"hc15_the_regents_gate"
title = "The Regent's Gate"
location = "The gatehouse, capital outskirts"
map_path = "res://maps/campaign/the_hollow_crown/hc15_the_regents_gate.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"sable_wren",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0"), SubResource("Bonus_1")])
events = Array[Resource]([SubResource("Event_four_more_entries"), SubResource("Event_audit_it_then")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The gate held, and Vance's claim held with it — one gatehouse short of the whole city."
