[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="10"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="11"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the crossing post Orlov committed to."
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Leave Orlov nothing on this line — every property at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "I don't probe, quartermaster. I commit. This crossing is committed to."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "No tricks up your sleeve, then. Almost restful, fighting a man who plays it straight."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Orlov hits the wounded hardest. Apart from our own base, those two towns on the road are the only place we can repair. Nothing of ours stays in the open below half."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Above half he's only a determined man on a straight road, and I'll take that trade every day of the week."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "The line broke exactly where the numbers said it would, once the numbers were ours."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "Withdrawn, no ceremony. I'll be back with better numbers."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "He will, and he'll write ahead to tell us so, which is the only part of him I've never had to guess at."

[sub_resource type="Resource" id="Trigger_eastern_crossing_ours"]
script = ExtResource("7")
cell = Vector2i(12, 3)
holder = 0

[sub_resource type="Resource" id="Spawn_the_reserve"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(16, 4)

[sub_resource type="Resource" id="Effect_the_reserve"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_the_reserve")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "You have the eastern crossing. I committed to this ground, Holt. I don't un-commit."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "I know. That's why we took the eastern crossing first. A man who can't back out is a man you can plan around."

[sub_resource type="Resource" id="Event_he_does_not_un_commit"]
script = ExtResource("6")
id = &"he_does_not_un_commit"
triggers = Array[Resource]([SubResource("Trigger_eastern_crossing_ours")])
effects = Array[Resource]([SubResource("Effect_the_reserve")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("11")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "For the record, he sent word of this crossing three days before he reached it. Orlov's never once had to lie about a line of march."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "Committed. Held. The crossing's mine because I said it would be, Holt."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Holt's headquarters fell to a man who'd announced he was coming, which I've logged without comment."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "The southern column's off the books. He committed. We didn't match it."
unless = SubResource("Run_hq_taken")

[resource]
script = ExtResource("1")
id = &"hc02_river_line"
