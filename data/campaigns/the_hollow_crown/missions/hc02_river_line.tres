[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Orlov committed to this crossing. Take the ground he committed it to."
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Own both banks — every property on the river line at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "I don't probe, quartermaster. I commit. This crossing is committed to."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "No tricks up your sleeve, then. Almost restful, fighting a man who plays it straight."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Orlov hits hardest at the wounded, and those two towns on the road are the only place we mend. Nothing of ours stays out in the open below half."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Line broke exactly where the numbers said it would — once the numbers were ours."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "Withdrawn, no ceremony. I will be back with better numbers."

[sub_resource type="Resource" id="Trigger_eastern_crossing_ours"]
script = ExtResource("7")
cell = Vector2i(11, 3)
holder = 0

[sub_resource type="Resource" id="Spawn_the_reserve"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(16, 4)

[sub_resource type="Resource" id="Effect_the_reserve"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_the_reserve")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "You have the eastern crossing. I committed to this ground, Holt. I do not un-commit."

[sub_resource type="Resource" id="Event_he_does_not_un_commit"]
script = ExtResource("6")
id = &"he_does_not_un_commit"
triggers = Array[Resource]([SubResource("Trigger_eastern_crossing_ours")])
effects = Array[Resource]([SubResource("Effect_the_reserve")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"hc02_river_line"
title = "River Line"
location = "The Verdant frontier, southern reach"
map_path = "res://maps/campaign/the_hollow_crown/hc02_river_line.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_he_does_not_un_commit")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
