location = "The Verdant frontier, southern reach"
map_path = "res://maps/campaign/the_hollow_crown/hc02_river_line.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_he_does_not_un_commit")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_rook"), SubResource("Line_3"), SubResource("Line_3b")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout")])
