[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Push Morn's column back and take the crossing post."
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Own the whole crossing — every property at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Every spring I test this line, Rook, and this year I brought more than a probing column."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted for the record. Officially the Directorate still stands. Nobody at this crossing thinks it will for long."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "One road, two towns, woods on both sides. He's a shade better than us on every square, so take the ones he isn't standing on yet."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Column withdrew in good order. No rout, no panic. He'll be back on this road before autumn."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "It does. Enjoy the quiet, Rook. It won't last the year."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("10")
day = 4

[sub_resource type="Resource" id="Spawn_the_road_behind"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(14, 2)

[sub_resource type="Resource" id="Effect_the_road_behind"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_the_road_behind")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "I told you: more than a probing column. The rest of it is on the road behind me."

[sub_resource type="Resource" id="Event_the_rest_of_the_column"]
script = ExtResource("6")
id = &"the_rest_of_the_column"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_road_behind")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_vanguard_gone"]
script = ExtResource("7")
tag = &"morn_vanguard"

[sub_resource type="Resource" id="Effect_morn_bloodied"]
script = ExtResource("8")
flag = &"morn_bloodied"
value = 1
note = "Morn's vanguard was broken at the spring crossing."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "My armour, in a morning. Next year I take what I want off this border without asking first."

[sub_resource type="Resource" id="Event_the_vanguard_breaks"]
script = ExtResource("6")
id = &"the_vanguard_breaks"
triggers = Array[Resource]([SubResource("Trigger_vanguard_gone")])
effects = Array[Resource]([SubResource("Effect_morn_bloodied")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("5")
text = "Morn's column crossed and dug in, and the spring test just became a permanent fixture."

