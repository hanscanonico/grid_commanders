[gd_resource type="Resource" script_class="MissionDefinition" load_steps=20 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="8"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Break the line and take their headquarters."
cell = Vector2i(15, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 10."
last_day = 10

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "The line gets tested every spring, Commander. This year I brought more than a probing column."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted for the record. The Directorate still stands, officially — nobody at this crossing believes it will for long."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Hold the line. Push him back east of the crossing."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Column withdrew in good order. For Morn, that counts as a warning shot answered."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "It does. Enjoy the quiet, Commander — it is not going to last."

[sub_resource type="Resource" id="Trigger_vanguard_gone"]
script = ExtResource("7")
tag = &"morn_vanguard"

[sub_resource type="Resource" id="Effect_morn_bloodied"]
script = ExtResource("8")
flag = &"morn_bloodied"
value = 1
note = "Morn's vanguard was broken at the spring crossing."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "My armour, in a morning. Whatever I take from this border next year, Commander, I will not be asking for it first."

[sub_resource type="Resource" id="Event_the_vanguard_breaks"]
script = ExtResource("6")
id = &"the_vanguard_breaks"
triggers = Array[Resource]([SubResource("Trigger_vanguard_gone")])
effects = Array[Resource]([SubResource("Effect_morn_bloodied")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"hc01_border_skirmish"
title = "Border Skirmish"
location = "The Meridian-Iron line, north crossing"
map_path = "res://maps/campaign/the_hollow_crown/hc01_border_skirmish.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"cassian_rook",
2: &"radek_morn"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_vanguard_breaks")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Morn's column crossed and dug in, and the spring test just became a permanent fixture."
