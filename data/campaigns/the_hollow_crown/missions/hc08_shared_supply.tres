[gd_resource type="Resource" script_class="MissionDefinition" load_steps=34 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/ally_survives_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="12"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold any three of the ridge road's cities at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "I want this depot for the bounty. Vance wants it for the ledger. Either way, you lose it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My column is thinner than I let on, Commander. Losing me loses the alliance with it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"sera_lark"
text = "Then we hold the relay and keep his army in the field. Both, not either."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"sera_lark"
text = "Depot road's shared, and your banner's still standing at the end of it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Ferrow and Vance retreat to lick two very different wounds. I do not forget who stood with me here."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Effect_marshal_kept"]
script = ExtResource("10")
flag = &"marshal_kept"
mode = 1
value = 1
note = "One more crossing fought with the marshal's banner still on the field."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "The depot road is yours as far as the fork, Commander. What I have left is holding the other half of it."

[sub_resource type="Resource" id="Event_the_road_is_shared"]
script = ExtResource("7")
id = &"the_road_is_shared"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_marshal_kept")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_outrider_gone"]
script = ExtResource("9")
tag = &"draeg_outrider"

[sub_resource type="Resource" id="Effect_draeg_column_broken"]
script = ExtResource("10")
flag = &"draeg_column_broken"
value = 1
note = "Draeg's outrider was lost on the depot road, and his column showed how thin it is."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "That was my outrider. I told you the column was thin, Commander — now you have seen how thin."

[sub_resource type="Resource" id="Event_how_thin_the_column_is"]
script = ExtResource("7")
id = &"how_thin_the_column_is"
triggers = Array[Resource]([SubResource("Trigger_outrider_gone")])
effects = Array[Resource]([SubResource("Effect_draeg_column_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Cost_of_the_depot_road"]
script = ExtResource("12")
text = "The depot road was fought for company by company."
max_losses = 0

[sub_resource type="Resource" id="Trigger_the_road_cost_us"]
script = ExtResource("11")
objective = SubResource("Cost_of_the_depot_road")

[sub_resource type="Resource" id="Event_line_3"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "That is one company neither of us gets back, Commander. Mine is the half of the road with nothing left behind it."

[sub_resource type="Resource" id="Event_the_road_cost_us"]
script = ExtResource("7")
id = &"the_road_cost_us"
triggers = Array[Resource]([SubResource("Trigger_the_road_cost_us")])
effects = Array[Resource]([SubResource("Effect_draeg_column_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_3")])

[resource]
script = ExtResource("1")
id = &"hc08_shared_supply"
title = "Shared Supply"
location = "The depot road behind the ridge"
map_path = "res://maps/campaign/the_hollow_crown/hc08_shared_supply.txt"
player_team = 1
ai_teams = Array[int]([2, 3, 4])
seats = Array[int]([])
sides = {1: 0, 2: 0, 3: 1, 4: 1}
commanders = {
1: &"sera_lark",
2: &"viktor_draeg",
3: &"dane_ferrow",
4: &"iona_vance"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([SubResource("Failure_0")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_road_is_shared"), SubResource("Event_the_road_cost_us"), SubResource("Event_how_thin_the_column_is")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "Draeg's army broke, and the alliance broke with it before the depot road was ever decided."
