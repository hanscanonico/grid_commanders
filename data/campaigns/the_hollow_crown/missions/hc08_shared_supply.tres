[gd_resource type="Resource" script_class="MissionDefinition" load_steps=35 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/ally_survives_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="12"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the depot relay at the northern fork."
cell = Vector2i(8, 6)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold three of the depot road's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "I want this depot for the bounty. Vance wants it for the ledger. Either way, you lose it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My column's thinner than I let on, Lark. Lose me, you lose the alliance. I'd rather you knew now."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"sera_lark"
text = "Then we do both. Hold the relay, keep his army in the field. We've got the legs for it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"sera_lark"
text = "Depot road's shared, and your banner's still standing at the end of it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Ferrow rides off short a bounty. Vance short a ledger entry. I don't forget who held this road with me."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Effect_marshal_kept"]
script = ExtResource("10")
flag = &"marshal_kept"
mode = 1
value = 1
note = "One more crossing fought with the marshal's banner still on the field."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "The depot road is yours as far as the fork. Past it the road is mine, and what I have left is holding it."

[sub_resource type="Resource" id="Event_the_road_is_shared"]
script = ExtResource("7")
id = &"the_road_is_shared"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_marshal_kept")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_relay_taken"]
script = ExtResource("9")
objective = SubResource("Objective_0")

[sub_resource type="Resource" id="Trigger_inside_five_days"]
script = ExtResource("11")
day = 5

[sub_resource type="Resource" id="Effect_draeg_column_broken"]
script = ExtResource("10")
flag = &"draeg_column_broken"
value = 1
note = "The relay fell inside five days, and it was Draeg's column that spent the crossing holding every other yard of the ridge."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Five days to the relay. My column bought them holding the rest of the ridge, and there isn't much of it left."

[sub_resource type="Resource" id="Event_how_thin_the_column_is"]
script = ExtResource("7")
id = &"how_thin_the_column_is"
triggers = Array[Resource]([SubResource("Trigger_relay_taken"), SubResource("Trigger_inside_five_days")])
effects = Array[Resource]([SubResource("Effect_draeg_column_broken")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("12")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Ferrow and Vance, for the record, at the same depot for two different reasons. Draeg's column is thinner than the ledger says. So is ours."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Depot's mine, bounty's paid. Vance can have the paperwork, Lark."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "The depot road headquarters fell, so I've logged it against the alliance, which was a column short already."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Lark's column is gone from the depot road. Draeg holds the fork alone. That lasts about a day."
unless = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_ally"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "I told you it was thin, Lark, so look at what's standing beside it now: nothing."

[resource]
script = ExtResource("1")
id = &"hc08_shared_supply"
title = "Shared Supply"
location = "The depot road behind the ridge"
map_path = "res://maps/campaign/the_hollow_crown/hc08_shared_supply.txt"
player_team = 1
ai_teams = Array[int]([2, 3, 4])
seats = Array[int]([])
sides = {1: 0, 2: 0, 3: 1, 4: 1}
commanders = {
1: &"sera_lark",
2: &"viktor_draeg",
3: &"dane_ferrow",
4: &"iona_vance"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0"), SubResource("Objective_1")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_road_is_shared"), SubResource("Event_how_thin_the_column_is")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_rook"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout"), SubResource("Line_defeat_ally")])
