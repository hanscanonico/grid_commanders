[gd_resource type="Resource" script_class="MissionDefinition" load_steps=28 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the wall relay — the last garrison outside the capital."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold three of the outer wall's towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"iona_vance"
text = "My ledger and his bounty book both close here, Warden. The outer wall is the last garrison before the throne room."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I fight beside you for the wall itself. Whoever holds it holds the last approach."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"nia_rowan"
text = "Take the relay. Nothing left behind this wall but the crown."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"nia_rowan"
text = "Outer wall's ours. Both ledger and bounty book close for good."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "Nothing stands between us and the throne room now, Commander. I have not forgotten what I said at the ridge."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Condition_ledger_intact"]
script = ExtResource("6")
flag = &"ferrow_unpaid"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Trigger_ledger_intact"]
script = ExtResource("9")
condition = SubResource("Condition_ledger_intact")

[sub_resource type="Resource" id="Effect_the_paychest_leaves"]
script = ExtResource("10")
tags = Array[StringName]([&"ferrow_paychest_wall"])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Vance can have the wall. I'll take the receipts and the road out."

[sub_resource type="Resource" id="Event_he_takes_the_receipts"]
script = ExtResource("7")
id = &"he_takes_the_receipts"
triggers = Array[Resource]([SubResource("Trigger_ledger_intact"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_paychest_leaves")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Condition_ledger_empty"]
script = ExtResource("6")
flag = &"ferrow_unpaid"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_ledger_empty"]
script = ExtResource("9")
condition = SubResource("Condition_ledger_empty")

[sub_resource type="Resource" id="Effect_the_whole_purse_leaves"]
script = ExtResource("10")
tags = Array[StringName]([&"ferrow_paychest_wall", &"ferrow_purse"])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "You emptied my ledger at the customs fort, Commander. I am not fighting a second season for free."

[sub_resource type="Resource" id="Event_no_second_season_for_free"]
script = ExtResource("7")
id = &"no_second_season_for_free"
triggers = Array[Resource]([SubResource("Trigger_ledger_empty"), SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_whole_purse_leaves")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
