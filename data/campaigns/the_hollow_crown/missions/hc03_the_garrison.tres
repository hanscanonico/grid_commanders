[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Break the line and take their headquarters."
cell = Vector2i(17, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 9."
last_day = 9

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "I'm not here for the post, Calder. I'm paid per column I break, and yours is standing right there."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "Then we cost you more than we're worth. Nine days before your paymaster expects results."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "Take his headquarters. Deny him the results entirely."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "Garrison holds. Your paymaster gets nothing for the season."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Empty ledger. That's the only defeat I understand — and I understand it fine."

