[gd_resource type="Resource" script_class="MissionDefinition" load_steps=27 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the customs fort."
cell = Vector2i(17, 1)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Leave the border post nothing unflagged: every property at once."
count = 6

[sub_resource type="Resource" id="Bonus_1"]
script = ExtResource("6")
text = "Take the season's take off him."
tag = &"ferrow_paychest"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "I'm not here for the post, Calder. I'm paid per column I break, and yours is standing right there."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "Then we cost you more than we're worth. Nine days before your paymaster expects results."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "He's paid for what he breaks, and nothing he fields is armoured. Cheap units forward, in the woods. He can't afford to trade with us."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"ines_calder"
text = "Garrison holds. Your paymaster gets nothing for the season."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Empty ledger. That's the only defeat I understand. I understand it fine."

[sub_resource type="Resource" id="Trigger_paychest_gone"]
script = ExtResource("8")
tag = &"ferrow_paychest"

[sub_resource type="Resource" id="Effect_ferrow_unpaid"]
script = ExtResource("9")
flag = &"ferrow_unpaid"
value = 1
note = "Ferrow's season went unpaid at the customs fort."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "That was the season's take, Calder. You've just made this unprofitable and personal at once."

[sub_resource type="Resource" id="Event_the_paychest_burns"]
script = ExtResource("7")
id = &"the_paychest_burns"
triggers = Array[Resource]([SubResource("Trigger_paychest_gone")])
effects = Array[Resource]([SubResource("Effect_ferrow_unpaid")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("10")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "One note for the file, Calder. His paymaster counts by the column, so a column that isn't broken is money he never sees."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Bounty collected, Calder. The fort's a bonus. I'll be gone before your paymaster hears about either."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "The customs fort's headquarters changed hands for the price of a raid, which is what I've logged it as."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Calder's column, broken and invoiced. Ferrow's paymaster settles up this week."
unless = SubResource("Run_hq_taken")

[resource]
script = ExtResource("1")
id = &"hc03_the_garrison"
title = "The Garrison"
location = "Aurora border post, the old customs fort"
map_path = "res://maps/campaign/the_hollow_crown/hc03_the_garrison.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"ines_calder",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0"), SubResource("Bonus_1")])
events = Array[Resource]([SubResource("Event_the_paychest_burns")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_rook"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout")])
