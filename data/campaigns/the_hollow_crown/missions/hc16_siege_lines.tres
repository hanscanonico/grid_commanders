[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the contested relay for the alliance."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("3")
text = "Keep the marshal's army in the field."
team = 2

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("4")
text = "The rivals held the field past day 9."
last_day = 9

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold every property the alliance can reach."
count = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Ferrow and I dug siege lines around the capital itself, Ward. Each of us hoping to starve the other's claim, and yours with it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My army is what stands between those lines closing. Keep me in the field, Commander."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"alina_ward"
text = "We take the relay. That breaks the siege from the inside."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"alina_ward"
text = "Siege lines are broken. Your banner still flies at the centre of them."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Orlov and Ferrow starved nothing but their own claims. This is the last I ask of you, Commander — the rest of the capital is mine to finish."

[resource]
script = ExtResource("1")
