[gd_resource type="Resource" script_class="MissionDefinition" load_steps=27 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/protect_unit_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Hold the relay through two days of the siege closing."
cell = Vector2i(10, 4)
days = 2

[sub_resource type="Resource" id="Failure_1"]
script = ExtResource("3")
text = "Marshal Draeg fell before the siege was broken."
tag = &"marshal_draeg"

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("5")
text = "Hold three of the siege works' towns at once."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Ferrow and I have dug siege lines around the capital, Ward. Each of us means to starve out the other's claim, and yours with it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "My army is what stands between those lines closing. Keep me in the field, Ward."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"alina_ward"
text = "We take the relay and hold it two days. That breaks the ring from the inside, and it takes every arm we have."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &"alina_ward"
text = "Siege lines are broken. Your banner still flies at the centre of them."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "Orlov and Ferrow starved nothing but their own claims. That's the last I ask of you, Ward. The rest of the capital is mine to finish."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Effect_marshal_kept"]
script = ExtResource("10")
flag = &"marshal_kept"
mode = 1
value = 1
note = "One more crossing fought with the marshal's banner still on the field."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("6")
speaker = &"viktor_draeg"
text = "I'm inside the ring with you, not behind it. Say that much when the other marshals ask."

[sub_resource type="Resource" id="Event_inside_the_ring"]
script = ExtResource("7")
id = &"inside_the_ring"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_marshal_kept")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("8")
day = 5

[sub_resource type="Resource" id="Effect_ferrow_takes_the_west"]
script = ExtResource("9")
team = 4
cells = Array[Vector2i]([Vector2i(3, 11)])

[sub_resource type="Resource" id="Effect_orlov_takes_the_east"]
script = ExtResource("9")
team = 3
cells = Array[Vector2i]([Vector2i(17, 11)])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "The lines close today, Ward. Ferrow has the west, I have the east, and nothing walks between them."

[sub_resource type="Resource" id="Event_the_lines_close"]
script = ExtResource("7")
id = &"the_lines_close"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_ferrow_takes_the_west"), SubResource("Effect_orlov_takes_the_east")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"hc16_siege_lines"
title = "Siege Lines"
location = "The capital's siege works"
map_path = "res://maps/campaign/the_hollow_crown/hc16_siege_lines.txt"
player_team = 1
ai_teams = Array[int]([2, 3, 4])
seats = Array[int]([])
sides = {1: 0, 2: 0, 3: 1, 4: 1}
commanders = {
1: &"alina_ward",
2: &"viktor_draeg",
3: &"cass_orlov",
4: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([SubResource("Failure_1")])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_inside_the_ring"), SubResource("Event_the_lines_close")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The siege lines held, and the capital starved under a claim that was never ours to break."
