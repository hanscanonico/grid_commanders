[ext_resource type="Resource" path="res://data/units/mech.tres" id="13"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Take the roadhead. The capital road opens the moment it falls."
cell = Vector2i(19, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Every property on the capital road, ours at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "I dug in across the capital road itself, Ash. Last obstacle before the walls."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "Your numbers are honest, same as ever. Ours have to be better today."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "From up here it is one road and three towns, Commander, with nothing to hide behind but those woods. He will gather on the road, so do not meet him on it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "Road's open. Your honest numbers weren't honest enough."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "No. They were not. The walls are yours to look at now, Commander — make of that what you will."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Condition_column_whole"]
script = ExtResource("6")
flag = &"draeg_column_broken"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Trigger_column_whole"]
script = ExtResource("9")
condition = SubResource("Condition_column_whole")

[sub_resource type="Resource" id="Spawn_two_companies_1"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(1, 3)

[sub_resource type="Resource" id="Spawn_two_companies_2"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(1, 6)

[sub_resource type="Resource" id="Effect_two_companies"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_two_companies_1"), SubResource("Spawn_two_companies_2")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I said we reach the capital together. Two of mine are on your right, Commander, and not one of them under your orders."

[sub_resource type="Resource" id="Event_the_marshal_pays_up"]
script = ExtResource("7")
id = &"the_marshal_pays_up"
triggers = Array[Resource]([SubResource("Trigger_column_whole"), SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_two_companies")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Condition_column_broken"]
script = ExtResource("6")
flag = &"draeg_column_broken"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_column_broken"]
script = ExtResource("9")
condition = SubResource("Condition_column_broken")

[sub_resource type="Resource" id="Spawn_one_company"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(1, 3)

[sub_resource type="Resource" id="Effect_one_company"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_one_company")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "One company is what the ridge left me. It is still yours."

[sub_resource type="Resource" id="Event_what_the_ridge_left_him"]
script = ExtResource("7")
id = &"what_the_ridge_left_him"
triggers = Array[Resource]([SubResource("Trigger_column_broken"), SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_one_company")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

