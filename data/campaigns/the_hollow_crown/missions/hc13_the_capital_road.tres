[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="12"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="13"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Capture the roadhead on the capital road."
cell = Vector2i(19, 4)

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Every property on the capital road, ours at once."
count = 12

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "I dug in across the capital road itself, Ash. Last obstacle before the walls."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "Your numbers are honest, same as ever. Ours have to be better today."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "From up here it's one road and three towns, with nothing on either side of it to hide behind but those woods. He'll gather on the road, so don't meet him on it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"perrin_ash"
text = "Road's open. Your honest numbers weren't."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "No. They weren't. The walls are yours to look at from here."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("8")
day = 2

[sub_resource type="Resource" id="Condition_column_whole"]
script = ExtResource("6")
flag = &"draeg_column_broken"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Trigger_column_whole"]
script = ExtResource("9")
condition = SubResource("Condition_column_whole")

[sub_resource type="Resource" id="Spawn_two_companies_1"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(1, 3)

[sub_resource type="Resource" id="Spawn_two_companies_2"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(1, 6)

[sub_resource type="Resource" id="Effect_two_companies"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_two_companies_1"), SubResource("Spawn_two_companies_2")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "I said we reach the capital together. Two of mine are on your right, Ash, and not one of them takes your orders."

[sub_resource type="Resource" id="Event_the_marshal_pays_up"]
script = ExtResource("7")
id = &"the_marshal_pays_up"
triggers = Array[Resource]([SubResource("Trigger_column_whole"), SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_two_companies")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Condition_column_broken"]
script = ExtResource("6")
flag = &"draeg_column_broken"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_column_broken"]
script = ExtResource("9")
condition = SubResource("Condition_column_broken")

[sub_resource type="Resource" id="Spawn_one_company"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(1, 3)

[sub_resource type="Resource" id="Effect_one_company"]
script = ExtResource("10")
team = 1
units = Array[Resource]([SubResource("Spawn_one_company")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("5")
speaker = &"viktor_draeg"
text = "One company is what the ridge left me. It's still yours."

[sub_resource type="Resource" id="Event_what_the_ridge_left_him"]
script = ExtResource("7")
id = &"what_the_ridge_left_him"
triggers = Array[Resource]([SubResource("Trigger_column_broken"), SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_one_company")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_hq_taken"]
script = ExtResource("6")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_rook"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Noted for the record: Orlov filed his position on the capital road in writing. He's honest. Read it anyway."

[sub_resource type="Resource" id="Line_defeat_foe"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "The road stays shut, Ash. My numbers were honest. They were also better."

[sub_resource type="Resource" id="Line_defeat_hq"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Ash's headquarters fell short of the capital road, logged at the same distance from the walls we started at."
requires = SubResource("Run_hq_taken")

[sub_resource type="Resource" id="Line_defeat_rout"]
script = ExtResource("5")
speaker = &"cassian_rook"
text = "Aurora's column is gone off the capital road. Draeg's companies went with it. For the record, he sent them."
unless = SubResource("Run_hq_taken")

[resource]
script = ExtResource("1")
id = &"hc13_the_capital_road"
title = "The Capital Road"
location = "The last open road to the capital"
map_path = "res://maps/campaign/the_hollow_crown/hc13_the_capital_road.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"perrin_ash",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_0")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_0")])
events = Array[Resource]([SubResource("Event_the_marshal_pays_up"), SubResource("Event_what_the_ridge_left_him")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_rook"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_foe"), SubResource("Line_defeat_hq"), SubResource("Line_defeat_rout")])
