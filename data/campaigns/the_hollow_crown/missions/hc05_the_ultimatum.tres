[sub_resource type="Resource" id="Unlock_unbloodied"]
script = ExtResource("6")
flag = &"morn_bloodied"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Answer the ultimatum: take Morn's command post on the crossing."
cell = Vector2i(19, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "Morn's command post stood past day 8, the ultimatum unanswered."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Answer him completely — every property on the crossing at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "I sent an ultimatum this time, Marr. Surrender the crossing or I take it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "Eight days to answer you with force instead of a courier."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "No coast on this crossing, Commander. Three towns strung on one road and nowhere to come in from the flank — we win it straight or not at all."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "Ultimatum answered itself the moment his headquarters fell."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Withdrawn. Quieter than I arrived — something else needs my attention now."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Spawn_the_deadline_1"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(18, 2)

[sub_resource type="Resource" id="Effect_the_deadline"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_the_deadline_1")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Half your eight days are spent, Marr, and my terms have not improved with keeping."

[sub_resource type="Resource" id="Event_the_terms_expire"]
script = ExtResource("7")
id = &"the_terms_expire"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_deadline")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
