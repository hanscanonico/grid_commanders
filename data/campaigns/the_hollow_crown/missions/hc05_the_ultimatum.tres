[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2")
text = "Break the line and take their headquarters."
cell = Vector2i(19, 2)

[sub_resource type="Resource" id="Failure_0"]
script = ExtResource("3")
text = "The line held past day 8."
last_day = 8

[sub_resource type="Resource" id="Bonus_0"]
script = ExtResource("4")
text = "Hold every property on the board at once."
count = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "I sent an ultimatum this time, Marr. Surrender the crossing or I take it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "Eight days to answer you with force instead of a courier."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "Take his headquarters. That's the only answer he respects."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"halden_marr"
text = "Ultimatum answered itself the moment his headquarters fell."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"radek_morn"
text = "Withdrawn. Quieter than I arrived — something else needs my attention now."

