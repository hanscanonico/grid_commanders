[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=13 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Bloodied"]
script = ExtResource("3")
flag = &"morn_bloodied"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Unbloodied"]
script = ExtResource("3")
flag = &"morn_bloodied"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "The Directorate had run the Iron Dominion for forty years. It took eleven days to fall apart, and no two border capitals agree on which of those days it died."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
text = "Reed's staff logged the hour it reached the border. Two Iron companies turned round mid-battle and walked off a field they were still winning. Nobody in the capital had told them to. There was nobody left in the capital to tell them."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"cassian_rook"
text = "Six marshals, six armies, no crown left for any of them to answer to, and every border we're holding now borders a different war."

[sub_resource type="Resource" id="Line_3b"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Five of them are on a border. Vale's in the supply office, working out which claimant can pay him."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"radek_morn"
text = "I came out of the spring a column lighter, so whatever I take from you next, I won't be asking first."
requires = SubResource("Bloodied")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2")
speaker = &"radek_morn"
text = "I came out of the spring with everything I marched in with. My ultimatum answered itself. We've both had the practice now."
requires = SubResource("Unbloodied")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2")
speaker = &"viktor_draeg"
text = "There's one marshal at your border who doesn't want the throne. I want the winter, and somebody to survive it beside. I'll be in touch."

[resource]
script = ExtResource("1")
after_block = 0
title = "The Crack"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_3b"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])
