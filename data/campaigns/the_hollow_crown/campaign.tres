[resource]
script = ExtResource("1")
id = &"the_hollow_crown"
title = "The Hollow Crown"
premise = "The Directorate falls, and the Iron Dominion's six marshals do not agree on who follows it. For the three border nations this is a civil war with tank divisions spilling over every frontier — and surviving it means making sure the right marshal wins."
antagonist = "The rival marshals of the Iron Dominion"
missions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19")])
block_titles = Array[String](["The Crack", "The Bargain", "The Crown"])
block_lengths = Array[int]([6, 6, 6])
