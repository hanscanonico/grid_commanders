[gd_resource type="Resource" script_class="CampaignInterlude" load_steps=19 format=3]

[ext_resource type="Script" path="res://core/campaign/campaign_interlude.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="3"]

[sub_resource type="Resource" id="Line"]
script = ExtResource("2")
speaker = &""
text = "Aldmoor stood. Vance took her army back across the Tamsin in good order, and Morn's battery went with her. Nobody in the city forgot the square it had fired on."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &""
text = "Meridian counted its autumn: a harbour kept, a river given up a day at a time, a road to Hollin, three airfields, and most of the men who held them."

[sub_resource type="Resource" id="Cond_ff_convoys"]
script = ExtResource("3")
flag = &"ff_convoys"
at_least = 3
at_most = -1

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Three carriers went down the Hollin road and three came back empty, which is the right way round, and Hollin marched for Aldmoor on what was in them."
requires = SubResource("Cond_ff_convoys")

[sub_resource type="Resource" id="Cond_ff_convoys_2"]
script = ExtResource("3")
flag = &"ff_convoys"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Two of my three carriers made Hollin. Enough to send their garrison to the capital. I still think about the third."
requires = SubResource("Cond_ff_convoys_2")

[sub_resource type="Resource" id="Cond_ff_convoys_3"]
script = ExtResource("3")
flag = &"ff_convoys"
at_least = 0
at_most = 1

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Hollin got less from me than it needed and kept its garrison at home. I've stopped telling people I'm good at logistics; it was starting to sound like a boast and then like a confession."
requires = SubResource("Cond_ff_convoys_3")

[sub_resource type="Resource" id="Cond_ff_capital_ring"]
script = ExtResource("3")
flag = &"ff_capital_ring"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2")
speaker = &"mara_voss"
text = "The Old Town was ours when the siege broke. Every ward in Aldmoor knows it, and so does Vance."
requires = SubResource("Cond_ff_capital_ring")

[sub_resource type="Resource" id="Cond_ff_capital_ring_2"]
script = ExtResource("3")
flag = &"ff_capital_ring"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2")
speaker = &"mara_voss"
text = "Iron had the Old Town when the siege broke. We'll rebuild it after the war, when there's something to rebuild it with."
requires = SubResource("Cond_ff_capital_ring_2")

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("2")
speaker = &"iris_colt"
text = "Alina's in Kharn. Nia's in the Thornwood, Sera's in Aurora, Viktor's in Iron with a tank that still flies our pennant. I'm going to collect them."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("2")
speaker = &"mara_voss"
text = "Take Holt. He's wasted on a marshal who can count."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("2")
speaker = &""
text = "In the second week of winter, Iris Colt left Aldmoor with a quartermaster, a signed letter from the Marshal of Meridian, and one flag of five."

[resource]
script = ExtResource("1")
after_block = 1
title = "One Flag of Five"
lines = Array[Resource]([SubResource("Line"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9"), SubResource("Line_10")])
