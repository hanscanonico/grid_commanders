[sub_resource type="Resource" id="Line_1"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "The mill bridge, an hour before dawn. My informant was punctual."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Off the road, into the trees, and keep the car moving."

[sub_resource type="Resource" id="Event_the_punctual_informant"]
