[sub_resource type="Resource" id="Line_3"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "Second column in from the east edge. Drive them onto the river. Hold them there till I come."

[sub_resource type="Resource" id="Event_the_east_column"]
script = ExtResource("12")
id = &"the_east_column"
triggers = Array[Resource]([SubResource("DayReached_1")])
