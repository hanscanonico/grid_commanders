[sub_resource type="Resource" id="SetOwner_1"]
script = ExtResource("15")
team = 1
cells = Array[Vector2i]([Vector2i(18, 1)])

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Greywater's opened its gate. The delegates are inside."

[sub_resource type="Resource" id="Event_greywater_opens"]
script = ExtResource("12")
id = &"greywater_opens"
triggers = Array[Resource]([SubResource("UnitReached_2")])
effects = Array[Resource]([SubResource("SetOwner_1")])
once = true
lines = Array[Resource]([SubResource("Line_4")])

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("11")
text = "The Thornwood. The League delegates who escaped Thorne's council are meeting at Greywater, and one armoured car is carrying all of them."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("11")
speaker = &"sable_wren"
text = "I've arranged your route, Captain. The north bridge is burned, so it's the drovers' road through the trees and over the mill bridge. Thorne's scouts haven't used it in a year."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "The car stays on the road. My rangers don't need one. We walk beside it and we don't shoot unless we're seen."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "Traitors in a tin box, driving through my forest in the dark. Find it. Nobody goes home."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "His huntmaster's tank is out there somewhere. If it finds us, it doesn't leave."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "The road's clear and the delegates are through to Greywater. They'll vote by morning."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("11")
speaker = &"sable_wren"
text = "Well done, Captain. Thorne must have had scouts of his own on the drovers' road. He's always been thorough."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Must have. Tell Colonel Colt the rangers march with her to Greenhollow, and I'll pick our roads myself from now on."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "The car's burning on the road, and your council with it."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "One armoured car, eleven delegates, a whole government. I'd have sent two cars. Nobody asks the quartermaster."

