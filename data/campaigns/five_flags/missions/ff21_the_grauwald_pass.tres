[sub_resource type="Resource" id="Line_21"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "South battery's ours, and so is its shell store. I've marked it down as fifteen hundred in salvage."

[sub_resource type="Resource" id="Event_22"]
