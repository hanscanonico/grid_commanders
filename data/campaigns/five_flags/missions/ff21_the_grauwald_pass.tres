[sub_resource type="Resource" id="Line_17"]
script = ExtResource("8")
speaker = &"iona_vance"
text = "North battery lost. The saddle is the whole position now, so the reserve goes up behind it. Both tanks and the gun."

[sub_resource type="Resource" id="Event_18"]
