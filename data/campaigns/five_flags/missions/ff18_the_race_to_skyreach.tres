once = true
lines = Array[Resource]([SubResource("Line_7")])

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("5")
text = "The Aurora highlands. Four signal relays tell the Compact what is coming over its borders, and Iron wants Aurora blind before it comes."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "Two of them, Major Lark. That's all I need. Two relays and Skyreach can't see past its own gate."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Then I need four, and I'm faster than he is, so everybody go, go now, and don't stop for anything that isn't a relay."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Recon can't capture, but a recon sitting on a relay means nobody else can either, so park them there and bring the rifles up behind."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Rook won't commit Aurora until the relays are his again, so win this one fast, Sera."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "All four relays are ours, Skyreach can see every road into Aurora, and I'd like it noted that I got here first."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("5")
speaker = &"iris_colt"
text = "Noted. Orlov wanted this country blind, which means Iron's coming soon."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "A good run, Major, and I'll be in the hills when you tire."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("5")
speaker = &"cass_orlov"
text = "Two relays out, and Aurora's looking at a blank screen. I'll tell Draeg the road's open. He'll want to know tonight."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Four relays, two roads, and Sera Lark came second. I've checked the report twice. It still says second."

