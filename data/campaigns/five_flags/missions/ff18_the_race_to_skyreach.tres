[sub_resource type="Resource" id="Line_7"]
script = ExtResource("5")
speaker = &"sera_lark"
text = "Aster's up and talking, Skyreach says thanks and sends money, which is the nicest thing Skyreach has ever said to me."

[sub_resource type="Resource" id="Event_the_first_relay_sings"]
