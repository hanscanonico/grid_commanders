[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("2")
flag = &"ff_mint_page"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_2"]
script = ExtResource("2")
flag = &"ff_cipher_read"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Objective_3"]
script = ExtResource("3")
text = "Destroy Sable Wren's command tank."
tag = &"sable_wren_command"

[sub_resource type="Resource" id="Objective_4"]
script = ExtResource("4")
text = "Capture the listening station."
cell = Vector2i(14, 2)

[sub_resource type="Resource" id="Objective_5"]
script = ExtResource("3")
text = "Destroy the picket cruiser."
tag = &"sable_picket"

[sub_resource type="Resource" id="Trigger_6"]
script = ExtResource("5")
day = 3

[sub_resource type="Resource" id="Effect_7"]
script = ExtResource("6")
team = 2
points = 12000

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "Her whole net just went off the air at once. Twelve sets, same second. She's saving her breath for something, so keep the recons out of the tree line until we see what."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "You taught half my operators, Orin. You should know what quiet means."

[sub_resource type="Resource" id="Event_the_net_goes_quiet"]
script = ExtResource("8")
id = &"the_net_goes_quiet"
triggers = Array[Resource]([SubResource("Trigger_6")])
effects = Array[Resource]([SubResource("Effect_7")])
once = true
lines = Array[Resource]([SubResource("Line_8"), SubResource("Line_9")])

[sub_resource type="Resource" id="Trigger_10"]
script = ExtResource("9")
cell = Vector2i(14, 2)
holder = 0

[sub_resource type="Resource" id="Effect_11"]
script = ExtResource("6")
team = 1
points = 11000

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "Station's ours, and her codebook was still on the desk. Every set in that lagoon is reporting to me now. Give me a turn and I'll fill her channels with static."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "Keep the codebook. I wrote it for readers like you."

[sub_resource type="Resource" id="Event_the_station_talks"]
script = ExtResource("8")
id = &"the_station_talks"
triggers = Array[Resource]([SubResource("Trigger_10")])
effects = Array[Resource]([SubResource("Effect_11")])
once = true
lines = Array[Resource]([SubResource("Line_12"), SubResource("Line_13")])

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("7")
text = "The Concord's outer islands. Mangrove and palm to the waterline, reefs between them, and Sable Wren somewhere under all of it."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "Draeg's proof reached Skyreach last night. Rook read it twice, then sent me. My recons see further than hers, and in this country that's the only edge we get."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "I read WREN off a Concord cipher at Skyreach and let Iris talk me out of it, which is a mistake a spymaster gets to make once."
requires = SubResource("Cond_2")

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "We never broke her cipher. Draeg had to hand us her name at the border fort, and I'm the spymaster who didn't have it first."
unless = SubResource("Cond_2")

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "I've carried one scorched page from Aurum Ford since the Mint. A payment line, initialled W. I'd like it back in her hand before a court."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "Orin. Aurora's spymaster, up to his knees in a lagoon, after one tired major. Rook must be very angry with somebody."

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "Her command tank's in the south-east woods, by her headquarters. Take the tank and we take her. The listening station on the headland is hers as well, and I want it."

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "Command tank's burning. Wren walked out of it on her own, asked me for a pencil, and she's in the back of my car now writing something down."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "Lyra's models gave the mainland nine years before the big war and two million dead in it. We bought a small one instead, on our terms, and I gave the order at the Hall myself. Run the numbers again and I'd give it again."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("7")
speaker = &"orin_flux"
text = "She's sure. That's the worst of it. Iris wants to ask about the Hall herself, and I've told her to expect exactly that answer."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "You looked where I wanted you to look, Orin. You always did. Go home and tell Rook the reefs are closed."

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Wren's still loose in the islands with the Hall on her conscience, or wherever she keeps it. I'll log the fuel and the hulls we left on the reefs."

