[sub_resource type="Resource" id="Line_29"]
script = ExtResource("8")
speaker = &"rhea_sol"
text = "Chancellor, this is Sol. Three of my batteries are behind your gate, laid on the eastern yards. Anything of Morn's that comes up those streets is mine."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "Thank you, General. You were not in my model. I am glad of it."

