[sub_resource type="Resource" id="Line_43"]
script = ExtResource("8")
speaker = &"radek_morn"
text = "One road over the water. A Chancellor standing at the end of it. The Hammer is loaded."

[sub_resource type="Resource" id="Line_44"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "All units, disperse. Nobody stands within two streets of anyone else. He fires at crowds."

[sub_resource type="Resource" id="Event_the_hammer_turns"]
script = ExtResource("9")
id = &"the_hammer_turns"
triggers = Array[Resource]([SubResource("Trigger_37")])
effects = Array[Resource]([SubResource("Effect_38"), SubResource("Effect_42")])
once = true
lines = Array[Resource]([SubResource("Line_43"), SubResource("Line_44")])

[sub_resource type="Resource" id="Line_45"]
script = ExtResource("8")
text = "The Aurum causeway is one road over the water between the city and the mainland, and half of Aurum is already on it, on foot, in carts and in the backs of army trucks."

[sub_resource type="Resource" id="Line_46"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "All Concord units. We hold the east end of the causeway until the city is across. Every convoy that reaches the mainland is one number in this war I can still change."

[sub_resource type="Resource" id="Line_47"]
script = ExtResource("8")
speaker = &"iris_colt"
text = "Quill, this is Colt. We're on the mainland end. Your people can come over, and nobody with a gun crosses behind them. That includes you."

[sub_resource type="Resource" id="Line_48"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "Understood, General. I had not planned to cross."

[sub_resource type="Resource" id="Line_49"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Rhea Sol's gunners are on their way down from the hills, Lyra, and she was careful not to say it was for you."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_50"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Rhea's guns are still dug in on the hills, pointed where you told her to point them, and they won't turn round in time to help anyone."
requires = SubResource("Cond_2")

[sub_resource type="Resource" id="Line_51"]
script = ExtResource("8")
speaker = &"radek_morn"
text = "Chancellor. You lent me a gun, and now you want to stand in front of it. I respect a creditor who comes to collect in person."

[sub_resource type="Resource" id="Line_52"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "Eight days. Aurum is across, or as much of it as reached the bridge. What is left of the Concord's army is standing at this gate."

[sub_resource type="Resource" id="Line_53"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "Every convoy crossed. I will not pretend that balances anything."
requires = SubResource("Cond_3")

[sub_resource type="Resource" id="Line_54"]
script = ExtResource("8")
speaker = &"lyra_quill"
text = "Most of the convoys never reached the bridge. I have their manifests, and I will read every name on them."
requires = SubResource("Cond_4")

[sub_resource type="Resource" id="Line_55"]
script = ExtResource("8")
speaker = &"iris_colt"
text = "Morn's pulling his vanguard back to the east yards. You held, Quill. I'll say that once."

[sub_resource type="Resource" id="Line_56"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "We march on Iron in the morning, Lyra. You'll ride with us, where we can see you."

[sub_resource type="Resource" id="Line_57"]
script = ExtResource("8")
speaker = &"radek_morn"
text = "The bridge is mine, Chancellor, and everyone still on it. Your arithmetic was always going to end at my gun."

[sub_resource type="Resource" id="Line_58"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "Morn has Aurum's end of the causeway. I've got a list of convoys that crossed, and a longer one of those that didn't."

