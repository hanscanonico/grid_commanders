[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("2")
flag = &"ff_nia_fought"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="ReachCell_1"]
script = ExtResource("3")
text = "Move the delegates' car to Greywater."
cells = Array[Vector2i]([Vector2i(21, 4), Vector2i(20, 4), Vector2i(21, 3), Vector2i(20, 3), Vector2i(21, 5)])
count = 1
tag = &"delegates"

[sub_resource type="Resource" id="ProtectUnit_1"]
script = ExtResource("4")
text = "The delegates' car is destroyed."
tag = &"delegates"

[sub_resource type="Resource" id="CaptureCell_1"]
script = ExtResource("5")
text = "Capture Nia's lodge."
cell = Vector2i(9, 3)

[sub_resource type="Resource" id="DayReached_1"]
script = ExtResource("6")
day = 3

[sub_resource type="Resource" id="Spawn_1"]
script = ExtResource("8")
unit_type = ExtResource("7")
cell = Vector2i(14, 8)

[sub_resource type="Resource" id="Spawn_2"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(16, 3)

[sub_resource type="Resource" id="SpawnUnits_1"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_1"), SubResource("Spawn_2")])

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "More of mine in the eastern trees, so let the car come to them."

[sub_resource type="Resource" id="Event_the_hunters_close"]
script = ExtResource("12")
id = &"the_hunters_close"
triggers = Array[Resource]([SubResource("DayReached_1")])
effects = Array[Resource]([SubResource("SpawnUnits_1")])
once = true
lines = Array[Resource]([SubResource("Line_1")])

[sub_resource type="Resource" id="UnitReached_1"]
script = ExtResource("13")
tag = &"delegates"
cells = Array[Vector2i]([Vector2i(10, 5), Vector2i(11, 5), Vector2i(12, 5)])

[sub_resource type="Resource" id="GrantCharge_1"]
script = ExtResource("14")
team = 2
points = 18000

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "You shot my people at the shrine, Iris. Two of them grew up in these woods."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "I know their names. Let the car through and nobody else has to die out here."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Thorne says the same thing about you."

[sub_resource type="Resource" id="Event_the_bridge"]
script = ExtResource("12")
id = &"the_bridge"
triggers = Array[Resource]([SubResource("UnitReached_1")])
effects = Array[Resource]([SubResource("GrantCharge_1")])
once = true
lines = Array[Resource]([SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])

[sub_resource type="Resource" id="ForceStrength_1"]
script = ExtResource("15")
team = 2
bound = 0
count = 2

[sub_resource type="Resource" id="RemoveUnits_1"]
script = ExtResource("16")
tags = Array[StringName]([&"nia_r1", &"nia_r2", &"nia_r3", &"nia_r4", &"nia_r5", &"nia_r6", &"nia_r7", &"nia_r8"])

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Enough. Rangers, off the road and home."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "I'm not doing this for you. Thorne hangs councillors, and you've never hanged anybody."

[sub_resource type="Resource" id="Event_nia_calls_off_the_hunt"]
script = ExtResource("12")
id = &"nia_calls_off_the_hunt"
triggers = Array[Resource]([SubResource("ForceStrength_1")])
effects = Array[Resource]([SubResource("RemoveUnits_1")])
once = true
lines = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("11")
text = "The Thornwood. Eleven League delegates who escaped Thorne's council are riding one armoured car to a secret meeting at Greywater."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "Thorne gave the woods to Nia Rowan, and after the shrine she said yes."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "You're on my road, Iris. Every tree between you and Greywater has a ranger behind it, and I know which ones."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "The car can't ford the Grey and there's only the one bridge. Recon out front, infantry in the trees, and nobody chases her into the woods alone."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "Bring me the car, Rowan. What's inside it is the League's whole disloyalty in one tin box."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "The road to Greywater's clear, and Nia's standing on it behind the car with her rifle slung."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Don't thank me. I counted what I've got left, and I'd rather lose it to you than feed it to Thorne."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "Then walk with us to Greenhollow and hate me the whole way there."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "I will."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "The car's in the ditch. I'm sorry for the delegates. I'm not sorry about the shrine."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "Eleven delegates, one car, and Nia Rowan waiting on the only road through the Thornwood, so next time I'm sending a letter and keeping the car."

