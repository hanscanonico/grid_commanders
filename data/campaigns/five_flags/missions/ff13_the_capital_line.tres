triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_hammer_loaded")])
once = true
lines = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])

