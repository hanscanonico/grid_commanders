[sub_resource type="Resource" id="Line"]
script = ExtResource("13")
speaker = &"gideon_holt"
text = "Hollin's garrison, on the west road. Fed, shod and armed out of my trucks, and they'd like everyone to know it."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "South ward. Tell them the marshal said thank you, and tell them she only says it once."

[sub_resource type="Resource" id="Event_hollin_marches"]
script = ExtResource("14")
id = &"hollin_marches"
triggers = Array[Resource]([SubResource("Trigger_convoys_through"), SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_spawn")])
once = true
lines = Array[Resource]([SubResource("Line"), SubResource("Line_2")])

[sub_resource type="Resource" id="Cond_ff_convoys_2"]
script = ExtResource("5")
flag = &"ff_convoys"
at_least = 0
at_most = 1

[sub_resource type="Resource" id="Trigger_convoys_short"]
script = ExtResource("6")
condition = SubResource("Cond_ff_convoys_2")

[sub_resource type="Resource" id="Trigger_day_3b"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Effect_hollin_purse"]
script = ExtResource("15")
team = 1
amount = 2000

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("13")
speaker = &"gideon_holt"
text = "Nothing from Hollin but a purse and an apology. They've barely enough to hold their own walls, and I know whose trucks didn't get there."

[sub_resource type="Resource" id="Event_hollin_keeps"]
script = ExtResource("14")
id = &"hollin_keeps"
triggers = Array[Resource]([SubResource("Trigger_convoys_short"), SubResource("Trigger_day_3b")])
effects = Array[Resource]([SubResource("Effect_hollin_purse")])
once = true
lines = Array[Resource]([SubResource("Line_3")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("7")
day = 5

[sub_resource type="Resource" id="Effect_hammer_loaded"]
script = ExtResource("16")
team = 3
points = 24000

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("13")
speaker = &"radek_morn"
text = "The Hammer is loaded. Clear the square."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("13")
speaker = &"iona_vance"
text = "Marshal Morn, I have men in every square you can see from up there."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("13")
speaker = &"radek_morn"
text = "Then they will be remembered."

[sub_resource type="Resource" id="Event_hammerfall"]
