[sub_resource type="Resource" id="Effect_reveal_siege"]
script = ExtResource("18")
objective_id = &"siege_hq"

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("13")
speaker = &"halden_marr"
text = "Marines ashore behind the Iron camp. Tide was kind. Her headquarters is in the town on the highway, Marshal, facing the wrong way."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "You knock on the back, Admiral. We'll knock on the front. Everything at the Old Town, forward."

[sub_resource type="Resource" id="Event_marr_lands"]
script = ExtResource("14")
id = &"marr_lands"
triggers = Array[Resource]([SubResource("Trigger_day_7")])
effects = Array[Resource]([SubResource("Effect_spawn_2"), SubResource("Effect_reveal_siege")])
once = true
lines = Array[Resource]([SubResource("Line_7"), SubResource("Line_8")])

[sub_resource type="Resource" id="Trigger_day_last"]
script = ExtResource("7")
day = 10

[sub_resource type="Resource" id="Trigger_old_town_ours"]
script = ExtResource("19")
cell = Vector2i(7, 7)
holder = 0

[sub_resource type="Resource" id="Effect_ring"]
script = ExtResource("20")
flag = &"ff_capital_ring"
mode = 0
value = 1
note = "Aldmoor's Old Town was still Meridian's when the siege broke."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "Ten days, and the Old Town is still ours."

[sub_resource type="Resource" id="Event_capital_ring"]
script = ExtResource("14")
id = &"capital_ring"
triggers = Array[Resource]([SubResource("Trigger_day_last"), SubResource("Trigger_old_town_ours")])
effects = Array[Resource]([SubResource("Effect_ring")])
once = true
lines = Array[Resource]([SubResource("Line_9")])

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("13")
speaker = &""
text = "Aldmoor, capital of Meridian. Everything the Tamsin and the Hollin road bought comes due here: Vance's whole army on the highway, and on the southern heights, a battery nobody in Meridian has seen fire."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "Hold the city ten days. By then the fleet's in position, and Vance finds out what's behind her."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("13")
speaker = &"iris_colt"
text = "What's on the heights?"

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "Radek Morn. I served under him once. Don't bunch up where his gun can see."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("13")
speaker = &"iona_vance"
text = "Mara. The arithmetic says four days. I'll give you six for old times, and then I stop counting."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "If the Old Town goes, the ring breaks, and then everything else in this city burns with it."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("13")
speaker = &"iona_vance"
text = "Marines in my camp and the timetable in pieces. I'm withdrawing, Mara. It isn't a defeat, and you know that better than anyone."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("13")
speaker = &"cass_orlov"
text = "A broadcast for the soldiers of the Ninth. Your general, Alina Ward, is alive and well in Kharn. Come and collect her."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("13")
speaker = &"iris_colt"
text = "She's alive."

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "I've watched you hold my city with a brigade that doesn't exist. The Ninth, then. Go and get your five flags back."

[sub_resource type="Resource" id="Cond_ff_capital_ring"]
script = ExtResource("5")
flag = &"ff_capital_ring"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("13")
speaker = &"mara_voss"
text = "And Colonel, the ring held. Tell the others that too."
requires = SubResource("Cond_ff_capital_ring")

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("13")
speaker = &"iona_vance"
text = "Aldmoor has fallen. I'm sorry, Mara; I did tell you four days."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("13")
speaker = &"gideon_holt"
text = "The capital's gone and the government's in a lorry on the west road. I'm driving it. I've counted the passengers twice."

