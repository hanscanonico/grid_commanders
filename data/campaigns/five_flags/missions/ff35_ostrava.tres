[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("1")
text = "Destroy Orlov's command car."
tag = &"orlov_command"

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("2")
text = "Capture the Kasern barracks."
cell = Vector2i(4, 2)

[sub_resource type="Resource" id="Objective_3"]
script = ExtResource("2")
text = "Capture the radio house."
cell = Vector2i(14, 2)

[sub_resource type="Resource" id="Cond_4"]
