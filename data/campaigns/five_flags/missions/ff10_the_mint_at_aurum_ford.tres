[gd_resource type="Resource" script_class="MissionDefinition" load_steps=48 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_owner_effect.gd" id="11"]

[sub_resource type="Resource" id="Gate"]
script = ExtResource("2")
flag = &"ff_gold_found"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Objective_house"]
script = ExtResource("3")
text = "Capture the counting house."
cell = Vector2i(8, 3)

[sub_resource type="Resource" id="Bonus_vault"]
script = ExtResource("3")
text = "Capture the bullion vault."
cell = Vector2i(8, 2)

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("4")
day = 2

[sub_resource type="Resource" id="Effect_toll"]
script = ExtResource("5")
team = 2
amount = 2000

[sub_resource type="Resource" id="Line"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Everything that crosses my bridge pays, Major. Your tanks included. Particularly your tanks."

[sub_resource type="Resource" id="Event_bridge_toll"]
script = ExtResource("7")
id = &"bridge_toll"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_toll")])
once = true
lines = Array[Resource]([SubResource("Line")])

[sub_resource type="Resource" id="Trigger_house_ours"]
script = ExtResource("8")
cell = Vector2i(8, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_before_burn"]
script = ExtResource("9")
day = 5

[sub_resource type="Resource" id="Effect_page"]
script = ExtResource("10")
flag = &"ff_mint_page"
mode = 0
value = 1
note = "The counting house at Aurum Ford was taken before its ledgers burned."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The grate's still warm but they were slow. I've got one page out whole. Payments, dated, and a set of initials in the margin."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "Bag it, Quartermaster. I'll read it on the way home."

[sub_resource type="Resource" id="Event_the_page"]
script = ExtResource("7")
id = &"the_page"
triggers = Array[Resource]([SubResource("Trigger_house_ours"), SubResource("Trigger_before_burn")])
effects = Array[Resource]([SubResource("Effect_page")])
once = true
lines = Array[Resource]([SubResource("Line_2"), SubResource("Line_3")])

[sub_resource type="Resource" id="Trigger_burn_day"]
script = ExtResource("4")
day = 6

[sub_resource type="Resource" id="Trigger_house_theirs"]
script = ExtResource("8")
cell = Vector2i(8, 3)
holder = 1

[sub_resource type="Resource" id="Effect_house_burned"]
script = ExtResource("11")
team = 0
cells = Array[Vector2i]([Vector2i(8, 3)])

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("6")
speaker = &""
text = "Smoke from the counting-house chimney, then from its windows. Ferrow's clerks walk out of the back door with empty hands."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "They're burning the books. Someone told them we were coming."

[sub_resource type="Resource" id="Event_the_ledgers_burn"]
script = ExtResource("7")
id = &"the_ledgers_burn"
triggers = Array[Resource]([SubResource("Trigger_burn_day"), SubResource("Trigger_house_theirs")])
effects = Array[Resource]([SubResource("Effect_house_burned")])
once = true
lines = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("6")
speaker = &""
text = "Aurum Ford, in the Seam. The coin from Garrow's strongbox was new, and Holt has spent a month following it."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Every coin in that box went through one exchange house. Here. It's Concord property, rented to a privateer, and it keeps books."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "Then we'll borrow the books. Ferrow's men will burn them the moment they see us, so let's not be seen crossing."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The river's shallow enough to walk. The bridge isn't, if you're a tank, and he's got a gun on it."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Major Wren. I was told the Ninth might come. I wasn't told it would be you."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "Keep to the trees along the bank, go straight for the house, and leave the town to whoever wants it."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Keep the building, Major. It was only ever rented."

[sub_resource type="Resource" id="Cond_ff_mint_page"]
script = ExtResource("2")
flag = &"ff_mint_page"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "One page, scorched at the edge. A payment to Ferrow's company, and the approval initialled 'W.'"
requires = SubResource("Cond_ff_mint_page")

[sub_resource type="Resource" id="Cond_ff_mint_page_2"]
script = ExtResource("2")
flag = &"ff_mint_page"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "W. Half the Concord signs with a W, Quartermaster. I'll make enquiries."
requires = SubResource("Cond_ff_mint_page_2")

[sub_resource type="Resource" id="Cond_ff_mint_page_3"]
script = ExtResource("2")
flag = &"ff_mint_page"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Nothing in the grate but ash and the brass corners off the ledgers. Somebody had the matches out before we reached the river, and I'd like to know who told them to."
requires = SubResource("Cond_ff_mint_page_3")

[sub_resource type="Resource" id="Cond_ff_mint_page_4"]
script = ExtResource("2")
flag = &"ff_mint_page"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("6")
speaker = &"sable_wren"
text = "They knew the hour we'd cross. I'll find out how."
requires = SubResource("Cond_ff_mint_page_4")

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("6")
speaker = &"dane_ferrow"
text = "Nothing to read here, Major. Go home."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "We came for a book and got a river crossing. I'll keep following the coin. It'll turn up somewhere it shouldn't."

[resource]
script = ExtResource("1")
