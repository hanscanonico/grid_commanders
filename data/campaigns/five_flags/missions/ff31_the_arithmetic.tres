[sub_resource type="Resource" id="Line_7"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "Every gun in the lower city now fires at maximum. I would prefer not to spend lives proving a result I already have, General. You are forcing me to."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Keep coming. She can roll all the sixes she likes; the gate doesn't move."

