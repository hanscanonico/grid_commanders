[sub_resource type="Resource" id="Effect_26"]
script = ExtResource("14")
objective_id = &"morn_vanguard"

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("7")
text = "A white light over the south sea, and then the inner citadel is gone, guard and tower and all."

[sub_resource type="Resource" id="Line_28"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "Aurum. Your Chancellor lent me the money for that gun. This is the first repayment. My vanguard is on your beach."

[sub_resource type="Resource" id="Line_29"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "All Concord units, this is the Chancellor. The arithmetic has changed. You are under General Colt's command, effective now."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Morn's landing on the south beach. Everybody who was shooting at us a minute ago, turn around and face the sea."

[sub_resource type="Resource" id="Event_hammerfall_on_aurum"]
script = ExtResource("8")
id = &"hammerfall_on_aurum"
triggers = Array[Resource]([SubResource("Trigger_9")])
effects = Array[Resource]([SubResource("Effect_10"), SubResource("Effect_11"), SubResource("Effect_25"), SubResource("Effect_26")])
once = true
lines = Array[Resource]([SubResource("Line_27"), SubResource("Line_28"), SubResource("Line_29"), SubResource("Line_30")])

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Lyra Quill's citadel. Cliffs all round, one gate in the west wall, her army in the lower city in front of it. We take the gate and the Concord has nowhere left to stand."

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "General Colt. I have modelled this afternoon four hundred times. In most of them you reach my gate. In none of them does it change the arithmetic."

[sub_resource type="Resource" id="Line_33"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Colt, it's Sol. My batteries are limbered on the ridge and laid on nothing. Nobody on those walls is mine."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_34"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Orin's picking up Iron traffic from somewhere past the south sea. Nobody knows whose. I've filed it under things to worry about later, which is getting to be a thick file."

[sub_resource type="Resource" id="Line_35"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Then she can watch us reach it. Guns forward to cover the approach, armour on the road, and nobody stops in the open under those walls."

[sub_resource type="Resource" id="Line_36"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Morn's vanguard is wreckage on the beach. He's still out there with his gun, but he doesn't have Aurum."

[sub_resource type="Resource" id="Line_37"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "General Colt. I burned the Lantern Hall: Sable gave the order because I gave it to her. I paid Ferrow, and I lent Konrad Vale the money for the foundries that built the gun which has just fired on my own city."

[sub_resource type="Resource" id="Line_38"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "My models gave the mainland nine years before a war nobody chose, and two million dead in it. So I chose a small one, and a Settlement after it: every nation's debt in my vaults and every army capped by contract. None of the models had a variable for Radek Morn."

[sub_resource type="Resource" id="Line_39"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Get them moving. Then you and I are going to talk about the Hall, and it's going to take a long time."

[sub_resource type="Resource" id="Line_40"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "The citadel stands, General, exactly as the model said it would, and I take no pleasure in having been right about a thing that cost this many lives."

[sub_resource type="Resource" id="Line_41"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Iris is back behind the lower city, Aurum's gate is still shut, and I've moved everything in the file marked later into the file marked now."

[sub_resource type="Resource" id="Line_34b"]
script = ExtResource("7")
speaker = &"alina_ward"
text = "Iris, most of the soldiers in that lower city were clerks and dockhands a month ago. Go through them to the gate if you have to, but leave as many standing as you can. Somebody will have to hold Aurum after Lyra."

[sub_resource type="Resource" id="Line_38b"]
script = ExtResource("7")
speaker = &"lyra_quill"
text = "I am not asking you to forgive the arithmetic, General, only to let my city cross the causeway before he lands again."

