[sub_resource type="Resource" id="Line_84"]
script = ExtResource("7")
text = "Hammer Hill, above the foundry valleys. The last of the Directorate's army is dug in around Radek Morn's citadel, and every flag that marched against him is on the roads below."

[sub_resource type="Resource" id="Line_85"]
script = ExtResource("7")
speaker = &"alina_ward"
text = "Iris. I'm on your west flank with everything Meridian gave me. Whatever comes up those roads today, we're going up the hill together."

[sub_resource type="Resource" id="Line_86"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Morn's headquarters is the job. Nobody bunches. The gun's gone but he still has his hand."

[sub_resource type="Resource" id="Line_87"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Vance is on the east road with the regular army and answered the radio this morning, so I've set her a place at breakfast."
requires = SubResource("Cond_78")

[sub_resource type="Resource" id="Line_88"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Vance took the regular army home to Ostrava and nobody knows which way it's pointing today, so I've set nobody a place at breakfast."
unless = SubResource("Cond_79")

[sub_resource type="Resource" id="Line_89"]
script = ExtResource("7")
speaker = &"konrad_vale"
text = "The eastern arsenal is mine to close, Colonel, and I have closed it."
requires = SubResource("Cond_80")

[sub_resource type="Resource" id="Line_90"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Vale's eastern arsenal is still turning out tanks for Morn. There are three in the yard with their engines running."
unless = SubResource("Cond_81")

[sub_resource type="Resource" id="Line_91"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "Five flags. I will put them all in one grave."

[sub_resource type="Resource" id="Line_92"]
script = ExtResource("7")
text = "Five flags go up on one pole on Hammer Hill: Meridian, Aurora, the League, the Concord's gold and Iron's slate."

[sub_resource type="Resource" id="Line_93"]
script = ExtResource("7")
speaker = &"mara_voss"
text = "He's done. I've waited nineteen years to say it and I don't feel anything like I thought I would."

[sub_resource type="Resource" id="Line_94"]
script = ExtResource("7")
speaker = &"alina_ward"
text = "The Ninth flies again, Iris. Five flags, one pole. Put them up yourself."

[sub_resource type="Resource" id="Line_95"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The column crossed the Lusk with nine days of fuel and it's still got some. So have the people who walked over the Aurum causeway. I've counted every one of them."
requires = SubResource("Cond_82")

[sub_resource type="Resource" id="Line_96"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The column crossed the Lusk with nine days of fuel and it's still got some, and I've stopped counting everything else for the day."
unless = SubResource("Cond_83")

[sub_resource type="Resource" id="Line_97"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Good. Now go home, all of you."

[sub_resource type="Resource" id="Cond_98"]
script = ExtResource("3")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_99"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "One grave. As I said."

[sub_resource type="Resource" id="Line_100"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The headquarters fell and the column fell back with it. Alina's holding the south road while I count who's still with us."
requires = SubResource("Cond_98")

[sub_resource type="Resource" id="Line_101"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The column's off the hill and scattered across the farmland. Get them back to the south road and we'll go again."
unless = SubResource("Cond_98")

