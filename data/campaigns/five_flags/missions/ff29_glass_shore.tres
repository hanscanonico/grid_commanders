[sub_resource type="Resource" id="Line_10"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "Second wave's on the north sand, dry-shod, which the tide tables didn't promise me. Push them south along the cliff road and pinch that fort from both ends."

[sub_resource type="Resource" id="Event_the_second_wave"]
script = ExtResource("8")
id = &"the_second_wave"
triggers = Array[Resource]([SubResource("Trigger_4")])
effects = Array[Resource]([SubResource("Effect_9")])
once = true
lines = Array[Resource]([SubResource("Line_10")])

[sub_resource type="Resource" id="Trigger_11"]
script = ExtResource("9")
cell = Vector2i(12, 11)
holder = 0

[sub_resource type="Resource" id="Effect_12"]
script = ExtResource("10")
tags = Array[StringName]([&"rhea_town_battery"])

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Battery Four, you are laid on a street with people in it. Cease fire, limber up, withdraw to the ridge. That is an order, not a suggestion."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "She's just pulled her own guns off her own town with us standing in it, which is worth remembering the next time we meet her."

[sub_resource type="Resource" id="Event_battery_four_stands_down"]
script = ExtResource("8")
id = &"battery_four_stands_down"
triggers = Array[Resource]([SubResource("Trigger_11")])
effects = Array[Resource]([SubResource("Effect_12")])
once = true
lines = Array[Resource]([SubResource("Line_13"), SubResource("Line_14")])

[sub_resource type="Resource" id="Trigger_15"]
script = ExtResource("4")
day = 4

[sub_resource type="Resource" id="Effect_16"]
script = ExtResource("11")
team = 2
points = 14000

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Fire plan Glass. Every square from the harbour mole to the south rocks, grid by grid, on my mark."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "Get off the sand. The dead ground under the cliffs is the one place her guns can't reach."

[sub_resource type="Resource" id="Event_fire_plan_glass"]
script = ExtResource("8")
id = &"fire_plan_glass"
triggers = Array[Resource]([SubResource("Trigger_15")])
effects = Array[Resource]([SubResource("Effect_16")])
once = true
lines = Array[Resource]([SubResource("Line_17"), SubResource("Line_18")])

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("7")
text = "The Glass Shore takes its name from the sand the old kilns fused along the waterline, and beyond its cliffs the road runs straight to Aurum."

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "First wave's ashore on the south beach and holding. The second rides the tide onto the north beach tomorrow. Between them it's all cliff, except for a harbour fort on one strip of shoal, and I mean to have that fort by the end of the week."

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Admiral Marr, General Sol. My guns are registered on both your beaches and on the harbour mole, to the metre. I would prefer you turned around. There are fishing families on this shore."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "I believe her about the guns, and about the families. Clear her hulls out of the channel and the battleship can reach the plateau, and a lander can run up to the harbour mole and put a company straight into the fort without climbing that gully."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "The fort's ours, and the harbour behind it. The rest of the army can come in over the mole now instead of wading."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Harbour fort, this is Sol. I am pulling my guns back to the Aurum hills. Admiral, there are four hundred people in the town on your south beach, and tonight they are yours to feed."

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("7")
speaker = &"halden_marr"
text = "They'll eat what my sailors eat. Tell her so. And tell her we saw where she pointed her guns today, and where she wouldn't."

[sub_resource type="Resource" id="Line_26"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Your landing is broken, Admiral. My boats will pull your survivors out of the surf. I would rather not have fired on them in it."

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Marr's fleet is back off the island counting hulls, and the Glass Shore is Concord sand again. The landing craft were borrowed, so I'll be writing an apology to somebody."

