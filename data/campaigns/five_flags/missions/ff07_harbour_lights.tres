once = true
lines = Array[Resource]([SubResource("Line_7")])

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("8")
speaker = &""
text = "Port Averly, on the Meridian coast. The Ninth is scattered, Iron's columns are over the border, and a privateer is anchored off the harbour lights."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("8")
speaker = &"halden_marr"
text = "Ferrow's parked a battleship where my fishing fleet ought to be. Two cruisers and a boat under the water to keep it company."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "Our side of the water has one port, one cruiser and one submarine. I've counted twice. It doesn't grow."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("8")
speaker = &"halden_marr"
text = "The cruiser kills his submarine. My sub kills his battleship. His battleship kills everything else, so keep the rockets back on the quay and let the bay do the work."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "Admiral. I hold an Iron licence to stop every hull in this bay, and a bill for each one. Surrender the harbour and I'll knock off the port fee."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("8")
speaker = &"halden_marr"
text = "Sink the flagship and his crews lose their nerve. Lose the harbour city and we've lost the coast."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("8")
speaker = &"halden_marr"
text = "The flagship's down by the bow. That's the tide going out on Ferrow."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "I was in the launch before the second torpedo, Admiral. Send the bill for the battleship to Iron. They'll pay; they always do."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "One harbour kept. The lights are back on, and I've sent a boy out to the rock to count what he left there."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "The harbour's under new management. Rates have gone up."

[sub_resource type="Resource" id="Cond_run_cause"]
script = ExtResource("17")
flag = &"run:cause"
at_least = 3
at_most = 4

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "He's got the port, so he's got the coast road. Anything we ship now goes round the long way and pays his toll."
requires = SubResource("Cond_run_cause")

[sub_resource type="Resource" id="Cond_run_cause_2"]
script = ExtResource("17")
flag = &"run:cause"
at_least = 3
at_most = 4

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "His guns had the bay, and the bay had us. I've written it down as a loan from the sea."
unless = SubResource("Cond_run_cause_2")

