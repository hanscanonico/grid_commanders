[sub_resource type="Resource" id="Trigger_sub_sunk"]
script = ExtResource("15")
tag = &"ferrow_sub"

[sub_resource type="Resource" id="Effect_salvage"]
script = ExtResource("16")
team = 1
amount = 3000

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("8")
speaker = &"halden_marr"
text = "His boat's on the bottom. The salvage crews are already rowing out; she was full of Concord coin."

[sub_resource type="Resource" id="Event_sub_sunk"]
