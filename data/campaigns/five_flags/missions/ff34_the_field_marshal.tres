[sub_resource type="Resource" id="Effect_16"]
script = ExtResource("8")
tags = Array[StringName]([&"vance_command", &"vance_staff_1", &"vance_staff_2"])

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("10")
speaker = &"iona_vance"
text = "Day 8, and the bridge is still mine. I'm withdrawing my staff to Ostrava, and the rearguard holds the river as long as it has shells."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("10")
speaker = &"mara_voss"
text = "She gave you a week, Colt. Now you get what she left behind."

[sub_resource type="Resource" id="Event_19"]
script = ExtResource("11")
id = &"the_field_marshal_withdraws"
triggers = Array[Resource]([SubResource("Trigger_14"), SubResource("Trigger_15")])
effects = Array[Resource]([SubResource("Effect_16")])
once = true
lines = Array[Resource]([SubResource("Line_17"), SubResource("Line_18")])

[sub_resource type="Resource" id="Cond_20"]
script = ExtResource("13")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("10")
text = "The Ostra, two days short of the capital. Iona Vance has the Dominion's regular army drawn up on the east bank, more guns than the Ninth has seen in one place."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("10")
speaker = &"iona_vance"
text = "Colonel Colt. I hold all three bridges between here and Ostrava, and every gun on this bank is ranged on the middle one. I make your chances about one in five."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("10")
speaker = &"iris_colt"
text = "Then I'll take the middle one."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("10")
speaker = &"mara_voss"
text = "Iona, it's Mara. You saw Aurum. You know he'll do the same to Ostrava the day it suits him."

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("10")
speaker = &"iona_vance"
text = "The Directorate signs my orders, Marshal. Until somebody takes that bridge out of my hands I'm obliged to hold it."

[sub_resource type="Resource" id="Line_26"]
script = ExtResource("10")
speaker = &"gideon_holt"
text = "Read that the way a quartermaster reads a contract. Take the Ostra bridgehead by day 7, leave her command tank alone, and she's out of obligations."

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("10")
speaker = &"iris_colt"
text = "Bridgehead's ours, and it stayed ours. Get the column over before dark."

[sub_resource type="Resource" id="Line_28"]
script = ExtResource("10")
speaker = &"mara_voss"
text = "Iona held that river for eleven years. I trained half the officers who dug those guns in, Colt, so I know what it cost."

[sub_resource type="Resource" id="Line_29"]
script = ExtResource("10")
speaker = &"gideon_holt"
text = "Three bridges, one still standing, and nobody has billed us for the other two yet, which I'm told makes this a good day."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("10")
speaker = &"iona_vance"
text = "Three bridges, and you needed one of them. I told you the odds, Colonel, and I don't hold rivers by luck."

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("10")
speaker = &"gideon_holt"
text = "Our headquarters went while we were all looking at the bridge, and I'll be writing that one up myself."
requires = SubResource("Cond_20")

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("10")
speaker = &"gideon_holt"
text = "The Ostra's still hers. I've counted the bridges again and there are still three."
unless = SubResource("Cond_20")

[sub_resource type="Resource" id="Cond_vance_joined"]
script = ExtResource("13")
flag = &"ff_vance_joined"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_vance_withdrew"]
script = ExtResource("13")
flag = &"ff_vance_joined"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_vance_joined"]
script = ExtResource("10")
speaker = &"iris_colt"
text = "Her guard is crossing under its own colours, the first Iron flag on our side of any river since the Hall burned."
requires = SubResource("Cond_vance_joined")

[sub_resource type="Resource" id="Line_vance_withdrew"]
script = ExtResource("10")
speaker = &"iris_colt"
text = "Vance took her staff car and most of her guns back to Ostrava, so the next time we see those batteries they'll be on the capital's walls."
requires = SubResource("Cond_vance_withdrew")

