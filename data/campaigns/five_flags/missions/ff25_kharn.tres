[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Destroy the warden's tank in the prison yard."
tag = &"kharn_warden"

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("3")
text = "Move 3 units to the Kharn road."
id = &"the_way_out"
hidden = true
cells = Array[Vector2i]([Vector2i(0, 3), Vector2i(0, 4), Vector2i(0, 5)])
count = 3

[sub_resource type="Resource" id="Objective_3"]
script = ExtResource("4")
text = "Alina Ward's transport is destroyed."
id = &"alina_alive"
hidden = true
tag = &"alina_transport"

[sub_resource type="Resource" id="Trigger_4"]
script = ExtResource("5")
tag = &"kharn_warden"

[sub_resource type="Resource" id="Effect_5"]
script = ExtResource("6")
from_team = 2
to_team = 1
tags = Array[StringName]([&"alina_transport"])

[sub_resource type="Resource" id="Effect_6"]
script = ExtResource("7")
objective_id = &"the_way_out"

[sub_resource type="Resource" id="Effect_7"]
script = ExtResource("7")
objective_id = &"alina_alive"

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Iris? Is that you on the yard radio? We're in the truck, all of us, and the engine still turns over."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("8")
speaker = &"iris_colt"
text = "Then drive. Kharn road, west, and don't stop for anything. My tanks will ride beside you the whole way."

[sub_resource type="Resource" id="Event_10"]
script = ExtResource("9")
id = &"cell_block_open"
triggers = Array[Resource]([SubResource("Trigger_4")])
effects = Array[Resource]([SubResource("Effect_5"), SubResource("Effect_6"), SubResource("Effect_7")])
once = true
lines = Array[Resource]([SubResource("Line_8"), SubResource("Line_9")])

[sub_resource type="Resource" id="Trigger_11"]
script = ExtResource("10")
day = 3

[sub_resource type="Resource" id="Spawn_12"]
script = ExtResource("12")
unit_type = ExtResource("11")
cell = Vector2i(1, 4)

[sub_resource type="Resource" id="Spawn_13"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(2, 5)

[sub_resource type="Resource" id="Effect_14"]
script = ExtResource("14")
team = 2
units = Array[Resource]([SubResource("Spawn_12"), SubResource("Spawn_13")])

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("8")
speaker = &"cass_orlov"
text = "Somebody's in my prison yard. How rude. Call the road patrol back and shut the Kharn road behind them."

[sub_resource type="Resource" id="Event_16"]
script = ExtResource("9")
id = &"kharn_alarm"
triggers = Array[Resource]([SubResource("Trigger_11")])
effects = Array[Resource]([SubResource("Effect_14")])
once = true
lines = Array[Resource]([SubResource("Line_15")])

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("8")
text = "Kharn prison, before dawn. The cell block backs onto the black water of the Kharn tarn, and the only door out of it is the prison yard."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("8")
speaker = &"iris_colt"
text = "Alina's truck is in the cell block, and the warden's tank is in the yard between us. Kill the tank, then get her out down the Kharn road."

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "The truck in the cell block is ours. Nobody shoots at it, whatever colour it's wearing."

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("8")
speaker = &"cass_orlov"
text = "Colonel Colt. I hoped you'd come in person. A cage is only half a trap until someone opens the door."

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Iris. Look at you. You brought half the Ninth into Iron to fetch one old woman."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("8")
speaker = &"iris_colt"
text = "Most of the Ninth. The rest are on their way."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("8")
speaker = &"cass_orlov"
text = "Let them run to the border. Draeg is holding it, and Draeg follows orders."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("8")
speaker = &"cass_orlov"
text = "The door's shut again, and now I have more of you to keep behind it."

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "Kharn's still locked, and Alina's still in it. I've stopped counting what we spent getting this far."

