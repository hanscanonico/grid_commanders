[sub_resource type="Resource" id="Effect_4"]
script = ExtResource("14")
team = 2
points = 14000

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Go, Sera. I have the bridge."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("11")
speaker = &"sera_lark"
text = "There's room in the trucks for your lot and room for you, General, just get in and we'll all go together."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Take the colours home, Sera. Somebody has to hold the far end of this bridge, and I've been holding it for twenty years."

[sub_resource type="Resource" id="Event_4"]
script = ExtResource("4")
id = &"i_have_the_bridge"
triggers = Array[Resource]([SubResource("Trigger_4")])
effects = Array[Resource]([SubResource("Effect_4")])
once = true
lines = Array[Resource]([SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("11")
text = "The recall orders were a day old. What was left of the Ninth's Meridian officers formed up on the Parade Road, facing west."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("11")
speaker = &"sera_lark"
text = "Border's thirty miles off, the road's straight, and between us and it there's a river and everyone who's decided since Tuesday that we're the enemy."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Iris is already over with the wounded. You take the column, Sera. I'll keep the rearguard at the bridge."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("11")
speaker = &"cass_orlov"
text = "Director Orlov, State Security. I hold a warrant for the Meridian general who blamed Iron for the fire. Please walk slowly."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("11")
speaker = &"sera_lark"
text = "Four through the crossing and we're home. Colours ride in the APC."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("11")
speaker = &"sera_lark"
text = "We're over. The trucks, the colours, everyone who could walk."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "The General held the bridge until the last truck crossed. I watched her through the glass. Then the bridge was Orlov's, and so was she."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "Then we'll go and get her back, however long it takes."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("11")
speaker = &"cass_orlov"
text = "The column stopped at the river, the way columns do when they've been running for a day and a night."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "Orlov has the General, the colours and most of the column, and I've no line in the ledger for any of it."

