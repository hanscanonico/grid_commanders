speaker = &"viktor_draeg"
text = "Keep driving. Somebody else can carry that flag now."

[sub_resource type="Resource" id="Event_the_pennant_burns"]
script = ExtResource("10")
id = &"the_pennant_burns"
triggers = Array[Resource]([SubResource("UnitDestroyed_1")])
effects = Array[Resource]([SubResource("GrantCharge_1")])
once = true
lines = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])

[sub_resource type="Resource" id="DayReached_1"]
script = ExtResource("14")
day = 4

[sub_resource type="Resource" id="Spawn_1"]
script = ExtResource("16")
unit_type = ExtResource("15")
cell = Vector2i(23, 12)

[sub_resource type="Resource" id="Spawn_2"]
script = ExtResource("16")
unit_type = ExtResource("17")
cell = Vector2i(23, 13)

[sub_resource type="Resource" id="Spawn_3"]
script = ExtResource("16")
unit_type = ExtResource("15")
cell = Vector2i(23, 14)

[sub_resource type="Resource" id="SpawnUnits_1"]
script = ExtResource("18")
team = 4
units = Array[Resource]([SubResource("Spawn_1"), SubResource("Spawn_2"), SubResource("Spawn_3")])

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "Second sortie. Aurora's air marshal flies well. He does not fly enough."

[sub_resource type="Resource" id="Event_vale_second_sortie"]
script = ExtResource("10")
id = &"vale_second_sortie"
triggers = Array[Resource]([SubResource("DayReached_1")])
effects = Array[Resource]([SubResource("SpawnUnits_1")])
once = true
lines = Array[Resource]([SubResource("Line_6")])

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("9")
text = "The Skyreach plateau. Aurora has joined the war, and Iron has answered by invading it."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Vale's bombers are coming in from the south-east, and Draeg's armour's coming up the western pass under them. Take the sky away and the tanks are just tanks."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("9")
speaker = &"sera_lark"
text = "I've got the east pass and anything with wheels. You keep his bombers off my back and I'll keep his tanks off yours."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Draeg's command tank flies the Ninth's old pennant, and he was ours for fifteen years. Leave that tank standing and he'll take his column home when it breaks. Burn it and he won't, so it's your call, Perrin."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "I'm told Iris Colt is up there. Tell her I kept the flag clean."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "Quality is decisive in the air. We will see how Aurora's is priced."

[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("19")
flag = &"ff_draeg_spared"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Vale's wing is down, the sky over Skyreach is ours again, and Rook's signing the alliance this afternoon."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Draeg took his column home. The pennant was still up on the command tank when it went round the bend."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Draeg's alive. His crew dragged him out of the tank and his own column carried him back to Iron."
unless = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("9")
speaker = &"sera_lark"
text = "Aurora and Verdant both, in one month. The Ninth's getting crowded, Colonel, I love it."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "Skyreach has no air cover and no air marshal. The Directorate will send the invoice."

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "Aurora's airfield is full of Vale's bombers and my requisition forms are full of ours. Rook's declared neutrality again, as of about an hour ago."

