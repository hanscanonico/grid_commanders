[sub_resource type="Resource" id="Effect_7"]
script = ExtResource("5")
team = 1
amount = 4000

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Colours are over the Lusk. That pennant hasn't flown on Iron ground since the Accord was signed."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Then the board just changed, and Aurora's paymasters have noticed. Four thousand on account, Colonel. Spend it north of the river."

[sub_resource type="Resource" id="Event_10"]
script = ExtResource("7")
id = &"colours_cross"
triggers = Array[Resource]([SubResource("Trigger_6")])
effects = Array[Resource]([SubResource("Effect_7")])
once = true
lines = Array[Resource]([SubResource("Line_8"), SubResource("Line_9")])

