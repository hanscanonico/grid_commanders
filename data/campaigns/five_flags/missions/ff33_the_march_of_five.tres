[sub_resource type="Resource" id="Line_16"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Loose the second pack from the rear road. They're to take the limping ones first and leave the flags for me."

[sub_resource type="Resource" id="Event_17"]
script = ExtResource("7")
id = &"orlov_looses_the_pack"
triggers = Array[Resource]([SubResource("Trigger_11")])
effects = Array[Resource]([SubResource("Effect_15")])
once = true
lines = Array[Resource]([SubResource("Line_16")])

[sub_resource type="Resource" id="Cond_18"]
script = ExtResource("1")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("6")
text = "Three weeks after Aurum. The Lusk is the last river before the Iron Dominion, and three armies are drawn up on its south bank."

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Vorn's the door into Iron. Orlov holds it with border troops and whatever he's hunting with this week. The Ninth goes up the middle."

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("6")
speaker = &"ines_calder"
text = "The League brought rifles, lots of them, and not one cost more than a plough. We'll take the west road and the west bridge. Don't wait for us."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Aurora has the east road. Orlov can watch two columns at once. Let's see how he likes three."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Voss, from Aldmoor. The Old Town rang its bells when your column left, Colt. The city you kept whole is paying for your fuel."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("6")
speaker = &"mara_voss"
text = "Voss, from Aldmoor. The Old Town is still ash, and it sent your fuel anyway. Don't spend it on a border post."
unless = SubResource("Cond_2")

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Three flags and one river. Come across, Colonel. Bring the tired ones first."

[sub_resource type="Resource" id="Line_26"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Vorn's ours. Tell Voss the door's open."

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("6")
speaker = &"ines_calder"
text = "The League counts two bridges and no rifles lost that we couldn't replace by Sunday."

[sub_resource type="Resource" id="Line_28"]
script = ExtResource("6")
speaker = &"cassian_rook"
text = "Orlov left by the north gate before the flag was even down, which means he'll be waiting somewhere with better cover."

[sub_resource type="Resource" id="Line_29"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The column crossed with nine days of fuel and has eight left, which by my arithmetic makes this the cheapest invasion in Iron's history."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("6")
speaker = &"cass_orlov"
text = "Three flags, and they all run the same way. Back over the Lusk, Colonel. I'll be on the bank when you try again."

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Our headquarters went while the column was up the road. I've filed that under things Orlov wanted us to do."
requires = SubResource("Cond_18")

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Vorn's still shut. I'll re-count the fuel and we'll knock again."
unless = SubResource("Cond_18")

