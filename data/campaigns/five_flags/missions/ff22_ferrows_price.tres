[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="10"]

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Capture the Iron depot."
cell = Vector2i(18, 6)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("2")
text = "Capture Ferrow's counting house."
cell = Vector2i(8, 3)

[sub_resource type="Resource" id="Trigger_3"]
script = ExtResource("3")
cell = Vector2i(8, 3)
holder = 0

[sub_resource type="Resource" id="Trigger_4"]
script = ExtResource("4")
team = 3
bound = 1
count = 2

[sub_resource type="Resource" id="Effect_5"]
script = ExtResource("5")
from_team = 3
to_team = 1
tags = Array[StringName]([&"ferrow_tank", &"ferrow_rifles_a", &"ferrow_mech", &"ferrow_guns", &"ferrow_riders", &"ferrow_rifles_b", &"ferrow_guard", &"ferrow_outrider", &"ferrow_flak"])

[sub_resource type="Resource" id="Effect_6"]
script = ExtResource("6")
flag = &"ff_ferrow_bought"
mode = 0
value = 1
note = "Ferrow's counting house was taken, and his company changed sides."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Counting house is ours, and so is the till. Ferrow, your men have been paid twice this month, and once by you."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("7")
speaker = &"dane_ferrow"
text = "Paid in my own coin. I respect that. Here's a receipt for free, Holt: the Concord paid for the Hall. Gold up front, Iron colours on the men."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("7")
speaker = &"konrad_vale"
text = "Ferrow has changed employers again. Note it in his file."

[sub_resource type="Resource" id="Event_10"]
script = ExtResource("8")
id = &"ferrow_bought"
triggers = Array[Resource]([SubResource("Trigger_3"), SubResource("Trigger_4")])
effects = Array[Resource]([SubResource("Effect_5"), SubResource("Effect_6")])
once = true
lines = Array[Resource]([SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9")])

[sub_resource type="Resource" id="Trigger_11"]
script = ExtResource("4")
team = 3
bound = 0
count = 1

[sub_resource type="Resource" id="Trigger_12"]
script = ExtResource("3")
cell = Vector2i(8, 3)
holder = 1

[sub_resource type="Resource" id="Effect_13"]
script = ExtResource("9")
team = 1
amount = 2000

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("7")
speaker = &"dane_ferrow"
text = "All right, book's closed! You want to know who hired me for the Hall? The Concord. Gold up front, Iron colours on the men, and I'm leaving now."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "He left the toll box. Two thousand, most of it Concord coin, and I'm putting it with the rest."

[sub_resource type="Resource" id="Event_16"]
script = ExtResource("8")
id = &"ferrow_runs"
triggers = Array[Resource]([SubResource("Trigger_11"), SubResource("Trigger_12")])
effects = Array[Resource]([SubResource("Effect_13")])
once = true
lines = Array[Resource]([SubResource("Line_14"), SubResource("Line_15")])

[sub_resource type="Resource" id="Cond_17"]
script = ExtResource("10")
flag = &"ff_gold_found"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_18"]
script = ExtResource("10")
flag = &"ff_gold_found"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Cond_19"]
script = ExtResource("10")
flag = &"ff_mint_page"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_20"]
script = ExtResource("10")
flag = &"ff_ferrow_bought"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Cond_21"]
script = ExtResource("10")
flag = &"ff_ferrow_bought"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("7")
text = "The Kessel valley is the one road east that doesn't climb a mountain. Dane Ferrow put a gate on it, and a price on the gate."

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("7")
speaker = &"dane_ferrow"
text = "Passage is two thousand a vehicle and a hundred a head, and I count the heads myself."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "I've carried your paymaster's strongbox since Garrow Crossing, Ferrow. New Concord coin. I thought you'd want it back."
requires = SubResource("Cond_17")

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "We never caught your paymaster, so I'm paying you in Meridian notes, which is the worst thing I've done all war, and I include the rations."
requires = SubResource("Cond_18")

[sub_resource type="Resource" id="Line_26"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "I've also got a scorched page from Aurum Ford with your fee on it. Initialled W. Who's W, Ferrow?"
requires = SubResource("Cond_19")

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("7")
speaker = &"konrad_vale"
text = "The Iron depot is beyond the river. It is mine and it is stocked, and it is not for sale at any price Ferrow can name."

[sub_resource type="Resource" id="Line_28"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Everybody in this valley has a price except Vale. Get somebody into that counting house and I'll do the haggling."

[sub_resource type="Resource" id="Line_29"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The Iron depot. Forty tonnes of shell, twelve of rations, and a paint store full of slate grey. Nobody touch the paint."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("7")
speaker = &"dane_ferrow"
text = "Pleasure doing business. My company rides with you to the end of the contract, Holt. Read the part about the end."
requires = SubResource("Cond_20")

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("7")
speaker = &"dane_ferrow"
text = "You didn't buy me, you beat me. A beaten man sends no receipts. Remember that the day you need a company."
requires = SubResource("Cond_21")

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("7")
speaker = &"konrad_vale"
text = "The depot was stocked to standard. Whoever empties it will find the standard was high."

[sub_resource type="Resource" id="Line_33"]
script = ExtResource("7")
speaker = &"konrad_vale"
text = "The depot stands. Ferrow's valley stays open for business, and Iron, as always, pays its tolls on time."

[sub_resource type="Resource" id="Line_34"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Outbid. We came to buy a valley from Ferrow and lost it to a man who never haggles, and I'm keeping the receipt."

[resource]
script = ExtResource("1")
id = &"ff22_ferrows_price"
title = "Ferrow's Price"
location = "The Kessel toll valley"
map_path = "res://maps/campaign/five_flags/ff22_ferrows_price.txt"
player_team = 1
ai_teams = Array[int]([2, 3])
seats = Array[int]([1, 2, 3])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"konrad_vale",
3: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_1")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Objective_2")])
events = Array[Resource]([SubResource("Event_10"), SubResource("Event_16")])
par_day = 12
briefing = Array[Resource]([SubResource("Line_22"), SubResource("Line_23"), SubResource("Line_24"), SubResource("Line_25"), SubResource("Line_26"), SubResource("Line_27"), SubResource("Line_28")])
victory = Array[Resource]([SubResource("Line_29"), SubResource("Line_30"), SubResource("Line_31"), SubResource("Line_32")])
defeat = Array[Resource]([SubResource("Line_33"), SubResource("Line_34")])
