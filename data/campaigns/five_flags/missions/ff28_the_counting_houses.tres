events = Array[Resource]([SubResource("Event_ferrow_rides_with_rook"), SubResource("Event_the_loans_freeze"), SubResource("Event_the_perfect_solution")])
par_day = 12
briefing = Array[Resource]([SubResource("Line_22"), SubResource("Line_23"), SubResource("Line_24"), SubResource("Line_25"), SubResource("Line_26")])
victory = Array[Resource]([SubResource("Line_27"), SubResource("Line_28"), SubResource("Line_29")])
defeat = Array[Resource]([SubResource("Line_30"), SubResource("Line_31")])
