[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Capture the toll house."
cell = Vector2i(8, 4)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("3")
text = "Destroy the paymaster."
id = &"paymaster_caught"
hidden = true
tag = &"paymaster"

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("5")
tag = &"paymaster"

[sub_resource type="Resource" id="Trigger_2"]
script = ExtResource("6")
day = 2

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("7")
flag = &"ff_gold_found"
mode = 0
value = 1
note = "Ferrow's paymaster was caught: his strongbox is new Concord coin."

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("8")
objective_id = &"paymaster_caught"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "Paymaster's burning. Somebody fetch the box before it melts."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "Four hundred crowns, Concord mint, this year's die. Freebooters get paid in old silver and promises. Somebody paid these ones new."

[sub_resource type="Resource" id="Event_1"]
script = ExtResource("4")
id = &"the_strongbox"
triggers = Array[Resource]([SubResource("Trigger_1"), SubResource("Trigger_2")])
effects = Array[Resource]([SubResource("Effect_1"), SubResource("Effect_2")])
once = true
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2")])

[sub_resource type="Resource" id="Trigger_3"]
script = ExtResource("10")
day = 3

