[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("12")
tags = Array[StringName]([&"paymaster"])

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "The payroll's gone east with my paymaster. The lads get paid whether you like it or not, Colonel. It's in the contract."

[sub_resource type="Resource" id="Event_2"]
script = ExtResource("4")
id = &"the_paymaster_escapes"
triggers = Array[Resource]([SubResource("Trigger_3"), SubResource("Trigger_4")])
effects = Array[Resource]([SubResource("Effect_3")])
once = true
lines = Array[Resource]([SubResource("Line_3")])

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("9")
text = "Garrow Crossing, two days before the renewal. The only bridge over the Garrow for thirty miles has a toll gate on it this morning."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "Ferrow's put a gate across the bridge and a price on the gate. I've two tanks and a base behind me. That's more than a gate."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "Colonel Draeg. We both carry Iron papers, you and I. Mine say I may tax a bridge. What do yours say?"

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "Mine say Ninth. Build at the base, send the rifles through the ford, and the tanks go over when the bridge is clear."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "His paymaster's parked on the east road with the week's wages. He leaves on the third morning. I'd dearly like to know what Ferrow pays his people in."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "Toll house is ours. The gate's firewood."

[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("13")
flag = &"ff_gold_found"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "The strongbox is on my desk. New Concord crowns, milled edges, not a scratch on them. Ferrow has never in his life had coin this clean."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "The paymaster got clean away east. Whatever Ferrow pays his people in, I never got to count it."
unless = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("9")
speaker = &"viktor_draeg"
text = "Two Iron licences on one bridge and one of them was mine, so I'll be writing to Ostrava about the other, in short words."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "The bridge stays shut until the toll's paid. I take Iron scrip, Colonel. Yours is good."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "We paid the toll in tanks. It's the worst rate I've ever seen on a bridge."

