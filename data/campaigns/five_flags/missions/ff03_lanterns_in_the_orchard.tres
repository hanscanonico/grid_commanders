[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Capture Ferrow's orchard camp."
cell = Vector2i(11, 3)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("3")
text = "Destroy the powder cart on the Candlemere road."
id = &"cart_a"
hidden = true
tag = &"powder_cart_a"

[sub_resource type="Resource" id="Objective_3"]
script = ExtResource("3")
text = "Destroy the powder cart in the orchard lane."
id = &"cart_b"
hidden = true
tag = &"powder_cart_b"

[sub_resource type="Resource" id="Objective_4"]
script = ExtResource("6")
text = "Move 1 unit onto the watchtower hill."
cells = Array[Vector2i]([Vector2i(5, 4), Vector2i(4, 5), Vector2i(5, 5), Vector2i(4, 6), Vector2i(5, 6)])
count = 1

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("5")
objective = SubResource("Objective_4")

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("7")
team = 1
cells = Array[Vector2i]([Vector2i(6, 5)])

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "Top of the hill. Lanterns on every tower from here to Candlemere, and two carts below them riding heavy. They'll be out of the orchard by the fourth morning."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "That's powder. What does a freebooter want with a road's worth of powder the night before a ceremony? Burn both before they're gone."

[sub_resource type="Resource" id="Event_1"]
script = ExtResource("4")
id = &"the_watchtower"
triggers = Array[Resource]([SubResource("Trigger_1")])
effects = Array[Resource]([SubResource("Effect_1")])
once = true
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2")])

[sub_resource type="Resource" id="Trigger_2"]
script = ExtResource("9")
tag = &"powder_cart_a"

[sub_resource type="Resource" id="Trigger_3"]
script = ExtResource("10")
day = 3

[sub_resource type="Resource" id="Effect_2"]
