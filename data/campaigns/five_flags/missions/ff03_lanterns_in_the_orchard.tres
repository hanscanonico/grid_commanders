[sub_resource type="Resource" id="Effect_6"]
script = ExtResource("14")
tags = Array[StringName]([&"powder_cart_b"])

[sub_resource type="Resource" id="Effect_7"]
script = ExtResource("15")
flag = &"ff_powder_lost"
mode = 1
value = 1
note = "A powder cart got through the orchards to Candlemere."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "The lane cart's past your pickets, Captain. Its load is somebody else's worry now."

[sub_resource type="Resource" id="Event_5"]
script = ExtResource("4")
id = &"cart_b_through"
triggers = Array[Resource]([SubResource("Trigger_8"), SubResource("Trigger_9")])
effects = Array[Resource]([SubResource("Effect_6"), SubResource("Effect_7")])
once = true
lines = Array[Resource]([SubResource("Line_6")])

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("8")
text = "The night before the renewal. Every lantern tower in the Seam is lit for the anniversary, and the Candle Orchards are full of shapes that aren't trees."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "Ferrow's men are in the rows, and from here I can't see his camp."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Then find it, Nia. Climb the old watchtower if you need eyes; on a lantern night that hill sees half the Seam."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "Lovely night for a delivery. Mind the lanterns, Captain, they're older than you and twice as expensive."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "Rangers walk the rows; the tank keeps to the road."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("8")
speaker = &"nia_rowan"
text = "The camp's ours. Empty crates, cut fuses, and a street map of Candlemere with the Hall marked on it."

[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("16")
flag = &"ff_powder_lost"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "Both carts burned in the orchard. That's a great deal of somebody's money set on fire, and for once none of it ours."
unless = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "I've written to the Candlemere watch about the carts. They wrote back that it's a festival and everyone has fireworks."
requires = SubResource("Cond_1")

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("8")
speaker = &"alina_ward"
text = "Double the guard on the Hall tomorrow. Quietly, please. It's meant to be a party."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("8")
speaker = &"dane_ferrow"
text = "Lanterns out, rangers home, and the delivery arrives on time."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("8")
speaker = &"gideon_holt"
text = "Nia's back with half the rangers she took. Whatever was on those carts is in Candlemere tonight."

