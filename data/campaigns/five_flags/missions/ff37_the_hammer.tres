[sub_resource type="Resource" id="Cond_34"]
script = ExtResource("14")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_35"]
script = ExtResource("7")
text = "The Hammerfall emplacement, in the mountains north of Ostrava. The gun that burned the Aldmoor road and the citadel at Aurum is dug into a cup of rock at the head of the valley."

[sub_resource type="Resource" id="Line_36"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Sol, with four batteries in the south-east corner. The Hammer needs a spotter to aim and a full magazine to fire. Its spotter sits on the lone peak west of the cup."

[sub_resource type="Resource" id="Line_37"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "And the magazine?"

[sub_resource type="Resource" id="Line_38"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Refilled every third day while the gun is his. Do not bunch your column, Colonel. It fires at wherever you are thickest."

[sub_resource type="Resource" id="Line_39"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "One gun. One hand. You have walked a long way to stand under it."

[sub_resource type="Resource" id="Line_40"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Every third day, three squares on a side, everything inside it. I've done the sums and I'd rather not read them out."

[sub_resource type="Resource" id="Line_41"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "The emplacement's ours. Spike the gun."

[sub_resource type="Resource" id="Line_42"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Sol to the Colonel. My batteries are standing down for the first time since Aurum. Thank you for letting me aim at the right thing."

[sub_resource type="Resource" id="Line_43"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "The gun was never the hammer. I am."

[sub_resource type="Resource" id="Line_44"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "One siege gun, captured, not for resale. I've put it on the inventory under things we're never using again."

[sub_resource type="Resource" id="Line_45"]
script = ExtResource("7")
speaker = &"radek_morn"
text = "You stood where I could reach you."

[sub_resource type="Resource" id="Line_46"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Morn's people came down the service road and took the headquarters while the gun kept our heads down. I'll count what's left when it stops firing."
requires = SubResource("Cond_34")

[sub_resource type="Resource" id="Line_47"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The Hammer broke the column on the valley road. Sol's batteries are covering what's left of us back to the start line."
unless = SubResource("Cond_34")

[sub_resource type="Resource" id="Cond_48"]
script = ExtResource("14")
flag = &"ff_rhea_turned"
at_least = 1
at_most = -1

