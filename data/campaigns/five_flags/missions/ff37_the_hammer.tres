[sub_resource type="Resource" id="Line_32"]
script = ExtResource("7")
speaker = &"rhea_sol"
text = "Spotter is down. The gun is firing at a map now, and a map is three days out of date. I am moving two more batteries up to grid twenty-one."

[sub_resource type="Resource" id="Event_33"]
