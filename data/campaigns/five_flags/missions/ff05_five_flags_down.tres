seats = Array[int]([1, 2, 3, 4])
sides = {}
commanders = {
1: &"iris_colt",
2: &"iona_vance",
3: &"ivar_thorne",
4: &"cassian_rook"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_1")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Objective_2")])
events = Array[Resource]([SubResource("Event_1"), SubResource("Event_2"), SubResource("Event_3")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_6"), SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9"), SubResource("Line_10"), SubResource("Line_11")])
victory = Array[Resource]([SubResource("Line_12"), SubResource("Line_13"), SubResource("Line_14")])
defeat = Array[Resource]([SubResource("Line_15"), SubResource("Line_16")])
