[gd_resource type="Resource" script_class="MissionDefinition" load_steps=40 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/effects/remove_units_effect.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="11"]

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Keep the Accord Archive for 6 days."
cell = Vector2i(8, 6)
days = 6

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("3")
text = "Capture the grain town."
cell = Vector2i(9, 10)

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("5")
day = 2

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("6")
tags = Array[StringName]([&"aurora_a", &"aurora_b", &"aurora_c", &"aurora_d", &"aurora_e"])

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("7")
speaker = &"cassian_rook"
text = "Aurora has no quarrel here. My column is going home, and the board just changed for everyone left on it."

[sub_resource type="Resource" id="Event_1"]
script = ExtResource("4")
id = &"aurora_goes_home"
triggers = Array[Resource]([SubResource("Trigger_1")])
effects = Array[Resource]([SubResource("Effect_1")])
once = true
lines = Array[Resource]([SubResource("Line_1")])

[sub_resource type="Resource" id="Trigger_2"]
script = ExtResource("5")
day = 3

[sub_resource type="Resource" id="Spawn_1"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(1, 10)

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_1")])

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("7")
speaker = &"mara_voss"
text = "Colonel Colt. Meridian recalls every officer on Seam duty to Aldmoor, effective now. My courier stays with you until you've read it twice."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "I've read it. I'm holding a building, Marshal. I'll come when it's held."

[sub_resource type="Resource" id="Event_2"]
script = ExtResource("4")
id = &"the_recall"
triggers = Array[Resource]([SubResource("Trigger_2")])
effects = Array[Resource]([SubResource("Effect_2")])
once = true
lines = Array[Resource]([SubResource("Line_2"), SubResource("Line_3")])

[sub_resource type="Resource" id="Trigger_3"]
script = ExtResource("5")
day = 4

[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("11")
team = 3
points = 6000

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("7")
speaker = &"ivar_thorne"
text = "Vance. Your people burned the Hall. Mine will bury it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("7")
speaker = &"iona_vance"
text = "Iron sent nobody to Candlemere, Thorne. I'd put your believing that at about ten percent."

[sub_resource type="Resource" id="Event_3"]
script = ExtResource("4")
id = &"thorne_meets_vance"
triggers = Array[Resource]([SubResource("Trigger_3")])
effects = Array[Resource]([SubResource("Effect_3")])
once = true
lines = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("7")
text = "Candlemere, the morning after. The Hall is ash. Its records survive in the Accord Archive on the old causeway, and every power on the continent wants them."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Three columns from three corners, all coming to secure the Archive. The Ninth is standing on it. Nobody gets it."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("7")
speaker = &"iona_vance"
text = "Colonel Colt. If you walk away now, I make your odds of seeing Aldmoor about sixty percent."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("7")
speaker = &"ivar_thorne"
text = "The Accord's dead. Whoever holds its paper holds the blame, and I'll hold it."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("7")
speaker = &"cassian_rook"
text = "Aurora is here to watch. For now."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "Iron, the League, Aurora. The Concord hasn't sent a column at all. I'd find that restful, in your place."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("7")
speaker = &"iris_colt"
text = "Six days, and the Archive's still ours, every page of it."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "The recall orders came in with breakfast. Draeg to Iron, Nia to the League, Sera to Aurora, each signed by a different minister in a different hurry."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("7")
speaker = &"sable_wren"
text = "The Concord hasn't recalled me. Yet."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("7")
speaker = &"iona_vance"
text = "The Archive is in Iron's keeping. Ninety-one percent of it, anyway."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("7")
speaker = &"gideon_holt"
text = "Every flag took a box of the Archive and went home. I kept the index. It's short."

[resource]
script = ExtResource("1")
