[sub_resource type="Resource" id="Objective_airfield"]
script = ExtResource("2")
text = "Capture Vale's forward airfield."
cell = Vector2i(13, 5)

[sub_resource type="Resource" id="Bonus_bomber"]
script = ExtResource("3")
text = "Destroy Vale's heavy bomber."
tag = &"vale_heavy_bomber"

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("4")
