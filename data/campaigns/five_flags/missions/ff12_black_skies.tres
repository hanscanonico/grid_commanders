[sub_resource type="Resource" id="Effect_spawn"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn")])

[sub_resource type="Resource" id="Line"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "More coming in off the east. High, slow and heavy, so somebody's paid for a lot of fuel today."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "The second wing is airborne. Each aircraft is certified for two hundred sorties. I do not expect it to need twenty."

[sub_resource type="Resource" id="Event_first_wave"]
script = ExtResource("10")
id = &"first_wave"
triggers = Array[Resource]([SubResource("Trigger_day_3"), SubResource("Trigger_strip_his_3")])
effects = Array[Resource]([SubResource("Effect_spawn")])
once = true
lines = Array[Resource]([SubResource("Line"), SubResource("Line_2")])

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("4")
day = 5

[sub_resource type="Resource" id="Trigger_strip_his_5"]
script = ExtResource("5")
cell = Vector2i(13, 5)
holder = 1

[sub_resource type="Resource" id="Spawn_2"]
script = ExtResource("6")
unit_type = ExtResource("7")
cell = Vector2i(17, 9)

[sub_resource type="Resource" id="Effect_spawn_2"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_2")])

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "A third wing. The strip will keep receiving them for as long as it is mine."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Then it stops being his. Get boots on that runway."

[sub_resource type="Resource" id="Event_second_wave"]
script = ExtResource("10")
id = &"second_wave"
triggers = Array[Resource]([SubResource("Trigger_day_5"), SubResource("Trigger_strip_his_5")])
effects = Array[Resource]([SubResource("Effect_spawn_2")])
once = true
lines = Array[Resource]([SubResource("Line_3"), SubResource("Line_4")])

[sub_resource type="Resource" id="Trigger_strip_ours"]
script = ExtResource("5")
cell = Vector2i(13, 5)
holder = 0

[sub_resource type="Resource" id="Effect_fuel_dump"]
script = ExtResource("11")
team = 1
amount = 3000

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Runway's ours, and so is his fuel dump. Tell Aldmoor they can look up again."

[sub_resource type="Resource" id="Event_strip_taken"]
script = ExtResource("10")
id = &"strip_taken"
triggers = Array[Resource]([SubResource("Trigger_strip_ours")])
effects = Array[Resource]([SubResource("Effect_fuel_dump")])
once = true
lines = Array[Resource]([SubResource("Line_5")])

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("9")
speaker = &""
text = "The Aldmoor airfields. Iron's bombers have been over the capital three nights running, flying from a strip Vale built on Meridian farmland in a week."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Perrin Ash, Aurora air marshal, currently on leave. Aurora's neutral. I'm on holiday, and I brought my fighters."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("9")
speaker = &"mara_voss"
text = "Your chancellor will have questions."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "He always does. Fighters clear the sky, the missile battery covers the runway, and the infantry walk over and take his strip while he's looking up."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "Marshal Ash. My bombers are the best that have ever been built. That is not an opinion. I have the test results."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "His big one's parked behind the strip, and it would be rude not to visit."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "The forward strip is lost. I will build another. It will cost more, and it will be better."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("9")
speaker = &"perrin_ash"
text = "Tell Rook I spent my leave usefully. No, on second thought, don't tell Rook anything, he'll only want the fuel back."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("9")
speaker = &"mara_voss"
text = "Aldmoor sleeps tonight. Thank you, Marshal. Unofficially."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("9")
speaker = &"konrad_vale"
text = "The sky over Aldmoor belongs to the better aircraft. The test results were correct."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "Three airfields gone and the fuel with them. We'll be meeting Vance at Aldmoor with whatever's left on the ground."

