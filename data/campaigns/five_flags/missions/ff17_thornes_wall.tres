[sub_resource type="Resource" id="GrantCharge_1"]
script = ExtResource("13")
team = 3
points = 11000

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "Everyone on this field bleeds today, mine as well. The ones who keep walking are the ones I want."

