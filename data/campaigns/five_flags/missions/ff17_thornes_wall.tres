[sub_resource type="Resource" id="Line_2"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "I'm on the east flank with the Speaker's people. Don't come looking for me, Iris."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "She's ours for today. Take what the League can give you."

[sub_resource type="Resource" id="Event_nia_joins_the_league"]
