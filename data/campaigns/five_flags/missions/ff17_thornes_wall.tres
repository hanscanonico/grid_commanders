[sub_resource type="Resource" id="Line_5"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "Ash Gate's open. Greenhollow's quartermasters are handing us their keys, so send everything you've got through it."

[sub_resource type="Resource" id="Event_the_ash_gate_falls"]
script = ExtResource("12")
id = &"the_ash_gate_falls"
triggers = Array[Resource]([SubResource("CellOwned_1")])
effects = Array[Resource]([SubResource("GrantFunds_1")])
once = true
lines = Array[Resource]([SubResource("Line_5")])

[sub_resource type="Resource" id="Cond_3"]
script = ExtResource("4")
flag = &"ff_concord_shells"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("11")
text = "Greenhollow, the League's capital. Ivar Thorne has walled himself in with what's left of the junta and every gun in the cantons."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "First Speaker Calder, what's left of the council. I have a lot of cheap soldiers and one good idea: we both hit the Wall at once and he can't be in two places."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "West gate's mine. Keep your people out of his artillery's reach until the gates open."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "And watch the day he spends his temper. Thorne's trick hurts his own lines as badly as ours, and he's proud of it."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "He's firing Aurum shells from that wall, by the way, the same lot you found in the crates at Harrowgate."
requires = SubResource("Cond_3")

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "The League forgot what it costs to be free. I'll remind it from the Wall, and nobody goes home until it has learned."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "Thorne's alive. He sat in his headquarters with a pistol on the desk and didn't pick it up."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "Good, because the League will try him in public, in the council chamber he locked us out of."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("11")
speaker = &"ines_calder"
text = "And the League marches with the Ninth, Colonel. Cheap rifles, lots of them. Send the bill to Aldmoor."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "I held this country together with my own hands for six years, and you'll see how long it lasts in yours."

[sub_resource type="Resource" id="Cond_4"]
script = ExtResource("4")
flag = &"run:cause"
at_least = 1
at_most = 1

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("11")
speaker = &"ivar_thorne"
text = "The Wall stands, and every soldier you left under it stays there."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "Calder's people ran out of soldiers before Thorne ran out of wall. I've got the League's invoice here and nobody to hand it to."
unless = SubResource("Cond_4")

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "Every unit we sent up to that wall is on my casualty list, and it's the longest list I've written this war."
requires = SubResource("Cond_4")

