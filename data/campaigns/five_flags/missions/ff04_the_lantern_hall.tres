[sub_resource type="Resource" id="Line_7"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "South gate, now. That's three sides. They've left us the west, which I don't like either."

[sub_resource type="Resource" id="Event_5"]
script = ExtResource("5")
id = &"south_gate"
triggers = Array[Resource]([SubResource("Trigger_7")])
effects = Array[Resource]([SubResource("Effect_5")])
once = true
lines = Array[Resource]([SubResource("Line_7")])

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("11")
text = "Candlemere, the night of the renewal: three delegations wait in the Lantern Hall to sign for another twenty years."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("11")
speaker = &"sable_wren"
text = "The Concord sends its regrets. Their delegates left an hour ago, something about catching the tide. The Chancellor's letter is very warm."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Then it's three cars to look after instead of four."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("11")
speaker = &"iris_colt"
text = "Contact on the west road, and more coming over the east bridge. They're in slate. Iron colours."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Clear the west gate and get the three cars through it. The Hall is a building, Iris. We can build another."

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("11")
text = "The delegations were through the west gate by midnight. Behind them the Lantern Hall burned to its beams."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("11")
speaker = &"viktor_draeg"
text = "The Iron delegate swears Iron sent nobody. I believe him. I'm the only one in the room who does."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Every car made the gate. Every man who attacked it wore slate, and nobody in any of those cars is going to sign a thing with Iron tonight."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("11")
speaker = &"dane_ferrow"
text = "Candlemere's burning and the Accord with it. Paid work, General. Nothing personal."

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("11")
speaker = &"gideon_holt"
text = "We lost the delegations. Every capital on the continent will have a different name for who did it, and none of them will be the same name."

