[sub_resource type="Resource" id="Line_5"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "Nothing on the east bank. No guns. The carts we burned last night would have been sitting right there."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("11")
speaker = &"alina_ward"
text = "Then the east wall's watch can come off it. Send them to the Hall."

[sub_resource type="Resource" id="Event_4"]
