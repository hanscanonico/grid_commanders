speaker = &"alina_ward"
text = "Guns east of the river. That's your orchard powder, Nia."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("11")
speaker = &"nia_rowan"
text = "I let it through. I'm sorry."

