[sub_resource type="Resource" id="Effect_30"]
script = ExtResource("5")
team = 2
points = 24000

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Magazine's ours. Whatever's up that rail line now is all he's got, and I've counted one shell on the loading tray."

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "Then I will fire the one in the breech."

[sub_resource type="Resource" id="Event_33"]
script = ExtResource("7")
id = &"the_last_shell"
triggers = Array[Resource]([SubResource("Trigger_28"), SubResource("Trigger_29")])
effects = Array[Resource]([SubResource("Effect_30")])
once = true
lines = Array[Resource]([SubResource("Line_31"), SubResource("Line_32")])

[sub_resource type="Resource" id="Cond_34"]
script = ExtResource("8")
flag = &"run:cause"
at_least = 2
at_most = 2

[sub_resource type="Resource" id="Line_35"]
script = ExtResource("6")
text = "The east valley below the Hammerfall emplacement. Rhea Sol's batteries stayed with the Concord, and nobody is coming to answer the gun for the Ninth."

[sub_resource type="Resource" id="Line_36"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "No counter-battery. Fine. We don't shoot the gun, we starve it."

[sub_resource type="Resource" id="Line_37"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The rail line runs from the gun down to a powder magazine in the middle of the valley. While Morn holds both, a shell goes up that line every third day. Take the magazine and he's firing what's left in the breech."

[sub_resource type="Resource" id="Line_38"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "You have come a long way to stand in one valley."

[sub_resource type="Resource" id="Line_39"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "Spread the column out. Nobody bunches, nobody stops, and nobody waits for anybody."

[sub_resource type="Resource" id="Line_40"]
script = ExtResource("6")
speaker = &"iris_colt"
text = "The emplacement's ours. Spike the gun."

[sub_resource type="Resource" id="Line_41"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "The gun was never the hammer. I am."

[sub_resource type="Resource" id="Line_42"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "One siege gun, captured and not for resale, with not a single shell left in the valley to fire from it, because I walked the rail line myself and checked."

[sub_resource type="Resource" id="Line_43"]
script = ExtResource("6")
speaker = &"radek_morn"
text = "You stood where I could reach you."

[sub_resource type="Resource" id="Line_44"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "Morn came down his own rail line and took the headquarters while the gun kept us in the woods. I'll count what's left when the ringing stops."
requires = SubResource("Cond_34")

[sub_resource type="Resource" id="Line_45"]
script = ExtResource("6")
speaker = &"gideon_holt"
text = "The Hammer broke the column halfway up the valley. What's left is walking back to the start line in fives."
unless = SubResource("Cond_34")

[sub_resource type="Resource" id="Cond_46"]
script = ExtResource("8")
flag = &"ff_rhea_turned"
at_least = 0
at_most = 0

