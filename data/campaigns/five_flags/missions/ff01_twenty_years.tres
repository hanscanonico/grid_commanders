[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2")
text = "Capture the village square."
cell = Vector2i(8, 3)

[sub_resource type="Resource" id="Objective_2"]
script = ExtResource("2")
text = "Capture the mill."
cell = Vector2i(6, 7)

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("4")
day = 2

[sub_resource type="Resource" id="Spawn_1"]
script = ExtResource("6")
unit_type = ExtResource("7")
cell = Vector2i(12, 0)

[sub_resource type="Resource" id="Spawn_2"]
script = ExtResource("6")
unit_type = ExtResource("7")
cell = Vector2i(13, 0)

[sub_resource type="Resource" id="Spawn_3"]
script = ExtResource("6")
unit_type = ExtResource("8")
cell = Vector2i(13, 1)

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("5")
team = 2
units = Array[Resource]([SubResource("Spawn_1"), SubResource("Spawn_2"), SubResource("Spawn_3")])

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "Second company, over the hill. I bill by the head, Colonel, so do leave a few standing."

[sub_resource type="Resource" id="Event_1"]
script = ExtResource("3")
id = &"ferrow_second_wave"
triggers = Array[Resource]([SubResource("Trigger_1")])
effects = Array[Resource]([SubResource("Effect_1")])
once = true
lines = Array[Resource]([SubResource("Line_1")])

[sub_resource type="Resource" id="Trigger_2"]
script = ExtResource("10")
cell = Vector2i(6, 7)
holder = 0

[sub_resource type="Resource" id="Spawn_4"]
script = ExtResource("6")
unit_type = ExtResource("11")
cell = Vector2i(10, 7)

[sub_resource type="Resource" id="Spawn_5"]
script = ExtResource("6")
unit_type = ExtResource("7")
cell = Vector2i(11, 7)

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("5")
team = 2
units = Array[Resource]([SubResource("Spawn_4"), SubResource("Spawn_5")])

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "That mill grinds flour I have already invoiced, Colonel. Riders, down the mill road, and bring it back."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Let them come along the river. The artillery's been waiting all morning for something to shoot."

[sub_resource type="Resource" id="Event_2"]
script = ExtResource("3")
id = &"ferrow_counter_raid"
triggers = Array[Resource]([SubResource("Trigger_2")])
effects = Array[Resource]([SubResource("Effect_2")])
once = true
lines = Array[Resource]([SubResource("Line_2"), SubResource("Line_3")])

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("9")
text = "Twenty years ago the Lantern Accord ended the Ash War in a hall at Candlemere. Since then the Ninth has kept the Seam quiet under five flags on one pole."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("9")
speaker = &"alina_ward"
text = "The parade's on Saturday, Iris, and I'd like the drill company to march in it with all its tanks. Freebooters took Orchard Row last night. Please don't break anything we'll have to polish."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "Dane Ferrow, holder of an Iron letter of marque. This village owes me road tolls back to the spring thaw. I've brought the invoice."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "They're in the square and the mill. Guns on the road first. Nobody walks into that square until the artillery's fired."

[sub_resource type="Resource" id="Cond_run_full"]
script = ExtResource("12")
flag = &"run:full"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Square's ours. The mill too, if anyone's asking."
requires = SubResource("Cond_run_full")

[sub_resource type="Resource" id="Line_8b"]
script = ExtResource("9")
speaker = &"iris_colt"
text = "Square's ours."
unless = SubResource("Cond_run_full")

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "Ferrow left four rifles, a tank with no fuel in it, and an invoice nailed to the mill door. The invoice is itemised. He's charged us for the nails."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("9")
speaker = &"alina_ward"
text = "Frame it, Gideon. And Iris? Wash the tank before Saturday."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("9")
speaker = &"dane_ferrow"
text = "Orchard Row is under new management, Colonel, and the tolls are payable at the bridge in cash."

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("9")
speaker = &"gideon_holt"
text = "We lost the drill company four days before the parade. I'll need a new company and a much better excuse."

