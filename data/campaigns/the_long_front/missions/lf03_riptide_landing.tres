[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="13"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="14"]

[sub_resource type="Resource" id="Objective_hold_the_coast"]
script = ExtResource("2")
text = "Hold the coast road until day 6."
day = 6

[sub_resource type="Resource" id="Failure_the_watch"]
script = ExtResource("4")
text = "The coast watch was caught on the beach road."
tag = &"coast_watch"

[sub_resource type="Resource" id="Bonus_watch_inland"]
script = ExtResource("5")
text = "Get the coast watch inland."
cells = Array[Vector2i]([Vector2i(2, 1)])
count = 1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "A second column is ashore behind the picket line, Rook. Meridian lost its border the same morning. That's no coincidence."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Two landings, one plan. Noted. We have no ground to trade for time, so we hold the road instead."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Four units and a spotter against a beachhead, and a battleship off the bay whose guns reach the road as far west as the city and not a cell further."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "We make the first tide count. Get the coast watch moving inland the moment the road's secure, and keep the copter west of those guns."

[sub_resource type="Resource" id="Watch_inland"]
script = ExtResource("9")
flag = &"coast_watch_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Watch_stranded"]
script = ExtResource("9")
flag = &"coast_watch_saved"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Picket held the road long enough. Coast watch is inland and accounted for."
requires = SubResource("Watch_inland")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Three units left standing. I'll call that a win worth having."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Picket held the road. The coast watch never got off it. They're still on that shore tonight with the sea at their backs and nothing I can send them."
requires = SubResource("Watch_stranded")

[sub_resource type="Resource" id="Trigger_watch_inland"]
script = ExtResource("7")
tag = &"coast_watch"
cells = Array[Vector2i]([Vector2i(2, 1)])

[sub_resource type="Resource" id="Effect_watch_saved"]
script = ExtResource("8")
flag = &"coast_watch_saved"
mode = 0
value = 1
note = "The Tidewatch coast watch got inland with its lists intact."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Watch is inland and counted, Rook. Every name on the list."

[sub_resource type="Resource" id="Event_the_watch_is_inland"]
script = ExtResource("6")
id = &"the_watch_is_inland"
triggers = Array[Resource]([SubResource("Trigger_watch_inland")])
effects = Array[Resource]([SubResource("Effect_watch_saved")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_3"]
script = ExtResource("10")
day = 3

[sub_resource type="Resource" id="Spawn_second_tide_1"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Spawn_second_tide_2"]
script = ExtResource("12")
unit_type = ExtResource("14")
cell = Vector2i(14, 4)

[sub_resource type="Resource" id="Effect_second_tide"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_second_tide_1"), SubResource("Spawn_second_tide_2")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Second tide's in. Boots on the beach under the headland, a mech and a squad. That's the second column Orin promised, and it's ashore behind the road."

[sub_resource type="Resource" id="Event_the_second_tide"]
script = ExtResource("6")
id = &"the_second_tide"
triggers = Array[Resource]([SubResource("Trigger_day_3")])
effects = Array[Resource]([SubResource("Effect_second_tide")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_routed"]
script = ExtResource("9")
flag = &"run:cause"
at_least = 1
at_most = 1

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("9")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "Two landings, one morning. The beachhead's a road now. It goes where I point it."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The picket broke on the beach road. My tanks were inland before the tide turned. The sea can keep whatever it caught."
requires = SubResource("Run_routed")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The watch was caught on the beach road. Nothing behind it but water. Every name on the district's lists was on that road."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_4"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The road's gone and the second column's inland. The watch is still moving, which is more than I can say for anything else on this coast."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
