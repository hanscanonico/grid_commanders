player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"cassian_rook",
2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_hold_the_coast")])
failures = Array[Resource]([SubResource("Failure_the_watch")])
bonus_objectives = Array[Resource]([SubResource("Bonus_watch_inland")])
events = Array[Resource]([SubResource("Event_the_watch_is_inland"), SubResource("Event_the_second_tide")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_7"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3"), SubResource("Line_defeat_4")])
