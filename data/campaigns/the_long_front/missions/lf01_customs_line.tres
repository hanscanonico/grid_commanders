[gd_resource type="Resource" script_class="MissionDefinition" load_steps=22 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/objectives/protect_unit_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/reach_cell_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="8"]

[sub_resource type="Resource" id="Objective_hold_the_line"]
script = ExtResource("2")
text = "Hold the customs line until the column has cleared."
day = 6

[sub_resource type="Resource" id="Failure_the_column"]
script = ExtResource("4")
text = "The refugee column was lost on the customs road."
tag = &"refugee_column"

[sub_resource type="Resource" id="Bonus_column_home"]
script = ExtResource("5")
text = "Get the column behind the line."
cells = Array[Vector2i]([Vector2i(1, 1)])
count = 1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Draeg's armour crossed at first light, Commander. Four units is what you have between the border and the column."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then four units is what holds it. I don't need to win this line — I need to keep it standing."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The column clears by day six if you do. Every hour past that, someone in it doesn't."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then we don't blink for six days. Get everyone off the road who isn't fighting on it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The column's clear. Draeg's tanks own the customs road now, and nothing they were sent to take."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "I fold the map and fall back to the next line. This won't be the last one."

[sub_resource type="Resource" id="Trigger_column_home"]
script = ExtResource("7")
tag = &"refugee_column"
cells = Array[Vector2i]([Vector2i(1, 1)])

[sub_resource type="Resource" id="Effect_column_saved"]
script = ExtResource("8")
flag = &"column_saved"
mode = 0
value = 1
note = "The customs-road column reached the line behind you."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Column's behind the line and off your road, Commander. Every hour after this one is yours to spend."

[sub_resource type="Resource" id="Event_the_column_is_home"]
script = ExtResource("6")
id = &"the_column_is_home"
triggers = Array[Resource]([SubResource("Trigger_column_home")])
effects = Array[Resource]([SubResource("Effect_column_saved")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"lf01_customs_line"
title = "Customs Line"
location = "The customs road, Meridian frontier"
map_path = "res://maps/campaign/the_long_front/lf01_customs_line.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"mara_voss",
2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_hold_the_line")])
failures = Array[Resource]([SubResource("Failure_the_column")])
bonus_objectives = Array[Resource]([SubResource("Bonus_column_home")])
events = Array[Resource]([SubResource("Event_the_column_is_home")])
par_day = 6
carry_out = true
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The column was still on the road when the line broke. Draeg's armour did not stop to count what it drove over."
