ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"mara_voss",
2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_narrows")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The narrows broke, and three nations' retreats became one rout with nowhere left to fall back to."
