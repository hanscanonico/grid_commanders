[sub_resource type="Resource" id="Effect_the_line_forms"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_picket_foot"), SubResource("Spawn_picket_scout")])

[sub_resource type="Resource" id="Effect_meridian"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_meridian_company")])

[sub_resource type="Resource" id="Effect_aurora"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_aurora_company")])

[sub_resource type="Resource" id="Effect_league"]
script = ExtResource("8")
team = 1
units = Array[Resource]([SubResource("Spawn_league_company")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Aurora's picket is on your left flank, Voss. What's left of it, anyway."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "And the wardens are on your right. We're done falling back separately."

[sub_resource type="Resource" id="Event_line_meridian"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The customs-road column reached the depots and put a company back on the line. They came looking for the officer who held that morning."

[sub_resource type="Resource" id="Event_line_aurora"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "My coast watch made it inland, so Aurora knows who's still standing and where. That's one more company than I promised you, and I'm not apologising for it."

[sub_resource type="Resource" id="Event_line_league"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "The shrine's keepers came out of the wood alive. The wardens who carried them are standing on your flank. The League pays that kind of debt in the field."

[sub_resource type="Resource" id="Event_the_line_forms"]
script = ExtResource("5")
id = &"the_line_forms"
triggers = Array[Resource]([SubResource("Trigger_day_2")])
effects = Array[Resource]([SubResource("Effect_the_line_forms")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[sub_resource type="Resource" id="Event_meridian_stands"]
script = ExtResource("5")
id = &"meridian_stands"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_column_saved")])
effects = Array[Resource]([SubResource("Effect_meridian")])
once = true
lines = Array[Resource]([SubResource("Event_line_meridian")])

[sub_resource type="Resource" id="Event_aurora_stands"]
script = ExtResource("5")
id = &"aurora_stands"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_watch_saved")])
effects = Array[Resource]([SubResource("Effect_aurora")])
once = true
lines = Array[Resource]([SubResource("Event_line_aurora")])

[sub_resource type="Resource" id="Event_the_league_stands"]
script = ExtResource("5")
id = &"the_league_stands"
triggers = Array[Resource]([SubResource("Trigger_day_2"), SubResource("Trigger_shrine_saved")])
effects = Array[Resource]([SubResource("Effect_league")])
once = true
lines = Array[Resource]([SubResource("Event_line_league")])

[sub_resource type="Resource" id="Run_routed"]
script = ExtResource("4")
flag = &"run:cause"
at_least = 1
at_most = 1

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "Three flags on one road. The road's mine now. They learned to retreat together; standing together was a different lesson."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The narrows broke. Three retreats went back to being three retreats. Nowhere left to run them."
requires = SubResource("Run_routed")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The narrows are his and there's nothing behind them but the depots. Three nations spent six weeks learning to hold one road. We didn't hold it."

