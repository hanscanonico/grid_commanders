[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_hold_the_narrows"]
script = ExtResource("2")
text = "Hold the narrows until day 7."
day = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Three retreats met on one road and stopped retreating, Voss. Aurora and the League are behind this line with you now."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then it's not my line anymore — it's ours. Draeg's spearhead hasn't slowed, only run out of ground to go around."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "My picket bought a day at the seawall. I'll spend today the same way, on your flank."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then hold what's yours and I'll hold what's mine. First time in a week that's actually true."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "The narrows held. First time since the crossing his column's stopped instead of advancing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "We've got a base behind us now, and an alliance in front of us. Both are new — I intend to get used to them."

[resource]
script = ExtResource("1")
id = &"lf07_the_narrows"
title = "The Narrows"
location = "The narrows, allied front"
map_path = "res://maps/campaign/the_long_front/lf07_the_narrows.txt"
