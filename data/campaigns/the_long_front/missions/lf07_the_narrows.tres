[sub_resource type="Resource" id="Objective_hold_the_narrows"]
script = ExtResource("2")
text = "Hold the narrows until day 7."
day = 7

[sub_resource type="Resource" id="Column_saved"]
script = ExtResource("4")
flag = &"column_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Watch_saved"]
script = ExtResource("4")
flag = &"coast_watch_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Shrine_saved"]
script = ExtResource("4")
flag = &"shrine_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Three retreats met on one road and stopped retreating, Voss. Aurora and the League are behind this line with you now."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "It isn't my line any more. It's ours. Draeg's spearhead hasn't slowed down; it's run out of ground to go round."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "My picket bought a day at the seawall. I'll spend today the same way, on your flank."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Hold what's yours. I'll hold what's mine. First time in six weeks that means anything."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "The narrows held. First time since the crossing his column's stopped instead of advancing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "We've got a base behind us now and an alliance on either flank. Both are new. Give me a week and I'll be spending them like they'd always been there."

[sub_resource type="Resource" id="Trigger_day_2"]
script = ExtResource("6")
day = 2

[sub_resource type="Resource" id="Trigger_column_saved"]
script = ExtResource("7")
condition = SubResource("Column_saved")

[sub_resource type="Resource" id="Trigger_watch_saved"]
script = ExtResource("7")
condition = SubResource("Watch_saved")

[sub_resource type="Resource" id="Trigger_shrine_saved"]
script = ExtResource("7")
condition = SubResource("Shrine_saved")

[sub_resource type="Resource" id="Spawn_picket_foot"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(3, 2)

[sub_resource type="Resource" id="Spawn_picket_scout"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(5, 2)

[sub_resource type="Resource" id="Spawn_meridian_company"]
