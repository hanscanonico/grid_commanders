[gd_resource type="Resource" script_class="MissionDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="8"]
[ext_resource type="Resource" path="res://data/units/md_tank.tres" id="9"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="10"]

[sub_resource type="Resource" id="Gate_carrow_opened_the_east"]
script = ExtResource("4")
flag = &"carrow_early"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Objective_hold_iron_hill"]
script = ExtResource("2")
text = "Hold Iron Hill until day 7."
day = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Vance is committing a heavier column than anything we've faced since the crossing. She means to break the line in one push."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "My answer hasn't changed. Hold, refuse, hold again — we don't have to advance today, only not break."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Second Wind's charged if you need the extra swing. I'd rather you didn't, but I'd rather you had it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "I'll take having it. Doesn't mean I plan on needing it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Her push spent itself against ground that refused to give. You're standing exactly where you started — that's the whole win."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"iris_colt"
text = "Every unit that comes back off this line is one Second Wind found a reason to keep fighting."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_heavy"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(16, 5)

[sub_resource type="Resource" id="Spawn_escort"]
script = ExtResource("8")
unit_type = ExtResource("10")
cell = Vector2i(16, 6)

[sub_resource type="Resource" id="Effect_the_second_column"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_heavy"), SubResource("Spawn_escort")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"iona_vance"
text = "The second column is on your line, Colt. Balance the books or be balanced."

[sub_resource type="Resource" id="Event_the_second_column"]
script = ExtResource("5")
id = &"the_second_column"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_second_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"lf11_iron_hill"
title = "Iron Hill"
location = "The eastern rise, allied front"
map_path = "res://maps/campaign/the_long_front/lf11_iron_hill.txt"
unlock_requires = SubResource("Gate_carrow_opened_the_east")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"iris_colt",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_iron_hill")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_second_column")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Iron Hill broke, and the allied front lost the high ground it had held since the narrows."
