[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_carrow"]
script = ExtResource("2")
text = "Take Carrow and open the crossing."
cell = Vector2i(10, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Carrow's the one bridge east for forty miles. Vale's engineers have been digging in around it since the line stopped moving."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Every day the works harden. We take the crossing now, or the alliance never takes it at all."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Vale's second trench line is still open. That's the window — it won't stay that way."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Then we don't wait for it to close. Moving now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "Carrow falls before the second trench line closes. Road east is open for the first time since the crossing."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Marking it on the map. Already counting the properties beyond it."

