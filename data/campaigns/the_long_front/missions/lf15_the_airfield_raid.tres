[gd_resource type="Resource" script_class="MissionDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/fighter.tres" id="10"]

[sub_resource type="Resource" id="Gate_ferrow_still_funded"]
script = ExtResource("4")
flag = &"cities_burned"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Objective_take_the_airfield"]
script = ExtResource("2")
text = "Take the airfield before it fields anything."
cell = Vector2i(12, 3)

[sub_resource type="Resource" id="Failure_day_8"]
script = ExtResource("5")
text = "The strip was still Ferrow's on day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "Ferrow's turned a captured airfield into a raiding base against the advance. Every day it stands, the highlands cost more."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "Then I take it back before it fields anything that flies. Give me the fastest approach you've got."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "North ridge, no cover, but it's the only route that beats his garrison to the strip."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "North ridge it is. In the air before he knows we're moving."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "The airfield changes hands before a single interceptor lifts off it. His raiders scatter into the passes on foot."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"perrin_ash"
text = "Logging the field as recovered production, not just recovered ground. That's the part that matters."

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("7")
day = 5

[sub_resource type="Resource" id="Spawn_interceptor"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Effect_the_strip_is_live"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_interceptor")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"dane_ferrow"
text = "Strip's live, Ash. Look up."

[sub_resource type="Resource" id="Event_the_strip_is_live"]
script = ExtResource("6")
id = &"the_strip_is_live"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_the_strip_is_live")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"lf15_the_airfield_raid"
title = "The Airfield Raid"
location = "The Iron highlands, eastern passes"
map_path = "res://maps/campaign/the_long_front/lf15_the_airfield_raid.txt"
unlock_requires = SubResource("Gate_ferrow_still_funded")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"perrin_ash",
2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_airfield")])
failures = Array[Resource]([SubResource("Failure_day_8")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_strip_is_live")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The airfield stayed Ferrow's, and the advance started paying for it in aircraft it never saw coming."
