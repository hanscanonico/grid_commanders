briefing = Array[String]([
"Draeg's third column pushes into the League's home trees. Ivar Thorne trades open ground for cover his enemy cannot drive through.",
"The woods will not stop tanks forever, but they will slow them long enough to matter. Hold the road until day 6."
])
victory = Array[String]([
"The column ground to a crawl in the tree line and never found the road it needed. Thorne calls the woods a fair trade.",
"He falls back deeper into the League's ground anyway. There is more forest to lose."
])
defeat = "The trees slowed Draeg down, but not enough — the road broke and the column marched on through open ground."
