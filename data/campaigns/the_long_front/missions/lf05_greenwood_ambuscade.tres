[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_hold_the_woods"]
script = ExtResource("2")
text = "Hold the greenwood road until day 6."
day = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Draeg's third column is into our home trees, Thorne. Open ground is gone — this is what's left to trade."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Then we trade cover for time. The woods won't stop tanks forever, but they'll slow them long enough."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "Six days of slowing costs us the tree line either way. Just tell me it's worth losing."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Everything's worth losing if it buys the road. Hold until day six — that's the whole fight."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"ines_calder"
text = "The column ground to a crawl in the tree line. Never found the road it needed."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "Fair trade. We fall back deeper into League ground anyway — there's more forest to lose."

[resource]
