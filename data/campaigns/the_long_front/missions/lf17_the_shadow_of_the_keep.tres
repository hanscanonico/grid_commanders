[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_the_outpost"]
script = ExtResource("2")
text = "Take Orlov's outpost base."
cell = Vector2i(16, 7)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Draeg's fortress is a day's march past this outpost. Orlov's holding it with everything the Dominion has left to spare."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "Then I clear the approach. Nothing about the final push works if this ground's still contested behind it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Take your time on it. We'd rather arrive late than arrive short a flank."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "I trust ground more than I trust a clock. Give me both and I'll use them right."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "The outpost falls. For the first time the keep itself is visible from allied ground."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "Sending word back down the line. The road to Draeg is open."

[resource]
script = ExtResource("1")
id = &"lf17_the_shadow_of_the_keep"
title = "The Shadow of the Keep"
location = "The last outpost before Draeg's keep"
map_path = "res://maps/campaign/the_long_front/lf17_the_shadow_of_the_keep.txt"
player_team = 1
ai_teams = Array[int]([2])
