[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="8"]

[sub_resource type="Resource" id="Battery_silenced"]
script = ExtResource("4")
flag = &"battery_silenced"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Battery_standing"]
script = ExtResource("4")
flag = &"battery_silenced"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_take_the_outpost"]
script = ExtResource("2")
text = "Capture Orlov's outpost base."
cell = Vector2i(16, 7)

[sub_resource type="Resource" id="Failure_short_a_flank"]
script = ExtResource("5")
text = "More than nine units lost, from any cause — nothing left to arrive with."
max_losses = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Draeg's fortress is a day's march past this outpost. Orlov's holding it with everything the Dominion has left to spare."

[sub_resource type="Resource" id="Line_1a"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "The pass battery is scrap, so nothing shells this approach while you clear it. That detour we argued about is paying for itself by the hour."
requires = SubResource("Battery_silenced")

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Morn's battery came out of the pass with him and it ranges this hill. Don't bunch up on the open ground. He only needs you to stand still once."
requires = SubResource("Battery_standing")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "I clear the approach, then. Nothing about the final push works if this ground's still contested behind it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Take your time on it. We'd rather arrive late than arrive short a flank."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "I trust ground more than I trust a clock. Give me both and I'll use them right."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "The outpost falls. For the first time the keep itself is visible from allied ground."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"nia_rowan"
text = "Sending word back down the line. The road to Draeg is open."

[sub_resource type="Resource" id="Trigger_orlov_is_spent"]
script = ExtResource("7")
team = 2
bound = 0
count = 4

[sub_resource type="Resource" id="Effect_the_last_of_the_purse"]
script = ExtResource("8")
team = 2
amount = 8000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Everything the Dominion has left to spare is standing on this hill. Come up and take it. There's nothing behind us but the keep."

[sub_resource type="Resource" id="Event_everything_left_to_spare"]
script = ExtResource("6")
id = &"everything_left_to_spare"
triggers = Array[Resource]([SubResource("Trigger_orlov_is_spent")])
effects = Array[Resource]([SubResource("Effect_the_last_of_the_purse")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("4")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("3")
speaker = &"cass_orlov"
text = "Everything the Dominion had left to spare is still standing on this hill. So is the outpost. The keep's as far off tonight as it was this morning."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "More than nine units gone and the outpost still standing. That's nothing left to arrive with. I said late was better than short a flank."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Orlov's outpost held and the keep is still a day's march past it. Eleven weeks to get within sight of the thing. We're not in sight of it tonight."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"lf17_the_shadow_of_the_keep"
title = "The Shadow of the Keep"
location = "The last outpost before Draeg's keep"
map_path = "res://maps/campaign/the_long_front/lf17_the_shadow_of_the_keep.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"nia_rowan",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_outpost")])
failures = Array[Resource]([SubResource("Failure_short_a_flank")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_everything_left_to_spare")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1a"), SubResource("Line_1b"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3")])
