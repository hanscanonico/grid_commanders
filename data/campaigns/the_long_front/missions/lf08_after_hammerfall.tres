[sub_resource type="Resource" id="Objective_break_the_garrison"]
script = ExtResource("5")
text = "Break the garrison Morn left holding the ashes."
tag = &"ruin_garrison"

[sub_resource type="Resource" id="Objective_hold_averyn"]
script = ExtResource("2")
text = "Retake Averyn's ground and keep it two days."
cell = Vector2i(9, 5)
days = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Averyn had barely any garrison. Morn's Command Power hit it overnight and left nothing standing to defend."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "We're not marching to save the town. There is no town. We're marching so he doesn't get to keep the ground it stood on."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Understood. No garrison to retake, just ashes and whatever he's left behind to hold them."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Take it anyway. Every acre he keeps after that is a second atrocity, not just the first."

[sub_resource type="Resource" id="Averyn_early"]
script = ExtResource("14")
flag = &"averyn_held"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Averyn_slow"]
script = ExtResource("14")
flag = &"averyn_held"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Averyn's ashes fly the alliance's colours again. I've filed happier reports about worse days."
requires = SubResource("Averyn_early")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Log it as ground recovered and move on. There'll be time to grieve it later — not today."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Averyn's ashes fly our colours again. Morn had time to put engineers in the ruins first, so we've bought the acres back at his asking price. Nothing about this week goes in the good column."
requires = SubResource("Averyn_slow")

[sub_resource type="Resource" id="Trigger_averyn_retaken"]
script = ExtResource("7")
cell = Vector2i(9, 5)
holder = 0

[sub_resource type="Resource" id="Spawn_bill_collector_armour"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(11, 4)

[sub_resource type="Resource" id="Spawn_bill_collector_foot"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(11, 5)

[sub_resource type="Resource" id="Effect_the_bill"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_bill_collector_armour"), SubResource("Spawn_bill_collector_foot")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "Take the ashes. I'll bill you for the ground underneath them."

[sub_resource type="Resource" id="Event_morn_bills_the_ground"]
script = ExtResource("6")
id = &"morn_bills_the_ground"
triggers = Array[Resource]([SubResource("Trigger_averyn_retaken")])
effects = Array[Resource]([SubResource("Effect_the_bill")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_before_the_garrison"]
script = ExtResource("13")
day = 5

[sub_resource type="Resource" id="Effect_averyn_held"]
script = ExtResource("12")
flag = &"averyn_held"
mode = 0
value = 1
note = "Averyn's ground flew allied colours again before Morn could garrison the ashes."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "His engineers never got a spade into the ruins, Ward. The land's back on our maps and he never garrisoned an acre of it."

[sub_resource type="Resource" id="Event_averyn_inside_the_week"]
script = ExtResource("6")
id = &"averyn_inside_the_week"
triggers = Array[Resource]([SubResource("Trigger_averyn_retaken"), SubResource("Trigger_before_the_garrison")])
effects = Array[Resource]([SubResource("Effect_averyn_held")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat"]
script = ExtResource("4")
text = "Morn's garrison dug in before Holt reached the ruins, and Averyn stayed his."

