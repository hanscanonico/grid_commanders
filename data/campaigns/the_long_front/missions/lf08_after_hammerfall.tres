[sub_resource type="Resource" id="Objective_break_the_garrison"]
script = ExtResource("5")
text = "Break the garrison Morn left holding the ashes."
tag = &"ruin_garrison"

[sub_resource type="Resource" id="Objective_hold_averyn"]
script = ExtResource("2")
text = "Retake Averyn's ground and keep it two days."
cell = Vector2i(9, 5)
days = 2

[sub_resource type="Resource" id="Failure_day_9"]
script = ExtResource("3")
text = "Morn garrisoned the ruins past day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Averyn had no garrison worth the name. Morn's Command Power fell on it overnight and left nothing standing to defend."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then we're not marching to save the town. We're marching so he doesn't get to keep the ground it stood on."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Understood. No garrison to retake, just ashes and whatever he's left behind to hold them."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Take it anyway. Every acre he keeps after that is a second atrocity, not just the first."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Averyn's ashes fly the alliance's colours again. Not a victory anyone's celebrating."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Log it as ground recovered and move on. There'll be time to grieve it later — not today."

[sub_resource type="Resource" id="Trigger_averyn_retaken"]
script = ExtResource("7")
cell = Vector2i(9, 5)
holder = 0

[sub_resource type="Resource" id="Spawn_bill_collector_armour"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(11, 4)

[sub_resource type="Resource" id="Spawn_bill_collector_foot"]
script = ExtResource("9")
unit_type = ExtResource("11")
cell = Vector2i(11, 5)

[sub_resource type="Resource" id="Effect_the_bill"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_bill_collector_armour"), SubResource("Spawn_bill_collector_foot")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "Take the ashes, Commander. I will bill you for the ground underneath them."

[sub_resource type="Resource" id="Event_morn_bills_the_ground"]
script = ExtResource("6")
id = &"morn_bills_the_ground"
triggers = Array[Resource]([SubResource("Trigger_averyn_retaken")])
effects = Array[Resource]([SubResource("Effect_the_bill")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_before_the_garrison"]
script = ExtResource("13")
day = 5

[sub_resource type="Resource" id="Effect_averyn_held"]
script = ExtResource("12")
flag = &"averyn_held"
mode = 0
value = 1
note = "Averyn's ground flew allied colours again before Morn could garrison the ashes."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "His engineers never got a spade into the ruins, Ward. The acres are back on our maps and they never became his garrison."

[sub_resource type="Resource" id="Event_averyn_inside_the_week"]
script = ExtResource("6")
id = &"averyn_inside_the_week"
triggers = Array[Resource]([SubResource("Trigger_averyn_retaken"), SubResource("Trigger_before_the_garrison")])
effects = Array[Resource]([SubResource("Effect_averyn_held")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"lf08_after_hammerfall"
title = "After Hammerfall"
location = "Averyn, allied front"
map_path = "res://maps/campaign/the_long_front/lf08_after_hammerfall.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"gideon_holt",
2: &"radek_morn"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_break_the_garrison"), SubResource("Objective_hold_averyn")])
failures = Array[Resource]([SubResource("Failure_day_9")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_morn_bills_the_ground"), SubResource("Event_averyn_inside_the_week")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Morn's garrison dug in before Holt reached the ruins, and Averyn stayed his."
