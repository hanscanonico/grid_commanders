[gd_resource type="Resource" script_class="MissionDefinition" load_steps=29 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="7"]

[sub_resource type="Resource" id="Objective_hold_the_seawall"]
script = ExtResource("2")
text = "Hold the seawall road until day 5."
day = 5

[sub_resource type="Resource" id="Watch_saved"]
script = ExtResource("4")
flag = &"coast_watch_saved"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Watch_lost"]
script = ExtResource("4")
flag = &"coast_watch_saved"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Rook's picket bought a day. Cost him half his force, and the port's still emptying out below you, Quill."

[sub_resource type="Resource" id="Line_1a"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "His coast watch came inland with him, so the quay knows who's still in the district and how many boats that takes."
requires = SubResource("Watch_saved")

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "His coast watch never got off the beach road, so nobody at the quay has a list. We load until the boats are full and hope that was everyone."
requires = SubResource("Watch_lost")

[sub_resource type="Resource" id="Line_1c"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The Concord lent us you and your arithmetic. They don't send a flag. They never have."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"lyra_quill"
text = "Five days, then. Give me the odds on the seawall holding that long."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Worse than yesterday's, better than tomorrow's. That's the only trend I can promise."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"lyra_quill"
text = "Good enough to bet on. Let the last boats clear — that is the whole job."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Last boat clears the harbour mouth as your line finally breaks. I have both times written down and they are the same minute."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"lyra_quill"
text = "The port is his. Nobody left in it was worth the keeping."

[sub_resource type="Resource" id="Trigger_day_4"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Effect_the_district_is_yours"]
script = ExtResource("7")
team = 1
points = 5000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "Last boat is past the harbour wall, Quill. Whatever's still in the district is yours to spend now."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("3")
speaker = &"lyra_quill"
text = "Good. Then the odds only have to hold one more day."

[sub_resource type="Resource" id="Event_the_port_is_empty"]
script = ExtResource("5")
id = &"the_port_is_empty"
triggers = Array[Resource]([SubResource("Trigger_day_4")])
effects = Array[Resource]([SubResource("Effect_the_district_is_yours")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_routed"]
script = ExtResource("4")
flag = &"run:cause"
at_least = 1
at_most = 1

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The seawall's down and the harbour's still full of boats. They can stay full. Nothing in that port's going anywhere now."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "Your line broke a day short of the last boat. Ask the quay what a day's worth. I already know."
requires = SubResource("Run_routed")

[sub_resource type="Resource" id="Line_defeat_3"]
script = ExtResource("3")
speaker = &"orin_flux"
text = "The wall gave with the harbour still full. I have the boat count and the day count. They never met."

[resource]
script = ExtResource("1")
id = &"lf04_seawall_retreat"
title = "Seawall Retreat"
location = "The Seawall district, Aurora Compact"
map_path = "res://maps/campaign/the_long_front/lf04_seawall_retreat.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"lyra_quill",
2: &"viktor_draeg"
}
fog_enabled = false
difficulty = &"easy"
objectives = Array[Resource]([SubResource("Objective_hold_the_seawall")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_port_is_empty")])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1a"), SubResource("Line_1b"), SubResource("Line_1c"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2"), SubResource("Line_defeat_3")])
