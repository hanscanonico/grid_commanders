[ext_resource type="Resource" path="res://data/units/tank.tres" id="9"]

[sub_resource type="Resource" id="Objective_hold_five_cities"]
script = ExtResource("2")
text = "Hold five of the highland cities."
count = 5
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "Vance is throwing a second heavy column into the passes to keep the highland cities out of our hands."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "Mixed force, no domain advantage on rock and passes. We take and hold five of them anyway."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "Seven cities, one column trying to stand in front of every one of them. Move faster than she can shift it between them and she loses six saving one."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "Speed it is. Weather's clear — that won't last either."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"rhea_sol"
text = "Five of the highland cities fly allied colours by nightfall. Her column falls back deeper into the highlands."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"halden_marr"
text = "We dig in on ground that produces for the front instead of against it. I've swapped a bad coast for a good ridge and I'd do it again tomorrow."

[sub_resource type="Resource" id="Trigger_day_5"]
script = ExtResource("5")
day = 5

[sub_resource type="Resource" id="Spawn_second_column_heavy"]
script = ExtResource("7")
unit_type = ExtResource("8")
cell = Vector2i(15, 7)

[sub_resource type="Resource" id="Spawn_second_column_escort"]
script = ExtResource("7")
unit_type = ExtResource("9")
cell = Vector2i(17, 7)

[sub_resource type="Resource" id="Effect_the_second_column"]
script = ExtResource("6")
team = 2
units = Array[Resource]([SubResource("Spawn_second_column_heavy"), SubResource("Spawn_second_column_escort")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"iona_vance"
text = "The first column bought me the passes. This one buys me the time to keep them."

[sub_resource type="Resource" id="Event_the_second_column"]
script = ExtResource("4")
id = &"the_second_column"
triggers = Array[Resource]([SubResource("Trigger_day_5")])
effects = Array[Resource]([SubResource("Effect_the_second_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"lf14_the_high_passes"
title = "The High Passes"
location = "The Iron highlands, central passes"
map_path = "res://maps/campaign/the_long_front/lf14_the_high_passes.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"halden_marr",
2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_five_cities")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_second_column")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Vance held enough of the highland cities to bleed the advance dry, and the passes stayed contested."
