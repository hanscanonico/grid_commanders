[sub_resource type="Resource" id="Objective_take_draeg_hq"]
script = ExtResource("2")
text = "Capture Draeg's headquarters."
cell = Vector2i(18, 9)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Every nation his spearhead drove back in the first week is standing on this ground together, Voss. You bought that first morning with four units and a river."

[sub_resource type="Resource" id="Line_1a"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Averyn's ground flies our colours behind us, too. Not the town. The ground was all there was left to take back."
requires = SubResource("Averyn_held")

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Averyn's ground came back to us late, and Morn made us pay for every acre. Whatever happens on this hill, that is the one bill we never got out from under."
requires = SubResource("Averyn_lost")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "I'll finish what I started there. Take Draeg's headquarters — there's nowhere left behind it for this war to go."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "Eleven weeks, Voss. I confess I did not expect to see you standing on this side of the line."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Neither did I, Marshal. Let's not waste either of our time pretending this ends any other way."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The uniform outlasts the officer who wears it. Remember that, when you sit behind this desk."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "The keep falls. The line that ran from the customs road to the highlands finally has an end written on it."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "You're standing where his desk stood this morning, Voss. Don't sit down yet. Three nations have a great deal to rebuild and they'll want you awake for it."

[sub_resource type="Resource" id="Trigger_day_3"]
