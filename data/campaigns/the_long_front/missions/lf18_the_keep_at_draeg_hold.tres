[sub_resource type="Resource" id="Event_line_ward"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Meridian's on your left, Aurora's on your right, and the League is behind both. That is the whole of what eleven weeks bought."

[sub_resource type="Resource" id="Event_line_voss"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then it was worth the road. Open the gate."

[sub_resource type="Resource" id="Event_line_meridian"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "The column I held the customs road for is standing on this hill, General. I'd like you to see it."

[sub_resource type="Resource" id="Event_line_aurora"]
script = ExtResource("3")
speaker = &"cassian_rook"
text = "The coast watch I got off that beach kept every name on its lists. Aurora came looking for the officer who bought them the morning."

[sub_resource type="Resource" id="Event_line_league"]
script = ExtResource("3")
speaker = &"ivar_thorne"
text = "The shrine's keepers are alive because your line held the grove. The League does not send a company for less."

[sub_resource type="Resource" id="Event_line_reed"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "Averyn's own battery, turned round and pointed at the gate. I have waited a long time to write that order."

[sub_resource type="Resource" id="Event_the_allies_arrive"]
