[sub_resource type="Resource" id="Event_line_draeg_wing"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The keep kept one wing back, Voss, and it's up now. Every hull you brought onto this hill is under it."

[sub_resource type="Resource" id="Event_the_keeps_own_wing"]
