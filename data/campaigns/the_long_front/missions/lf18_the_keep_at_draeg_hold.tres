at_most = -1

[sub_resource type="Resource" id="Run_first"]
script = ExtResource("4")
flag = &"run:first"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "The keep holds, Voss. Eleven weeks to reach this gate and one morning to lose it. The uniform stays where it was."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The alliance broke against the one wall it couldn't move. Three nations climbed eleven weeks to this gate. I'm writing the report from the bottom of the hill."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3")
speaker = &"viktor_draeg"
text = "Nine days for my keep. I held the customs road for less."
requires = SubResource("Run_par")

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Count the wagons. Nearly all of them made the hill."
requires = SubResource("Run_few_losses")

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Count the wagons that didn't make this hill before anyone says the word won."
requires = SubResource("Run_many_losses")

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Nine days, no wagon left behind and every flag on this hill. Write it up as a victory, Voss. He'd know the difference and so would you."
requires = SubResource("Run_full")

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Up this hill again. The report reads better than the last one did. I'll keep the first one anyway, for comparison."
requires = SubResource("Run_best")
unless = SubResource("Run_first")

