[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_hold_the_causeway"]
script = ExtResource("2")
text = "Hold the river line until day 6."
day = 6

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The Arden won't stop his infantry, but it stops his tanks. Everything that matters funnels onto one bridge."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then the bridge is where we make him pay for every yard. Hold the crossing, nothing else."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Every hour it costs him is an hour the column gains on the ridge road."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "Then we count the fight in hours, not ground. That's a trade I can make."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The bridge held long enough. His armour's still stacked on the wrong bank as the last wagon clears the ridge."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"mara_voss"
text = "It's a delay, not a victory. I know the difference — keep moving."

