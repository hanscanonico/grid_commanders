[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_the_camp"]
script = ExtResource("2")
text = "Take Orlov's forward base."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Orlov's fortified camp is the last thing standing between us and the foothills of the Iron highlands."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Then it's the last thing standing between defence and offence. Take the camp, and the front stops holding and starts moving."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Six weeks of retreat, three nations, one alliance — and now we're the ones advancing. Feels strange to say out loud."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Say it anyway. We'll need to believe it before the highlands do."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The camp falls, and with it the last piece of ground his spearhead took in the opening week."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "I'm looking east, past the foothills, to where the highlands start. We've never fought there before."

[resource]
script = ExtResource("1")
