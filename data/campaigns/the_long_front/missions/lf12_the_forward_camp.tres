[gd_resource type="Resource" script_class="MissionDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="7"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="8"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="9"]

[sub_resource type="Resource" id="Objective_take_the_camp"]
script = ExtResource("2")
text = "Take Orlov's forward base."
cell = Vector2i(13, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Orlov's fortified camp is the last thing standing between us and the foothills of the Iron highlands."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Then it's the last thing standing between defence and offence. Take the camp, and the front stops holding and starts moving."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Six weeks of retreat, three nations, one alliance — and now we're the ones advancing. Feels strange to say out loud."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Say it anyway. We'll need to believe it before the highlands do."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The camp falls, and with it the last piece of ground his spearhead took in the opening week."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "I'm looking east, past the foothills, to where the highlands start. We've never fought there before."

[sub_resource type="Resource" id="Trigger_road_city_ours"]
script = ExtResource("5")
cell = Vector2i(9, 5)
holder = 0

[sub_resource type="Resource" id="Spawn_forward_armour"]
script = ExtResource("7")
unit_type = ExtResource("8")
cell = Vector2i(2, 3)

[sub_resource type="Resource" id="Spawn_forward_foot"]
script = ExtResource("7")
unit_type = ExtResource("9")
cell = Vector2i(3, 2)

[sub_resource type="Resource" id="Effect_bring_the_line_forward"]
script = ExtResource("6")
team = 1
units = Array[Resource]([SubResource("Spawn_forward_armour"), SubResource("Spawn_forward_foot")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("3")
speaker = &"alina_ward"
text = "Road city's ours. Bring the line forward — all of it, not a screen."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Six weeks I have written the word fall back. This is the first order that says the other thing."

[sub_resource type="Resource" id="Event_the_line_moves"]
script = ExtResource("4")
id = &"the_line_moves"
triggers = Array[Resource]([SubResource("Trigger_road_city_ours")])
effects = Array[Resource]([SubResource("Effect_bring_the_line_forward")])
once = true
lines = Array[Resource]([SubResource("Event_line_1"), SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"lf12_the_forward_camp"
title = "The Forward Camp"
location = "The foothill camp, allied front"
map_path = "res://maps/campaign/the_long_front/lf12_the_forward_camp.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
1: &"alina_ward",
2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_camp")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_line_moves")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "Orlov's camp held, and the first order that said advance was filed unsent."
