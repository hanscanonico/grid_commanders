[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="3"]

[sub_resource type="Resource" id="Objective_take_the_garrison"]
script = ExtResource("2")
text = "Take Morn's garrison at the pass."
cell = Vector2i(15, 3)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The pass carries Averyn's name now. Morn's garrison shields it like the town he flattened were worth defending."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I've waited three weeks for this fight, Holt. I don't intend to lose it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "Nobody's asking you to. Just don't make it about the ashes — make it about the ground."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "It's always about the ground with me. That's how I win it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3")
speaker = &"gideon_holt"
text = "The garrison breaks. Morn falls back east with nothing to show for what he spent at Averyn."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3")
speaker = &"tomas_reed"
text = "I won't call it justice. I'll call it the next line on the map, and move the army onto it."

[resource]
