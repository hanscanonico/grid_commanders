[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2")
text = "Three nations lost the same morning and only heard about each other six days later. Each of them counted the loss in something different: a road, a harbour, a wood."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Meridian's account for the week. The customs column got behind Voss's line, wagon for wagon, and is quartered east of the Arden."
requires = SubResource("Column_saved")

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2")
speaker = &"gideon_holt"
text = "Meridian's account for the week. Not all of the customs column got behind the line, and I'm not writing down how much did."
requires = SubResource("Column_lost")

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2")
speaker = &"orin_flux"
text = "Aurora's is shorter. The port's gone, the coast watch is inland with its lists, and I can still tell you where every name on them is."
requires = SubResource("Watch_saved")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2")
speaker = &"orin_flux"
text = "Aurora's is shorter. The port's gone, the coast watch was lost with the beach road, and nobody's left who can tell me who else was."
requires = SubResource("Watch_lost")

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("2")
speaker = &"ines_calder"
text = "The League lost the Greenwood and kept the shrine's keepers. Every one of them carried out. The wood grows back; they wouldn't have."
requires = SubResource("Shrine_saved")

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("2")
speaker = &"ines_calder"
text = "The League lost the Greenwood and the grove with it. The keepers were still in the shrine when the fighting reached it, and I will carry that."
requires = SubResource("Shrine_lost")

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("2")
speaker = &"mara_voss"
text = "Three retreats, one road. They all arrive at the narrows, and past that there is nowhere left to arrive separately."

[resource]
script = ExtResource("1")
after_block = 0
title = "Alone"
lines = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6"), SubResource("Line_7"), SubResource("Line_8")])
