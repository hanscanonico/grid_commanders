[sub_resource type="Resource" id="Objective_hold_the_first_depot"]
script = ExtResource("5")
text = "Take the west depot on the road and keep it three whole days."
cell = Vector2i(6, 4)
days = 3

[sub_resource type="Resource" id="Objective_take_the_second_depot"]
script = ExtResource("2")
text = "Take the depot a square south of the road."
cell = Vector2i(10, 5)

[sub_resource type="Resource" id="Objective_take_the_third_depot"]
script = ExtResource("2")
text = "Take the east depot where the road runs out."
cell = Vector2i(14, 4)

[sub_resource type="Resource" id="Failure_the_chain_was_broken_before_day_10"]
script = ExtResource("3")
text = "Day 10 passed with a depot in the chain still his."
last_day = 10

[sub_resource type="Resource" id="Failure_more_than_four_lost"]
script = ExtResource("6")
text = "More than five of ours were lost holding the road."
max_losses = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three depots, three line items on the forged ledger. Ferrow means to take the whole chain in one sweep."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "One road, no cover on it, three depots strung along it. That is artillery country — I can hold a depot I am not standing on."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Two of the depots sit on the road itself, west and east. The middle one is a square south of it, off the highway — his sweep has to come off the road to reach that one."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "All three, and the middle one never came under fire at all — I had the road ranged before his sweep reached it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow's sweep found nothing to sweep."

[sub_resource type="Resource" id="Trigger_middle_taken"]
script = ExtResource("8")
cell = Vector2i(10, 5)
holder = 0

[sub_resource type="Resource" id="Spawn_raider_east"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(16, 4)

[sub_resource type="Resource" id="Spawn_raider_behind"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(3, 4)

[sub_resource type="Resource" id="Effect_both_ends"]
script = ExtResource("12")
team = 2
units = Array[Resource]([SubResource("Spawn_raider_east"), SubResource("Spawn_raider_behind")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Middle of the chain. Bold. Now hold both ends of it at once."

[sub_resource type="Resource" id="Event_both_ends_at_once"]
script = ExtResource("7")
id = &"both_ends_at_once"
triggers = Array[Resource]([SubResource("Trigger_middle_taken")])
effects = Array[Resource]([SubResource("Effect_both_ends")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Already_paid"]
script = ExtResource("11")
flag = &"ferrow_bounty"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_already_paid"]
script = ExtResource("10")
condition = SubResource("Already_paid")

[sub_resource type="Resource" id="Trigger_day_three"]
script = ExtResource("9")
day = 3

[sub_resource type="Resource" id="Spawn_bought_raider"]
script = ExtResource("13")
unit_type = ExtResource("14")
cell = Vector2i(16, 6)

[sub_resource type="Resource" id="Effect_bought_raider"]
script = ExtResource("12")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_raider")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "What your border towns paid me, I have spent on this road. You funded him yourself, Commander."

[sub_resource type="Resource" id="Event_spent_the_bounty"]
script = ExtResource("7")
id = &"spent_the_bounty"
triggers = Array[Resource]([SubResource("Trigger_already_paid"), SubResource("Trigger_day_three")])
effects = Array[Resource]([SubResource("Effect_bought_raider")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc03_the_supply_chain"
title = "The Supply Chain"
location = "The depot road, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc03_the_supply_chain.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"rhea_sol",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_first_depot"), SubResource("Objective_take_the_second_depot"), SubResource("Objective_take_the_third_depot")])
failures = Array[Resource]([SubResource("Failure_the_chain_was_broken_before_day_10"), SubResource("Failure_more_than_four_lost")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_both_ends_at_once"), SubResource("Event_spent_the_bounty")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "One depot fell, and Ferrow's raiders used it to roll up the other two."
