[gd_resource type="Resource" script_class="MissionDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]

[sub_resource type="Resource" id="Objective_hold_the_first_depot"]
script = ExtResource("2")
text = "Hold the first depot."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Objective_hold_the_second_depot"]
script = ExtResource("2")
text = "Hold the second depot."
cell = Vector2i(10, 5)

[sub_resource type="Resource" id="Objective_hold_the_third_depot"]
script = ExtResource("2")
text = "Hold the third depot."
cell = Vector2i(14, 4)

[sub_resource type="Resource" id="Failure_the_chain_was_broken_before_day_10"]
script = ExtResource("3")
text = "The chain was broken before day 10."
last_day = 10

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three depots, three line items on the forged ledger. Ferrow means to take the whole chain in one sweep."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "Six to ten days of exposure on each, depending how thin he spreads. Hold all three and none of that math works for him."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Hold all three and the ledger's claim on this road is finished."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"rhea_sol"
text = "All three depots held. The supply chain never left our hands, not for a day."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow's sweep found nothing to sweep."

[resource]
script = ExtResource("1")
id = &"tc03_the_supply_chain"
