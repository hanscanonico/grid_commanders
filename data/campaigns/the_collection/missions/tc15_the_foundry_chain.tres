[sub_resource type="Resource" id="Objective_take_the_first_foundry_depot"]
script = ExtResource("2")
text = "Take the first foundry depot."
cell = Vector2i(6, 5)

[sub_resource type="Resource" id="Objective_take_the_second_foundry_depot"]
script = ExtResource("2")
text = "Take the second foundry depot."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_take_the_third_foundry_depot"]
script = ExtResource("2")
text = "Take the third foundry depot."
cell = Vector2i(14, 5)

[sub_resource type="Resource" id="Failure_the_chain_stayed_iron_s_past_day_11"]
script = ExtResource("3")
text = "The chain stayed Iron's past day 11."
last_day = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three depots, one road, all feeding the same production line. Morn's defending output, not ground — he'll spend units to keep it running."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "Then we make it cost him more than it's worth. Take all three, but keep the column spread while we do it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Morn's Hammerfall is charged and waiting — give him nothing worth the charge."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "The chain is ours, foundry by foundry. Nobody bunched up, and nobody paid for it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The production line stopped the moment the third depot fell."

[resource]
script = ExtResource("1")
