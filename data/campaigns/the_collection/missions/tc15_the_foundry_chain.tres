[gd_resource type="Resource" script_class="MissionDefinition" load_steps=37 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="13"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="14"]

[sub_resource type="Resource" id="Objective_take_the_first_foundry_depot"]
script = ExtResource("2")
text = "Capture the west depot on the road."
cell = Vector2i(6, 5)

[sub_resource type="Resource" id="Objective_take_the_second_foundry_depot"]
script = ExtResource("2")
text = "Capture the depot a square north of the road."
cell = Vector2i(10, 4)

[sub_resource type="Resource" id="Objective_take_the_third_foundry_depot"]
script = ExtResource("2")
text = "Capture the east depot at the end of the chain."
cell = Vector2i(14, 5)

[sub_resource type="Resource" id="Failure_the_column_bunched"]
script = ExtResource("5")
text = "More than nine units lost — the column stopped being spread."
max_losses = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three depots on one road, all feeding the same production line. Morn is defending output rather than ground, and he'll spend units to keep it running."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "Then we make it cost more than it's worth. Take all three, and keep the column spread out while we do."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Morn's Hammerfall is charged and waiting — give him nothing worth the charge."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"tomas_reed"
text = "The chain is ours, foundry by foundry. Nobody bunched up, and nobody paid for it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The production line stopped the moment the third depot fell."

[sub_resource type="Resource" id="Trigger_middle_depot_taken"]
script = ExtResource("7")
cell = Vector2i(10, 4)
holder = 0

[sub_resource type="Resource" id="Spawn_line_replacement"]
script = ExtResource("10")
unit_type = ExtResource("13")
cell = Vector2i(15, 4)

[sub_resource type="Resource" id="Effect_line_replacement"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_line_replacement")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "One depot off the line. The line replaced it the same afternoon. Bring more."

[sub_resource type="Resource" id="Event_the_line_replaces_it"]
script = ExtResource("6")
id = &"the_line_replaces_it"
triggers = Array[Resource]([SubResource("Trigger_middle_depot_taken")])
effects = Array[Resource]([SubResource("Effect_line_replacement")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_nine"]
script = ExtResource("8")
day = 9

[sub_resource type="Resource" id="Effect_hammerfall_charge"]
script = ExtResource("11")
team = 2
points = 8000

[sub_resource type="Resource" id="Effect_morn_charged"]
script = ExtResource("12")
flag = &"morn_charged"
value = 1
note = "The foundry chain ran nine days, and Morn banked every one of them."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "Nine days, and the line is still running. So am I."

[sub_resource type="Resource" id="Event_the_line_still_runs"]
script = ExtResource("6")
id = &"the_line_still_runs"
triggers = Array[Resource]([SubResource("Trigger_day_nine")])
effects = Array[Resource]([SubResource("Effect_hammerfall_charge"), SubResource("Effect_morn_charged")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("14")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "The line is still running. It replaced everything you broke, the same afternoon, every afternoon. Bring more."

[sub_resource type="Resource" id="Line_defeat_2_failure"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "More than nine. The column bunched up and Hammerfall found it. Morn never spent a unit of production on us."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_2_tactical"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Reed's column got spread thin enough to be safe from Hammerfall and thin enough to lose to the line."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"tc15_the_foundry_chain"
title = "The Foundry Chain"
location = "The production road, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc15_the_foundry_chain.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"tomas_reed",
	2: &"radek_morn"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_first_foundry_depot"), SubResource("Objective_take_the_second_foundry_depot"), SubResource("Objective_take_the_third_foundry_depot")])
failures = Array[Resource]([SubResource("Failure_the_column_bunched")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_line_replaces_it"), SubResource("Event_the_line_still_runs")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2_failure"), SubResource("Line_defeat_2_tactical")])
