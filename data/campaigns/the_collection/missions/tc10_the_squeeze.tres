[gd_resource type="Resource" script_class="MissionDefinition" load_steps=33 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="11"]
[ext_resource type="Resource" path="res://data/units/mech.tres" id="12"]

[sub_resource type="Resource" id="Objective_hold_the_hq_until_day_7"]
script = ExtResource("2")
text = "Ride out the siege to day 7."
day = 7

[sub_resource type="Resource" id="Failure_the_hq_fell_before_day_7"]
script = ExtResource("3")
text = "Day 11 came and went with the siege still unbroken."
last_day = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale has three of the four towns and the income to match, and we've never been this far behind in the whole war."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Good. My units hit harder the worse they look, and by day seven they'll all look terrible. Hold. Let them get angry."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Reinforcements break the squeeze the moment they land."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Day seven. The siege broke, and I'm still standing to see it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's financing couldn't buy back what he lost holding it."

[sub_resource type="Resource" id="Trigger_day_five"]
script = ExtResource("6")
day = 5

[sub_resource type="Resource" id="Spawn_relief_tank"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(0, 6)

[sub_resource type="Resource" id="Spawn_relief_mech"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(0, 5)

[sub_resource type="Resource" id="Effect_relief_column"]
script = ExtResource("9")
team = 1
units = Array[Resource]([SubResource("Spawn_relief_tank"), SubResource("Spawn_relief_mech")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Relief on the west road. I told you I fight best with my back to something."

[sub_resource type="Resource" id="Event_relief_column"]
script = ExtResource("5")
id = &"relief_column"
triggers = Array[Resource]([SubResource("Trigger_day_five")])
effects = Array[Resource]([SubResource("Effect_relief_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Interest_drawn"]
script = ExtResource("8")
flag = &"vale_funded"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_interest_drawn"]
script = ExtResource("7")
condition = SubResource("Interest_drawn")

[sub_resource type="Resource" id="Trigger_day_three"]
script = ExtResource("6")
day = 3

[sub_resource type="Resource" id="Spawn_bought_tank"]
script = ExtResource("10")
unit_type = ExtResource("11")
cell = Vector2i(12, 2)

[sub_resource type="Resource" id="Effect_bought_tank"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_tank")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "The blockade paid for this one. You left it standing six days. This is what six days buys."

[sub_resource type="Resource" id="Event_bought_and_paid"]
script = ExtResource("5")
id = &"bought_and_paid"
triggers = Array[Resource]([SubResource("Trigger_interest_drawn"), SubResource("Trigger_day_three")])
effects = Array[Resource]([SubResource("Effect_bought_tank")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc10_the_squeeze"
title = "The Squeeze"
location = "The financial siege, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc10_the_squeeze.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"ivar_thorne",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_hq_until_day_7")])
failures = Array[Resource]([SubResource("Failure_the_hq_fell_before_day_7")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_relief_column"), SubResource("Event_bought_and_paid")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The squeeze held, and the last town fell with the HQ behind it."
