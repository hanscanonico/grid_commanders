[sub_resource type="Resource" id="Objective_hold_the_hq_until_day_7"]
script = ExtResource("2")
text = "Hold the HQ until day 7."
day = 7

[sub_resource type="Resource" id="Failure_the_hq_fell_before_day_7"]
script = ExtResource("3")
text = "The HQ fell before day 7."
last_day = 7

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale has three of the four towns and the income to match. This is the worst position of the war so far."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Good. I fight hardest with my back against something. Seven days — we hold."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Reinforcements break the squeeze the moment they land."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ivar_thorne"
text = "Day seven. The siege broke, and I'm still standing to see it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's financing couldn't buy back what he lost holding it."

