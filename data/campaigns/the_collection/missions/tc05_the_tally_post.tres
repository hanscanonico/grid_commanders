[gd_resource type="Resource" script_class="MissionDefinition" load_steps=29 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/capture_cell_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/destroy_unit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_destroyed_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="12"]

[sub_resource type="Resource" id="Objective_take_the_tally_post_between_the_pass"]
script = ExtResource("2")
text = "Take the tally post between the passes."
cell = Vector2i(8, 5)

[sub_resource type="Resource" id="Bonus_destroy_the_tally_courier"]
script = ExtResource("5")
text = "Destroy the courier carrying the running count."
tag = &"tally_courier"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The tally post is where Ferrow keeps his count of what the ledger claims. Burn it and the count goes back to nothing."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "I've had worse days than climbing two passes at once. We take it through whichever one he leaves thin."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Just take it before he reinforces both."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "The tally post is ours. Whatever Ferrow was counting, the count starts over."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Nothing owed, nothing collected. That is the sum he hates most."

[sub_resource type="Resource" id="Trigger_courier_taken"]
script = ExtResource("7")
tag = &"tally_courier"

[sub_resource type="Resource" id="Effect_forgery_proven"]
script = ExtResource("9")
flag = &"forgery_proven"
value = 1
note = "The courier's satchel put the running count in Ferrow's own hand."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "Got the courier. The whole count is in this satchel — and every line of it is in Ferrow's own hand."

[sub_resource type="Resource" id="Event_the_courier"]
script = ExtResource("6")
id = &"the_courier"
triggers = Array[Resource]([SubResource("Trigger_courier_taken")])
effects = Array[Resource]([SubResource("Effect_forgery_proven")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_five"]
script = ExtResource("8")
day = 5

[sub_resource type="Resource" id="Spawn_north_pass"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(13, 4)

[sub_resource type="Resource" id="Spawn_south_pass"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(13, 6)

[sub_resource type="Resource" id="Effect_both_passes_paid"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_north_pass"), SubResource("Spawn_south_pass")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Five days and you have taken nothing. The passes are paid for. Both of them."

[sub_resource type="Resource" id="Event_both_passes_paid"]
script = ExtResource("6")
id = &"both_passes_paid"
triggers = Array[Resource]([SubResource("Trigger_day_five")])
effects = Array[Resource]([SubResource("Effect_both_passes_paid")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc05_the_tally_post"
title = "The Tally Post"
location = "The forward reckoning, Meridian-Iron border"
map_path = "res://maps/campaign/the_collection/tc05_the_tally_post.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"iris_colt",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_tally_post_between_the_pass")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_destroy_the_tally_courier")])
events = Array[Resource]([SubResource("Event_the_courier"), SubResource("Event_both_passes_paid")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The post held, and the tally kept climbing in the raiders' favour."
