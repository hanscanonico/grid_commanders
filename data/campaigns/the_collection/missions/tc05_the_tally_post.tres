[sub_resource type="Resource" id="Objective_take_the_tally_post_between_the_pass"]
script = ExtResource("2")
text = "Take the tally post between the passes."
cell = Vector2i(8, 5)

[sub_resource type="Resource" id="Failure_the_tally_post_stood_past_day_9"]
script = ExtResource("3")
text = "The tally post stood past day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The tally post is where Ferrow keeps his running count of what the ledger claims. Burn it and the count resets to nothing."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "I've had worse days than climbing two passes at once. We take it through whichever one he leaves thin."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Just take it before he reinforces both."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"iris_colt"
text = "The tally post is ours. Whatever Ferrow was counting, the count starts over."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Zero owed, zero collected. He hates that math most of all."

