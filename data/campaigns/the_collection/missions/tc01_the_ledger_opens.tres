[sub_resource type="Resource" id="Objective_hold_the_customs_depot_two_days"]
script = ExtResource("2")
text = "Hold the customs depot the ledger names for two days."
cell = Vector2i(6, 4)
days = 2

[sub_resource type="Resource" id="Failure_the_depot_was_seized_before_day_8"]
script = ExtResource("3")
text = "The depot was seized before day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "A Directorate audit surfaced overnight, claiming this depot as payment on a debt that never existed. Ferrow's signature is all over it — he still steals off every kill he lands."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then he doesn't get the kills. His raiders don't carry the armor to trade evenly — hold formation and make him pay for every approach."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Hold the depot and the claim dies with it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The depot is ours. Whatever the ledger says, Ferrow left empty-handed."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "First entry in his forged book, and it's already a loss."

[resource]
script = ExtResource("1")
id = &"tc01_the_ledger_opens"
title = "The Ledger Opens"
location = "The customs depot, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc01_the_ledger_opens.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"alina_ward",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_customs_depot_two_days")])
failures = Array[Resource]([SubResource("Failure_the_depot_was_seized_before_day_8")])
bonus_objectives = Array[Resource]([])
par_day = 5
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The depot changed hands, and the forged ledger gained its first entry."
