[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="12"]

[sub_resource type="Resource" id="Objective_hold_the_customs_depot_two_days"]
script = ExtResource("2")
text = "Hold the customs depot the ledger names for two days."
cell = Vector2i(6, 4)
days = 2

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "A Directorate audit appeared overnight, claiming this depot as payment on a debt that never existed. Ferrow's signature is all over it, and he still takes a cut of every kill he lands."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then he doesn't get the kills. His raiders are too thin-skinned to trade evenly. Hold formation. Make him pay to come near us."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "It is one road end to end, with the depot square in the middle. The only cover is four stands of trees, so whatever he sends, you will watch it coming for two days first."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The depot is ours. Whatever the ledger says, Ferrow left empty-handed."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "First entry in his forged book, and it's already a loss."

[sub_resource type="Resource" id="Trigger_depot_taken"]
script = ExtResource("6")
cell = Vector2i(6, 4)
holder = 0

[sub_resource type="Resource" id="Spawn_collector"]
script = ExtResource("8")
unit_type = ExtResource("9")
cell = Vector2i(11, 4)

[sub_resource type="Resource" id="Effect_collectors_raider"]
script = ExtResource("7")
team = 2
units = Array[Resource]([SubResource("Spawn_collector")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Ground taken is ground I can price. Let's see what holding it costs you."

[sub_resource type="Resource" id="Event_ferrow_collects"]
script = ExtResource("5")
id = &"ferrow_collects"
triggers = Array[Resource]([SubResource("Trigger_depot_taken")])
effects = Array[Resource]([SubResource("Effect_collectors_raider")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_column_thinned"]
script = ExtResource("10")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Effect_bounty_banked"]
script = ExtResource("11")
flag = &"ferrow_bounty"
value = 1
note = "Ferrow was paid in wrecks on the customs road."

[sub_resource type="Resource" id="Effect_ferrow_charge"]
script = ExtResource("12")
team = 2
points = 3000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "There. Column's down to two and the depot hasn't even changed hands. I get paid by the wreck. Keep them coming."

[sub_resource type="Resource" id="Event_paid_off_the_kills"]
script = ExtResource("5")
id = &"paid_off_the_kills"
triggers = Array[Resource]([SubResource("Trigger_column_thinned")])
effects = Array[Resource]([SubResource("Effect_bounty_banked"), SubResource("Effect_ferrow_charge")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "One customs depot, taken. First entry posted. I dated it myself."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The depot's his, so the first line of the forged book reads true without him having to forge it."

[resource]
script = ExtResource("1")
id = &"tc01_the_ledger_opens"
title = "The Ledger Opens"
location = "The customs depot, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc01_the_ledger_opens.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"alina_ward",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_the_customs_depot_two_days")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_ferrow_collects"), SubResource("Event_paid_off_the_kills")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
