[gd_resource type="Resource" script_class="MissionDefinition" load_steps=35 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/flag_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="13"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_five_foundries"]
script = ExtResource("2")
text = "Hold three of the five foundries."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Interest_drawn"]
script = ExtResource("5")
flag = &"vale_funded"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Interest_denied"]
script = ExtResource("5")
flag = &"vale_funded"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This belt built the army that crossed our border. Take the majority. Then it builds ours instead."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vale's finished. His money isn't — what he earned off the blockade is in Vance's hands now."
requires = SubResource("Interest_drawn")

[sub_resource type="Resource" id="Line_1c"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Vance got Vale's belt and none of his money, because the blockade never paid him a coin."
requires = SubResource("Interest_denied")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Trees beside every one of those foundries. Sit in them. Let her walk onto the property and pay twice for ground I never left."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four of the foundries are out at the corners with trees beside them. The fifth is in the centre, where her whole line can reach it. Take the cheap four and let her keep the expensive one."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Three foundries, and I never came out of the trees to take one of them."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Her own production line is working against her."

[sub_resource type="Resource" id="Trigger_interest_drawn"]
script = ExtResource("7")
condition = SubResource("Interest_drawn")

[sub_resource type="Resource" id="Trigger_day_four"]
script = ExtResource("8")
day = 4

[sub_resource type="Resource" id="Effect_inherited_reserves"]
script = ExtResource("10")
team = 2
amount = 6000

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Vale's money outlived Vale. Three percent a day, and it's all still adding up."

[sub_resource type="Resource" id="Event_vales_money_outlives_him"]
script = ExtResource("6")
id = &"vales_money_outlives_him"
triggers = Array[Resource]([SubResource("Trigger_interest_drawn"), SubResource("Trigger_day_four")])
effects = Array[Resource]([SubResource("Effect_inherited_reserves")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_centre_taken"]
script = ExtResource("9")
cell = Vector2i(8, 6)
holder = 0

[sub_resource type="Resource" id="Spawn_belt_tank"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(14, 6)

[sub_resource type="Resource" id="Effect_belt_tank"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_belt_tank")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Take the middle and I will simply build around it."

[sub_resource type="Resource" id="Event_the_belt_answers"]
script = ExtResource("6")
id = &"the_belt_answers"
triggers = Array[Resource]([SubResource("Trigger_centre_taken")])
effects = Array[Resource]([SubResource("Effect_belt_tank")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "The belt built faster than you could break it. It's still adding up. I'll build around what's left of you."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Wren never came out of the trees, which suited Vance fine, since the foundries did all the walking."

[resource]
script = ExtResource("1")
id = &"tc16_out_producing_the_foundry"
title = "Out-Producing the Foundry"
location = "The production belt, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc16_out_producing_the_foundry.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"sable_wren",
	2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_five_foundries")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_vales_money_outlives_him"), SubResource("Event_the_belt_answers")])
par_day = 7
carry_in = true
carry_out = true
carry_floor_hp = 50
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1b"), SubResource("Line_1c"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
