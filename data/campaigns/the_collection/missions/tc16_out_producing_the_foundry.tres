[sub_resource type="Resource" id="Objective_hold_three_of_the_five_foundries"]
script = ExtResource("2")
text = "Hold three of the five foundries."
count = 3

[sub_resource type="Resource" id="Failure_the_belt_stayed_iron_s_past_day_10"]
script = ExtResource("3")
text = "The belt stayed Iron's past day 10."
last_day = 10

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This belt built the army that crossed our border in the first place. Take the majority and it starts building ours instead."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Outbuild her. Don't outfight her."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three of five foundries. She'll grind for every one."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sable_wren"
text = "Three foundries. Iron builds for us now."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Her own production line is working against her."

