[sub_resource type="Resource" id="Objective_hold_three_of_the_five_towns"]
script = ExtResource("2")
text = "Hold three of the five towns."
count = 3

[sub_resource type="Resource" id="Failure_the_books_closed_before_day_9_with_t"]
script = ExtResource("3")
text = "The books closed before day 9 with the towns still split."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The forged audit \"auctions\" these towns to whoever holds them when it closes. Ferrow's racing the clock as much as us."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "Weather's turning on the coast road — that favors whoever moves first. Let's be the ones who move first."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three of five, and the auction closes in our favor."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "Three towns, ours, when the books closed. The auction's over before it started."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow bid on ground he never held."

