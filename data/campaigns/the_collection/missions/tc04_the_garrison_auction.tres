[gd_resource type="Resource" script_class="MissionDefinition" load_steps=34 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/survive_until_day_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_before_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="13"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_five_towns"]
script = ExtResource("2")
text = "Hold three of the auction's five towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Objective_still_holding_when_the_books_close"]
script = ExtResource("5")
text = "Still be holding them when the books close at the start of day 7."
day = 7

[sub_resource type="Resource" id="Bonus_hold_four_of_the_five"]
script = ExtResource("2")
text = "Hold four of the five — the auction outright."
count = 4
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The forged audit \"auctions\" these towns to whoever holds them when it closes. So Ferrow's racing the clock as hard as we are."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "No water anywhere on this board, so today I'm just another commander. Suits the job. Five towns, five walks, and whoever starts first owns them when the books close."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four of the towns sit out at the corners and the fifth stands alone in the north between them. His last bidders walk in from the east on day six, so hold what you have rather than reaching for one more."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "The books closed with us standing in three of them and his last bidders still walking in from the east."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow bid on ground he never held."

[sub_resource type="Resource" id="Trigger_day_six"]
script = ExtResource("7")
day = 6

[sub_resource type="Resource" id="Spawn_bidder_north"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(13, 2)

[sub_resource type="Resource" id="Spawn_bidder_south"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(13, 8)

[sub_resource type="Resource" id="Effect_last_bidders"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_bidder_north"), SubResource("Spawn_bidder_south")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Books close on day nine. Everything you're not standing on is mine."

[sub_resource type="Resource" id="Event_last_bidders"]
script = ExtResource("6")
id = &"last_bidders"
triggers = Array[Resource]([SubResource("Trigger_day_six")])
effects = Array[Resource]([SubResource("Effect_last_bidders")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_four_towns_held"]
script = ExtResource("9")
objective = SubResource("Bonus_hold_four_of_the_five")

[sub_resource type="Resource" id="Trigger_before_day_six"]
script = ExtResource("8")
day = 6

[sub_resource type="Resource" id="Effect_province_held"]
script = ExtResource("12")
flag = &"province_held"
value = 1
note = "Four of the five auction towns were ours before the books closed."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"halden_marr"
text = "Four of five, and three days to spare. Whatever that audit is worth, it's ours now."

[sub_resource type="Resource" id="Event_the_books_are_ours"]
script = ExtResource("6")
id = &"the_books_are_ours"
triggers = Array[Resource]([SubResource("Trigger_four_towns_held"), SubResource("Trigger_before_day_six")])
effects = Array[Resource]([SubResource("Effect_province_held")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Bidding closed early. Nobody left on your side of the room to raise a hand. Entry posted, five towns."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "He didn't outbid us. He waited for the room to empty. Then he took the lot at the reserve."

[resource]
script = ExtResource("1")
id = &"tc04_the_garrison_auction"
title = "The Garrison Auction"
location = "The garrison town, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc04_the_garrison_auction.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"halden_marr",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_five_towns"), SubResource("Objective_still_holding_when_the_books_close")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_hold_four_of_the_five")])
events = Array[Resource]([SubResource("Event_last_bidders"), SubResource("Event_the_books_are_ours")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
