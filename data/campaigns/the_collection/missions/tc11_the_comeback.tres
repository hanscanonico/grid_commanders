[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/objective_met_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Resource" path="res://data/units/artillery.tres" id="10"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_five_towns"]
script = ExtResource("2")
text = "Win back three of the belt's five towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Interest_drawn"]
script = ExtResource("5")
flag = &"vale_funded"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Interest_denied"]
script = ExtResource("5")
flag = &"vale_funded"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four of the five towns are gone, and Vale's expensive army holds all of them. This is the bottom of the squeeze."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "The border blockade is still paying dividends here, Commander. Do enjoy them."
requires = SubResource("Interest_drawn")

[sub_resource type="Resource" id="Line_1c"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "You closed the blockade before it earned a coin. That is the only reason this belt is still in question."
requires = SubResource("Interest_denied")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Then it only gets better from here. Three towns puts us level. Nothing more, nothing less."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "From here, the occupation starts costing him more than it's worth."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Three towns back, and from where I stand I can count what he has left in the belt. Level is a position I know how to work from."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The occupation belt just stopped paying for itself."

[sub_resource type="Resource" id="Halfway_back"]
script = ExtResource("2")
text = "Two of the five towns are back in our hands."
count = 2
terrain_id = &"city"

[sub_resource type="Resource" id="Trigger_halfway_back"]
script = ExtResource("7")
objective = SubResource("Halfway_back")

[sub_resource type="Resource" id="Spawn_occupation_guns"]
script = ExtResource("9")
unit_type = ExtResource("10")
cell = Vector2i(14, 5)

[sub_resource type="Resource" id="Effect_occupation_guns"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_occupation_guns")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "You are buying towns with units. That is an expensive way to be even."

[sub_resource type="Resource" id="Event_expensive_parity"]
script = ExtResource("6")
id = &"expensive_parity"
triggers = Array[Resource]([SubResource("Trigger_halfway_back")])
effects = Array[Resource]([SubResource("Effect_occupation_guns")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[resource]
script = ExtResource("1")
id = &"tc11_the_comeback"
title = "The Comeback"
location = "The occupied belt, Meridian-Iron border"
map_path = "res://maps/campaign/the_collection/tc11_the_comeback.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"orin_flux",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_five_towns")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_expensive_parity")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1b"), SubResource("Line_1c"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The belt stayed Vale's, and the occupation kept its books comfortably in the black."
