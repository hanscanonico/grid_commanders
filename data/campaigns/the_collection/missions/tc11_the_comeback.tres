[sub_resource type="Resource" id="Objective_hold_three_of_the_five_towns"]
script = ExtResource("2")
text = "Hold three of the five towns."
count = 3

[sub_resource type="Resource" id="Failure_the_belt_stayed_lost_past_day_11"]
script = ExtResource("3")
text = "The belt stayed lost past day 11."
last_day = 11

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Four of five towns, gone, and Vale's premium army holds every one of them. This is the bottom of the squeeze."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Then the numbers only go up from here. Three towns brings us even — nothing more, nothing less."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "From here, the occupation starts costing him more than it's worth."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"orin_flux"
text = "Three towns, back in hand. The numbers are even again."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The occupation belt just stopped paying for itself."

