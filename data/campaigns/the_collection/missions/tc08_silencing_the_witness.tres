[gd_resource type="Resource" script_class="MissionDefinition" load_steps=36 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/objectives/protect_unit_objective.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="12"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="13"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_five_towns"]
script = ExtResource("2")
text = "Take back three of the five witness towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Failure_the_auditor_s_escort_was_lost"]
script = ExtResource("5")
text = "The auditor's escort was destroyed."
tag = &"witness_column"

[sub_resource type="Resource" id="Fact_witnesses_on_record"]
script = ExtResource("13")
flag = &"witnesses_alive"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Fact_notes_unsigned"]
script = ExtResource("13")
flag = &"witnesses_alive"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Orlov isn't here to fight. He's here to hold ground until the witnesses in these towns go quiet, and he still hits fifteen percent harder at anything wounded."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "Then nothing wounded stands where he can reach it. That's the cheaper insurance."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "He holds three, we hold one, and the fifth sits unclaimed in the middle of the field. Take that one and he has to leave his towns to answer it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "The witnesses are still talking. I brought home everything I marched in with, down to the last supply truck."
requires = SubResource("Fact_witnesses_on_record")

[sub_resource type="Resource" id="Line_4_unsigned"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "The towns are ours. The auditor's alive, and her notes are still unsigned in the back of the wagon. Nobody down there has gone on the record yet."
requires = SubResource("Fact_notes_unsigned")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "He came here to make five towns go quiet. He goes home having made them louder."

[sub_resource type="Resource" id="Trigger_middle_town_taken"]
script = ExtResource("7")
cell = Vector2i(7, 5)
holder = 0

[sub_resource type="Resource" id="Spawn_hunter"]
script = ExtResource("10")
unit_type = ExtResource("12")
cell = Vector2i(11, 5)

[sub_resource type="Resource" id="Effect_hunter"]
script = ExtResource("9")
team = 2
units = Array[Resource]([SubResource("Spawn_hunter")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "You reached for the middle one. Now show me what you left behind you."

[sub_resource type="Resource" id="Event_what_you_left_behind"]
script = ExtResource("6")
id = &"what_you_left_behind"
triggers = Array[Resource]([SubResource("Trigger_middle_town_taken")])
effects = Array[Resource]([SubResource("Effect_hunter")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_auditor_reaches_a_witness"]
script = ExtResource("8")
tag = &"witness_column"
cells = Array[Vector2i]([Vector2i(10, 2), Vector2i(4, 8), Vector2i(10, 8)])

[sub_resource type="Resource" id="Effect_witnesses_alive"]
script = ExtResource("11")
flag = &"witnesses_alive"
value = 1
note = "The auditor reached the occupied towns, and her witnesses are still talking."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"ines_calder"
text = "She's signed. Two of Orlov's own townsfolk put their names under hers, in the square, with his line close enough to watch it. He didn't move a man."

[sub_resource type="Resource" id="Event_the_auditor_gets_out"]
script = ExtResource("6")
id = &"the_auditor_gets_out"
triggers = Array[Resource]([SubResource("Trigger_auditor_reaches_a_witness")])
effects = Array[Resource]([SubResource("Effect_witnesses_alive")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("13")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"cass_orlov"
text = "She stopped talking. They all do. I only had to wait."

[sub_resource type="Resource" id="Line_defeat_2_failure"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "The escort's gone. Her notes were the only copy of what those towns knew. He'll have the wagon by morning."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_2_tactical"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Calder's column is gone with the towns still his. Whatever the auditor wrote down, nobody's left to walk it to a witness."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"tc08_silencing_the_witness"
title = "Silencing the Witness"
location = "The audit towns, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc08_silencing_the_witness.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"ines_calder",
	2: &"cass_orlov"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_five_towns")])
failures = Array[Resource]([SubResource("Failure_the_auditor_s_escort_was_lost")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_what_you_left_behind"), SubResource("Event_the_auditor_gets_out")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_4_unsigned"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2_failure"), SubResource("Line_defeat_2_tactical")])
