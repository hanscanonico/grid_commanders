[gd_resource type="Resource" script_class="MissionDefinition" load_steps=37 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/hold_cell_objective.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/objectives/loss_limit_objective.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="12"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="13"]

[sub_resource type="Resource" id="Objective_hold_four_of_the_six_towns"]
script = ExtResource("2")
text = "Hold four of the six towns."
count = 4
terrain_id = &"city"

[sub_resource type="Resource" id="Failure_more_than_four_lost"]
script = ExtResource("6")
text = "More than eight units lost, counting any merged into another."
max_losses = 8

[sub_resource type="Resource" id="Bonus_hold_the_central_relay"]
script = ExtResource("4")
text = "Hold the relay in the middle of the province three whole days."
cell = Vector2i(9, 6)
days = 3

[sub_resource type="Resource" id="Auction_won"]
script = ExtResource("7")
flag = &"province_held"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Auction_split"]
script = ExtResource("7")
flag = &"province_held"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Ferrow's ledger now claims the entire province. This is the seizure he's been building to since the border road."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "We closed the auction holding four of the five towns, so this is the only ground his claim still rests on."
requires = SubResource("Auction_won")

[sub_resource type="Resource" id="Line_1c"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The auction closed with the towns split, so he came into this province with half a case already made."
requires = SubResource("Auction_split")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "I hold. I don't chase. Give me the majority of these towns and I'll make the rest of his claim irrelevant."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Four towns out at the corners with woods beside them, and two more stacked in the middle with the relay between them. The middle is the shorter walk for both of us."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "He never took a second square of this province. I stood on four towns and let him wear himself out on the fifth."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The Seizure is over. Whatever Ferrow tries next, it starts from zero."

[sub_resource type="Resource" id="Trigger_relay_taken"]
script = ExtResource("9")
cell = Vector2i(9, 6)
holder = 0

[sub_resource type="Resource" id="Spawn_claim_tank"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(16, 6)

[sub_resource type="Resource" id="Spawn_claim_raider"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(18, 7)

[sub_resource type="Resource" id="Effect_the_claim_stands"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_claim_tank"), SubResource("Spawn_claim_raider")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "The province was never the prize. The claim was. Take all of it; I'll still have it written down."

[sub_resource type="Resource" id="Event_the_claim_stands"]
script = ExtResource("8")
id = &"the_claim_stands"
triggers = Array[Resource]([SubResource("Trigger_relay_taken")])
effects = Array[Resource]([SubResource("Effect_the_claim_stands")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("7")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Run_par"]
script = ExtResource("7")
flag = &"run:par"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_4_par"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Seven days. The claim never got as far as the paperwork."
requires = SubResource("Run_par")

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("5")
speaker = &"dane_ferrow"
text = "Province seized. Entry posted for the whole of it, towns, relay, roads. That's the page I came for."

[sub_resource type="Resource" id="Line_defeat_2_failure"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "More than eight in one province. That's his fee paid in full. The seizure's only the receipt."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_2_tactical"]
script = ExtResource("5")
speaker = &"gideon_holt"
text = "Voss held four corners until nobody was left to stand in them. Now the claim's got a province under it. Written down, like he said."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"tc06_the_seized_province"
title = "The Seized Province"
location = "The contested province, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc06_the_seized_province.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"mara_voss",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_four_of_the_six_towns")])
failures = Array[Resource]([SubResource("Failure_more_than_four_lost")])
bonus_objectives = Array[Resource]([SubResource("Bonus_hold_the_central_relay")])
events = Array[Resource]([SubResource("Event_the_claim_stands")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1b"), SubResource("Line_1c"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_4_par"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2_failure"), SubResource("Line_defeat_2_tactical")])
