[sub_resource type="Resource" id="Objective_hold_four_of_the_six_towns"]
script = ExtResource("2")
text = "Hold four of the six towns."
count = 4

[sub_resource type="Resource" id="Failure_the_province_stayed_split_past_day_1"]
script = ExtResource("3")
text = "The province stayed split past day 11."
last_day = 11

[sub_resource type="Resource" id="Bonus_take_the_central_relay_for_a_bonus"]
script = ExtResource("4")
text = "Take the central relay for a bonus."
cell = Vector2i(9, 6)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Ferrow's ledger now claims the entire province. This is the seizure he's been building to since the border road."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "I hold. I don't chase. Give me the majority of these towns and I'll make the rest of his claim irrelevant."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "Hold the majority of the towns and the whole forged claim collapses at once."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("5")
speaker = &"mara_voss"
text = "Four towns, ours. The province stayed exactly what it always was — not his to take."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("5")
speaker = &"alina_ward"
text = "The Seizure is over. Whatever Ferrow tries next, it starts from zero."

