[resource]
script = ExtResource("1")
id = &"tc18_closing_the_ledger"
title = "Closing the Ledger"
location = "The foundry heart, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc18_closing_the_ledger.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"alina_ward",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"difficult"
objectives = Array[Resource]([SubResource("Objective_take_the_foundry_that_opened_this_wa")])
failures = Array[Resource]([SubResource("Failure_the_foundry_stayed_ferrow_s_past_day")])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_northern_town_for_a_bonus"), SubResource("Bonus_take_the_southern_town_for_a_bonus")])
par_day = 9
briefing = Array[String]([
	"This is the foundry the forged ledger was written to protect. Ferrow has nowhere left to fall back to.",
	"Take it, and the debt he invented is finally paid — by him."
])
victory = Array[String]([
	"The foundry is ours. The ledger that started this war closes with nothing owed on our side of it.",
	"Ferrow's collection is over. So is the Directorate's audit."
])
defeat = "The foundry held, and the forged debt just became a real one — ours."
