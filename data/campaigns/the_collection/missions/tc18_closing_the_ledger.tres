[sub_resource type="Resource" id="Objective_take_the_foundry_that_opened_this_wa"]
script = ExtResource("2")
text = "Take the foundry that opened this war."
cell = Vector2i(10, 6)

[sub_resource type="Resource" id="Failure_the_foundry_stayed_ferrow_s_past_day"]
script = ExtResource("3")
text = "The foundry stayed Ferrow's past day 12."
last_day = 12

[sub_resource type="Resource" id="Bonus_take_the_northern_town_for_a_bonus"]
script = ExtResource("2")
text = "Take the northern town for a bonus."
cell = Vector2i(7, 2)

[sub_resource type="Resource" id="Bonus_take_the_southern_town_for_a_bonus"]
script = ExtResource("2")
text = "Take the southern town for a bonus."
cell = Vector2i(13, 10)

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "This is the foundry the forged ledger was written to protect. Ferrow's got nowhere left to fall back to."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Every war ends in a ledger, Commander. Mine just happens to be honest about it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Then let's close it. Take the foundry, and the debt he invented is finally paid — by him."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The foundry is ours. The ledger that started this war closes with nothing owed on our side of it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Ferrow's collection is over. So is the Directorate's audit."

[resource]
script = ExtResource("1")
id = &"tc18_closing_the_ledger"
title = "Closing the Ledger"
location = "The foundry heart, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc18_closing_the_ledger.txt"
