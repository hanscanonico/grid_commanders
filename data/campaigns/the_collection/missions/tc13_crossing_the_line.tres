[sub_resource type="Resource" id="Objective_take_the_border_foundry_and_open_the"]
script = ExtResource("2")
text = "Take the border foundry and open the province."
cell = Vector2i(7, 5)

[sub_resource type="Resource" id="Failure_the_border_stayed_closed_past_day_9"]
script = ExtResource("3")
text = "The border stayed closed past day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The forged ledger bought Ferrow two provinces on paper. This is where he starts paying it back — on his own ground."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "Crossing now. Clean approach, no hesitation — that foundry opens the whole province behind it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Take the border foundry and the whole province opens up behind it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "The border foundry is ours. Ferrow's home ground just became the front line."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Repossession starts today. Everything he took, we're taking back."

[resource]
script = ExtResource("1")
