[sub_resource type="Resource" id="Objective_take_the_border_foundry_and_open_the"]
script = ExtResource("2")
text = "Take the border foundry and open the province."
cell = Vector2i(7, 5)

[sub_resource type="Resource" id="Failure_the_crossing_was_not_clean"]
script = ExtResource("5")
text = "More than five units lost — the crossing was anything but clean."
max_losses = 5

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The forged ledger bought Ferrow two provinces on paper. This is where he starts paying it back — on his own ground."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "Crossing now. Clean approach, no hesitation — that foundry opens the whole province behind it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The foundry sits in a notch in the mountain wall, and we can walk onto it from our own side. Everything else on that row is rock — the two gaps and the foundry square itself are the only ground anything with tracks can cross."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"perrin_ash"
text = "The border foundry is ours. Ferrow's home ground just became the front line."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Repossession starts today. Everything he took, we're taking back."

[sub_resource type="Resource" id="Forgery_provable"]
script = ExtResource("9")
flag = &"forgery_proven"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_forgery_provable"]
script = ExtResource("7")
condition = SubResource("Forgery_provable")

[sub_resource type="Resource" id="Trigger_day_five"]
script = ExtResource("8")
day = 5

[sub_resource type="Resource" id="Column_on_the_crossing"]
script = ExtResource("15")
text = "Our column is on the border crossing."
cells = Array[Vector2i]([Vector2i(6, 5), Vector2i(7, 4), Vector2i(7, 5), Vector2i(7, 6), Vector2i(8, 5)])
count = 1

[sub_resource type="Resource" id="Trigger_column_on_the_crossing"]
script = ExtResource("14")
objective = SubResource("Column_on_the_crossing")

[sub_resource type="Resource" id="Effect_the_levy_goes_home"]
script = ExtResource("10")
tags = Array[StringName]([&"border_levy"])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "Ferrow. The audit is a forgery and my men will not die for it. Neither will your border levy — they have put their rifles down and walked home."

[sub_resource type="Resource" id="Event_the_border_levy"]
script = ExtResource("6")
id = &"the_border_levy"
triggers = Array[Resource]([SubResource("Trigger_forgery_provable"), SubResource("Trigger_column_on_the_crossing")])
effects = Array[Resource]([SubResource("Effect_the_levy_goes_home")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Spawn_ferrows_own"]
script = ExtResource("12")
unit_type = ExtResource("13")
cell = Vector2i(11, 7)

[sub_resource type="Resource" id="Effect_ferrows_own"]
script = ExtResource("11")
team = 2
units = Array[Resource]([SubResource("Spawn_ferrows_own")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "This is my ground, Commander, and I am standing on it personally. Price it accordingly."

[sub_resource type="Resource" id="Event_ferrow_digs_in"]
script = ExtResource("6")
id = &"ferrow_digs_in"
triggers = Array[Resource]([SubResource("Trigger_day_five")])
effects = Array[Resource]([SubResource("Effect_ferrows_own")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc13_crossing_the_line"
title = "Crossing the Line"
location = "The border foundry, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc13_crossing_the_line.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"perrin_ash",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_border_foundry_and_open_the")])
failures = Array[Resource]([SubResource("Failure_the_crossing_was_not_clean")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_border_levy"), SubResource("Event_ferrow_digs_in")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The border held, and the repossession stalled before it started."
