[gd_resource type="Resource" script_class="MissionDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/objectives/day_deadline_objective.gd" id="3"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_four_towns"]
script = ExtResource("2")
text = "Hold three of the four towns."
count = 3

[sub_resource type="Resource" id="Failure_the_sector_stayed_contested_past_day"]
script = ExtResource("3")
text = "The sector stayed contested past day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Word from the wire: Draeg's stood his whole sector down. Turns out even Iron's most honest marshal draws a line at fighting for a forged ledger."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Draeg's sentiment is noted and irrelevant. I inherited his sector, thin as it is, and I don't need to be honest to hold it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Thin is thin. Hit it before she finishes reassigning it — three of the four towns, now."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Three towns, ours. Whatever was left of Draeg's line gave way without him in it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "One marshal down without a shot fired. Vance won't be so easy."

[resource]
script = ExtResource("1")
id = &"tc14_draegs_line"
title = "Draeg's Line"
location = "The abandoned sector, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc14_draegs_line.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
