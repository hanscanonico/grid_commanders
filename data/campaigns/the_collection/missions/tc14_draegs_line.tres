[gd_resource type="Resource" script_class="MissionDefinition" load_steps=31 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/triggers/unit_reached_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/defect_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]

[sub_resource type="Resource" id="Gate_forgery_provable"]
script = ExtResource("5")
flag = &"forgery_proven"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Fact_veterans_spared"]
script = ExtResource("5")
flag = &"draeg_veterans_spared"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Fact_veterans_lost"]
script = ExtResource("5")
flag = &"draeg_veterans_spared"
at_least = 0
at_most = 0

[sub_resource type="Resource" id="Objective_hold_four_of_the_six_towns"]
script = ExtResource("2")
text = "Hold four of the six towns."
count = 4
terrain_id = &"city"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Word off the wire: Draeg has stood his whole sector down. Even Iron's most honest marshal won't fight for a forged ledger."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Draeg's feelings are noted and beside the point. I have his sector now, thin as it is, and I don't need to be honest to hold it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Thin is thin. Two men in the whole sector and six towns nobody's standing on. I can be on two of them before she finishes reading her orders."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Four towns, ours. Whatever was left of Draeg's line gave way without him in it."

[sub_resource type="Resource" id="Line_4_walked_out"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "You had my column in the open for two days and not one of you fired on it. I don't forget a thing like that. Neither will they."
requires = SubResource("Fact_veterans_spared")

[sub_resource type="Resource" id="Line_4_never_walked"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "My men were yours from the third day. They never came out of that sector, and I've had no word of them since. Whatever happened to them happened under your flag."
requires = SubResource("Fact_veterans_lost")

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "One marshal down without a shot fired. Vance won't be so easy."

[sub_resource type="Resource" id="Trigger_day_three"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Effect_the_holdouts_walk"]
script = ExtResource("9")
from_team = 2
to_team = 1
tags = Array[StringName]([&"draeg_holdouts"])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"viktor_draeg"
text = "Vance can have the sector. She can't have my men. They're walking out unarmed. Don't shoot them for it."

[sub_resource type="Resource" id="Event_the_holdouts"]
script = ExtResource("6")
id = &"the_holdouts"
triggers = Array[Resource]([SubResource("Trigger_day_three")])
effects = Array[Resource]([SubResource("Effect_the_holdouts_walk")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_holdouts_behind_our_line"]
script = ExtResource("8")
tag = &"draeg_holdouts"
cells = Array[Vector2i]([Vector2i(5, 2), Vector2i(5, 10), Vector2i(1, 4), Vector2i(1, 5)])

[sub_resource type="Resource" id="Effect_veterans_spared"]
script = ExtResource("10")
flag = &"draeg_veterans_spared"
value = 1
note = "Draeg's holdouts walked out of the sector alive, behind our line."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"sera_lark"
text = "Draeg's squad is behind our line. Out of this war, all of them. Nobody has to bury that column."

[sub_resource type="Resource" id="Event_they_marched_home"]
script = ExtResource("6")
id = &"they_marched_home"
triggers = Array[Resource]([SubResource("Trigger_holdouts_behind_our_line")])
effects = Array[Resource]([SubResource("Effect_veterans_spared")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"iona_vance"
text = "Two men and six empty towns, against your whole column. Draeg's sector holds. I'll note that beside his feelings."

[sub_resource type="Resource" id="Line_defeat_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Lark was on two towns before Vance finished her orders, then off them again before she'd finished the next page."

[resource]
script = ExtResource("1")
id = &"tc14_draegs_line"
title = "Draeg's Line"
location = "The abandoned sector, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc14_draegs_line.txt"
unlock_requires = SubResource("Gate_forgery_provable")
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"sera_lark",
	2: &"iona_vance"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_four_of_the_six_towns")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_holdouts"), SubResource("Event_they_marched_home")])
par_day = 7
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_4_walked_out"), SubResource("Line_4_never_walked"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2")])
