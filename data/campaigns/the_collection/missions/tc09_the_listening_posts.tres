[sub_resource type="Resource" id="Objective_take_the_first_listening_post"]
script = ExtResource("2")
text = "Take the first listening post."
cell = Vector2i(6, 4)

[sub_resource type="Resource" id="Objective_take_the_second_listening_post"]
script = ExtResource("2")
text = "Take the second listening post."
cell = Vector2i(10, 5)

[sub_resource type="Resource" id="Objective_take_the_third_listening_post"]
script = ExtResource("2")
text = "Take the third listening post."
cell = Vector2i(13, 4)

[sub_resource type="Resource" id="Failure_the_wire_stayed_live_past_day_10"]
script = ExtResource("3")
text = "The wire stayed live past day 10."
last_day = 10

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Every post on this road reports straight to Orlov. Cut all three and his witnesses stop being found."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "We start this one behind on income — the odds favor speed over an even fight, every time I run it."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Move fast, not evenly."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"lyra_quill"
text = "All three posts, ours. The wire's cut, and the odds just flipped in our favor for once."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Orlov's hunting blind now."

