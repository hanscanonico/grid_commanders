[sub_resource type="Resource" id="Objective_take_the_counting_house_that_funds_t"]
script = ExtResource("2")
text = "Take the counting house that funds the occupation."
cell = Vector2i(16, 8)

[sub_resource type="Resource" id="Bonus_take_the_northern_town_for_a_bonus"]
script = ExtResource("2")
text = "Take the northern town his garrison holds on our side of the field."
cell = Vector2i(5, 2)

[sub_resource type="Resource" id="Bonus_destroy_the_paymaster"]
script = ExtResource("5")
text = "Destroy Vale's paymaster before he leaves with the books."
tag = &"paymaster"

[sub_resource type="Resource" id="Witnesses_talking"]
script = ExtResource("6")
flag = &"witnesses_alive"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The counting house is where Vale's occupation gets paid. Take it and the whole squeeze runs out of money at once."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The auditor's witnesses are still talking, too. Put her testimony next to Vale's payment book and the forgery stops being an accusation."
requires = SubResource("Witnesses_talking")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"nia_rowan"
text = "Ground holds better than a treasury does. Take the house, and the roads he's been buying stop being his."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "This ends the financial war. What's left after this is a fair fight."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"nia_rowan"
text = "The counting house is ours. Vale's books close in the red, and the occupation with them."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Strangle is over. Now we go and finish it properly."

[sub_resource type="Resource" id="Trigger_paymaster_taken"]
script = ExtResource("8")
tag = &"paymaster"

[sub_resource type="Resource" id="Trigger_before_the_books_move"]
script = ExtResource("9")
day = 7

[sub_resource type="Resource" id="Effect_forgery_proven_twice"]
script = ExtResource("11")
flag = &"forgery_proven"
value = 2
note = "Vale's payment book was taken intact, in his own hand, against the forged audit."

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"nia_rowan"
text = "Books intact. Every payment Vale made against that audit, in his own hand."

[sub_resource type="Resource" id="Event_the_books"]
script = ExtResource("7")
id = &"the_books"
triggers = Array[Resource]([SubResource("Trigger_paymaster_taken"), SubResource("Trigger_before_the_books_move")])
effects = Array[Resource]([SubResource("Effect_forgery_proven_twice")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_eight"]
script = ExtResource("10")
day = 8

[sub_resource type="Resource" id="Effect_moved_the_money"]
script = ExtResource("12")
team = 2
amount = 4000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "The ledgers left for the interior an hour ago, Commander. You may still have the man who kept them."

[sub_resource type="Resource" id="Event_the_ledgers_move"]
script = ExtResource("7")
id = &"the_ledgers_move"
triggers = Array[Resource]([SubResource("Trigger_day_eight")])
effects = Array[Resource]([SubResource("Effect_moved_the_money")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc12_the_counting_house"
title = "The Counting House"
location = "Vale's paymaster town, Meridian-Iron border"
map_path = "res://maps/campaign/the_collection/tc12_the_counting_house.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"nia_rowan",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_take_the_counting_house_that_funds_t")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_take_the_northern_town_for_a_bonus"), SubResource("Bonus_destroy_the_paymaster")])
events = Array[Resource]([SubResource("Event_the_books"), SubResource("Event_the_ledgers_move")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1b"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The counting house held, and the squeeze that started in the border towns just got permanent."
