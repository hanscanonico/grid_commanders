[sub_resource type="Resource" id="Objective_hold_the_foundry_core_until_day_8"]
script = ExtResource("2")
text = "Hold the foundry core until day 8."
day = 8

[sub_resource type="Resource" id="Failure_the_core_fell_before_day_8"]
script = ExtResource("3")
text = "The core fell before day 8."
last_day = 8

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Everything we've taken this act comes down to holding this ground. Morn's throwing what's left at it, Hammerfall included."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then nothing gets bunched, and nothing gets thrown at us worth the charge. I've held worse ground on a thinner budget."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Spread the line, keep nothing bunched, and hold to day eight."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Day eight. The core held, and Morn's got nothing left to throw at it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "One foundry from the end of this."

