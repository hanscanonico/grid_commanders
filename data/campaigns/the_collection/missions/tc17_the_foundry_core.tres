[ext_resource type="Resource" path="res://data/units/md_tank.tres" id="13"]
[ext_resource type="Resource" path="res://data/units/recon.tres" id="14"]

[sub_resource type="Resource" id="Objective_hold_the_foundry_core_until_day_8"]
script = ExtResource("2")
text = "Hold the foundry core until day 8."
day = 8

[sub_resource type="Resource" id="Failure_the_line_bunched"]
script = ExtResource("5")
text = "More than nine units lost — the line was too tight in one place."
max_losses = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Everything we've taken comes down to holding this ground. Morn is throwing what's left at it, Hammerfall included."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Then nothing bunches up. He never gets a target worth the charge, and I've held worse ground on less."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Four towns on this field, far apart, with nothing between them but open ground. There is nothing out there worth standing shoulder to shoulder for."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Day eight. The core held, and Morn's got nothing left to throw at it."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "One foundry from the end of this."

[sub_resource type="Resource" id="Trigger_day_four"]
script = ExtResource("7")
day = 4

[sub_resource type="Resource" id="Spawn_last_wave"]
script = ExtResource("11")
unit_type = ExtResource("12")
cell = Vector2i(18, 3)

[sub_resource type="Resource" id="Effect_last_wave"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_last_wave")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "I am not manoeuvring. I am arriving. Stand where you like."

[sub_resource type="Resource" id="Event_the_last_wave"]
script = ExtResource("6")
id = &"the_last_wave"
triggers = Array[Resource]([SubResource("Trigger_day_four")])
effects = Array[Resource]([SubResource("Effect_last_wave")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Charge_banked"]
script = ExtResource("9")
flag = &"morn_charged"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Trigger_charge_banked"]
script = ExtResource("8")
condition = SubResource("Charge_banked")

[sub_resource type="Resource" id="Trigger_day_five"]
script = ExtResource("7")
day = 5

[sub_resource type="Resource" id="Spawn_banked_armour"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(18, 7)

[sub_resource type="Resource" id="Spawn_banked_scout"]
script = ExtResource("11")
unit_type = ExtResource("14")
cell = Vector2i(17, 8)

[sub_resource type="Resource" id="Effect_banked_column"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_banked_armour"), SubResource("Spawn_banked_scout")])

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "You gave me nine days at the chain. I've spent them here."

[sub_resource type="Resource" id="Event_spent_them_here"]
script = ExtResource("6")
id = &"spent_them_here"
triggers = Array[Resource]([SubResource("Trigger_charge_banked"), SubResource("Trigger_day_five")])
effects = Array[Resource]([SubResource("Effect_banked_column")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[sub_resource type="Resource" id="Run_failure"]
script = ExtResource("9")
flag = &"run:cause"
at_least = 3
at_most = 3

[sub_resource type="Resource" id="Line_defeat_1"]
script = ExtResource("4")
speaker = &"radek_morn"
text = "I didn't manoeuvre. I arrived. The core's mine, whatever day it is."

[sub_resource type="Resource" id="Line_defeat_2_failure"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "More than nine. All in one place. Hammerfall found the shoulder-to-shoulder bit I said we'd never do."
requires = SubResource("Run_failure")

[sub_resource type="Resource" id="Line_defeat_2_tactical"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "I said I'd held worse ground on less. I hadn't. This was the ground and that was the less."
unless = SubResource("Run_failure")

[resource]
script = ExtResource("1")
id = &"tc17_the_foundry_core"
title = "The Foundry Core"
location = "The production heart, Iron Dominion territory"
map_path = "res://maps/campaign/the_collection/tc17_the_foundry_core.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"gideon_holt",
	2: &"radek_morn"
}
fog_enabled = false
difficulty = &"hard"
objectives = Array[Resource]([SubResource("Objective_hold_the_foundry_core_until_day_8")])
failures = Array[Resource]([SubResource("Failure_the_line_bunched")])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_last_wave"), SubResource("Event_spent_them_here")])
par_day = 8
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = Array[Resource]([SubResource("Line_defeat_1"), SubResource("Line_defeat_2_failure"), SubResource("Line_defeat_2_tactical")])
