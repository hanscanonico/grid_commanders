[sub_resource type="Resource" id="Objective_take_the_blockade_town_vale_is_fundi"]
script = ExtResource("2")
text = "Take the blockade town Vale is funding from."
cell = Vector2i(9, 3)

[sub_resource type="Resource" id="Failure_the_blockade_held_past_day_9"]
script = ExtResource("3")
text = "The blockade held past day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Ferrow's collection was the opening move. Konrad Vale is the one actually financing this war, and he's bought this garrison three towns before we even crossed the border."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Financing isn't theft, Commander. It's simply better arithmetic."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "Then we audit his arithmetic. Every day the blockade town stands, his funding gap widens on paper — take it and it widens for real."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "Take the blockade town. Every day it stands, his funding gap widens."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "The blockade town is ours. Vale's financing dries up the moment it falls."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Strangle starts with him running out of money to strangle us with."

[resource]
script = ExtResource("1")
id = &"tc07_the_blockade"
