[ext_resource type="Script" path="res://core/campaign/triggers/cell_owned_trigger.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_funds_effect.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/tank.tres" id="13"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="14"]

[sub_resource type="Resource" id="Objective_take_the_blockade_town_vale_is_fundi"]
script = ExtResource("2")
text = "Take the blockade town Vale is funding from."
cell = Vector2i(9, 3)

[sub_resource type="Resource" id="Bonus_keep_our_own_town_four_days"]
script = ExtResource("5")
text = "Keep our own border town all four days as well."
cell = Vector2i(6, 3)
days = 4

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Ferrow's collection was the opening move. Konrad Vale is the one actually financing this war, and he's bought this garrison three towns before we even crossed the border."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Financing isn't theft, Commander. It's simply better arithmetic."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "Then we audit his arithmetic. Every day the blockade town stands, his funding gap widens on paper — take it and it widens for real."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "His blockade town and ours face each other three squares apart on the same row, and he holds the one directly below ours as well. Break the near pair and the belt is even again."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"cassian_rook"
text = "The blockade town is ours. Vale's financing dries up the moment it falls."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The Strangle starts with him running out of money to strangle us with."

[sub_resource type="Resource" id="Trigger_day_three"]
script = ExtResource("7")
day = 3

[sub_resource type="Resource" id="Spawn_bought_garrison"]
script = ExtResource("11")
unit_type = ExtResource("14")
cell = Vector2i(12, 6)

[sub_resource type="Resource" id="Effect_bought_garrison"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_bought_garrison")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "A garrison is a line item, Commander. I have simply approved another one."

[sub_resource type="Resource" id="Event_another_line_item"]
script = ExtResource("6")
id = &"another_line_item"
triggers = Array[Resource]([SubResource("Trigger_day_three")])
effects = Array[Resource]([SubResource("Effect_bought_garrison")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_day_six"]
script = ExtResource("7")
day = 6

[sub_resource type="Resource" id="Trigger_blockade_still_his"]
script = ExtResource("8")
cell = Vector2i(9, 3)
holder = 1

[sub_resource type="Resource" id="Effect_vale_interest"]
script = ExtResource("9")
team = 2
amount = 3000

[sub_resource type="Resource" id="Spawn_interest_tank"]
script = ExtResource("11")
unit_type = ExtResource("13")
cell = Vector2i(12, 3)

[sub_resource type="Resource" id="Effect_interest_tank"]
script = ExtResource("10")
team = 2
units = Array[Resource]([SubResource("Spawn_interest_tank")])

[sub_resource type="Resource" id="Effect_vale_funded"]
script = ExtResource("12")
flag = &"vale_funded"
value = 1
note = "The blockade town stood six days, and Vale drew the interest on it."

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"konrad_vale"
text = "Six days of interest, Commander. I have bought another garrison with it."

[sub_resource type="Resource" id="Event_interest_accrues"]
script = ExtResource("6")
id = &"interest_accrues"
triggers = Array[Resource]([SubResource("Trigger_day_six"), SubResource("Trigger_blockade_still_his")])
effects = Array[Resource]([SubResource("Effect_vale_interest"), SubResource("Effect_interest_tank"), SubResource("Effect_vale_funded")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc07_the_blockade"
title = "The Blockade"
location = "The financed frontier, Meridian-Iron border"
map_path = "res://maps/campaign/the_collection/tc07_the_blockade.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"cassian_rook",
	2: &"konrad_vale"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_take_the_blockade_town_vale_is_fundi")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([SubResource("Bonus_keep_our_own_town_four_days")])
events = Array[Resource]([SubResource("Event_another_line_item"), SubResource("Event_interest_accrues")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
victory = Array[Resource]([SubResource("Line_5"), SubResource("Line_6")])
defeat = "The blockade held, and Vale's occupation kept drawing interest on ground we never touched."
