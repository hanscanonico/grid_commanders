[gd_resource type="Resource" script_class="MissionDefinition" load_steps=32 format=3]

[ext_resource type="Script" path="res://core/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://core/campaign/objectives/own_properties_objective.gd" id="2"]
[ext_resource type="Script" path="res://core/campaign/mission_line.gd" id="4"]
[ext_resource type="Script" path="res://core/campaign/mission_event.gd" id="5"]
[ext_resource type="Script" path="res://core/campaign/triggers/day_reached_trigger.gd" id="6"]
[ext_resource type="Script" path="res://core/campaign/triggers/force_strength_trigger.gd" id="7"]
[ext_resource type="Script" path="res://core/campaign/effects/spawn_units_effect.gd" id="8"]
[ext_resource type="Script" path="res://core/campaign/effects/mission_spawn.gd" id="9"]
[ext_resource type="Script" path="res://core/campaign/effects/set_flag_effect.gd" id="10"]
[ext_resource type="Script" path="res://core/campaign/effects/grant_charge_effect.gd" id="11"]
[ext_resource type="Script" path="res://core/campaign/flag_condition.gd" id="12"]
[ext_resource type="Resource" path="res://data/units/infantry.tres" id="13"]

[sub_resource type="Resource" id="Objective_hold_three_of_the_four_named_towns"]
script = ExtResource("2")
text = "Hold three of the four named towns."
count = 3
terrain_id = &"city"

[sub_resource type="Resource" id="Paid_already"]
script = ExtResource("12")
flag = &"ferrow_bounty"
at_least = 1
at_most = -1

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The forged audit names these four towns as reparations owed. Ferrow means to collect on paper what he can't win outright."

[sub_resource type="Resource" id="Line_1b"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "And he collected off us on the depot road, which he will have banked before he read a word of this."
requires = SubResource("Paid_already")

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Funny thing about paper claims — they need boots on the ground to mean anything. Let's not give him the boots."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Four towns in two rows, a stand of woods at each end of both. The trees are the only cover on this field, so whoever sits in them buys the towns cheap."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three towns held. The audit's claim is worth exactly the paper it's written on."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Ferrow's ledger just got a correction."

[sub_resource type="Resource" id="Trigger_day_four"]
script = ExtResource("6")
day = 4

[sub_resource type="Resource" id="Spawn_collector_north"]
script = ExtResource("9")
unit_type = ExtResource("13")
cell = Vector2i(14, 1)

[sub_resource type="Resource" id="Spawn_collector_south"]
script = ExtResource("9")
unit_type = ExtResource("13")
cell = Vector2i(14, 8)

[sub_resource type="Resource" id="Effect_the_collectors"]
script = ExtResource("8")
team = 2
units = Array[Resource]([SubResource("Spawn_collector_north"), SubResource("Spawn_collector_south")])

[sub_resource type="Resource" id="Event_line_1"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "The audit says these towns are mine. I have sent someone for the keys."

[sub_resource type="Resource" id="Event_the_collectors"]
script = ExtResource("5")
id = &"the_collectors"
triggers = Array[Resource]([SubResource("Trigger_day_four")])
effects = Array[Resource]([SubResource("Effect_the_collectors")])
once = true
lines = Array[Resource]([SubResource("Event_line_1")])

[sub_resource type="Resource" id="Trigger_column_thinned"]
script = ExtResource("7")
team = 1
bound = 0
count = 2

[sub_resource type="Resource" id="Effect_bounty_banked"]
script = ExtResource("10")
flag = &"ferrow_bounty"
value = 1
note = "Ferrow was paid in wrecks on the customs road."

[sub_resource type="Resource" id="Effect_ferrow_charge"]
script = ExtResource("11")
team = 2
points = 3000

[sub_resource type="Resource" id="Event_line_2"]
script = ExtResource("4")
speaker = &"dane_ferrow"
text = "Down to two, and every wreck of them posts to the credit column. Thank you, Commander."

[sub_resource type="Resource" id="Event_bounty_banked"]
script = ExtResource("5")
id = &"bounty_banked"
triggers = Array[Resource]([SubResource("Trigger_column_thinned")])
effects = Array[Resource]([SubResource("Effect_bounty_banked"), SubResource("Effect_ferrow_charge")])
once = true
lines = Array[Resource]([SubResource("Event_line_2")])

[resource]
script = ExtResource("1")
id = &"tc02_named_in_the_audit"
title = "Named in the Audit"
location = "The market towns, Meridian frontier"
map_path = "res://maps/campaign/the_collection/tc02_named_in_the_audit.txt"
player_team = 1
ai_teams = Array[int]([2])
seats = Array[int]([])
sides = {}
commanders = {
	1: &"gideon_holt",
	2: &"dane_ferrow"
}
fog_enabled = false
difficulty = &"normal"
objectives = Array[Resource]([SubResource("Objective_hold_three_of_the_four_named_towns")])
failures = Array[Resource]([])
bonus_objectives = Array[Resource]([])
events = Array[Resource]([SubResource("Event_the_collectors"), SubResource("Event_bounty_banked")])
par_day = 6
briefing = Array[Resource]([SubResource("Line_1"), SubResource("Line_1b"), SubResource("Line_2"), SubResource("Line_3")])
victory = Array[Resource]([SubResource("Line_4"), SubResource("Line_5")])
defeat = "The towns fell one by one, and the ledger's forged debt started looking real."
