[sub_resource type="Resource" id="Objective_hold_three_of_the_four_named_towns"]
script = ExtResource("2")
text = "Hold three of the four named towns."
count = 3

[sub_resource type="Resource" id="Failure_the_audit_s_claim_went_unanswered_pa"]
script = ExtResource("3")
text = "The audit's claim went unanswered past day 9."
last_day = 9

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "The forged audit names these four towns as reparations owed. Ferrow means to collect on paper what he can't win outright."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Funny thing about paper claims — they need boots on the ground to mean anything. Let's not give him the boots."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Hold three of the four and the claim has nothing behind it."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("4")
speaker = &"gideon_holt"
text = "Three towns held. The audit's claim is worth exactly the paper it's written on."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("4")
speaker = &"alina_ward"
text = "Ferrow's ledger just got a correction."

