# The off-desktop capture renderer's engine and image tag, read by both
# tools/godot_gui.sh and the Makefile — README.md's smoke section is the rule
# they follow. The version is stated here alone; tools/check_scripts.sh holds it
# equal to the engine the rest of the repo is pinned to.
GODOT_CAPTURE_VERSION=4.7.1-stable
GODOT_CAPTURE_IMAGE=grid-commanders-capture:${GODOT_CAPTURE_VERSION}
# The two renderer names: what a caller sets GODOT_CAPTURE_RENDERER to, what the
# launcher records, and what a smoke manifest carries. Stated here alone so the
# launcher and the sweep cannot drift apart on a string.
GODOT_DESKTOP_RENDERER=desktop
GODOT_CONTAINER_RENDERER=container
