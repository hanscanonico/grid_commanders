# The off-desktop capture renderer's engine and image tag — the one place both
# tools/godot_gui.sh and the Makefile's capture-image target read them from, so
# an engine bump changes the tag and forces a rebuild rather than silently
# rendering on the old binary.
#
# Keep GODOT_CAPTURE_VERSION equal to the engine version the Makefile's macOS
# binary and .github/workflows/verify.yml are pinned to.
GODOT_CAPTURE_VERSION=4.7.1-stable
GODOT_CAPTURE_IMAGE=grid-commanders-capture:4.7.1-stable
